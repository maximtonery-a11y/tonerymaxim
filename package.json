{
  "name": "tonerymaxim",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "worker:ads:refresh": "node --experimental-strip-types scripts/run-ads-intelligence-worker.ts",
    "preview": "astro preview --host 0.0.0.0 --port 3000",
    "check": "astro check",
    "test": "npm run test:ads && npm run test:search && npm run test:woo && npm run test:seo && npm run test:migration && npm run test:security && npm run test:production",
    "test:ads": "node --experimental-strip-types --test scripts/ads-intelligence.test.ts scripts/google-ads-readonly.test.ts scripts/ads-intelligence-api.test.ts scripts/marketing-v2.test.ts scripts/data-attribution-v3.test.ts scripts/marketing-optimization-v2.test.ts",
    "test:search": "node --experimental-strip-types --test scripts/search-quality.test.ts",
    "test:woo": "node --experimental-strip-types --test scripts/woocommerce-catalog.test.ts",
    "test:seo": "node --experimental-strip-types --test scripts/seo-foundation.test.ts scripts/seo-index-cache.test.ts scripts/seo-snippet.test.ts scripts/product-publication-policy.test.ts scripts/seo-content-quality.test.ts",
    "test:migration": "node --experimental-strip-types --test scripts/legacy-migration.test.ts && node scripts/migration-gate.test.mjs",
    "test:security": "node --experimental-strip-types --test scripts/security-config.test.ts",
    "test:production": "node --experimental-strip-types --test scripts/production-readiness.test.ts scripts/calendar-integration.test.ts scripts/ai-tomas-calendars.test.ts scripts/ai-tomas-hard-regression.test.ts scripts/combined-release.test.ts",
    "test:storefront": "node scripts/storefront-production-smoke.mjs",
    "test:storefront:load": "node scripts/storefront-load-smoke.mjs",
    "geo:score": "node scripts/geo-ai-score.mjs",
    "release:check": "npm run check && npm test && npm run build && npm audit --omit=dev",
    "release:verify:local": "node scripts/verify-local-catalog.mjs",
    "release:verify:info": "node scripts/verify-deployment.mjs --base-url https://www.tonerymaxim.info",
    "release:verify:sk": "node scripts/verify-deployment.mjs --base-url https://www.tonerymaxim.sk",
    "migration:gate": "node scripts/run-migration-gate.mjs",
    "migration:gate:remote": "node scripts/migration-gate.mjs",
    "migration:gate:dry-run": "node scripts/migration-gate.mjs --dry-run --no-fail",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "11.0.3",
    "astro": "7.1.6",
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.1.2",
    "@types/nodemailer": "8.0.1",
    "typescript": "6.0.3"
  }
}
