# Povinné minimum pre ostrú prevádzku ToneryMAXIM
NODE_ENV=production
PUBLIC_SITE_URL=https://www.tonerymaxim.sk

# Vygenerujte jedinečný náhodný reťazec s minimálne 32 znakmi.
# Nepoužívajte túto ukážkovú hodnotu.
AUTH_SECRET=SEM_VLOZTE_DLHY_NAHODNY_TAJNY_RETAZEC_MIN_32_ZNAKOV

# Ochrana administrátorských API a synchronizácie
ADMIN_API_SECRET=SEM_VLOZTE_INY_DLHY_NAHODNY_RETAZEC
SYNC_SECRET=SEM_VLOZTE_INY_DLHY_NAHODNY_RETAZEC
TM_PERSISTENCE_SECRET=SEM_VLOZTE_INY_DLHY_NAHODNY_RETAZEC
TM_ANALYTICS_ADMIN_KEY=SEM_VLOZTE_SAMOSTATNY_KLUC_PRE_ADMIN_DASHBOARDY
TM_PERSISTENT_DATA_DIR=/app/data
TM_CACHE_DIR=/app/data/product-cache

# Denná aktualizácia stránky poradne o firmvéri. Údaje uložte iba ako tajné
# premenné v Coolify; nikdy ich nevkladajte do zdrojového kódu ani verejného PUBLIC_ kľúča.
ABIX_FIRMWARE_ENABLED=1
ABIX_FIRMWARE_USERNAME=
ABIX_FIRMWARE_PASSWORD=
ABIX_FIRMWARE_INTERVAL_MS=86400000
ABIX_FIRMWARE_START_DELAY_MS=90000

# Produkčné testovacie endpointy musia zostať vypnuté
TM_ALLOW_TEST_ENDPOINTS=0

# WooCommerce
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
# Voliteľná absolútna poistka. Hodnota 0 používa dynamický počet hlásený WooCommerce.
# Nenastavujte odhad vyšší než skutočný počet publikovaných produktov.
WOO_SYNC_EXPECTED_MIN_PRODUCTS=0
WOO_SYNC_COMPLETENESS_RATIO=0.99
WOO_SYNC_MIN_PRODUCTS=100
WOO_CACHE_TTL_MS=3600000
WOO_READINESS_MAX_CACHE_AGE_MS=129600000

# Google Merchant Center – predvolené hodnoty zodpovedajú aktuálnej doprave e-shopu
MERCHANT_FEED_MIN_PRODUCTS=50
MERCHANT_SHIPPING_PRICE=3.90
MERCHANT_FREE_SHIPPING_FROM=29
MERCHANT_MIN_HANDLING_DAYS=0
MERCHANT_MAX_HANDLING_DAYS=1
MERCHANT_MIN_TRANSIT_DAYS=1
MERCHANT_MAX_TRANSIT_DAYS=2

# Google tag pre GA4 / Google Ads. Podporované sú G-, GT-, AW- aj GTM- identifikátory.
# Značka sa načíta v režime Consent Mode a súhlas sa aktualizuje cez cookie panel.
PUBLIC_GOOGLE_TAG_ID=G-F8E3LFM3WJ

# Spätná kompatibilita pre staré nasadenia s Google Tag Manager kontajnerom.
PUBLIC_GTM_ID=

# Google Ads API – iba čítanie výkonových dát, konektor nevykonáva žiadne mutate operácie.
# Developer token získate v API Center Google Ads manager účtu. ID zapisujte bez pomlčiek.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Vyplňte iba ak pristupujete cez manager (MCC) účet.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# TM SEO Dominator – počet denných priorít, povolený rozsah 20 až 100
SEO_DOMINATOR_LIMIT=100

# AI Tomáš – kľúč patrí iba do serverového prostredia, nikdy nie do PUBLIC_ premennej
OPENAI_ASSISTANT_ENABLED=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=12000
OPENAI_MAX_OUTPUT_TOKENS=450

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Povinné: odosielateľ musí byť na doméne @tonerymaxim.sk. Iná doména je aplikáciou zablokovaná.
MAIL_FROM=info@tonerymaxim.sk
MAIL_NAME=ToneryMAXIM.sk
MAIL_REPLY_TO=info@tonerymaxim.sk
ADMIN_EMAIL=

# Toner bez starostí – upozornenia zákazníkovi a obchodníkovi 21 dní pred odhadovanou výmenou
TM_TONER_CARE_ENABLED=1
# Kontrola raz denne; každá výmena sa odošle iba raz vďaka záznamu v zákazníckom účte.
TM_TONER_CARE_INTERVAL_MS=86400000
TM_TONER_CARE_START_DELAY_MS=180000

# Heureka XML a Overené zákazníkmi
# Tajný 32-znakový kľúč patrí iba do serverového prostredia (nikdy nie PUBLIC_).
HEUREKA_SECRET_KEY=
HEUREKA_VERIFIED_ENABLED=1
# 1 = expedícia najbližší pracovný deň. Hodnotu 0 použite iba pri reálnej expedícii v deň objednávky.
HEUREKA_DELIVERY_DAYS=1
HEUREKA_FEED_MIN_PRODUCTS=50

# Výkon vyhľadávania a produktového katalógu
SMART_SEARCH_CACHE_TTL_MS=600000
SMART_SEARCH_CACHE_MAX_ITEMS=1000
SMART_SEARCH_MAX_PREFIX_BUCKET=1200
PRODUCTS_API_CACHE_TTL_MS=300000
PRODUCTS_API_CACHE_MAX_ITEMS=500

# GoPay
GOPAY_ENV=production
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_RETURN_URL=https://www.tonerymaxim.sk/platba-dokoncena
GOPAY_NOTIFY_URL=https://www.tonerymaxim.sk/api/gopay-notify

# Samostatný katalóg Kalendáre 2027. Volá sa iba pri objednávke obsahujúcej kalendár;
# tonerové objednávky túto službu nepotrebujú. Pri výpadku sa použije pribalený posledný overený katalóg.
TM_CALENDAR_CATALOG_URL=https://www.tonerymaxim.sk/kalendare/api/products

# Samostatný kalendárový Merchant feed obsluhuje kalendárová aplikácia:
# https://www.tonerymaxim.sk/kalendare/google.xml
