# Povinné minimum pre ostrú prevádzku ToneryMAXIM
NODE_ENV=production
PUBLIC_SITE_URL=https://www.tonerymaxim.sk

# Vygenerujte jedinečný náhodný reťazec s minimálne 32 znakmi.
# Nepoužívajte túto ukážkovú hodnotu.
AUTH_SECRET=SEM_VLOZTE_DLHY_NAHODNY_TAJNY_RETAZEC_MIN_32_ZNAKOV

# Ochrana administrátorských API a synchronizácie
ADMIN_API_SECRET=SEM_VLOZTE_INY_DLHY_NAHODNY_RETAZEC
SYNC_SECRET=SEM_VLOZTE_INY_DLHY_NAHODNY_RETAZEC
TM_PERSISTENCE_SECRET=SEM_VLOZTE_INY_DLHY_NAHODNY_RETAZEC
TM_PERSISTENT_DATA_DIR=/app/data

# Produkčné testovacie endpointy musia zostať vypnuté
TM_ALLOW_TEST_ENDPOINTS=0

# WooCommerce
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_NAME=ToneryMAXIM
MAIL_REPLY_TO=
ADMIN_EMAIL=

# GoPay
GOPAY_ENV=production
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_RETURN_URL=https://www.tonerymaxim.sk/platba/vysledok
GOPAY_NOTIFY_URL=https://www.tonerymaxim.sk/api/gopay-notify
