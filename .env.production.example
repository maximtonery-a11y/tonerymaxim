# Povinné minimum pre ostrú prevádzku ToneryMAXIM
NODE_ENV=production
PUBLIC_SITE_URL=https://www.tonerymaxim.sk

# Vygenerujte jedinečný náhodný reťazec s minimálne 32 znakmi.
# Nepoužívajte túto ukážkovú hodnotu.
AUTH_SECRET=SEM_VLOZTE_DLHY_NAHODNY_TAJNY_RETAZEC_MIN_32_ZNAKOV

# Ochrana administrátorských API a synchronizácie
ADMIN_API_SECRET=SEM_VLOZTE_INY_DLHY_NAHODNY_RETAZEC
SYNC_SECRET=SEM_VLOZTE_INY_DLHY_NAHODNY_RETAZEC
TM_PERSISTENCE_SECRET=SEM_VLOZTE_INY_DLHY_NAHODNY_RETAZEC
TM_ANALYTICS_ADMIN_KEY=SEM_VLOZTE_SAMOSTATNY_KLUC_PRE_ADMIN_DASHBOARDY
TM_PERSISTENT_DATA_DIR=/app/data
TM_CACHE_DIR=/app/data/product-cache

# Produkčné testovacie endpointy musia zostať vypnuté
TM_ALLOW_TEST_ENDPOINTS=0

# WooCommerce
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
# Voliteľná absolútna poistka. Hodnota 0 používa dynamický počet hlásený WooCommerce.
# Nenastavujte odhad vyšší než skutočný počet publikovaných produktov.
WOO_SYNC_EXPECTED_MIN_PRODUCTS=0
WOO_SYNC_COMPLETENESS_RATIO=0.99
WOO_SYNC_MIN_PRODUCTS=100
WOO_CACHE_TTL_MS=3600000
WOO_READINESS_MAX_CACHE_AGE_MS=129600000

# Google Merchant Center – predvolené hodnoty zodpovedajú aktuálnej doprave e-shopu
MERCHANT_FEED_MIN_PRODUCTS=50
MERCHANT_SHIPPING_PRICE=3.90
MERCHANT_FREE_SHIPPING_FROM=29
MERCHANT_MIN_HANDLING_DAYS=0
MERCHANT_MAX_HANDLING_DAYS=1
MERCHANT_MIN_TRANSIT_DAYS=1
MERCHANT_MAX_TRANSIT_DAYS=2

# Voliteľné meranie Google Ads/GA4 cez Google Tag Manager.
# Bez platného GTM-ID sa žiadny Google skript nenačíta.
PUBLIC_GTM_ID=

# TM SEO Dominator – počet denných priorít, povolený rozsah 20 až 100
SEO_DOMINATOR_LIMIT=100

# AI Tomáš – kľúč patrí iba do serverového prostredia, nikdy nie do PUBLIC_ premennej
OPENAI_ASSISTANT_ENABLED=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=12000
OPENAI_MAX_OUTPUT_TOKENS=450

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_NAME=ToneryMAXIM
MAIL_REPLY_TO=
ADMIN_EMAIL=

# Heureka – voliteľné. Bez kľúča sa nezobrazujú neoverené náhradné recenzie.
HEUREKA_SECRET_KEY=

# GoPay
GOPAY_ENV=production
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_RETURN_URL=https://www.tonerymaxim.sk/platba-dokoncena
GOPAY_NOTIFY_URL=https://www.tonerymaxim.sk/api/gopay-notify
