        return d
      }
      function orderNo(v:unknown){return String(v||'—')}function setBase(no:unknown,method:string,state:string){e.order.textContent=orderNo(no);e.order2&&(e.order2.textContent=orderNo(no));e.sideOrder.textContent=orderNo(no);e.payment.textContent=payText(method);e.payment2&&(e.payment2.textContent=payText(method));e.sidePayment.textContent=payText(method);e.state&&(e.state.textContent=state||'Uložené');e.vs.textContent=String(no||'').replace(/\D/g,'')||'—'}
      function bank(show:boolean){e.bank.classList.toggle('hidden',!show)}function showRetry(url:string){if(url){e.retry.href=url;e.retry.classList.remove('tm26-hidden')}else{e.retry.href='/pokladna';e.retry.classList.remove('tm26-hidden')}}
      async function reward(no:unknown,success=true){if(!success){e.reward.classList.add('tm26-hidden');return}const isReg=await registered();if(isReg){e.rewardText.textContent='Po dokončení objednávky získate 7 % zľavu na ďalší nákup kompatibilných tonerov. Pri ďalšej objednávke sa prihlásenému zákazníkovi použije automaticky.';e.couponCode.textContent='7 %';e.couponLabel.textContent='zľava na ďalší nákup'}else{const code=`MAXIM${String(no||Date.now()).replace(/\D/g,'')}`;e.rewardText.textContent='Po dokončení objednávky získate kupón so zľavou 7 % na ďalší nákup kompatibilných tonerov. Kupón potom zadáte v pokladni.';e.couponCode.textContent=code;e.couponLabel.textContent='zľava 7 % na ďalší nákup'}}
      function trackPurchase(no:unknown,pr:any,total:number,attempt=0){const tracker=(window as any).tmTrackPurchase;if(typeof tracker==='function'){tracker(no,pr,total);return}if(attempt<20)setTimeout(()=>trackPurchase(no,pr,total,attempt+1),100)}
      function success(no:unknown,method:string,msg?:string){const pr=preview();const totals=calc(pr);trackPurchase(no,pr,totals.total);e.pill.classList.remove('is-failed','is-pending');e.icon.textContent='✓';e.status.textContent='Objednávka prijatá';e.title.textContent='Ďakujeme. Objednávku máme.';e.lead.textContent=msg||'Potvrdenie sme poslali na e-mail uvedený v pokladni. Skladové produkty pripravíme čo najskôr.';setBase(no,method,method==='gopay'?'Zaplatené':'Uložené');bank(method==='bank_prepaid');reward(no,true);localStorage.removeItem('tm_cart_v1');localStorage.removeItem('tm_coupon_v1');localStorage.removeItem('tm_loyalty_apply')}
      function fail(no:unknown,method:string,msg:string|undefined,gw:string){e.pill.classList.add('is-failed');e.icon.textContent='!';e.status.textContent='Platba nedokončená';e.title.textContent='Platba nebola dokončená.';e.lead.textContent=msg||'Objednávka zatiaľ nie je zaplatená. Skúste platbu zopakovať cez GoPay.';setBase(no,method,'Nezaplatené');bank(false);reward(no,false);showRetry(gw)}
      async function init(){const pr=preview();render(pr);if(directOrder){success(directOrder,directMethod||pr?.payment,'Objednávka bola úspešne uložená. Potvrdenie sme poslali na e-mail uvedený v pokladni.');return}if(!paymentId){e.pill.classList.add('is-pending');e.icon.textContent='?';e.status.textContent='Nevieme overiť';e.title.textContent='Objednávku nevieme overiť.';e.lead.textContent='V adrese chýba číslo objednávky alebo GoPay ID platby.';setBase('—',directMethod||pr?.payment,'Neoverené');return}try{const r=await fetch(`/api/gopay-status?id=${encodeURIComponent(paymentId)}`,{headers:{Accept:'application/json'}});const data=await r.json();const state=String(data?.state||'UNKNOWN');const no=data?.payment?.order_number||data?.pending?.orderNumber||`TM-${paymentId}`;const gw=data?.payment?.gw_url||data?.pending?.gwUrl||'';if(!r.ok||!data.ok){fail(no,'gopay',data?.error||'Platbu sa nepodarilo overiť.',gw);return}if(state==='PAID')success(no,'gopay','Online platba prebehla úspešne. Potvrdenie sme poslali na e-mail uvedený v pokladni.');else if(['CANCELED','TIMEOUTED','FAILED'].includes(state))fail(no,'gopay',data?.ui?.message,gw);else{e.pill.classList.add('is-pending');e.icon.textContent='…';e.status.textContent='Platbu overujeme';e.title.textContent='Platbu ešte overujeme.';e.lead.textContent=data?.ui?.message||'GoPay zatiaľ neposlal finálny stav. Skúste stránku o chvíľu obnoviť.';setBase(no,'gopay',state);showRetry(gw)}}catch(err){fail(`TM-${paymentId}`,'gopay','Platbu sa nepodarilo overiť. Skúste platbu zopakovať alebo nás kontaktujte.','')}}
      document.querySelector('[data-copy-iban]')?.addEventListener('click',()=>navigator.clipboard?.writeText(String(document.querySelector('[data-iban]')?.textContent||'').replace(/\s/g,'')));document.querySelector('[data-copy-vs]')?.addEventListener('click',()=>navigator.clipboard?.writeText(e.vs.textContent||''));init();
    </script>
  </body>
</html>
