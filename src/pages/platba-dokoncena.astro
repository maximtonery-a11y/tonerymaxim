    <script>
      const $=(s:string):any=>document.querySelector(s);const p=new URLSearchParams(location.search);const paymentId=p.get("id");const directOrder=p.get("order");const directMethod=p.get("method");
      const e={pill:$('[data-status-pill]'),icon:$('[data-icon]'),status:$('[data-status]'),title:$('[data-title]'),lead:$('[data-lead]'),order:$('[data-order]'),order2:$('[data-order-2]'),dispatch:$('[data-dispatch]'),payment:$('[data-payment]'),payment2:$('[data-payment-2]'),state:$('[data-state]'),total:$('[data-total]'),sideCount:$('[data-side-count]'),sideShipping:$('[data-side-shipping]'),sidePayment:$('[data-side-payment]'),sideOrder:$('[data-side-order]'),count:$('[data-count]'),date:$('[data-date]'),items:$('[data-items]'),summary:$('[data-summary]'),shipping:$('[data-shipping]'),bank:$('[data-bank]'),vs:$('[data-vs]'),bankTotal:$('[data-bank-total]'),retry:$('[data-gopay-retry]'),reward:$('[data-reward]'),rewardText:$('[data-reward-text]'),couponCode:$('[data-coupon-code]'),couponLabel:$('[data-coupon-label]'),addresses:$('[data-addresses]')};
      const fmtDate=new Intl.DateTimeFormat('sk-SK',{day:'numeric',month:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'});if(e.date)e.date.textContent=fmtDate.format(new Date());
      const money=(v:unknown)=>new Intl.NumberFormat('sk-SK',{style:'currency',currency:'EUR'}).format(Number.isFinite(Number(v))?Number(v):0);const esc=(v:unknown)=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
      function preview():any{try{return JSON.parse(localStorage.getItem('tm_last_order_preview')||'null')}catch{return null}}function img(i:any){return i?.image||i?.images?.[0]?.src||i?.imageUrl||'/images/tm-product-placeholder-box.jpg'}
      function payText(m:unknown){return m==='cod'?'Dobierka':m==='bank_prepaid'?'Platba prevodným príkazom vopred':m==='invoice_org'?'Prevod pre firmy':m==='applepay'?'Apple Pay':m==='googlepay'?'Google Pay':'Online platba GoPay'}
      function calc(pr:any){const cart:any[]=Array.isArray(pr?.cart)?pr.cart:[];const pricing=pr?.pricing||{};const shipping=pr?.shipping||{};const method=String(pr?.payment||directMethod||'');const itemsTotal=cart.reduce((s:number,i:any)=>s+Number(i.price||0)*Number(i.qty||1),0);const qd=Number(pricing.discount||0);const cd=Number(pr?.coupon?.discount||0);const ld=Number(pr?.loyalty?.apply?pr?.loyalty?.discount||0:0);const discountedSubtotal=Math.max(0,itemsTotal-qd);const goodsAfterDiscounts=Math.max(0,discountedSubtotal-cd-ld);const ship=goodsAfterDiscounts>=29?0:Number(shipping?.price||0);const pp=method==='cod'?1.2:0;const total=Math.max(0,Math.round((goodsAfterDiscounts+ship+pp)*100)/100);return{cart,shipping,method,itemsTotal,qd,cd,ld,ship,pp,total,net:total/1.23,vat:total-total/1.23}}
      async function registered(){try{const r=await fetch('/api/account/me',{headers:{Accept:'application/json'}});return r.ok}catch{return false}}
      function pick(o:any,...keys:string[]){for(const k of keys){const v=o?.[k];if(v!==undefined&&v!==null&&String(v).trim())return String(v).trim()}return ''}
      function normalizeAddress(raw:any, fallback:any){
        const v=raw||{};
        if(typeof v==='string') return { note:v.trim() };
        const out={
          company:pick(v,'company'), ico:pick(v,'ico','icO','IČO'), dic:pick(v,'dic','DIČ'), icDph:pick(v,'icDph','ic_dph','vat','IČDPH'),
          firstName:pick(v,'firstName','first_name'), lastName:pick(v,'lastName','last_name'),
          name:pick(v,'name'), street:pick(v,'address','address_1','street','ulica'),
          city:pick(v,'city','mesto'), zip:pick(v,'zip','postcode','postal_code','psc'),
          email:pick(v,'email') || pick(fallback,'email'), phone:pick(v,'phone') || pick(fallback,'phone')
        };
        return out;
      }
      function hasAddress(a:any){return Boolean(a&&(a.note||a.company||a.firstName||a.lastName||a.name||a.street||a.city||a.zip||a.email||a.phone||a.ico||a.dic||a.icDph))}
      function addressRows(rows:Array<[unknown,unknown]>){return `<div class="tm26-address-table">${rows.map(([l,v])=>`<div class="tm26-address-row"><span>${esc(l)}</span><strong>${esc(v)}</strong></div>`).join('')}</div>`}
      function addressCard(title:string,a:any){
        if(!hasAddress(a)) return `<div class="tm26-address-box"><h3>${esc(title)}</h3><div class="tm26-address-empty2">Adresa nebola uložená v náhľade objednávky.</div></div>`;
        if(a.note) return `<div class="tm26-address-box"><h3>${esc(title)}</h3><div class="tm26-address-empty2">${esc(a.note)}</div></div>`;
        const rows:Array<[string,unknown]>=[];
        const fullName=a.name || [a.firstName,a.lastName].filter(Boolean).join(' ');
        if(a.company) rows.push(['Firma',a.company]);
        if(a.ico) rows.push(['IČO',a.ico]);
        if(a.dic) rows.push(['DIČ',a.dic]);
        if(a.icDph) rows.push(['IČ DPH',a.icDph]);
        if(a.firstName) rows.push(['Meno',a.firstName]);
        if(a.lastName) rows.push(['Priezvisko',a.lastName]);
        if(!a.firstName && !a.lastName && fullName) rows.push(['Meno a priezvisko',fullName]);
        if(a.street) rows.push(['Ulica a číslo',a.street]);
        if(a.zip) rows.push(['PSČ',a.zip]);
        if(a.city) rows.push(['Mesto / obec',a.city]);
        if(a.email) rows.push(['E-mail',a.email]);
        if(a.phone) rows.push(['Telefón',a.phone]);
        return `<div class="tm26-address-box"><h3>${esc(title)}</h3>${addressRows(rows)}</div>`;
      }
      function sameDelivery(delivery:any){return !delivery || delivery.differentAddress===false || (!delivery.street&&!delivery.address&&!delivery.address_1&&!delivery.city&&!delivery.zip&&!delivery.firstName&&!delivery.lastName)}
      function render(pr:any){
        const d=calc(pr);const qty=d.cart.reduce((sum:number,item:any)=>sum+Number(item.qty||1),0);
        e.total.textContent=d.total?money(d.total):'—';
        e.shipping&&(e.shipping.textContent=d.shipping?.label||'—');
        e.sideShipping.textContent=d.shipping?.label||'—';
        e.sideCount&&(e.sideCount.textContent=qty?`${qty} ks`:'—');
        if(e.count)e.count.textContent=qty?`${qty} ks v objednávke`:'Súhrn objednávky';
        if(e.items)e.items.innerHTML=d.cart.length?d.cart.map(i=>{const q=Number(i.qty||1),lt=Number(i.price||0)*q;const meta=[i.sku?`SKU: ${esc(i.sku)}`:'',q?`${q} ks`:''].filter(Boolean);return `<div class="tm26-order-product-row"><div class="tm26-order-product-image"><img src="${esc(img(i))}" alt="${esc(i.name||'Produkt')}" loading="lazy"></div><div class="tm26-order-product-info"><div class="tm26-order-product-name">${esc(i.name||'Produkt')}</div><div class="tm26-order-product-meta">${meta.map(m=>`<span>${m}</span>`).join('')}</div></div><div class="tm26-order-product-qty">${q} ks</div><div class="tm26-order-product-price">${money(lt)}</div></div>`}).join(''):`<div class="tm26-order-product-row"><div class="tm26-order-product-image"><img src="/images/tm-product-placeholder-box.jpg" alt="Produkt" loading="lazy"></div><div class="tm26-order-product-info"><div class="tm26-order-product-name">Objednávka bola prijatá</div><div class="tm26-order-product-meta"><span>Detail pošleme e-mailom.</span></div></div><div class="tm26-order-product-qty">—</div><div class="tm26-order-product-price">—</div></div>`;
        const rows=[];
        if(d.itemsTotal)rows.push(`<div class="tm26-order-summary-row"><span>Produkty</span><span></span><strong>${money(d.itemsTotal)}</strong></div>`);
        if(d.qd>0)rows.push(`<div class="tm26-order-summary-row discount"><span>Množstevná / sadová zľava</span><span></span><strong>-${money(d.qd)}</strong></div>`);
        if(d.cd>0)rows.push(`<div class="tm26-order-summary-row discount"><span>${esc(pr?.coupon?.label||'Kupónová zľava')}</span><span></span><strong>-${money(d.cd)}</strong></div>`);
        if(d.ld>0)rows.push(`<div class="tm26-order-summary-row discount"><span>Vernostné body</span><span></span><strong>-${money(d.ld)}</strong></div>`);
        rows.push(`<div class="tm26-order-summary-row"><span>Doprava</span><span></span><strong>${d.ship>0?money(d.ship):'Zdarma'}</strong></div>`);
        rows.push(`<div class="tm26-order-summary-row"><span>Platba</span><span></span><strong>${d.pp>0?money(d.pp):'Bez poplatku'}</strong></div>`);
