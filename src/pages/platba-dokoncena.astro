---
import "../styles/global.css";
import Header from "../components/Header.astro";
import "../styles/footer.css";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import { BANK_TRANSFER_DETAILS } from "../lib/bank-details";

const title = "Ďakujeme za objednávku | ToneryMaxim.sk";
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        --tm26-navy:#061a3a;
        --tm26-blue:#1f6fff;
        --tm26-green:#0ea85b;
        --tm26-red:#dc2626;
        --tm26-amber:#f8b400;
        --tm26-muted:#607089;
        --tm26-line:#dce8f5;
        --tm26-soft:#f4f8fd;
        --tm26-card:#fff;
        --tm26-shadow:0 24px 70px rgba(6,26,58,.09);
      }
      body{background:#fff;color:var(--tm26-navy)}
      .tm26-page{min-height:70vh;padding:44px 0 82px;background:radial-gradient(circle at 8% 10%,rgba(31,111,255,.08),transparent 30%),radial-gradient(circle at 90% 4%,rgba(248,180,0,.14),transparent 28%),linear-gradient(180deg,#fff 0%,#f5f9ff 46%,#fff 100%)}
      .tm26-wrap{width:min(1180px,calc(100% - 48px));margin:0 auto}
      .tm26-hero{display:grid;grid-template-columns:minmax(0,1fr) 430px;gap:26px;align-items:stretch}
      .tm26-main,.tm26-card,.tm26-bank,.tm26-reward,.tm26-help{background:rgba(255,255,255,.94);border:1px solid var(--tm26-line);border-radius:32px;box-shadow:var(--tm26-shadow)}
      .tm26-main{padding:38px 42px 34px;min-height:430px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;position:relative}
      .tm26-main:after{content:"";position:absolute;right:-80px;top:-110px;width:300px;height:300px;border-radius:999px;background:rgba(31,111,255,.07);pointer-events:none}
      .tm26-status{display:inline-flex;align-items:center;gap:12px;width:max-content;max-width:100%;padding:9px 13px 9px 9px;border:1px solid var(--tm26-line);border-radius:999px;background:#fff;font-weight:950;color:var(--tm26-navy)}
      .tm26-mark{width:42px;height:42px;border-radius:999px;background:#e9f8f0;color:var(--tm26-green);display:grid;place-items:center;font-size:26px;font-weight:950;line-height:1}
      .tm26-status.is-failed .tm26-mark{background:#fff1f2;color:var(--tm26-red)}
      .tm26-status.is-pending .tm26-mark{background:#fff7dd;color:#b77900}
      .tm26-title{margin:8px 0 0;max-width:720px;font-size:clamp(42px,5vw,76px);line-height:.94;letter-spacing:-.065em}
      .tm26-lead{margin:20px 0 0;max-width:650px;color:var(--tm26-muted);font-size:18px;line-height:1.55}
      .tm26-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:32px;position:relative;z-index:1}
      .tm26-fact{border:1px solid var(--tm26-line);background:#fff;border-radius:20px;padding:15px 16px;min-width:0}
      .tm26-fact span{display:block;color:var(--tm26-muted);font-weight:800;font-size:13px;margin-bottom:6px}
      .tm26-fact strong{display:block;font-size:16px;line-height:1.2;word-break:break-word}
      .tm26-side{display:grid;gap:16px}
      .tm26-card{padding:22px;display:flex;flex-direction:column;gap:16px}
      .tm26-card-kicker{color:var(--tm26-muted);font-weight:850;font-size:13px}
      .tm26-card h2{margin:0;font-size:26px;line-height:1.05;letter-spacing:-.04em}
      .tm26-total{font-size:42px;font-weight:950;letter-spacing:-.06em;margin-top:2px}
      .tm26-mini-rows{display:grid;gap:0;border:1px solid var(--tm26-line);border-radius:20px;overflow:hidden;background:#fff}
      .tm26-mini-row{display:flex;justify-content:space-between;gap:16px;padding:13px 15px;border-top:1px solid var(--tm26-line);color:var(--tm26-muted);font-weight:850}
      .tm26-mini-row:first-child{border-top:0}.tm26-mini-row strong{color:var(--tm26-navy);text-align:right}
      .tm26-buttons{display:grid;grid-template-columns:1fr 1fr;gap:10px}
      .tm26-btn{border:1px solid var(--tm26-line);background:#fff;color:var(--tm26-navy);min-height:52px;border-radius:16px;text-decoration:none;display:flex;align-items:center;justify-content:center;text-align:center;padding:0 18px;font-weight:950;cursor:pointer;font:inherit}
      .tm26-btn.primary{background:var(--tm26-blue);border-color:var(--tm26-blue);color:#fff;box-shadow:0 14px 30px rgba(31,111,255,.22)}
      .tm26-btn.danger{background:var(--tm26-red);border-color:var(--tm26-red);color:#fff;box-shadow:0 14px 30px rgba(220,38,38,.18)}
      .tm26-strip{margin-top:24px;background:#fff;border:1px solid var(--tm26-line);border-radius:28px;box-shadow:0 18px 50px rgba(6,26,58,.06);padding:24px}
      .tm26-strip-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:24px}
      .tm26-strip h2,.tm26-bank h2,.tm26-reward h2,.tm26-help h2{margin:0;font-size:26px;letter-spacing:-.04em}
      .tm26-strip-head p{margin:0;color:var(--tm26-muted);font-weight:750}
      .tm26-timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;position:relative}
      .tm26-timeline:before{content:"";position:absolute;left:38px;right:38px;top:27px;height:2px;background:var(--tm26-line)}
      .tm26-step{position:relative;z-index:1;text-align:center}
      .tm26-dot{width:54px;height:54px;border-radius:999px;background:#fff;border:2px solid var(--tm26-line);display:grid;place-items:center;margin:0 auto 10px;font-weight:950;color:var(--tm26-muted)}
      .tm26-step.active .tm26-dot{background:var(--tm26-green);border-color:var(--tm26-green);color:#fff}
      .tm26-step strong{display:block;font-size:15px}.tm26-step span{display:block;margin-top:4px;color:var(--tm26-muted);font-size:13px;line-height:1.35}
      .tm26-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:22px;margin-top:24px}
      .tm26-panel{background:#fff;border:1px solid var(--tm26-line);border-radius:28px;box-shadow:0 18px 50px rgba(6,26,58,.06);padding:24px}
      .tm26-panel-head{display:flex;justify-content:space-between;gap:16px;margin-bottom:18px}.tm26-panel h2{margin:0;font-size:26px;letter-spacing:-.04em}.tm26-panel-head span{color:var(--tm26-muted);font-weight:850}
      .tm26-items{display:grid;gap:10px}.tm26-item{display:grid;grid-template-columns:74px 1fr auto;gap:16px;align-items:center;border:1px solid var(--tm26-line);border-radius:18px;padding:14px 16px;background:#fff}.tm26-item-img{width:74px;height:58px;border:1px solid var(--tm26-line);border-radius:14px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden}.tm26-item-img img{max-width:100%;max-height:100%;object-fit:contain}.tm26-item strong{display:block;font-size:17px;line-height:1.18}.tm26-item span{display:block;color:var(--tm26-muted);font-weight:750;margin-top:4px}.tm26-item-price{font-weight:950;white-space:nowrap;font-size:18px}
      .tm26-order-table{border:1px solid var(--tm26-line);border-radius:22px;overflow:hidden;background:#fff}.tm26-order-head,.tm26-order-line,.tm26-cart-total-row{display:grid;grid-template-columns:minmax(0,1fr) 110px 120px;gap:16px;align-items:center}.tm26-order-head{background:#f6f9fd;color:var(--tm26-muted);font-size:13px;font-weight:950;padding:12px 16px}.tm26-order-line{padding:14px 16px;border-top:1px solid var(--tm26-line)}.tm26-order-product{display:grid;grid-template-columns:72px minmax(0,1fr);gap:14px;align-items:center}.tm26-order-thumb{width:72px;height:56px;border:1px solid var(--tm26-line);border-radius:14px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;flex:0 0 72px}.tm26-order-thumb img{width:auto!important;height:auto!important;max-width:68px!important;max-height:52px!important;object-fit:contain!important;display:block}.tm26-order-name{font-weight:950;font-size:16px;line-height:1.2}.tm26-order-meta{margin-top:4px;color:var(--tm26-muted);font-size:13px;font-weight:800}.tm26-order-qty,.tm26-order-price{text-align:right;font-weight:950}.tm26-order-totals{border-top:1px solid var(--tm26-line);padding:10px 16px;background:#fff}.tm26-cart-total-row{padding:8px 0;color:var(--tm26-muted);font-weight:850}.tm26-cart-total-row strong{text-align:right;color:var(--tm26-navy)}.tm26-cart-total-row.discount,.tm26-cart-total-row.discount strong{color:var(--tm26-green)}.tm26-cart-total-row.total{border-top:1px solid var(--tm26-line);margin-top:6px;padding-top:14px;color:var(--tm26-navy);font-size:18px}.tm26-cart-total-row.total strong{font-size:22px}.tm26-addresses{display:grid;gap:14px}.tm26-address-card{border:1px solid var(--tm26-line);border-radius:20px;background:#fff;overflow:hidden}.tm26-address-card h3{margin:0;padding:13px 15px;background:#f6f9fd;border-bottom:1px solid var(--tm26-line);font-size:16px}.tm26-address-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px}.tm26-address-field{border:1px solid var(--tm26-line);border-radius:14px;padding:10px 11px;min-height:54px;background:#fff}.tm26-address-field.full{grid-column:1/-1}.tm26-address-field span{display:block;color:var(--tm26-muted);font-size:12px;font-weight:900;margin-bottom:4px}.tm26-address-field strong{display:block;font-size:14px;line-height:1.25;word-break:break-word}.tm26-address-empty{padding:14px;color:var(--tm26-muted);font-weight:850;line-height:1.45}

      /* v9: prehľad objednávky a adresy nanovo - kompaktne, na celú šírku */
      .tm26-details{display:grid;gap:22px;margin-top:24px}
      .tm26-order-wide{background:#fff;border:1px solid var(--tm26-line);border-radius:28px;box-shadow:0 18px 50px rgba(6,26,58,.06);padding:24px}
      .tm26-section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:18px}
      .tm26-section-head h2{margin:0;font-size:26px;letter-spacing:-.04em}
      .tm26-section-head span{color:var(--tm26-muted);font-weight:850}
      .tm26-cart-like{border:1px solid var(--tm26-line);border-radius:22px;overflow:hidden;background:#fff}
      .tm26-cart-head,.tm26-cart-row{display:grid;grid-template-columns:minmax(0,1fr) 92px 118px;gap:18px;align-items:center}
      .tm26-cart-head{background:#f6f9fd;color:var(--tm26-muted);font-size:13px;font-weight:950;padding:12px 16px}
      .tm26-cart-row{padding:14px 16px;border-top:1px solid var(--tm26-line)}
      .tm26-cart-product{display:grid;grid-template-columns:78px minmax(0,1fr);gap:16px;align-items:center;min-width:0}
      .tm26-cart-thumb{width:78px;height:62px;border:1px solid var(--tm26-line);border-radius:16px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden}
      .tm26-cart-thumb img{display:block!important;width:auto!important;height:auto!important;max-width:72px!important;max-height:56px!important;object-fit:contain!important}
      .tm26-cart-name{font-size:17px;font-weight:950;line-height:1.22;color:var(--tm26-navy)}
      .tm26-cart-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px;color:var(--tm26-muted);font-size:12px;font-weight:850}
      .tm26-chip{border:1px solid var(--tm26-line);background:#f8fbff;border-radius:999px;padding:4px 8px}
      .tm26-cart-qty,.tm26-cart-price{text-align:right;font-weight:950;color:var(--tm26-navy)}
      .tm26-cart-totals{display:grid;grid-template-columns:minmax(0,1fr) 330px;border-top:1px solid var(--tm26-line);background:#fbfdff}
      .tm26-cart-total-list{grid-column:2;padding:12px 16px}
      .tm26-cart-total-row{display:flex;justify-content:space-between;gap:20px;padding:8px 0;color:var(--tm26-muted);font-weight:850}
      .tm26-cart-total-row strong{color:var(--tm26-navy);text-align:right}
      .tm26-cart-total-row.discount,.tm26-cart-total-row.discount strong{color:var(--tm26-green)}
      .tm26-cart-total-row.final{margin-top:6px;padding-top:14px;border-top:1px solid var(--tm26-line);color:var(--tm26-navy);font-size:18px;font-weight:950}
      .tm26-cart-total-row.final strong{font-size:24px}
      .tm26-address-wide{background:#fff;border:1px solid var(--tm26-line);border-radius:28px;box-shadow:0 18px 50px rgba(6,26,58,.06);padding:24px}
      .tm26-address-grid2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
      .tm26-address-box{border:1px solid var(--tm26-line);border-radius:22px;background:#fff;overflow:hidden}
      .tm26-address-box h3{margin:0;padding:14px 16px;background:#f6f9fd;border-bottom:1px solid var(--tm26-line);font-size:18px;letter-spacing:-.02em}
      .tm26-address-table{display:grid;padding:10px 16px 14px}
      .tm26-address-row{display:grid;grid-template-columns:140px minmax(0,1fr);gap:14px;align-items:start;padding:9px 0;border-bottom:1px solid #edf3fa}
      .tm26-address-row:last-child{border-bottom:0}
      .tm26-address-row span{color:var(--tm26-muted);font-size:13px;font-weight:900}
      .tm26-address-row strong{color:var(--tm26-navy);font-size:14px;line-height:1.35;word-break:break-word}
      .tm26-company-sep{margin:8px 0 2px;padding-top:10px;border-top:1px solid var(--tm26-line);color:var(--tm26-blue);font-weight:950;font-size:13px;text-transform:uppercase;letter-spacing:.04em}
      .tm26-address-empty2{padding:16px;color:var(--tm26-muted);font-weight:850;line-height:1.45}
      .tm26-rows{border-top:1px solid var(--tm26-line);margin-top:16px;padding-top:8px}.tm26-row{display:flex;justify-content:space-between;gap:20px;padding:9px 0;color:var(--tm26-muted);font-weight:800}.tm26-row strong{color:var(--tm26-navy);text-align:right}.tm26-row.discount,.tm26-row.discount strong{color:var(--tm26-green)}.tm26-row.total{margin-top:8px;padding-top:16px;border-top:1px solid var(--tm26-line);color:var(--tm26-navy);font-size:20px;font-weight:950}.tm26-row.total strong{font-size:24px}
      .tm26-bank{margin-top:24px;padding:26px;border-color:rgba(31,111,255,.35);background:linear-gradient(135deg,#f4f8ff,#fff)}.tm26-bank.hidden{display:none}.tm26-bank-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:16px}.tm26-bank-box{background:#fff;border:1px solid var(--tm26-line);border-radius:18px;padding:15px}.tm26-bank-box span{display:block;color:var(--tm26-muted);font-weight:800;font-size:13px}.tm26-bank-box strong{display:block;margin-top:5px;font-size:18px;word-break:break-word}.tm26-copy{margin-top:14px;display:flex;gap:10px;flex-wrap:wrap}
      .tm26-reward{margin-top:24px;padding:26px;border-color:rgba(248,180,0,.65);background:linear-gradient(135deg,#fffaf0,#fff);display:grid;grid-template-columns:1fr 310px;gap:22px;align-items:center}.tm26-reward p{margin:10px 0 0;color:var(--tm26-muted);line-height:1.55}.tm26-coupon{background:#fff;border:1px solid rgba(248,180,0,.8);border-radius:24px;min-height:132px;display:grid;place-items:center;text-align:center;padding:18px}.tm26-coupon strong{display:block;font-size:34px;letter-spacing:-.04em;color:var(--tm26-green);word-break:break-all}.tm26-coupon span{display:block;margin-top:8px;font-weight:950}.tm26-coupon small{display:block;margin-top:8px;color:var(--tm26-muted);font-weight:800}
      .tm26-quick{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:24px}.tm26-quick a{text-decoration:none;color:var(--tm26-navy);background:#fff;border:1px solid var(--tm26-line);border-radius:26px;box-shadow:0 18px 48px rgba(6,26,58,.055);padding:24px;display:flex;flex-direction:column;gap:12px;min-height:178px}.tm26-quick b{font-size:22px;letter-spacing:-.03em}.tm26-quick p{margin:0;color:var(--tm26-muted);line-height:1.45}.tm26-quick span{margin-top:auto;color:var(--tm26-blue);font-weight:950}.tm26-icon{width:52px;height:52px;border-radius:17px;background:var(--tm26-soft);display:grid;place-items:center;font-size:24px}
      .tm26-help{margin-top:24px;padding:24px;display:grid;grid-template-columns:64px 1fr auto;gap:18px;align-items:center}.tm26-help p{margin:6px 0 0;color:var(--tm26-muted)}.tm26-ai{width:58px;height:58px;border-radius:20px;background:#fff4cf;display:grid;place-items:center;font-weight:950;font-size:22px}
      .tm26-hidden{display:none!important}
      @media(max-width:1020px){.tm26-hero,.tm26-grid,.tm26-address-grid2,.tm26-reward,.tm26-help{grid-template-columns:1fr}.tm26-bank-grid,.tm26-quick{grid-template-columns:1fr}.tm26-main{min-height:auto}.tm26-facts{grid-template-columns:1fr}.tm26-side{grid-template-columns:1fr}.tm26-buttons{grid-template-columns:1fr}}
      @media(max-width:700px){.tm26-page{padding:22px 0 58px}.tm26-wrap{width:calc(100% - 28px)}.tm26-main,.tm26-card,.tm26-strip,.tm26-panel,.tm26-bank,.tm26-reward,.tm26-help{border-radius:24px}.tm26-main{padding:25px 20px}.tm26-title{font-size:42px}.tm26-lead{font-size:16px}.tm26-card{padding:18px}.tm26-total{font-size:34px}.tm26-strip-head{display:block}.tm26-strip-head p{margin-top:8px}.tm26-timeline{grid-template-columns:1fr;gap:14px}.tm26-timeline:before{display:none}.tm26-step{text-align:left;display:grid;grid-template-columns:54px 1fr;gap:12px;align-items:start}.tm26-dot{margin:0}.tm26-step strong{margin-top:4px}.tm26-item{grid-template-columns:58px 1fr}.tm26-item-img{width:58px;height:48px}.tm26-item-price{grid-column:2}.tm26-row{font-size:14px}.tm26-row.total{font-size:18px}.tm26-row.total strong{font-size:22px}.tm26-address-fields{grid-template-columns:1fr}.tm26-order-head{display:none}.tm26-order-line{grid-template-columns:1fr;gap:10px}.tm26-order-product{grid-template-columns:58px 1fr}.tm26-order-thumb{width:58px;height:48px;flex-basis:58px}.tm26-order-thumb img{max-width:54px!important;max-height:44px!important}.tm26-order-qty,.tm26-order-price{text-align:left}.tm26-cart-total-row{grid-template-columns:1fr auto}.tm26-help{grid-template-columns:1fr}.tm26-ai{width:54px;height:54px}.tm26-coupon strong{font-size:28px}}

      @media(max-width:760px){
        .tm26-order-wide,.tm26-address-wide{padding:18px;border-radius:24px}
        .tm26-section-head{align-items:flex-start;flex-direction:column;gap:6px}
        .tm26-cart-head{display:none}
        .tm26-cart-row{grid-template-columns:1fr;gap:10px;padding:14px}
        .tm26-cart-product{grid-template-columns:64px 1fr;gap:12px}
        .tm26-cart-thumb{width:64px;height:54px;border-radius:14px}.tm26-cart-thumb img{max-width:58px!important;max-height:48px!important}
        .tm26-cart-qty,.tm26-cart-price{text-align:left}.tm26-cart-qty:before{content:'Počet: ';color:var(--tm26-muted)}.tm26-cart-price:before{content:'Cena: ';color:var(--tm26-muted)}
        .tm26-cart-totals{grid-template-columns:1fr}.tm26-cart-total-list{grid-column:1;padding:12px 14px}
        .tm26-address-row{grid-template-columns:112px 1fr;gap:10px}
      }

      /* v10: definitívny Grid/Flex layout pre súhrn a adresy */
      .tm26-details{display:grid!important;grid-template-columns:1fr!important;gap:22px!important;margin-top:24px!important}
      .tm26-order-wide,.tm26-address-wide{width:100%!important;min-width:0!important;box-sizing:border-box!important;background:#fff!important;border:1px solid var(--tm26-line)!important;border-radius:28px!important;box-shadow:0 18px 50px rgba(6,26,58,.06)!important;padding:24px!important}
      .tm26-order-list{display:flex!important;flex-direction:column!important;border:1px solid var(--tm26-line)!important;border-radius:20px!important;overflow:hidden!important;background:#fff!important}
      .tm26-order-product-row{display:grid!important;grid-template-columns:88px minmax(0,1fr) 88px 120px!important;gap:18px!important;align-items:center!important;padding:16px!important;border-bottom:1px solid var(--tm26-line)!important;min-width:0!important}
      .tm26-order-product-row:last-child{border-bottom:0!important}
      .tm26-order-product-image{width:88px!important;height:72px!important;display:flex!important;align-items:center!important;justify-content:center!important;overflow:hidden!important;border:1px solid var(--tm26-line)!important;border-radius:14px!important;background:#fff!important}
      .tm26-order-product-image img{display:block!important;width:auto!important;height:auto!important;max-width:80px!important;max-height:64px!important;object-fit:contain!important;margin:0!important;padding:0!important;transform:none!important}
      .tm26-order-product-info{min-width:0!important}
      .tm26-order-product-name{font-size:16px!important;line-height:1.25!important;font-weight:900!important;color:var(--tm26-navy)!important;overflow-wrap:anywhere!important}
      .tm26-order-product-meta{display:flex!important;flex-wrap:wrap!important;gap:7px!important;margin-top:8px!important}
      .tm26-order-product-meta span{display:inline-flex!important;padding:4px 8px!important;border:1px solid var(--tm26-line)!important;border-radius:999px!important;background:#f7faff!important;color:var(--tm26-muted)!important;font-size:12px!important;font-weight:800!important}
      .tm26-order-product-qty,.tm26-order-product-price{text-align:right!important;font-weight:900!important;white-space:nowrap!important;color:var(--tm26-navy)!important}
      .tm26-order-product-price{font-size:18px!important}
