        if(e.summary)e.summary.innerHTML=rows.join('');e.bankTotal.textContent=d.total?money(d.total):'—';
        const billing=normalizeAddress(pr?.billing||pr?.billingAddress||pr?.customer||pr?.customer_data,pr?.contact);
