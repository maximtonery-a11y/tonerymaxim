---
import "../styles/global.css";
import Header from "../components/Header.astro";
import "../styles/footer.css";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";

const title = "Ďakujeme za objednávku | ToneryMaxim.sk";
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <style>
      :root {
        --tm-navy: #071b3a;
        --tm-blue: #1d6cf2;
        --tm-green: #13a354;
        --tm-yellow: #f8bd00;
        --tm-muted: #64748b;
        --tm-line: #dbe7f4;
        --tm-soft: #f3f8fd;
        --tm-shadow: 0 22px 54px rgba(7, 27, 58, .08);
      }

      .thank-page {
        min-height: 70vh;
        padding: 56px 0 76px;
        background: linear-gradient(180deg, #ffffff 0%, #f4f9ff 48%, #ffffff 100%);
        color: var(--tm-navy);
      }

      .thank-wrap {
        max-width: 1160px;
        margin: 0 auto;
        padding: 0 24px;
      }

      .thank-hero,
      .thank-panel,
      .thank-reward,
      .thank-action-card,
      .thank-info {
        background: #fff;
        border: 1px solid var(--tm-line);
        border-radius: 28px;
        box-shadow: var(--tm-shadow);
      }

      .thank-hero {
        text-align: center;
        padding: 46px 38px 42px;
        margin-bottom: 22px;
      }

      .thank-check {
        width: 82px;
        height: 82px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #eaf8f0;
        color: var(--tm-green);
        display: grid;
        place-items: center;
        font-size: 42px;
        box-shadow: 0 0 0 12px rgba(19, 163, 84, .08);
      }

      .thank-kicker {
        color: var(--tm-blue);
        font-weight: 950;
        margin-bottom: 8px;
      }

      .thank-hero h1 {
        margin: 0;
        font-size: clamp(36px, 5vw, 64px);
        line-height: 1;
        letter-spacing: -.055em;
      }

      .thank-order-number {
        display: block;
        color: var(--tm-blue);
        margin-top: 8px;
      }

      .thank-hero p {
        max-width: 760px;
        margin: 18px auto 0;
        color: var(--tm-muted);
        line-height: 1.6;
        font-size: 17px;
      }

      .thank-success-line {
        margin-top: 16px;
        font-weight: 950;
        color: var(--tm-navy) !important;
      }

      .thank-success-line strong {
        color: var(--tm-green);
      }

      .thank-grid {
        display: grid;
        grid-template-columns: 1.08fr .92fr;
        gap: 22px;
        margin-bottom: 22px;
      }

      .thank-panel {
        padding: 28px;
      }

      .thank-panel h2,
      .thank-reward h2,
      .thank-info h2 {
        margin: 0 0 20px;
        font-size: 25px;
        letter-spacing: -.035em;
      }

      .thank-steps {
        display: grid;
        gap: 16px;
      }

      .thank-step {
        display: grid;
        grid-template-columns: 52px 1fr;
        gap: 16px;
        align-items: start;
      }

      .thank-step-icon {
        width: 52px;
        height: 52px;
        border-radius: 18px;
        background: var(--tm-soft);
        display: grid;
        place-items: center;
        font-size: 24px;
      }

      .thank-step strong {
        display: block;
        margin-bottom: 4px;
        font-size: 17px;
      }

      .thank-step p {
        margin: 0;
        color: var(--tm-muted);
        line-height: 1.48;
      }

      .thank-summary {
        display: grid;
        gap: 0;
        border: 1px solid var(--tm-line);
        border-radius: 20px;
        overflow: hidden;
      }

      .thank-summary-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 15px 17px;
        border-bottom: 1px solid var(--tm-line);
      }

      .thank-summary-row:last-child { border-bottom: 0; }
      .thank-summary-row span { color: var(--tm-muted); }
      .thank-summary-row strong { text-align: right; }

      .thank-order-detail {
        margin: 22px 0;
        padding: 24px;
      }

      .thank-order-detail h2 {
        margin: 0 0 16px;
        font-size: 22px;
      }



      .tm-final-summary-card {
        border: 1px solid var(--tm-line);
        border-radius: 22px;
        background: #ffffff;
        overflow: hidden;
      }
      .tm-final-summary-list { display: grid; }
      .tm-final-summary-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        padding: 14px 18px;
        border-bottom: 1px solid var(--tm-line);
        align-items: start;
      }
      .tm-final-summary-row:last-child { border-bottom: 0; }
      .tm-final-summary-title { min-width: 0; }
      .tm-final-summary-title strong { display: block; font-weight: 950; line-height: 1.35; color: var(--tm-navy); }
      .tm-final-summary-title small { display: block; margin-top: 4px; color: var(--tm-muted); line-height: 1.35; }
      .tm-final-summary-price { text-align: right; white-space: nowrap; font-weight: 950; color: var(--tm-navy); }
      .tm-final-summary-row.is-discount .tm-final-summary-title strong,
      .tm-final-summary-row.is-discount .tm-final-summary-price { color: var(--tm-green); }
      .tm-final-summary-totals { background: #f8fbff; padding: 8px 0; border-top: 1px solid var(--tm-line); }
      .tm-final-summary-total {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        padding: 9px 18px;
        color: var(--tm-muted);
      }
      .tm-final-summary-total strong { color: var(--tm-navy); text-align: right; white-space: nowrap; }
      .tm-final-summary-total.is-grand {
        margin-top: 6px;
        padding-top: 16px;
        border-top: 1px solid var(--tm-line);
        color: var(--tm-navy);
        font-size: 21px;
        font-weight: 950;
      }
      .tm-final-summary-total.is-grand strong { font-size: 24px; }

      .thank-order-card {
        border: 1px solid var(--tm-line);
        border-radius: 22px;
        background: #fff;
        overflow: hidden;
      }

      .thank-order-items,
      .thank-order-totals {
        display: grid;
      }

      .thank-order-line {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        align-items: start;
        padding: 15px 18px;
        border-bottom: 1px solid var(--tm-line);
      }

      .thank-order-line-title {
        min-width: 0;
      }

      .thank-order-line-title strong {
        display: block;
        font-size: 15px;
        line-height: 1.35;
        color: var(--tm-navy);
      }

      .thank-order-line-title small {
        display: block;
        margin-top: 4px;
        color: var(--tm-muted);
        line-height: 1.35;
      }

      .thank-order-line-price {
        white-space: nowrap;
        text-align: right;
        font-weight: 950;
        color: var(--tm-navy);
      }

      .thank-order-line.is-discount .thank-order-line-price,
      .thank-order-line.is-discount .thank-order-line-title strong {
        color: var(--tm-green);
      }

      .thank-order-totals {
        padding: 8px 0;
        background: #fbfdff;
      }

      .thank-order-total-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        padding: 10px 18px;
        color: var(--tm-muted);
      }

      .thank-order-total-row strong {
        color: var(--tm-navy);
        white-space: nowrap;
        text-align: right;
      }

      .thank-order-total-row.is-grand {
        margin-top: 6px;
        padding-top: 16px;
        border-top: 1px solid var(--tm-line);
        font-size: 22px;
        font-weight: 950;
        color: var(--tm-navy);
      }

      .thank-order-total-row.is-grand strong {
        font-size: 24px;
      }

      @media (max-width: 620px) {
        .thank-order-line,
        .thank-order-total-row {
          grid-template-columns: 1fr;
          gap: 7px;
        }
        .thank-order-line-price,
        .thank-order-total-row strong {
          text-align: left;
        }
      }

      .thank-paid-pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 5px 10px;
        background: #eaf8f0;
        color: var(--tm-green);
        font-weight: 950;
        font-size: 13px;
      }

      .thank-reward {
        margin-bottom: 24px;
        padding: 26px;
        display: grid;
        grid-template-columns: .9fr 1.1fr;
        gap: 24px;
        align-items: center;
        border-color: rgba(248, 189, 0, .55);
        background: linear-gradient(135deg, #fffaf0 0%, #ffffff 70%);
      }

      .thank-reward p {
        margin: 0;
        color: var(--tm-muted);
        line-height: 1.55;
      }

      .scratch-card {
        border: 1px solid rgba(248, 189, 0, .75);
        border-radius: 22px;
        background: #fff;
        padding: 18px;
      }

      .scratch-surface {
        min-height: 108px;
        border-radius: 18px;
        background: repeating-linear-gradient(135deg, #dfe4ec 0 10px, #f4f7fb 10px 20px);
        display: grid;
        place-items: center;
        text-align: center;
        font-weight: 950;
        color: var(--tm-navy);
        cursor: pointer;
        user-select: none;
      }

      .scratch-card.is-revealed .scratch-surface {
        background: #eaf8f0;
        color: var(--tm-green);
      }

      .scratch-result {
        margin-top: 12px;
        padding: 13px 14px;
        border-radius: 16px;
        background: #eaf8f0;
        color: #0b7d3a;
        font-weight: 950;
        display: none;
      }

      .scratch-card.is-revealed .scratch-result { display: block; }

      .thank-actions-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 24px;
      }

      .thank-action-card {
        padding: 24px;
        text-decoration: none;
        color: var(--tm-navy);
        display: grid;
        gap: 13px;
        min-height: 210px;
      }

      .thank-action-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 28px 65px rgba(7, 27, 58, .11);
      }

      .thank-action-icon {
        width: 58px;
        height: 58px;
        border-radius: 20px;
        background: var(--tm-soft);
        display: grid;
        place-items: center;
        font-size: 28px;
      }

      .thank-action-card strong {
        font-size: 21px;
        letter-spacing: -.025em;
      }

      .thank-action-card p {
        margin: 0;
        color: var(--tm-muted);
        line-height: 1.45;
      }

      .thank-action-button {
        margin-top: auto;
        min-height: 46px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 16px;
        font-weight: 950;
        background: var(--tm-blue);
        color: #fff;
      }

      .thank-action-card.is-orders .thank-action-button { background: #7c3aed; }
      .thank-action-card.is-printer .thank-action-button { background: var(--tm-green); }

      .thank-info {
        padding: 26px;
        display: grid;
        grid-template-columns: 64px 1fr auto;
        gap: 18px;
        align-items: center;
      }

      .thank-info-icon {
        width: 58px;
        height: 58px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        background: var(--tm-soft);
        font-size: 26px;
      }

      .thank-info ul {
        margin: 0;
        padding-left: 20px;
        color: var(--tm-muted);
        line-height: 1.7;
      }

      .thank-contact {
        min-height: 48px;
        border: 1px solid var(--tm-line);
        background: #fff;
        color: var(--tm-navy);
        border-radius: 14px;
        padding: 0 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-weight: 950;
        white-space: nowrap;
      }

      .thank-hidden { display: none !important; }

      .thank-debug {
        margin-top: 12px;
        color: var(--tm-muted);
        font-size: 13px;
      }

      @media (max-width: 980px) {
        .thank-grid,
        .thank-reward,
        .thank-actions-grid,
        .thank-info {
          grid-template-columns: 1fr;
        }

        .thank-info { align-items: start; }
      }

      @media (max-width: 640px) {
        .thank-page { padding: 34px 0 56px; }
        .thank-wrap { padding: 0 16px; }
        .thank-hero,
        .thank-panel,
        .thank-reward,
        .thank-action-card,
        .thank-info { border-radius: 22px; }
        .thank-hero { padding: 32px 22px; }
        .thank-summary-row { flex-direction: column; gap: 4px; }
        .thank-summary-row strong { text-align: left; }
      }
    </style>
  </head>

  <body>
    <div class="page">
      <Header />

      <main class="thank-page">
        <section class="thank-wrap">
          <div class="thank-hero" data-thank-hero>
            <div class="thank-check" data-thank-icon>✓</div>
            <div class="thank-kicker" data-payment-kicker>GoPay platba</div>
            <h1 data-payment-title>Overujeme objednávku</h1>
            <p class="thank-success-line" data-payment-subtitle>Načítavame stav online platby.</p>
            <p data-payment-text>
              O chvíľu zobrazíme potvrdenie objednávky a ďalší postup.
            </p>
          </div>

          <div class="thank-grid">
            <section class="thank-panel">
              <h2>Čo sa bude diať ďalej?</h2>
              <div class="thank-steps">
                <div class="thank-step">
                  <div class="thank-step-icon">✉️</div>
                  <div>
                    <strong>Potvrdenie objednávky</strong>
                    <p>Potvrdenie objednávky odošleme na e-mail uvedený v pokladni.</p>
                  </div>
                </div>
                <div class="thank-step">
                  <div class="thank-step-icon">📦</div>
                  <div>
                    <strong>Príprava a expedícia</strong>
                    <p>Skladové produkty pripravíme čo najskôr. Pri objednávke do 14:00 expedujeme spravidla ešte dnes.</p>
                  </div>
                </div>
                <div class="thank-step">
                  <div class="thank-step-icon">🚚</div>
                  <div>
                    <strong>Doručenie</strong>
                    <p>Po odoslaní zásielky dostanete e-mail s informáciami k doručeniu.</p>
                  </div>
                </div>
              </div>
            </section>

            <section class="thank-panel">
              <h2>Prehľad objednávky</h2>
              <div class="thank-summary">
                <div class="thank-summary-row">
                  <span>Stav platby</span>
                  <strong data-summary-state>Overujeme</strong>
                </div>
                <div class="thank-summary-row">
                  <span>ID platby GoPay</span>
                  <strong data-summary-payment-id>—</strong>
                </div>
                <div class="thank-summary-row">
                  <span>Objednávka</span>
                  <strong data-summary-order>—</strong>
                </div>
                <div class="thank-summary-row">
                  <span>Dátum</span>
                  <strong data-summary-date>—</strong>
                </div>
                <div class="thank-summary-row">
                  <span>Spôsob platby</span>
                  <strong data-summary-payment-method>Online platba GoPay</strong>
                </div>
              </div>
              <div class="thank-debug" data-payment-debug hidden></div>
            </section>
          </div>

          <section class="thank-panel thank-order-detail" data-order-detail hidden>
            <h2>Súhrn objednávky</h2>
            <div class="thank-order-lines" data-order-lines></div>
          </section>

          <section class="thank-reward" data-reward-section hidden>
            <div>
              <h2>🎁 Vaša odmena na ďalší nákup</h2>
              <p>Ako poďakovanie za objednávku sme vám pripravili 7 % zľavu na kompatibilné produkty. Automaticky ju použijeme pri vašej ďalšej objednávke.</p>
            </div>
            <div class="scratch-card" data-scratch-card>
              <div class="scratch-surface is-ready" data-scratch-button>
                Zľava pripravená
              </div>
              <div class="scratch-result" data-scratch-result>
                Zľava 7 % na kompatibilné produkty bude automaticky použitá pri ďalšej objednávke.
              </div>
            </div>
          </section>

          <section class="thank-actions-grid" data-success-actions hidden>
            <a class="thank-action-card" href="/">
              <div class="thank-action-icon">🛍️</div>
              <strong>Pokračovať v nákupe</strong>
              <p>Objavte ďalšie tonery, náplne a príslušenstvo za skvelé ceny.</p>
              <span class="thank-action-button">Do obchodu →</span>
            </a>

            <a class="thank-action-card is-orders" href="/ucet/objednavky">
              <div class="thank-action-icon">📋</div>
              <strong>Moje objednávky</strong>
              <p>Pozrite si históriu objednávok a ich aktuálny stav.</p>
              <span class="thank-action-button">Zobraziť objednávky →</span>
            </a>

            <a class="thank-action-card is-printer" href="/ucet/tlaciarne">
              <div class="thank-action-icon">🖨️</div>
              <strong>Uložiť tlačiareň</strong>
              <p>Uložte si tlačiareň a zjednodušte si ďalší nákup kompatibilných náplní.</p>
              <span class="thank-action-button">Uložiť tlačiareň →</span>
            </a>
          </section>

          <section class="thank-info">
            <div class="thank-info-icon">ℹ️</div>
            <div>
              <h2>Dôležité informácie</h2>
              <ul data-info-list>
                <li>Faktúru pošleme e-mailom spolu s potvrdením objednávky.</li>
                <li>Pri skladových produktoch objednávku pripravíme čo najskôr.</li>
                <li>V prípade otázok nás môžete kontaktovať.</li>
              </ul>
            </div>
            <a class="thank-contact" href="/kontakt">Kontaktovať nás</a>
          </section>
        </section>
      </main>

      <Footer />
      <FloatingAdvisor />
    </div>

    <script>
      const titleEl = document.querySelector("[data-payment-title]");
      const subtitleEl = document.querySelector("[data-payment-subtitle]");
      const textEl = document.querySelector("[data-payment-text]");
      const iconEl = document.querySelector("[data-thank-icon]");
      const kickerEl = document.querySelector("[data-payment-kicker]");
      const stateEl = document.querySelector("[data-summary-state]");
      const paymentMethodEl = document.querySelector("[data-summary-payment-method]");
      const paymentIdEl = document.querySelector("[data-summary-payment-id]");
      const orderEl = document.querySelector("[data-summary-order]");
      const dateEl = document.querySelector("[data-summary-date]");
      const debugBox = document.querySelector("[data-payment-debug]");
      const rewardSection = document.querySelector("[data-reward-section]");
      const successActions = document.querySelector("[data-success-actions]");
      const infoList = document.querySelector("[data-info-list]");
      const scratchCard = document.querySelector("[data-scratch-card]");
      const scratchButton = document.querySelector("[data-scratch-button]");
      const thankCouponCode = document.querySelector("[data-thank-coupon-code]");
      const orderDetail = document.querySelector("[data-order-detail]");
      const orderLines = document.querySelector("[data-order-lines]");

      const params = new URLSearchParams(window.location.search);
      const paymentId = params.get("id");
      const directOrder = params.get("order");
      const directMethod = params.get("method");

      const now = new Intl.DateTimeFormat("sk-SK", {
        day: "numeric",
        month: "numeric",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      }).format(new Date());

      dateEl.textContent = now;
      paymentIdEl.textContent = paymentId || "—";

      function getOrderNumber(data) {
        return data?.payment?.order_number || (paymentId ? `TM-${paymentId}` : "—");
      }

      function paymentLabel(method) {
        if (method === "cod") return "Objednávka na dobierku";
        if (method === "bank_prepaid") return "Objednávka s platbou prevodom vopred";
        if (method === "invoice_org") return "Objednávka s prevodným príkazom";
        return "Objednávka";
      }

      function paymentMethodText(method) {
        if (method === "cod") return "Dobierka";
        if (method === "bank_prepaid") return "Platba prevodom vopred";
        if (method === "invoice_org") return "Prevodný príkaz pre organizácie a firmy";
        if (method === "applepay") return "Apple Pay";
        if (method === "googlepay") return "Google Pay";
        return "Online platba GoPay";
      }


      function formatMoney(value) {
        const number = Number(value || 0);
        return new Intl.NumberFormat("sk-SK", { style: "currency", currency: "EUR" }).format(Number.isFinite(number) ? number : 0);
      }

      function setThankCoupon(orderNumber) {
        const clean = String(orderNumber || "").replace(/\D/g, "");
        if (thankCouponCode && clean) thankCouponCode.textContent = `NAKUP7-${clean}`;
      }

      function escapeHtml(value) {
        return String(value ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function orderLine(title, price, meta = "", className = "") {
        return `
          <div class="tm-final-summary-row ${className}">
            <div class="tm-final-summary-title">
              <strong>${escapeHtml(title)}</strong>
              ${meta ? `<small>${escapeHtml(meta)}</small>` : ""}
            </div>
            <div class="tm-final-summary-price">${price}</div>
          </div>
        `;
      }

      function totalRow(label, value, className = "") {
        return `
          <div class="tm-final-summary-total ${className}">
            <span>${escapeHtml(label)}</span>
            <strong>${value}</strong>
          </div>
        `;
      }

      function renderOrderDetail() {
        if (!orderDetail || !orderLines) return;
        let preview = null;
        try { preview = JSON.parse(localStorage.getItem("tm_last_order_preview") || "null"); } catch { preview = null; }
        const cart = Array.isArray(preview?.cart) ? preview.cart : [];
        if (!cart.length) return;

        const pricing = preview?.pricing || {};
        const shipping = preview?.shipping || {};
        const paymentCode = String(preview?.payment || "");
        const paymentMap = {
          cod: "Dobierka",
          bank_prepaid: "Platba prevodom vopred",
          invoice_org: "Prevodný príkaz pre organizácie a firmy",
          gopay: "Online platba GoPay",
          applepay: "Apple Pay",
          googlepay: "Google Pay"
        };

        const itemsTotal = cart.reduce((sum, item) => sum + Number(item.price || 0) * Number(item.qty || 1), 0);
        const quantityDiscount = Number(pricing.discount || 0);
        const couponDiscount = Number(preview?.coupon?.discount || 0);
        const loyaltyDiscount = Number(preview?.loyalty?.apply ? preview?.loyalty?.discount || 0 : 0);
        const shippingPrice = Number(shipping?.price || 0);
        const paymentPrice = paymentCode === "cod" ? 1.2 : 0;
        const total = Math.max(0, itemsTotal - quantityDiscount - couponDiscount - loyaltyDiscount + shippingPrice + paymentPrice);
        const net = total / 1.23;
        const vat = total - net;
        const paymentLabelText = paymentMap[paymentCode] || paymentCode || "—";
        const couponLabel = preview?.coupon?.label || "Kupónová zľava";
        const shippingLabel = shipping?.label || "Doprava";

        const itemRows = cart.map((item) => {
          const qty = Number(item.qty || 1);
          const lineTotal = Number(item.price || 0) * qty;
          const metaParts = [];
          if (item.sku) metaParts.push(`SKU: ${item.sku}`);
          if (qty > 1) metaParts.push(`${qty} ks × ${formatMoney(Number(item.price || 0))}`);
          return orderLine(`${item.name || "Produkt"} × ${qty}`, formatMoney(lineTotal), metaParts.join(" · "));
        }).join("");

        orderLines.innerHTML = `
          <div class="tm-final-summary-card">
            <div class="tm-final-summary-list">
              ${itemRows}
              ${quantityDiscount > 0 ? orderLine("Množstevná / sadová zľava", `-${formatMoney(quantityDiscount)}`, "", "is-discount") : ""}
              ${couponDiscount > 0 ? orderLine(couponLabel, `-${formatMoney(couponDiscount)}`, "", "is-discount") : ""}
              ${loyaltyDiscount > 0 ? orderLine("Vernostné body", `-${formatMoney(loyaltyDiscount)}`, "", "is-discount") : ""}
              ${orderLine(`Doprava (${shippingLabel})`, shippingPrice > 0 ? formatMoney(shippingPrice) : "Zdarma")}
              ${orderLine(`Platba (${paymentLabelText})`, paymentPrice > 0 ? formatMoney(paymentPrice) : "Bez poplatku")}
            </div>
            <div class="tm-final-summary-totals">
              ${totalRow("Základ bez DPH", formatMoney(net))}
              ${totalRow("DPH 23 %", formatMoney(vat))}
              ${totalRow("Spolu s DPH", formatMoney(total), "is-grand")}
            </div>
          </div>
        `;
        orderDetail.hidden = false;
      }

      function showDirectOrder() {
        const orderNumber = directOrder || "—";

        iconEl.textContent = "✓";
        kickerEl.textContent = paymentMethodText(directMethod);
        paymentMethodEl.textContent = paymentMethodText(directMethod);
        titleEl.innerHTML = `Ďakujeme za objednávku<br><span class="thank-order-number">č. ${orderNumber}</span>`;
        subtitleEl.innerHTML = `${paymentLabel(directMethod)} bola <strong>úspešne uložená</strong>.`;
        textEl.textContent = "Potvrdenie objednávky sme poslali na e-mail uvedený v pokladni.";

        stateEl.innerHTML = '<span class="thank-paid-pill">ULOŽENÉ</span>';
        paymentIdEl.textContent = "—";
        orderEl.textContent = orderNumber;
        setThankCoupon(orderNumber);
        renderOrderDetail();
        rewardSection.hidden = false;
        successActions.hidden = false;

        localStorage.removeItem("tm_cart_v1");
        localStorage.removeItem("tm_coupon_v1");
        localStorage.removeItem("tm_loyalty_apply");
      }

      function showPaid(data) {
        const orderNumber = getOrderNumber(data);

        iconEl.textContent = "✓";
        kickerEl.textContent = paymentMethodText(directMethod);
        paymentMethodEl.textContent = paymentMethodText(directMethod);
        titleEl.innerHTML = `Ďakujeme za objednávku<br><span class="thank-order-number">č. ${orderNumber}</span>`;
        subtitleEl.innerHTML = "Vaša platba online prebehla <strong>úspešne</strong>.";
        textEl.textContent = "Potvrdenie objednávky sme poslali na e-mail uvedený v pokladni.";

        stateEl.innerHTML = '<span class="thank-paid-pill">PAID</span>';
        orderEl.textContent = orderNumber;
        setThankCoupon(orderNumber);
        renderOrderDetail();
        rewardSection.hidden = false;
        successActions.hidden = false;

        localStorage.removeItem("tm_cart_v1");
        localStorage.removeItem("tm_coupon_v1");
        localStorage.removeItem("tm_loyalty_apply");
      }

      function showCanceled(data) {
        const orderNumber = getOrderNumber(data);

        iconEl.textContent = "×";
        titleEl.innerHTML = `Platba nebola dokončená<br><span class="thank-order-number">${orderNumber}</span>`;
        subtitleEl.textContent = "Platbu sa nepodarilo dokončiť.";
        textEl.textContent = "Objednávka zatiaľ nie je zaplatená. Môžete sa vrátiť do košíka alebo skúsiť platbu znova.";

        stateEl.innerHTML = '<span class="thank-paid-pill" style="background:#fff1f0;color:#d92d20;">CANCELED</span>';
        orderEl.textContent = orderNumber;
        rewardSection.hidden = true;
        successActions.hidden = false;
        successActions.innerHTML = `
          <a class="thank-action-card" href="/kosik">
            <div class="thank-action-icon">🛒</div>
            <strong>Otvoriť košík</strong>
            <p>Skontrolujte produkty v košíku a pokračujte v objednávke.</p>
            <span class="thank-action-button">Do košíka →</span>
          </a>
          <a class="thank-action-card is-orders" href="/pokladna">
            <div class="thank-action-icon">💳</div>
            <strong>Skúsiť platbu znova</strong>
            <p>Vráťte sa do pokladne a zvoľte platobnú metódu.</p>
            <span class="thank-action-button">Do pokladne →</span>
          </a>
          <a class="thank-action-card is-printer" href="/">
            <div class="thank-action-icon">🏠</div>
            <strong>Pokračovať v nákupe</strong>
            <p>Vráťte sa do obchodu a pokračujte vo výbere.</p>
            <span class="thank-action-button">Do obchodu →</span>
          </a>
        `;
      }

      function showPending(data, state) {
        const orderNumber = getOrderNumber(data);

        iconEl.textContent = "…";
        titleEl.innerHTML = `Platbu ešte overujeme<br><span class="thank-order-number">${orderNumber}</span>`;
        subtitleEl.textContent = "GoPay zatiaľ nevrátil finálny stav platby.";
        textEl.textContent = "Skúste stránku o chvíľu obnoviť. Ak sa stav nezmení, kontaktujte nás.";

        stateEl.textContent = state || "PENDING";
        orderEl.textContent = orderNumber;
        rewardSection.hidden = true;
        successActions.hidden = false;
      }

      async function loadStatus() {
        if (directOrder) {
          showDirectOrder();
          return;
        }

        if (!paymentId) {
          titleEl.textContent = "Chýba ID platby";
          subtitleEl.textContent = "GoPay nevrátilo ID platby.";
          textEl.textContent = "Skontrolujte nastavenie GOPAY_RETURN_URL v .env.";
          stateEl.textContent = "Neoverené";
          return;
        }

        try {
          const response = await fetch(`/api/gopay-status?id=${encodeURIComponent(paymentId)}`);
          const data = await response.json();

          if (!response.ok || !data.ok) {
            throw new Error(data.error || "Nepodarilo sa overiť stav platby.");
          }

          const state = data.state || "UNKNOWN";
          paymentIdEl.textContent = paymentId;

          if (state === "PAID") {
            showPaid(data);
          } else if (state === "CANCELED") {
            showCanceled(data);
          } else {
            showPending(data, state);
          }

          debugBox.hidden = false;
          debugBox.textContent = `Technický stav GoPay: ${state}`;
        } catch (error) {
          iconEl.textContent = "!";
          titleEl.textContent = "Platbu sa nepodarilo overiť";
          subtitleEl.textContent = "E-shop nevedel načítať finálny stav platby.";
          textEl.textContent = "GoPay platba bola vytvorená, ale stav sa nepodarilo načítať. Skúste to o chvíľu alebo nás kontaktujte.";
          stateEl.textContent = "Chyba overenia";
          debugBox.hidden = false;
          debugBox.textContent = error.message || "Nepodarilo sa overiť stav platby.";
        }
      }

      scratchButton?.addEventListener("click", () => {
        scratchCard?.classList.add("is-revealed");
        scratchButton.textContent = "Odmena odhalená";
      });

      loadStatus();
    </script>
  </body>
</html>
