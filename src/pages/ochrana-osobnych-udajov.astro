---
import "../styles/global.css";
import "../styles/footer.css";
import "../styles/legal.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import InfoPageShell from "../components/InfoPageShell.astro";
const cards = [
  ["▤", "Kto sme", "Správcom osobných údajov je Roman Babčan INkarus."],
  ["☰", "Aké údaje spracúvame", "Údaje potrebné pri nákupe, registrácii alebo kontakte."],
  ["△", "Na aké účely", "Vybavenie objednávok, komunikácia a zákonné povinnosti."],
  ["◌", "Ako dlho", "Údaje uchovávame len po nevyhnutnú alebo zákonom stanovenú dobu."],
  ["◎", "Komu údaje poskytujeme", "Dopravcom, platobným a technickým poskytovateľom."],
  ["♙", "Vaše práva", "Prístup, oprava, výmaz, obmedzenie, námietka a sťažnosť."],
];
---
<!doctype html><html lang="sk"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Ochrana osobných údajov | ToneryMaxim.sk</title></head><body><div class="page"><Header /><main>
<InfoPageShell active="/ochrana-osobnych-udajov" eyebrow="GDPR" title="Ochrana osobných údajov" intro="Zásady ochrany osobných údajov e-shopu ToneryMaxim.sk.">
  <section class="gdpr-grid">{cards.map(([icon,title,text]) => <article class="gdpr-card"><span class="info-icon">{icon}</span><h2>{title}</h2><p>{text}</p></article>)}</section>
  <article class="legal-panel">
    <header class="legal-panel-head"><h2>Podrobné informácie o spracúvaní údajov</h2><p>Osobné údaje spracúvame len v rozsahu potrebnom na prevádzku e-shopu, vybavenie objednávok a plnenie zákonných povinností.</p></header>
    <div class="legal-content">
      <section><h2>1. Prevádzkovateľ</h2><p>Prevádzkovateľom osobných údajov je Roman Babčan INkarus, Tajov 265, 976 34 Tajov, IČO: 37 328 344, e-mail: <a href="mailto:info@tonerymaxim.sk">info@tonerymaxim.sk</a>.</p></section>
      <section><h2>2. Aké osobné údaje spracúvame</h2><p>Spracúvame najmä údaje, ktoré nám zákazník poskytne pri objednávke, registrácii alebo kontakte: meno, priezvisko, fakturačné a dodacie údaje, e-mail, telefón, údaje o objednávke, platbe a komunikácii.</p><p>Pri používaní webu môžeme spracúvať aj technické údaje, napríklad IP adresu, informácie o zariadení, prehliadači a cookies podľa nastavení používateľa.</p></section>
      <section><h2>3. Účely spracúvania</h2><ul><li>vytvorenie a vybavenie objednávky,</li><li>doručenie tovaru a komunikácia so zákazníkom,</li><li>vystavenie faktúry a plnenie účtovných povinností,</li><li>vybavenie reklamácie alebo odstúpenia od zmluvy,</li><li>správa zákazníckeho účtu,</li><li>odpoveď na otázky odoslané cez kontaktný formulár,</li><li>ochrana právnych nárokov a bezpečnosť webu.</li></ul></section>
      <section><h2>4. Právny základ</h2><p>Osobné údaje spracúvame najmä na základe plnenia zmluvy, plnenia zákonných povinností, oprávneného záujmu alebo súhlasu tam, kde je potrebný.</p></section>
      <section><h2>5. Doba uchovávania</h2><p>Údaje uchovávame len po dobu nevyhnutnú na splnenie účelu spracúvania. Účtovné a daňové doklady uchovávame po dobu stanovenú príslušnými právnymi predpismi.</p><p>Údaje z kontaktných formulárov uchovávame po dobu potrebnú na vybavenie požiadavky a následnú ochranu oprávnených nárokov.</p></section>
      <section><h2>6. Komu údaje poskytujeme</h2><p>Osobné údaje môžu byť sprístupnené len nevyhnutným príjemcom, najmä dopravcom, poskytovateľom platobných služieb, účtovným a technickým poskytovateľom, prípadne orgánom verejnej moci, ak to vyžaduje zákon.</p><p>Medzi dopravcov môžu patriť napríklad GLS, DPD alebo Packeta podľa zvoleného spôsobu doručenia.</p></section>
      <section><h2>7. Vaše práva</h2><p>Máte právo požiadať o prístup k osobným údajom, opravu nesprávnych údajov, vymazanie, obmedzenie spracúvania, prenosnosť údajov a právo namietať proti spracúvaniu.</p><p>Ak sa domnievate, že vaše údaje spracúvame v rozpore s právnymi predpismi, môžete podať sťažnosť na Úrad na ochranu osobných údajov SR.</p></section>
      <section><h2>8. Kontakt</h2><div class="legal-contact-box"><strong>Kontakt pre otázky k osobným údajom</strong><a href="mailto:info@tonerymaxim.sk">info@tonerymaxim.sk</a><span>+421 917 859 206, Po–Pi 9:00–15:00</span></div></section>
    </div>
  </article>
</InfoPageShell>
</main><Footer showTrust={false} /><FloatingAdvisor /></div></body></html>
