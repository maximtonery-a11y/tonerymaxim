---
export const prerender = false;

import SeoCatalogPage from "../../../components/SeoCatalogPage.astro";
import { getProductsCache } from "../../../lib/tm-products-cache";
import {
  brandProducts,
  catalogStats,
  findPrinterEntity,
  topPrinterLinks,
  productOemCodes,
  productSearchText,
} from "../../../lib/seo-catalog";
import { findPrinterGeoPilot } from "../../../data/geo-pilot";
import { geoPrinterPriority } from "../../../data/geo-priorities";
import { benchmarkForPath, DEFAULT_GEO_GUIDES } from "../../../data/geo-benchmark-content";
import { printerGeoAnswer } from "../../../lib/geo-entity-answer";


const KNOWN_PRODUCT_BRANDS = ["HP", "Canon", "Brother", "Epson", "Samsung", "Xerox", "Kyocera", "Lexmark", "OKI", "Ricoh", "Konica Minolta", "Develop", "Sharp", "Panasonic"];
const normText = (value: unknown) => String(value || "").replace(/\s+/g, " ").trim();
const uniqueText = (values: string[], limit = 8) => [...new Set(values.map(normText).filter(Boolean))].slice(0, limit);
const naturalList = (values: string[]) => values.length < 2 ? (values[0] || "") : values.length === 2 ? `${values[0]} a ${values[1]}` : `${values.slice(0, -1).join(", ")} a ${values.at(-1)}`;
function brandSegment(product: any, targetBrand: string): string {
  const source = normText(`${product?.name || ""} ${product?.mpn || ""}`);
  if (!source) return "";
  const escaped = KNOWN_PRODUCT_BRANDS.map((brand) => brand.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|");
  const markers = [...source.matchAll(new RegExp(`\\b(${escaped})\\b`, "gi"))];
  const wanted = markers.findIndex((match) => normText(match[1]).toLowerCase() === targetBrand.toLowerCase());
  if (wanted < 0) return "";
  const start = markers[wanted].index || 0;
  const end = markers[wanted + 1]?.index ?? source.length;
  return source.slice(start, end);
}
function brandOemCodes(product: any, targetBrand: string): string[] {
  const segment = brandSegment(product, targetBrand);
  if (!segment) return [];
  return productOemCodes({ ...product, name: segment, sku: "" } as any);
}
function isDrum(product: any): boolean {
  return /\b(valec|drum|image drum|imaging unit|optick|zobrazovac)/i.test(productSearchText(product));
}
function productYields(products: any[]): string[] {
  return uniqueText(products.flatMap((product) => [product.page_yield, product.capacity]).filter((value) => /\d/.test(String(value || ""))), 4);
}

const cache = await getProductsCache().catch(() => ({ products: [] as any[], generated_at: "" }));
const printer = findPrinterEntity(cache.products, Astro.params.brand, Astro.params.model);
const notFound = !printer;
const allProducts = printer?.products || [];
const requestedType = String(Astro.url.searchParams.get("typ") || "").toLowerCase();
const selectedType = ["compatible", "original", "renovated"].includes(requestedType) ? requestedType : "";
const products = selectedType
  ? allProducts.filter((product) => product.product_type_key === selectedType)
  : allProducts;
const stats = catalogStats(allProducts);

if (notFound) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
  Astro.response.headers.set("X-Robots-Tag", "noindex, follow");
}

const printerName = printer?.name || "Neznámy model tlačiarne";
const geoPilot = printer ? findPrinterGeoPilot(printer.name) : undefined;
const geoPriority = printer ? geoPrinterPriority(printer.slug) : undefined;
const brandName = printer?.brand.name || "Tlačiareň";
const canonicalPath = printer
  ? `/tlaciarne/${printer.brand.slug}/${printer.slug}`
  : Astro.url.pathname;
const benchmark = printer ? benchmarkForPath(canonicalPath) : undefined;
const integratedDrum = Boolean(geoPilot && /(?:obsahuje|súčasťou|spojen[ée]|jednej zostave|v jednej kazete).{0,80}(?:valec|drum)|(?:valec|drum).{0,80}(?:obsahuje|súčasťou|spojen[ée]|jednej zostave|v jednej kazete)/i.test(`${geoPilot.productKind} ${geoPilot.selection} ${geoPilot.caution}`));
const rawGuideLinks = geoPilot?.adviceLinks?.length ? geoPilot.adviceLinks : DEFAULT_GEO_GUIDES;
const guideLinks = integratedDrum
  ? rawGuideLinks.filter((link) => !/valec|drum/i.test(`${link.href} ${link.label}`))
  : rawGuideLinks;
const relatedPrinterLinks = printer
  ? topPrinterLinks(brandProducts(cache.products, printer.brand), 24)
      .filter((link) => link.href !== canonicalPath)
      .slice(0, 12)
  : [];

const typeNames = [
  ...(stats.compatible ? ["kompatibilné"] : []),
  ...(stats.original ? ["originálne"] : []),
  ...(stats.renovated ? ["renovované"] : []),
  ...(stats.other ? ["ďalšie"] : []),
];
const typeSummary = typeNames.length > 1
  ? `${typeNames.slice(0, -1).join(", ")} a ${typeNames.at(-1)}`
  : typeNames[0] || "dostupné";
const modelDescription = `Tonery a náplne pre ${printerName}: ${typeSummary}. Aktuálne ceny, dostupnosť, farby a výťažnosť.`;
const blockedImageTokens = ["no-image", "image-coming-soon", `tm-product-${"place"}holder`, `tm-ink-${"place"}holder`];
const imageCandidate = products
  .flatMap((product) => [product.image, ...(Array.isArray(product.images) ? product.images : [])])
  .map((value) => String(value || "").trim())
  .find((value) => value && !blockedImageTokens.some((token) => value.toLowerCase().includes(token)));
let modelImage: string | undefined;
if (imageCandidate) {
  try {
    const url = new URL(imageCandidate, "https://www.tonerymaxim.sk");
    if (url.protocol === "https:") modelImage = url.toString();
  } catch {
    modelImage = undefined;
  }
}
const geoAnswer = !notFound ? printerGeoAnswer(printerName, allProducts, geoPilot) : undefined;
const tonerProducts = allProducts.filter((product) => !isDrum(product));
const drumProducts = allProducts.filter(isDrum);
// Originálne kazety danej značky sú najsilnejší zdroj pre názvy OEM na stránke tlačiarne.
// Tým sa zabráni miešaniu ekvivalentov (napr. HP W1490A/X vs. Canon CRG-070/070H)
// aj preneseniu omylom priradených rodín z kompatibilných/renovovaných produktov.
const originalTonerProducts = tonerProducts.filter((product) => product.product_type_key === "original");
const originalDrumProducts = drumProducts.filter((product) => product.product_type_key === "original");
const originalTonerOems = printer ? uniqueText(originalTonerProducts.flatMap((product) => brandOemCodes(product, brandName)), 8) : [];
const originalDrumOems = printer ? uniqueText(originalDrumProducts.flatMap((product) => brandOemCodes(product, brandName)), 5) : [];
const tonerOems = originalTonerOems.length ? originalTonerOems : (printer ? uniqueText(tonerProducts.flatMap((product) => brandOemCodes(product, brandName)), 8) : []);
const drumOems = originalDrumOems.length ? originalDrumOems : (printer ? uniqueText(drumProducts.flatMap((product) => brandOemCodes(product, brandName)), 5) : []);
const relevantTonerProducts = tonerOems.length
  ? tonerProducts.filter((product) => brandOemCodes(product, brandName).some((code) => tonerOems.includes(code)))
  : tonerProducts;
const relevantDrumProducts = drumOems.length
  ? drumProducts.filter((product) => brandOemCodes(product, brandName).some((code) => drumOems.includes(code)))
  : drumProducts;
const colors = uniqueText(relevantTonerProducts.map((product) => product.color).filter(Boolean), 5);
const yields = productYields(relevantTonerProducts);
const drumYields = productYields(relevantDrumProducts);
const colorText = colors.length === 1 ? `${colors[0].toLowerCase()} toner` : colors.length > 1 ? `tonery vo farbách ${naturalList(colors.map((x) => x.toLowerCase()))}` : "toner alebo náplň";
const oemText = naturalList(tonerOems);
const yieldText = yields.length === 1 ? ` s výťažnosťou ${yields[0]}` : yields.length > 1 ? ` vo variantoch ${naturalList(yields)}` : "";
const drumText = drumOems.length ? ` Samostatný zobrazovací valec ${brandName} ${naturalList(drumOems)}${drumYields.length === 1 ? ` má výťažnosť ${drumYields[0]}` : ""}.` : "";
const quickAnswer = !notFound
  ? tonerOems.length
    ? `${printerName} používa ${colorText} ${brandName} ${oemText}${yieldText}.${drumText}`
    : `${printerName}: vyberte náplň iba z produktov priradených k tomuto presnému modelu. OEM označenie overte v detaile produktu.`
  : "";

const brandOemLinks = [...tonerOems, ...drumOems].map((code) => ({ href: `/oem/${code.toLowerCase()}`, label: `${brandName} ${code}` }));

const typeFacts = [
  `Všetky: ${stats.total}`,
  ...(stats.compatible ? [`Kompatibilné: ${stats.compatible}`] : []),
  ...(stats.original ? [`Originálne: ${stats.original}`] : []),
  ...(stats.renovated ? [`Renovované: ${stats.renovated}`] : []),
];
---

<SeoCatalogPage
  title={notFound ? "Model tlačiarne sa nenašiel | ToneryMaxim.sk" : `Tonery pre ${printerName} | ToneryMaxim.sk`}
  description={notFound
    ? "Požadovaný model tlačiarne sa v katalógu nenašiel."
    : modelDescription}
  image={modelImage}
  canonicalPath={canonicalPath}
  eyebrow={notFound ? "Neznámy model" : "Náplne podľa modelu tlačiarne"}
  heading={notFound ? "Model tlačiarne sa nenašiel" : `Tonery pre ${printerName}`}
  intro={notFound
    ? "Skontrolujte označenie modelu alebo sa vráťte na výber tlačiarne."
    : quickAnswer}
  products={products}
  answer={quickAnswer}
  generatedAt={cache.generated_at}
  breadcrumbs={[
    { name: "Tlačiarne", path: "/tlaciarne" },
    { name: brandName, path: printer ? `/tlaciarne/${printer.brand.slug}` : "/tlaciarne" },
    { name: printerName, path: canonicalPath },
  ]}
  entityFacts={notFound ? [] : typeFacts}
  relatedLinks={[]}
  faq={notFound ? [] : [
    { question: `Aký toner alebo náplň používa ${printerName}?`, answer: quickAnswer },
    ...(stats.compatible > 0 ? [{ question: "Môžem použiť kompatibilný toner namiesto originálneho?", answer: "Áno, ak je konkrétny kompatibilný produkt určený pre tento model tlačiarne. Typ produktu je viditeľne označený pri každej položke." }] : []),
    
  ]}
  contentSections={notFound ? [] : [
    {
      heading: `Výber tonera alebo náplne pre ${printerName}`,
      paragraphs: [quickAnswer, `Produkty na tejto stránke majú model ${printerName} uvedený v zozname kompatibilných tlačiarní. Pri ${brandName} uvádzame v texte iba označenia náplní patriace značke ${brandName}; ekvivalentné kódy iných výrobcov do popisu tejto tlačiarne nemiešame.`],
      bullets: ["Porovnajte presný model zo štítku zariadenia.", "Skontrolujte OEM kód pôvodnej kazety.", "Vyberte správnu farbu a požadovanú kapacitu."],
    },
    {
      heading: "Ako čítať aktuálnu ponuku",
      paragraphs: ["Každá produktová karta uvádza typ produktu, cenu s DPH a dostupnosť. Detail produktu dopĺňa výťažnosť, farbu a ďalšie kompatibilné tlačiarne, ak sú tieto údaje v katalógu dostupné."],
    },
  ]}
  linkGroups={notFound ? [] : [
    { heading: `OEM označenia pre ${printerName}`, intro: `Pre túto ${brandName} tlačiareň zobrazujeme iba OEM označenia značky ${brandName}.`, links: brandOemLinks },
    { heading: `Produkty pre ${printerName}`, intro: "Konkrétne produkty s cenou, dostupnosťou a detailom kompatibility sú uvedené v aktuálnej ponuke.", links: [{ href: "#produkty", label: `Zobraziť ${stats.total} priradených produktov`, count: stats.total }] },
    { heading: "Relevantné návody", intro: "Postup kontroly modelu, OEM kódu a rozdielov medzi typmi náplní.", links: guideLinks },
    { heading: `Ďalšie modely ${brandName}`, intro: "Súvisiace modely značky s reálnymi produktmi v katalógu.", links: relatedPrinterLinks },
  ]}
  schemaEntities={notFound ? [] : [
    { name: printerName, url: canonicalPath },
    { name: brandName, url: printer ? `/znacky/${printer.brand.slug}` : undefined },
    { name: `Tonery pre ${printerName}` },
  ]}
  expertGuide={geoPriority || geoPilot ? {
    title: geoAnswer?.question || benchmark?.prompt || `Aké náplne používa ${printerName}?`,
    summary: quickAnswer,
    updated: "2026-08-09",
    author: "Roman Babčan",
    experience: "17+ rokov skúseností",
    links: guideLinks,
  } : undefined}
  notFound={notFound}
  productFirst={!notFound}
  productTypeFilters={!notFound}
/>
