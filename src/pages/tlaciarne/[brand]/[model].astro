---
export const prerender = false;

import SeoCatalogPage from "../../../components/SeoCatalogPage.astro";
import { getProductsCache } from "../../../lib/tm-products-cache";
import {
  brandProducts,
  catalogStats,
  findPrinterEntity,
  topOemLinks,
  topPrinterLinks,
} from "../../../lib/seo-catalog";
import { findPrinterGeoPilot, pilotFaq } from "../../../data/geo-pilot";

const cache = await getProductsCache().catch(() => ({ products: [] as any[], generated_at: "" }));
const printer = findPrinterEntity(cache.products, Astro.params.brand, Astro.params.model);
const notFound = !printer;
const products = printer?.products || [];
const stats = catalogStats(products);

if (notFound) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
  Astro.response.headers.set("X-Robots-Tag", "noindex, follow");
}

const printerName = printer?.name || "Neznámy model tlačiarne";
const geoPilot = printer ? findPrinterGeoPilot(printer.name) : undefined;
const brandName = printer?.brand.name || "Tlačiareň";
const canonicalPath = printer
  ? `/tlaciarne/${printer.brand.slug}/${printer.slug}`
  : Astro.url.pathname;
const relatedPrinterLinks = printer
  ? topPrinterLinks(brandProducts(cache.products, printer.brand), 24)
      .filter((link) => link.href !== canonicalPath)
      .slice(0, 12)
  : [];

const typeNames = [
  ...(stats.compatible ? ["kompatibilné"] : []),
  ...(stats.original ? ["originálne"] : []),
  ...(stats.renovated ? ["renovované"] : []),
  ...(stats.other ? ["ďalšie"] : []),
];
const typeSummary = typeNames.length > 1
  ? `${typeNames.slice(0, -1).join(", ")} a ${typeNames.at(-1)}`
  : typeNames[0] || "dostupné";
const modelDescription = `Tonery a náplne pre ${printerName}: ${typeSummary}. Aktuálne ceny, dostupnosť, farby a výťažnosť.`;
const blockedImageTokens = ["no-image", "image-coming-soon", `tm-product-${"place"}holder`, `tm-ink-${"place"}holder`];
const imageCandidate = products
  .flatMap((product) => [product.image, ...(Array.isArray(product.images) ? product.images : [])])
  .map((value) => String(value || "").trim())
  .find((value) => value && !blockedImageTokens.some((token) => value.toLowerCase().includes(token)));
let modelImage: string | undefined;
if (imageCandidate) {
  try {
    const url = new URL(imageCandidate, "https://www.tonerymaxim.sk");
    if (url.protocol === "https:") modelImage = url.toString();
  } catch {
    modelImage = undefined;
  }
}
const typeFacts = [
  ...(stats.compatible ? [`Kompatibilné: ${stats.compatible}`] : []),
  ...(stats.original ? [`Originálne: ${stats.original}`] : []),
  ...(stats.renovated ? [`Renovované: ${stats.renovated}`] : []),
  ...(stats.other ? [`Ostatné: ${stats.other}`] : []),
];
---

<SeoCatalogPage
  title={notFound ? "Model tlačiarne sa nenašiel | ToneryMaxim.sk" : `Tonery pre ${printerName} | ToneryMaxim.sk`}
  description={notFound
    ? "Požadovaný model tlačiarne sa v katalógu nenašiel."
    : modelDescription}
  image={modelImage}
  canonicalPath={canonicalPath}
  eyebrow={notFound ? "Neznámy model" : "Náplne podľa modelu tlačiarne"}
  heading={notFound ? "Model tlačiarne sa nenašiel" : `Tonery a náplne pre ${printerName}`}
  intro={notFound
    ? "Skontrolujte označenie modelu alebo sa vráťte na výber tlačiarne."
    : `Zobrazené produkty majú model ${printerName} uvedený medzi kompatibilnými tlačiarňami. Pred objednaním odporúčame porovnať aj OEM označenie kazety.`}
  products={products}
  answer={notFound
    ? ""
    : `Pre tlačiareň ${printerName} evidujeme ${stats.total} vhodných produktov s platnou cenou, z ktorých je ${stats.inStock} skladom. Ponuka obsahuje ${stats.compatible} kompatibilných, ${stats.original} originálnych a ${stats.renovated} renovovaných možností. Pred nákupom porovnajte OEM kód a farbu kazety.`}
  generatedAt={cache.generated_at}
  breadcrumbs={[
    { name: "Tlačiarne", path: "/tlaciarne" },
    { name: brandName, path: printer ? `/tlaciarne/${printer.brand.slug}` : "/tlaciarne" },
    { name: printerName, path: canonicalPath },
  ]}
  entityFacts={notFound ? [] : [
    `Značka ${brandName}`,
    ...typeFacts,
    "Cena s DPH a aktuálny sklad",
  ]}
  relatedLinks={[
    { href: printer ? `/znacky/${printer.brand.slug}` : "/tlaciarne", label: `Všetky produkty ${brandName}` },
    { href: "/kompatibilne-tonery", label: "Kompatibilné tonery" },
    { href: "/originalne-tonery", label: "Originálne tonery" },
    { href: "/tlaciarne", label: "Zmeniť tlačiareň" },
  ]}
  faq={notFound ? [] : [
    { question: `Ktorý toner je vhodný pre ${printerName}?`, answer: `Vyberte niektorý z produktov uvedených na tejto stránke a v detaile ešte skontrolujte model ${printerName} a OEM označenie kazety.` },
    ...(stats.compatible > 0 ? [{ question: "Môžem použiť kompatibilný toner namiesto originálneho?", answer: "Áno, ak je konkrétny kompatibilný produkt určený pre tento model tlačiarne. Typ produktu je viditeľne označený pri každej položke." }] : []),
    ...(geoPilot ? pilotFaq(printerName, geoPilot) : []),
  ]}
  contentSections={notFound ? [] : [
    ...(geoPilot ? [{
      heading: `Odborné odporúčanie pre ${printerName}`,
      paragraphs: [geoPilot.selection, geoPilot.caution],
      bullets: [`Typ spotrebného materiálu: ${geoPilot.productKind}.`, "Porovnajte celý OEM kód vrátane farebnej alebo kapacitnej koncovky.", "Kompatibilitu potvrďte v detaile konkrétneho produktu."],
    }] : []),
    {
      heading: `Výber tonera alebo náplne pre ${printerName}`,
      paragraphs: [`Produkty na tejto stránke majú model ${printerName} uvedený v zozname kompatibilných tlačiarní. Rozhodujúci je celý názov modelu, pretože podobne pomenované zariadenia ${brandName} nemusia používať rovnakú kazetu.`],
      bullets: ["Porovnajte presný model zo štítku zariadenia.", "Skontrolujte OEM kód pôvodnej kazety.", "Vyberte správnu farbu a požadovanú kapacitu."],
    },
    {
      heading: "Ako čítať aktuálnu ponuku",
      paragraphs: ["Každá produktová karta uvádza typ produktu, cenu s DPH a dostupnosť. Detail produktu dopĺňa výťažnosť, farbu a ďalšie kompatibilné tlačiarne, ak sú tieto údaje v katalógu dostupné."],
    },
  ]}
  linkGroups={notFound ? [] : [
    { heading: `OEM označenia pre ${printerName}`, intro: "Otvorte OEM stránku a porovnajte dostupné originálne a alternatívne varianty.", links: topOemLinks(products, 12) },
    { heading: `Ďalšie modely ${brandName}`, intro: "Súvisiace modely značky s reálnymi produktmi v katalógu.", links: relatedPrinterLinks },
  ]}
  schemaEntities={notFound ? [] : [
    { name: printerName, url: canonicalPath },
    { name: brandName, url: printer ? `/znacky/${printer.brand.slug}` : undefined },
    { name: `Tonery pre ${printerName}` },
  ]}
  expertGuide={geoPilot ? {
    title: `Aké náplne používa ${printerName}?`,
    summary: `${geoPilot.selection} ${geoPilot.caution}`,
    updated: "2026-08-09",
    author: "Roman Babčan",
    experience: "17+ rokov skúseností",
    links: geoPilot.adviceLinks,
  } : undefined}
  notFound={notFound}
/>
