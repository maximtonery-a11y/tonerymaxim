---
export const prerender = false;

import SeoCatalogPage from "../../../components/SeoCatalogPage.astro";
import { getProductsCache } from "../../../lib/tm-products-cache";
import {
  brandProducts,
  catalogStats,
  findPrinterEntity,
  topOemLinks,
  topPrinterLinks,
  productOemCodes,
  productSearchText,
} from "../../../lib/seo-catalog";
import { findPrinterGeoPilot, pilotFaq } from "../../../data/geo-pilot";
import { geoPrinterPriority } from "../../../data/geo-priorities";
import { benchmarkForPath, DEFAULT_GEO_GUIDES } from "../../../data/geo-benchmark-content";
import { printerGeoAnswer } from "../../../lib/geo-entity-answer";

const cache = await getProductsCache().catch(() => ({ products: [] as any[], generated_at: "" }));
const printer = findPrinterEntity(cache.products, Astro.params.brand, Astro.params.model);
const notFound = !printer;
const allProducts = printer?.products || [];
const requestedType = String(Astro.url.searchParams.get("typ") || "").toLowerCase();
const selectedType = ["compatible", "original", "renovated"].includes(requestedType) ? requestedType : "";
const products = selectedType
  ? allProducts.filter((product) => product.product_type_key === selectedType)
  : allProducts;
const stats = catalogStats(allProducts);

if (notFound) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
  Astro.response.headers.set("X-Robots-Tag", "noindex, follow");
}

const printerName = printer?.name || "Neznámy model tlačiarne";
const geoPilot = printer ? findPrinterGeoPilot(printer.name) : undefined;
const geoPriority = printer ? geoPrinterPriority(printer.slug) : undefined;
const brandName = printer?.brand.name || "Tlačiareň";
const canonicalPath = printer
  ? `/tlaciarne/${printer.brand.slug}/${printer.slug}`
  : Astro.url.pathname;
const benchmark = printer ? benchmarkForPath(canonicalPath) : undefined;
const integratedDrum = Boolean(geoPilot && /(?:obsahuje|súčasťou|spojen[ée]|jednej zostave|v jednej kazete).{0,80}(?:valec|drum)|(?:valec|drum).{0,80}(?:obsahuje|súčasťou|spojen[ée]|jednej zostave|v jednej kazete)/i.test(`${geoPilot.productKind} ${geoPilot.selection} ${geoPilot.caution}`));
const rawGuideLinks = geoPilot?.adviceLinks?.length ? geoPilot.adviceLinks : DEFAULT_GEO_GUIDES;
const guideLinks = integratedDrum
  ? rawGuideLinks.filter((link) => !/valec|drum/i.test(`${link.href} ${link.label}`))
  : rawGuideLinks;
const relatedPrinterLinks = printer
  ? topPrinterLinks(brandProducts(cache.products, printer.brand), 24)
      .filter((link) => link.href !== canonicalPath)
      .slice(0, 12)
  : [];

function cleanCapacity(value: unknown): string {
  const raw = String(value || "").replace(/\s+/g, " ").trim();
  if (!raw) return "";
  const match = raw.match(/([\d\s.,]+)\s*(str[aá]n|pages?)/i);
  if (match) return `${match[1].replace(/\s+/g, " ").trim()} strán`;
  if (/^\d[\d\s.,]*$/.test(raw)) return `${raw} strán`;
  return raw.length <= 28 ? raw : "";
}
function productCapacity(product: any): string {
  return cleanCapacity(product.capacity || product.kapacita || product.yield || product.page_yield || "");
}
function naturalList(values: string[]): string {
  const unique = [...new Set(values.filter(Boolean))];
  if (unique.length <= 1) return unique[0] || "";
  if (unique.length === 2) return `${unique[0]} a ${unique[1]}`;
  return `${unique.slice(0, -1).join(", ")} a ${unique.at(-1)}`;
}
function productKnowledgeSummary(name: string, products: any[]): string {
  const drumProducts = products.filter((p) => /\b(valec|drum|image drum|imaging drum|imaging unit|optick)/i.test(productSearchText(p)));
  const inkProducts = products.filter((p) => /\b(atrament|ink|cartridge ink)\b/i.test(productSearchText(p)));
  const mainProducts = products.filter((p) => !drumProducts.includes(p));
  const tonerProducts = mainProducts.filter((p) => !inkProducts.includes(p));
  const main = inkProducts.length > tonerProducts.length ? inkProducts : tonerProducts.length ? tonerProducts : mainProducts;
  const mainCodes = [...new Set(main.flatMap(productOemCodes))].slice(0, 8);
  const drumCodes = [...new Set(drumProducts.flatMap(productOemCodes))].slice(0, 4);
  const capacities = [...new Set(main.map(productCapacity).filter(Boolean))].slice(0, 4);
  const colors = [...new Set(main.map((p) => String(p.color || p.farba || "").trim()).filter(Boolean))].slice(0, 4);
  const isInk = inkProducts.length > tonerProducts.length;
  const material = isInk ? "atramentové náplne" : "tonery";
  let first = mainCodes.length
    ? `${name} používa ${material} ${naturalList(mainCodes)}.`
    : `Pre ${name} sú nižšie zobrazené presne priradené ${material}.`;
  const facts: string[] = [];
  if (colors.length === 1) facts.push(`Farba: ${colors[0]}`);
  else if (colors.length > 1 && colors.length <= 4) facts.push(`Farby: ${naturalList(colors)}`);
  if (capacities.length === 1) facts.push(`Výťažnosť/kapacita: ${capacities[0]}`);
  else if (capacities.length > 1) facts.push(`Dostupné kapacity: ${naturalList(capacities)}`);
  let second = facts.length ? ` ${facts.join(" • ")}.` : "";
  if (drumCodes.length) {
    const drumCaps = [...new Set(drumProducts.map(productCapacity).filter(Boolean))].slice(0, 2);
    second += ` Zobrazovací valec ${naturalList(drumCodes)} je vedený samostatne${drumCaps.length === 1 ? ` (${drumCaps[0]})` : ""}.`;
  }
  return `${first}${second}`.replace(/\s+/g, " ").trim();
}

const typeNames = [
  ...(stats.compatible ? ["kompatibilné"] : []),
  ...(stats.original ? ["originálne"] : []),
  ...(stats.renovated ? ["renovované"] : []),
  ...(stats.other ? ["ďalšie"] : []),
];
const typeSummary = typeNames.length > 1
  ? `${typeNames.slice(0, -1).join(", ")} a ${typeNames.at(-1)}`
  : typeNames[0] || "dostupné";
const concisePrinterAnswer = !notFound ? productKnowledgeSummary(printerName, allProducts) : "";
const modelDescription = !notFound ? `${concisePrinterAnswer} Aktuálne ceny a skladová dostupnosť na ToneryMaxim.sk.` : "Požadovaný model tlačiarne sa v katalógu nenašiel.";
const blockedImageTokens = ["no-image", "image-coming-soon", `tm-product-${"place"}holder`, `tm-ink-${"place"}holder`];
const imageCandidate = products
  .flatMap((product) => [product.image, ...(Array.isArray(product.images) ? product.images : [])])
  .map((value) => String(value || "").trim())
  .find((value) => value && !blockedImageTokens.some((token) => value.toLowerCase().includes(token)));
let modelImage: string | undefined;
if (imageCandidate) {
  try {
    const url = new URL(imageCandidate, "https://www.tonerymaxim.sk");
    if (url.protocol === "https:") modelImage = url.toString();
  } catch {
    modelImage = undefined;
  }
}
const geoAnswer = !notFound ? printerGeoAnswer(printerName, allProducts, geoPilot) : undefined;
const quickAnswer = concisePrinterAnswer;

const typeFacts = [
  `Všetky: ${stats.total}`,
  ...(stats.compatible ? [`Kompatibilné: ${stats.compatible}`] : []),
  ...(stats.original ? [`Originálne: ${stats.original}`] : []),
  ...(stats.renovated ? [`Renovované: ${stats.renovated}`] : []),
  ...(stats.other ? [`Ostatné: ${stats.other}`] : []),
];
---

<SeoCatalogPage
  title={notFound ? "Model tlačiarne sa nenašiel | ToneryMaxim.sk" : `Tonery pre ${printerName} | ToneryMaxim.sk`}
  description={notFound
    ? "Požadovaný model tlačiarne sa v katalógu nenašiel."
    : modelDescription}
  image={modelImage}
  canonicalPath={canonicalPath}
  eyebrow={notFound ? "Neznámy model" : "Náplne podľa modelu tlačiarne"}
  heading={notFound ? "Model tlačiarne sa nenašiel" : `Tonery pre ${printerName}`}
  intro={notFound
    ? "Skontrolujte označenie modelu alebo sa vráťte na výber tlačiarne."
    : concisePrinterAnswer}
  products={products}
  answer={quickAnswer}
  generatedAt={cache.generated_at}
  breadcrumbs={[
    { name: "Tlačiarne", path: "/tlaciarne" },
    { name: brandName, path: printer ? `/tlaciarne/${printer.brand.slug}` : "/tlaciarne" },
    { name: printerName, path: canonicalPath },
  ]}
  entityFacts={notFound ? [] : typeFacts}
  relatedLinks={[
    { href: printer ? `/znacky/${printer.brand.slug}` : "/tlaciarne", label: `Všetky produkty ${brandName}` },
    { href: "/kompatibilne-tonery", label: "Kompatibilné tonery" },
    { href: "/originalne-tonery", label: "Originálne tonery" },
    { href: "/tlaciarne", label: "Zmeniť tlačiareň" },
  ]}
  faq={notFound ? [] : [
    { question: geoAnswer?.question || `Ktorá náplň je vhodná pre ${printerName}?`, answer: geoAnswer?.answer || "" },
    ...(stats.compatible > 0 ? [{ question: "Môžem použiť kompatibilný toner namiesto originálneho?", answer: "Áno, ak je konkrétny kompatibilný produkt určený pre tento model tlačiarne. Typ produktu je viditeľne označený pri každej položke." }] : []),
    ...(geoPilot ? pilotFaq(printerName, geoPilot) : []),
  ]}
  contentSections={notFound ? [] : [
    {
      heading: `Výber tonera alebo náplne pre ${printerName}`,
      paragraphs: [`Produkty na tejto stránke majú model ${printerName} uvedený v zozname kompatibilných tlačiarní. Rozhodujúci je celý názov modelu, pretože podobne pomenované zariadenia ${brandName} nemusia používať rovnakú kazetu.`],
      bullets: ["Porovnajte presný model zo štítku zariadenia.", "Skontrolujte OEM kód pôvodnej kazety.", "Vyberte správnu farbu a požadovanú kapacitu."],
    },
    {
      heading: "Ako čítať aktuálnu ponuku",
      paragraphs: ["Každá produktová karta uvádza typ produktu, cenu s DPH a dostupnosť. Detail produktu dopĺňa výťažnosť, farbu a ďalšie kompatibilné tlačiarne, ak sú tieto údaje v katalógu dostupné."],
    },
  ]}
  linkGroups={notFound ? [] : [
    { heading: `OEM označenia pre ${printerName}`, intro: "Otvorte OEM stránku a porovnajte dostupné originálne a alternatívne varianty.", links: topOemLinks(products, 12) },
    { heading: `Produkty pre ${printerName}`, intro: "Konkrétne produkty s cenou, dostupnosťou a detailom kompatibility sú uvedené v aktuálnej ponuke.", links: [{ href: "#produkty", label: `Zobraziť ${stats.total} priradených produktov`, count: stats.total }] },
    { heading: "Relevantné návody", intro: "Postup kontroly modelu, OEM kódu a rozdielov medzi typmi náplní.", links: guideLinks },
    { heading: `Ďalšie modely ${brandName}`, intro: "Súvisiace modely značky s reálnymi produktmi v katalógu.", links: relatedPrinterLinks },
  ]}
  schemaEntities={notFound ? [] : [
    { name: printerName, url: canonicalPath },
    { name: brandName, url: printer ? `/znacky/${printer.brand.slug}` : undefined },
    { name: `Tonery pre ${printerName}` },
  ]}
  expertGuide={geoPriority || geoPilot ? {
    title: geoAnswer?.question || benchmark?.prompt || `Aké náplne používa ${printerName}?`,
    summary: geoAnswer?.answer || `${geoPilot?.selection || "Výber vychádza z aktuálneho katalógu."} ${geoPilot?.caution || "Pred objednaním potvrďte celý model a OEM kód."}`,
    updated: "2026-08-09",
    author: "Roman Babčan",
    experience: "17+ rokov skúseností",
    links: guideLinks,
  } : undefined}
  notFound={notFound}
  productFirst={!notFound}
  productTypeFilters={!notFound}
/>
