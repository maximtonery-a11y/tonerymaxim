---
export const prerender = false;

import SeoCatalogPage from "../../../components/SeoCatalogPage.astro";
import { getProductsCache } from "../../../lib/tm-products-cache";
import {
  catalogStats,
  entitySlug,
  findPrinterEntity,
  printerBrandForName,
  productOemCodes,
  productSearchText,
} from "../../../lib/seo-catalog";
import { findPrinterGeoPilot } from "../../../data/geo-pilot";
import { geoPrinterPriority } from "../../../data/geo-priorities";
import { benchmarkForPath, DEFAULT_GEO_GUIDES } from "../../../data/geo-benchmark-content";
import { printerGeoAnswer } from "../../../lib/geo-entity-answer";


const KNOWN_PRODUCT_BRANDS = ["HP", "Canon", "Brother", "Epson", "Samsung", "Xerox", "Kyocera", "Lexmark", "OKI", "Ricoh", "Konica Minolta", "Develop", "Sharp", "Panasonic"];
const normText = (value: unknown) => String(value || "").replace(/\s+/g, " ").trim();
const uniqueText = (values: string[], limit = 8) => [...new Set(values.map(normText).filter(Boolean))].slice(0, limit);
const naturalList = (values: string[]) => values.length < 2 ? (values[0] || "") : values.length === 2 ? `${values[0]} a ${values[1]}` : `${values.slice(0, -1).join(", ")} a ${values.at(-1)}`;
function brandSegment(product: any, targetBrand: string): string {
  const source = normText(`${product?.name || ""} ${product?.mpn || ""}`);
  if (!source) return "";
  const escaped = KNOWN_PRODUCT_BRANDS.map((brand) => brand.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|");
  const markers = [...source.matchAll(new RegExp(`\\b(${escaped})\\b`, "gi"))];
  const wanted = markers.findIndex((match) => normText(match[1]).toLowerCase() === targetBrand.toLowerCase());
  if (wanted < 0) return "";
  const start = markers[wanted].index || 0;
  const end = markers[wanted + 1]?.index ?? source.length;
  return source.slice(start, end);
}
function brandOemCodes(product: any, targetBrand: string): string[] {
  const segment = brandSegment(product, targetBrand);
  if (!segment) return [];
  return productOemCodes({ ...product, name: segment, sku: "" } as any);
}
function isDrum(product: any): boolean {
  return /\b(valec|drum|image drum|imaging unit|optick|zobrazovac)/i.test(productSearchText(product));
}
function formatYieldValue(value: unknown): string {
  let text = normText(value)
    .replace(/\s*[x×]\s*/gi, " × ")
    .replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1 ");
  if (!text) return "";
  // Ak zdroj obsahuje iba číslo, doplníme jednotku. Ak ju už obsahuje, nemeníme ju.
  if (/^\d[\d ]*$/.test(text)) text = `${text} strán`;
  return text;
}
function productYields(products: any[]): string[] {
  return uniqueText(
    products
      .flatMap((product) => [product.page_yield, product.capacity])
      .map(formatYieldValue)
      .filter((value) => /\d/.test(value)),
    6,
  );
}
function isInkProduct(product: any): boolean {
  const text = productSearchText(product);
  return /\b(atrament|inkjet|ink)\b/i.test(text) || (/\bcartridge\b/i.test(text) && !/\btoner\b/i.test(text));
}
function isTonerProduct(product: any): boolean {
  return /\btoner(?:ov|y|a|u|om|mi)?\b/i.test(productSearchText(product)) && !isDrum(product);
}
function consumableKind(product: any): "drum" | "ink" | "toner" | "waste" | "fuser" | "transfer" | "ribbon" | "maintenance" | "other" {
  const text = productSearchText(product);
  if (isDrum(product)) return "drum";
  if (isInkProduct(product)) return "ink";
  if (isTonerProduct(product)) return "toner";
  if (/odpad|waste\s*toner|waste\s*container|waste\s*bottle/i.test(text)) return "waste";
  if (/fuser|zapekac|fixing\s*(unit|assembly)|fixac/i.test(text)) return "fuser";
  if (/transfer\s*(belt|unit)|prenosov|transferovy|transferový/i.test(text)) return "transfer";
  if (/ribbon|paska|páska/i.test(text)) return "ribbon";
  if (/maintenance|udrzb|údržb|service\s*kit/i.test(text)) return "maintenance";
  return "other";
}
function cleanColor(value: unknown): string {
  const text = normText(value).toLowerCase();
  if (!text) return "";
  if (/cier|čier|black/.test(text)) return "čierna";
  if (/cyan|azur|azúr/.test(text)) return "azúrová";
  if (/magenta|purpur/.test(text)) return "purpurová";
  if (/yellow|zlt|žlt/.test(text)) return "žltá";
  if (/tri.?color|farebn|colour|color|cmy/.test(text)) return "farebná";
  return text;
}

const cache = await getProductsCache().catch(() => ({ products: [] as any[], generated_at: "" }));
const printer = findPrinterEntity(cache.products, Astro.params.brand, Astro.params.model);
const notFound = !printer;
const allProducts = printer?.products || [];
const requestedType = String(Astro.url.searchParams.get("typ") || "").toLowerCase();
const selectedType = ["compatible", "original", "renovated"].includes(requestedType) ? requestedType : "";
const products = selectedType
  ? allProducts.filter((product) => product.product_type_key === selectedType)
  : allProducts;
const stats = catalogStats(allProducts);

if (notFound) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
  Astro.response.headers.set("X-Robots-Tag", "noindex, follow");
}

const printerName = printer?.name || "Neznámy model tlačiarne";
const geoPilot = printer ? findPrinterGeoPilot(printer.name) : undefined;
const geoPriority = printer ? geoPrinterPriority(printer.slug) : undefined;
const brandName = printer?.brand.name || "Tlačiareň";
const canonicalPath = printer
  ? `/tlaciarne/${printer.brand.slug}/${printer.slug}`
  : Astro.url.pathname;
const benchmark = printer ? benchmarkForPath(canonicalPath) : undefined;
const integratedDrum = Boolean(geoPilot && /(?:obsahuje|súčasťou|spojen[ée]|jednej zostave|v jednej kazete).{0,80}(?:valec|drum)|(?:valec|drum).{0,80}(?:obsahuje|súčasťou|spojen[ée]|jednej zostave|v jednej kazete)/i.test(`${geoPilot.productKind} ${geoPilot.selection} ${geoPilot.caution}`));
const rawGuideLinks = geoPilot?.adviceLinks?.length ? geoPilot.adviceLinks : DEFAULT_GEO_GUIDES;
const guideLinks = integratedDrum
  ? rawGuideLinks.filter((link) => !/valec|drum/i.test(`${link.href} ${link.label}`))
  : rawGuideLinks;
const typeNames = [
  ...(stats.compatible ? ["kompatibilné"] : []),
  ...(stats.original ? ["originálne"] : []),
  ...(stats.renovated ? ["renovované"] : []),
  ...(stats.other ? ["ďalšie"] : []),
];
const typeSummary = typeNames.length > 1
  ? `${typeNames.slice(0, -1).join(", ")} a ${typeNames.at(-1)}`
  : typeNames[0] || "dostupné";
let modelDescription = `Náplne pre ${printerName}: ${typeSummary}. Aktuálne ceny, dostupnosť a parametre produktov.`;
const blockedImageTokens = ["no-image", "image-coming-soon", `tm-product-${"place"}holder`, `tm-ink-${"place"}holder`];
const imageCandidate = products
  .flatMap((product) => [product.image, ...(Array.isArray(product.images) ? product.images : [])])
  .map((value) => String(value || "").trim())
  .find((value) => value && !blockedImageTokens.some((token) => value.toLowerCase().includes(token)));
let modelImage: string | undefined;
if (imageCandidate) {
  try {
    const url = new URL(imageCandidate, "https://www.tonerymaxim.sk");
    if (url.protocol === "https:") modelImage = url.toString();
  } catch {
    modelImage = undefined;
  }
}
const geoAnswer = !notFound ? printerGeoAnswer(printerName, allProducts, geoPilot) : undefined;
const tonerProducts = allProducts.filter((product) => !isDrum(product) && (isInkProduct(product) || isTonerProduct(product)));
const drumProducts = allProducts.filter(isDrum);
const originalTonerProducts = tonerProducts.filter((product) => product.product_type_key === "original");
const originalDrumProducts = drumProducts.filter((product) => product.product_type_key === "original");
const originalTonerOems = printer ? uniqueText(originalTonerProducts.flatMap((product) => brandOemCodes(product, brandName)), 12) : [];
const originalDrumOems = printer ? uniqueText(originalDrumProducts.flatMap((product) => brandOemCodes(product, brandName)), 8) : [];
const tonerOems = originalTonerOems.length ? originalTonerOems : (printer ? uniqueText(tonerProducts.flatMap((product) => brandOemCodes(product, brandName)), 12) : []);
const drumOems = originalDrumOems.length ? originalDrumOems : (printer ? uniqueText(drumProducts.flatMap((product) => brandOemCodes(product, brandName)), 8) : []);
const relevantTonerProducts = tonerOems.length
  ? tonerProducts.filter((product) => brandOemCodes(product, brandName).some((code) => tonerOems.includes(code)))
  : tonerProducts;
const relevantDrumProducts = drumOems.length
  ? drumProducts.filter((product) => brandOemCodes(product, brandName).some((code) => drumOems.includes(code)))
  : drumProducts;
const colors = uniqueText(relevantTonerProducts.map((product) => product.color).filter(Boolean), 5);
const inkBased = relevantTonerProducts.length > 0 && relevantTonerProducts.some(isInkProduct);
const laserBased = relevantTonerProducts.some(isTonerProduct);
const knownOtherKinds = relevantTonerProducts.map(consumableKind).filter((kind) => !["ink", "toner", "other"].includes(kind));
const consumableName = inkBased
  ? "atramentové náplne"
  : laserBased
    ? "tonerové kazety"
    : knownOtherKinds.includes("ribbon")
      ? "tlačové pásky"
      : "spotrebný materiál";
const pageHeading = inkBased
  ? `Atramentové náplne pre ${printerName}`
  : laserBased
    ? `Tonery pre ${printerName}`
    : `Spotrebný materiál pre ${printerName}`;
modelDescription = inkBased
  ? `Atramentové náplne pre ${printerName}: ${typeSummary}. Aktuálne ceny, dostupnosť, farby a kapacity podľa údajov pri produktoch.`
  : laserBased
    ? `Tonery pre ${printerName}: ${typeSummary}. Aktuálne ceny, dostupnosť, farby a výťažnosť.`
    : `Spotrebný materiál pre ${printerName}: ${typeSummary}. Aktuálne ceny, dostupnosť a parametre produktov.`;
const isMultipack = (product: any) => /\b(dualpack|multipack|dvojbal|2\s*[x×])\b/i.test(productSearchText(product)) || /^\s*2\s*[x×]/i.test(normText(product?.page_yield || product?.capacity));
const singleTonerProducts = relevantTonerProducts.filter((product) => !isMultipack(product));
const singleOriginalProducts = singleTonerProducts.filter((product) => product.product_type_key === "original");
const baseProducts = singleOriginalProducts.length ? singleOriginalProducts : singleTonerProducts;
const baseOems = printer ? uniqueText(baseProducts.flatMap((product) => brandOemCodes(product, brandName)), 8) : [];
const oemText = naturalList(baseOems.length ? baseOems : tonerOems);
function numericYield(product: any): number | null {
  if (isInkProduct(product)) return null; // atramenty: nikdy neporovnávame strany a ml v jednom výpočte
  const raw = normText(product?.page_yield || product?.capacity).replace(/\s/g, "");
  if (!raw || /^2[x×]/i.test(raw) || /\b(ml|millil)/i.test(raw)) return null;
  const match = raw.match(/\d+/);
  const value = match ? Number(match[0]) : 0;
  return value > 0 ? value : null;
}
function bestCostPerPage(products: any[]) {
  return products
    .filter((product) => !isInkProduct(product) && !isDrum(product))
    .map((product) => {
      const pages = numericYield(product);
      const price = Number(product?.price || 0);
      return pages && price > 0 ? { product, pages, price, cpp: price / pages } : null;
    })
    .filter(Boolean)
    .sort((a: any, b: any) => a.cpp - b.cpp)[0] as any;
}
function productPrimaryOem(product: any): string {
  return brandOemCodes(product, brandName)[0] || "";
}
const compatibleBest = inkBased ? null : bestCostPerPage(singleTonerProducts.filter((product) => product.product_type_key === "compatible"));
const originalBest = inkBased ? null : bestCostPerPage(singleTonerProducts.filter((product) => product.product_type_key === "original"));
const renovatedBest = inkBased ? null : bestCostPerPage(singleTonerProducts.filter((product) => product.product_type_key === "renovated"));
const allBest = [compatibleBest, originalBest, renovatedBest].filter(Boolean).sort((a: any, b: any) => a.cpp - b.cpp)[0] as any;
const recommendation = compatibleBest && allBest?.product?.product_type_key === "compatible"
  ? `Najlepší pomer ceny a výťažnosti má z aktuálnej ponuky kompatibilný ${brandName} ${productPrimaryOem(compatibleBest.product) || "toner"} – približne ${compatibleBest.cpp.toFixed(4).replace(".", ",")} € za stranu.`
  : allBest
    ? `Najnižšiu vypočítanú cenu za stranu má aktuálne ${brandName} ${productPrimaryOem(allBest.product) || "toner"} – približne ${allBest.cpp.toFixed(4).replace(".", ",")} € za stranu.`
    : "";

// Kapacitné odporúčanie vytvárame iba pre laserové tonery a iba z jednoznačne priradených OEM variantov.
const capacityByOem = new Map<string, number>();
if (!inkBased) {
  for (const product of baseProducts) {
    const pages = numericYield(product);
    if (!pages) continue;
    for (const code of brandOemCodes(product, brandName)) {
      const old = capacityByOem.get(code);
      if (!old || pages > old) capacityByOem.set(code, pages);
    }
  }
}
const capacityVariants = [...capacityByOem.entries()]
  .map(([code, pages]) => ({ code, pages }))
  .sort((a, b) => a.pages - b.pages);
const lowVariant = capacityVariants[0];
const highVariant = capacityVariants.at(-1);
const capacityAdvice = lowVariant && highVariant && highVariant.pages > lowVariant.pages
  ? `Pre menší objem tlače je určený ${brandName} ${lowVariant.code}; pri pravidelnej alebo častejšej tlači je praktickejší ${brandName} ${highVariant.code} s výťažnosťou približne ${highVariant.pages.toLocaleString("sk-SK")} strán.`
  : "";

function colorFact(values: string[]): string {
  if (!values.length) return "";
  if (values.length === 1 && /čier/i.test(values[0])) return "Farba: čierna.";
  return `Farby náplní: ${naturalList(values.map((value) => value.toLowerCase()))}.`;
}
const colorSentence = colorFact(colors);
const drumSentence = drumOems.length
  ? `Toner a optický valec sú dva samostatné spotrebné materiály. Samostatný optický valec pre tento model má označenie ${brandName} ${naturalList(drumOems)}.`
  : "";
const inkAdvice = inkBased
  ? "Pri atramentových náplniach cenu za stranu neporovnávame, pretože katalóg môže uvádzať kapacitu v mililitroch alebo výťažnosť v stranách podľa konkrétnej náplne."
  : "";
const quickParts = tonerOems.length
  ? [
      `${printerName} používa ${consumableName} ${brandName} ${oemText}.`,
      colorSentence,
      drumSentence,
    ].filter(Boolean)
  : [];
const quickAnswer = !notFound
  ? quickParts.length
    ? quickParts.join(" ")
    : `${printerName}: vyberte náplň iba z produktov priradených k tomuto presnému modelu. OEM označenie overte v detaile produktu.`
  : "";
const compatibilityAnswer = tonerOems.length
  ? drumOems.length
    ? `${printerName} používa ${consumableName} ${brandName} ${oemText}. Optický valec je samostatný spotrebný materiál: ${brandName} ${naturalList(drumOems)}. Na stránke uvádzame iba označenia spotrebného materiálu značky ${brandName}.`
    : `${printerName} používa ${consumableName} ${brandName} ${oemText}. Na stránke uvádzame iba označenia spotrebného materiálu značky ${brandName}.`
  : quickAnswer;
const recommendationAnswer = inkBased
  ? inkAdvice
  : recommendation || "Odporúčanie podľa ceny za stranu zobrazíme iba vtedy, keď máme pri porovnávaných tonerových kazetách spoľahlivo uvedenú cenu aj výťažnosť v stranách.";
const brandOemLinks = [...tonerOems, ...drumOems].map((code) => ({ href: `/oem/${code.toLowerCase()}`, label: `${brandName} ${code}` }));

const kindGroups = new Map<string, any[]>();
for (const product of allProducts) {
  const kind = consumableKind(product);
  kindGroups.set(kind, [...(kindGroups.get(kind) || []), product]);
}
const inkProducts = kindGroups.get("ink") || [];
const laserTonerProducts = kindGroups.get("toner") || [];
const otherConsumables = allProducts.filter((product) => !["ink", "toner"].includes(consumableKind(product)));
const mainKind: "ink" | "toner" | "other" = inkProducts.length > laserTonerProducts.length
  ? "ink"
  : laserTonerProducts.length > 0
    ? "toner"
    : "other";

function oemsFor(products: any[], limit = 16): string[] {
  return printer ? uniqueText(products.flatMap((product) => brandOemCodes(product, brandName)), limit) : [];
}
function colorOemParagraphs(sourceProducts: any[]): string[] {
  const byColor = new Map<string, Set<string>>();
  for (const product of sourceProducts) {
    const color = cleanColor(product.color || product.farba);
    if (!color) continue;
    const codes = brandOemCodes(product, brandName);
    if (!codes.length) continue;
    const set = byColor.get(color) || new Set<string>();
    codes.forEach((code) => set.add(code));
    byColor.set(color, set);
  }
  if (byColor.size < 2) return [];
  const order = ["čierna", "azúrová", "purpurová", "žltá", "farebná"];
  return [...byColor.entries()]
    .sort(([a], [b]) => (order.indexOf(a) < 0 ? 99 : order.indexOf(a)) - (order.indexOf(b) < 0 ? 99 : order.indexOf(b)))
    .map(([color, codes]) => `${color.charAt(0).toUpperCase()}${color.slice(1)}: ${brandName} ${naturalList([...codes].slice(0, 6))}.`);
}
function typeLabel(kind: string): string {
  return ({
    drum: "optický valec",
    waste: "nádoba na odpadový toner",
    fuser: "zapekacia jednotka",
    transfer: "prenosová jednotka alebo pás",
    ribbon: "tlačová páska",
    maintenance: "údržbová súprava",
    other: "ďalší spotrebný materiál",
  } as Record<string, string>)[kind] || "spotrebný materiál";
}
function otherConsumableParagraphs(): string[] {
  const kinds = ["drum", "waste", "fuser", "transfer", "ribbon", "maintenance"];
  return kinds.flatMap((kind) => {
    const items = kindGroups.get(kind) || [];
    if (!items.length) return [];
    const codes = oemsFor(items, 8);
    const label = typeLabel(kind);
    return [codes.length
      ? `${label.charAt(0).toUpperCase()}${label.slice(1)} je v ponuke vedený pod označením ${brandName} ${naturalList(codes)}.`
      : `V ponuke je pre tento model vedený aj ${label}.`];
  });
}
function aliasFacts(sourceProducts: any[]): string[] {
  const aliases = new Map<string, Set<string>>();
  for (const product of sourceProducts) {
    const name = normText(product?.name);
    if (!name) continue;
    for (const code of brandOemCodes(product, brandName)) {
      const idx = name.toUpperCase().indexOf(code.toUpperCase());
      if (idx < 0) continue;
      const nearby = name.slice(idx + code.length, idx + code.length + 32);
      const candidates = [
        ...[...nearby.matchAll(/\(\s*(?:no\.?\s*)?([0-9]{2,4}(?:XL|XXL)?[A-Z]?)\s*\)/gi)].map((m) => m[1]),
        ...[...nearby.matchAll(/^\s+(?:\(\s*)?(?:no\.?\s*)?([0-9]{2,3}(?:XL|XXL)?[A-Z])\b/gi)].map((m) => m[1]),
      ].map((value) => value.toUpperCase());
      for (const alias of candidates) {
        if (!alias || alias === code.toUpperCase()) continue;
        const set = aliases.get(code) || new Set<string>();
        set.add(alias);
        aliases.set(code, set);
      }
    }
  }
  return [...aliases.entries()].map(([code, values]) => `${brandName} ${code} sa v názvoch produktov uvádza aj ako ${brandName} ${naturalList([...values])}.`);
}

function xlFacts(sourceProducts: any[]): string[] {
  const xl = uniqueText(sourceProducts.flatMap((product) => {
    const text = productSearchText(product);
    if (!/\b(?:xl|xxl|high\s*yield|high[- ]capacity)\b/i.test(text)) return [];
    return brandOemCodes(product, brandName);
  }), 10);
  if (!xl.length) return [];
  return [`Vysokokapacitné prevedenie je v aktuálnej ponuke označené ${brandName} ${naturalList(xl)}. Označenie XL/XXL preto pri výbere nevynechávajte – ide o inú kapacitnú verziu tej istej produktovej rady.`];
}
function multipackFacts(sourceProducts: any[], noun: string): string[] {
  const packs = sourceProducts.filter(isMultipack);
  if (!packs.length) return [];
  const codes = oemsFor(packs, 10);
  return [codes.length
    ? `V ponuke sú aj viacbalenia ${noun}; rozpoznáte ich podľa označení ${brandName} ${naturalList(codes)}. Pri viacbalení porovnávajte obsah celého balenia, nie cenu jednej samostatnej náplne.`
    : `V ponuke sú aj viacbalenia ${noun}. Pri porovnaní sledujte obsah celého balenia, nie cenu jednej samostatnej náplne.`];
}
function capacityFactsFor(sourceProducts: any[]): string[] {
  const byCode = new Map<string, Set<string>>();
  for (const product of sourceProducts.filter((item) => !isMultipack(item))) {
    const values = productYields([product]);
    if (!values.length) continue;
    for (const code of brandOemCodes(product, brandName)) {
      const set = byCode.get(code) || new Set<string>();
      values.forEach((value) => set.add(value));
      byCode.set(code, set);
    }
  }
  return [...byCode.entries()].slice(0, 12).map(([code, values]) => {
    const capacities = naturalList([...values]);
    return `${brandName} ${code}: deklarovaná kapacita alebo výťažnosť ${capacities}.`;
  });
}
function exactRelatedPrinterLinks() {
  if (!printer) return [];
  const source = mainKind === "ink" ? inkProducts : mainKind === "toner" ? laserTonerProducts : allProducts;
  const candidates = new Map<string, { name: string; count: number }>();
  for (const product of source) {
    const names = Array.isArray(product.compatible_printers) ? product.compatible_printers : [];
    for (const rawName of names) {
      const name = normText(rawName);
      const slug = entitySlug(name);
      if (!slug || slug === printer.slug || printerBrandForName(name)?.slug !== printer.brand.slug) continue;
      const current = candidates.get(slug);
      candidates.set(slug, { name, count: (current?.count || 0) + 1 });
    }
  }
  return [...candidates.entries()]
    .sort(([, left], [, right]) => right.count - left.count || left.name.localeCompare(right.name, "sk"))
    .slice(0, 12)
    .map(([slug, item]) => ({ href: `/tlaciarne/${printer.brand.slug}/${slug}`, label: item.name }));
}

const lowerContentSections: Array<{ heading: string; paragraphs: string[]; bullets?: string[] }> = [];
if (!notFound && mainKind === "toner") {
  const capacityFacts = capacityFactsFor(laserTonerProducts);
  lowerContentSections.push({
    heading: `Tonery a spotrebný materiál pre ${printerName}`,
    paragraphs: [
      tonerOems.length
        ? `${printerName} používa ${consumableName} ${brandName} ${oemText}. ${colorSentence}`.trim()
        : `Pre ${printerName} vyberajte toner podľa presného označenia uvedeného pri produkte.`,
      ...(capacityAdvice ? [capacityAdvice] : []),
      ...(drumSentence ? [drumSentence] : []),
    ],
    bullets: capacityFacts,
  });
  const aliases = aliasFacts(laserTonerProducts);
  if (aliases.length) lowerContentSections.push({ heading: "Označenia, pod ktorými toner nájdete", paragraphs: aliases });
