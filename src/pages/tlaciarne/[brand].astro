---
import "../../styles/global.css";
import "../../styles/printer-finder.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FloatingAdvisor from "../../components/FloatingAdvisor.astro";
import "../../styles/footer.css";
import mobileLogo from "../../assets/tonerymaxim-mobile-approved-logo.png";

const brandParam = String(Astro.params.brand || "");
const brandMap: Record<string, string> = {
  hp: "HP",
  canon: "Canon",
  brother: "Brother",
  epson: "Epson",
  xerox: "Xerox",
  samsung: "Samsung",
  lexmark: "Lexmark",
  kyocera: "Kyocera",
  oki: "OKI",
  ricoh: "Ricoh",
  "konica-minolta": "Konica Minolta",
  utax: "Utax",
  panasonic: "Panasonic",
  toshiba: "Toshiba",
  dell: "Dell",
};
const selectedBrand = brandMap[brandParam.toLowerCase()] || brandParam;
const title = `Náplne do tlačiarní ${selectedBrand} | ToneryMaxim.sk`;
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="printer-page">
    <div class="page">
      <Header />

      <section class="printer-mobile-shell" aria-label="Mobilné vyhľadanie podľa tlačiarne">
        <div class="printer-mobile-topbar">
          <button class="printer-mobile-menu-button" type="button" aria-label="Otvoriť menu" aria-expanded="false" data-printer-mobile-menu-toggle>
            <span></span><span></span><span></span>
          </button>
          <a class="printer-mobile-logo-link" href="/" aria-label="ToneryMaxim domov">
            <img src={mobileLogo.src} alt="ToneryMaxim" loading="eager" decoding="async" />
          </a>
          <a class="printer-mobile-cart-link" href="/kosik" aria-label="Košík">
            <span aria-hidden="true">🛒</span><strong data-cart-count>0</strong>
          </a>
        </div>

        <div class="printer-mobile-drawer" data-printer-mobile-menu aria-hidden="true">
          <div class="printer-mobile-drawer-panel">
            <div class="printer-mobile-drawer-head">
              <strong>Menu</strong>
              <button type="button" aria-label="Zavrieť menu" data-printer-mobile-menu-close>×</button>
            </div>
            <section>
              <strong>Môj účet</strong>
              <a href="/prihlasenie">Prihlásenie</a>
              <a href="/ucet">Môj účet</a>
              <a href="/ucet/objednavky">Moje objednávky</a>
            </section>
            <section>
              <strong>Informácie</strong>
              <a href="/kontakt">Kontakt</a>
              <a href="/doprava-a-platba">Doprava a platba</a>
              <a href="/reklamacie">Reklamácie</a>
              <a href="/obchodne-podmienky">Obchodné podmienky</a>
              <a href="/ochrana-osobnych-udajov">Ochrana osobných údajov</a>
            </section>
            <section>
              <strong>Ponuka</strong>
              <a href="/produkty?category=tonery&search=toner">Tonery</a>
              <a href="/produkty?category=atramentove-naplne&search=atramentov%C3%A9%20n%C3%A1plne">Atramentové náplne</a>
              <a href="/produkty?category=opticke-valce&search=optick%C3%A9%20valce">Valce</a>
              <a href="/produkty?category=ostatne-komponenty&search=ostatn%C3%A9%20komponenty">Komponenty</a>
            </section>
          </div>
        </div>
      </section>

      <main class="printer-finder-page" data-printer-finder data-brand={selectedBrand}>
        <section class="printer-finder-hero">
          <div class="wrap printer-finder-hero-inner">
            <div class="printer-finder-copy">
              <a class="printer-back-link" href="/">← späť na úvod</a>
              <p class="eyebrow">Vyhľadanie podľa tlačiarne</p>
              <h1>Farby a náplne do tlačiarne {selectedBrand}</h1>
              <p class="lead">Značku už máte vybranú. Vyberte model zo zoznamu alebo začnite písať názov tlačiarne.</p>
            </div>
            <div class="printer-brand-card" aria-label={`Vybraná značka ${selectedBrand}`}>
              <span>Značka</span>
              <strong>{selectedBrand}</strong>
            </div>
          </div>
        </section>

        <section class="printer-finder-panel-section">
          <div class="wrap">
            <div class="printer-finder-panel">
              <div class="printer-field printer-field-brand">
                <label>Značka tlačiarne</label>
                <button type="button" data-open-brand-list>{selectedBrand}</button>
              </div>

              <div class="printer-field printer-field-model">
                <label>Model tlačiarne</label>
                <div class="printer-model-control">
                  <input type="search" data-printer-input placeholder="Vyberte alebo začnite písať model" autocomplete="off" />
                  <button type="button" data-clear-printer hidden aria-label="Vymazať model">×</button>
                </div>
                <div class="printer-suggestions" data-printer-suggestions hidden></div>
              </div>

              <button class="printer-submit" type="button" data-printer-submit disabled>Vyhľadať náplň</button>
            </div>

            <div class="printer-helper-row">
              <div class="printer-helper" data-printer-status>Načítavam modely tlačiarní...</div>
              <div class="printer-helper-note">V rozbaľovacom zozname sú všetky modely pre vybranú značku.</div>
            </div>
          </div>
        </section>

        <section class="wrap printer-popular-section">
          <div class="printer-section-head">
            <div>
              <p class="eyebrow">Najvyhľadávanejšie modely</p>
              <h2>Najčastejšie hľadané tlačiarne {selectedBrand}</h2>
              <p class="section-lead">Rýchly výber pre zákazníkov, ktorí nechcú prechádzať celý zoznam modelov.</p>
            </div>
            <p data-printer-count></p>
          </div>

          <div class="printer-popular-grid" data-printer-popular-grid></div>
        </section>

        <section class="wrap printer-help-section">
          <div class="printer-help-card">
            <div>
              <p class="eyebrow">Pomoc s výberom</p>
              <h2>Neviete presný model tlačiarne?</h2>
              <p>Napíšte nám označenie tonera, fotku štítku alebo model tlačiarne. Pomôžeme vybrať správnu náplň.</p>
            </div>
            <div class="printer-help-actions">
              <a href="mailto:info@tonerymaxim.sk">Napísať e-mail</a>
              <a href="tel:+421910123456">Zavolať</a>
            </div>
          </div>
        </section>
      </main>

      <section class="printer-mobile-help-area" aria-label="Pomoc s výberom správnej náplne">
        <div class="printer-mobile-help-card">
          <h2>Radi vám pomôžeme</h2>
          <a class="printer-mobile-help-row" href="tel:0917859206" aria-label="Zavolať 0917 859 206">
            <span aria-hidden="true" class="printer-mobile-help-icon">☎</span>
            <strong>0917 859 206</strong>
          </a>
          <a class="printer-mobile-help-row" href="mailto:info@tonerymaxim.sk" aria-label="Napísať e-mail info@tonerymaxim.sk">
            <span aria-hidden="true" class="printer-mobile-help-icon">✉</span>
            <strong>info@tonerymaxim.sk</strong>
          </a>
        </div>
      </section>

      <div class="printer-mobile-bottom-search" data-printer-bottom-search>
        <form action="/produkty" method="get" data-smart-search>
          <span aria-hidden="true">⌕</span>
          <input type="search" name="s" data-smart-search-input placeholder="Hľadať toner alebo tlačiareň" aria-label="Hľadať toner alebo tlačiareň" />
          <button type="submit">Hľadať</button>
        </form>
      </div>

      <dialog class="printer-brand-modal" data-brand-modal>
        <div class="printer-brand-modal-card">
          <button class="printer-brand-modal-close" type="button" data-close-brand-modal aria-label="Zavrieť">×</button>
          <h2>Vyberte značku tlačiarne</h2>
          <p>Po kliknutí sa otvorí stránka pre vybranú značku.</p>
          <div class="printer-brand-grid" data-brand-grid></div>
        </div>
      </dialog>

      <Footer />
      <FloatingAdvisor />
    </div>

    <script>
      import "../../scripts/printer-finder.js";
      import "../../scripts/smart-search.js";
      window.tmInitSmartSearch?.();
    </script>

    <script>
      const printerMenuToggle = document.querySelector('[data-printer-mobile-menu-toggle]');
      const printerMenu = document.querySelector('[data-printer-mobile-menu]');
      const printerMenuClose = document.querySelector('[data-printer-mobile-menu-close]');
      function setPrinterMenu(open) {
        if (!printerMenu || !printerMenuToggle) return;
        printerMenu.classList.toggle('is-open', open);
        printerMenu.setAttribute('aria-hidden', String(!open));
        printerMenuToggle.setAttribute('aria-expanded', String(open));
        document.documentElement.classList.toggle('tm-menu-open', open);
      }
      printerMenuToggle?.addEventListener('click', () => setPrinterMenu(!printerMenu?.classList.contains('is-open')));
      printerMenuClose?.addEventListener('click', () => setPrinterMenu(false));
      printerMenu?.addEventListener('click', (event) => { if (event.target === printerMenu) setPrinterMenu(false); });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setPrinterMenu(false); });
      window.tmInitSmartSearch?.();
      document.addEventListener('DOMContentLoaded', () => window.tmInitSmartSearch?.());
    </script>
  </body>
</html>
