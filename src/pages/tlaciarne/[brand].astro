---
import "../../styles/global.css";
import "../../styles/printer-finder.css";
import "../../styles/home-mobile.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FloatingAdvisor from "../../components/FloatingAdvisor.astro";
import "../../styles/footer.css";
import mobileLogo from "../../assets/tonerymaxim-mobile-approved-logo.png";
import SeoHead from "../../components/SeoHead.astro";
import { breadcrumbJsonLd, organizationJsonLd, websiteJsonLd } from "../../lib/seo";
import { getProductsCache } from "../../lib/tm-products-cache";
import { findBrand, printerEntities } from "../../lib/seo-catalog";

const brandParam = String(Astro.params.brand || "");
const brandMap: Record<string, string> = {
  hp: "HP",
  canon: "Canon",
  brother: "Brother",
  epson: "Epson",
  xerox: "Xerox",
  samsung: "Samsung",
  lexmark: "Lexmark",
  kyocera: "Kyocera",
  oki: "OKI",
  ricoh: "Ricoh",
  "konica-minolta": "Konica Minolta",
  utax: "Utax",
  panasonic: "Panasonic",
  toshiba: "Toshiba",
  dell: "Dell",
  philips: "Philips",
  ibm: "IBM",
  sharp: "Sharp",
  pantum: "Pantum",
};
const selectedBrand = brandMap[brandParam.toLowerCase()] || brandParam;
const brand = findBrand(brandParam);
const notFound = !brand;
if (notFound) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
  Astro.response.headers.set("X-Robots-Tag", "noindex, follow");
}
const cache = await getProductsCache().catch(() => ({ products: [] as any[], generated_at: "" }));
const brandPrinters = brand
  ? printerEntities(cache.products).filter((printer) => printer.brand.slug === brand.slug)
  : [];
const brandProductMap = new Map<string, any>();
brandPrinters.forEach((printer) => printer.products.forEach((product) => {
  const key = String(product.id || product.slug || product.sku || "");
  if (key) brandProductMap.set(key, product);
}));
const brandProducts = [...brandProductMap.values()];
const inStockProducts = brandProducts.filter((product) => product.stock_status === "instock").length;
const SEO_ORIGIN = 'https://www.tonerymaxim.sk';
const canonicalPath = brand ? `/tlaciarne/${brand.slug}` : Astro.url.pathname;
const title = notFound ? "Značka tlačiarne sa nenašla | ToneryMaxim.sk" : `Tonery a náplne do tlačiarní ${selectedBrand} | ToneryMaxim.sk`;
const description = notFound ? "Požadovaná značka tlačiarne sa v katalógu nenašla." : `Vyberte model tlačiarne ${selectedBrand} a nájdite kompatibilný alebo originálny toner, atrament či optický valec.`;
const noindex = notFound || ["tonerymaxim.info", "www.tonerymaxim.info"].includes(Astro.url.hostname);
const generatedDate = cache.generated_at && !Number.isNaN(new Date(cache.generated_at).getTime())
  ? new Intl.DateTimeFormat("sk-SK", { dateStyle: "medium" }).format(new Date(cache.generated_at))
  : "";
const faqItems = [
  {
    question: `Ako nájdem správnu náplň pre tlačiareň ${selectedBrand}?`,
    answer: `Vyberte presný model tlačiarne ${selectedBrand}. Na stránke modelu sa zobrazia iba produkty, pri ktorých je daný model uvedený medzi kompatibilnými zariadeniami. Pred objednaním porovnajte aj OEM označenie pôvodnej kazety.`,
  },
  {
    question: `Používajú podobne označené tlačiarne ${selectedBrand} rovnaký toner?`,
    answer: `Nie vždy. Rozdielne modelové rady alebo koncovky názvu môžu používať inú kazetu, preto treba porovnať celý názov modelu a OEM kód.`,
  },
  {
    question: `Sú pre tlačiarne ${selectedBrand} dostupné originálne aj kompatibilné náplne?`,
    answer: `Dostupný typ závisí od konkrétneho modelu. Pri každom produkte je uvedené, či ide o originálny, kompatibilný alebo renovovaný výrobok, jeho cena a aktuálna skladová dostupnosť.`,
  },
];
const jsonLd = [
  organizationJsonLd(SEO_ORIGIN),
  websiteJsonLd(SEO_ORIGIN),
  breadcrumbJsonLd(SEO_ORIGIN, [{ name: "Domov", path: "/" }, { name: "Tlačiarne", path: "/tlaciarne" }, { name: selectedBrand, path: canonicalPath }]),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${SEO_ORIGIN}${canonicalPath}#collection`,
    url: `${SEO_ORIGIN}${canonicalPath}`,
    name: `Tlačiarne ${selectedBrand} a vhodné náplne`,
    description,
    inLanguage: "sk-SK",
    isPartOf: { "@id": `${SEO_ORIGIN}/#website` },
    provider: { "@id": `${SEO_ORIGIN}/#organization` },
    ...(cache.generated_at ? { dateModified: cache.generated_at } : {}),
    about: { "@type": "Brand", name: selectedBrand },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: brandPrinters.length,
      itemListElement: brandPrinters.slice(0, 50).map((printer, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: printer.name,
        url: `${SEO_ORIGIN}/tlaciarne/${printer.brand.slug}/${printer.slug}`,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${SEO_ORIGIN}${canonicalPath}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title={title} description={description} canonical={`${SEO_ORIGIN}${canonicalPath}`} noindex={noindex} jsonLd={notFound ? undefined : jsonLd} />
  </head>
  <body class="printer-brand-page">
    <div class="page">
      <Header />

      <section class="tm-printer-mobile" aria-label={`Vybrať tlačiareň ${selectedBrand}`} data-printer-finder data-brand={selectedBrand}>
        <div class="tm-printer-mobile-topbar">
          <button class="tm-printer-mobile-menu-button" type="button" aria-label="Otvoriť menu" aria-expanded="false" data-tm-printer-menu-toggle>
            <span></span><span></span><span></span>
          </button>
          <a class="tm-printer-mobile-logo-link" href="/" aria-label="ToneryMaxim domov">
            <img src={mobileLogo.src} alt="ToneryMaxim" loading="eager" decoding="async" />
          </a>
          <a class="tm-printer-mobile-cart-link" href="/kosik" aria-label="Košík">
            <span aria-hidden="true">🛒</span>
            <strong data-cart-count>0</strong>
          </a>
        </div>

        <div class="tm-printer-mobile-drawer" data-tm-printer-menu aria-hidden="true">
          <div class="tm-printer-mobile-drawer-panel">
            <div class="tm-printer-mobile-drawer-head">
              <strong>Menu</strong>
              <button type="button" aria-label="Zavrieť menu" data-tm-printer-menu-close>×</button>
            </div>
            <section>
              <strong>Môj účet</strong>
              <a href="/prihlasenie">Prihlásenie</a>
              <a href="/ucet">Môj účet</a>
              <a href="/ucet/objednavky">Moje objednávky</a>
            </section>
            <section>
              <strong>Informácie</strong>
              <a href="/kontakt">Kontakt</a>
              <a href="/doprava-a-platba">Doprava a platba</a>
              <a href="/reklamacie">Reklamácie</a>
              <a href="/obchodne-podmienky">Obchodné podmienky</a>
              <a href="/ochrana-osobnych-udajov">Ochrana osobných údajov</a>
            </section>
            <section>
              <strong>Ponuka</strong>
              <a href="/tonery">Tonery</a>
              <a href="/atramentove-naplne">Atramentové náplne</a>
              <a href="/produkty?category=opticke-valce&search=optick%C3%A9%20valce">Valce</a>
              <a href="/produkty?category=ostatne-komponenty">Komponenty</a>
            </section>
          </div>
        </div>

        <main class="tm-printer-mobile-content tm-printer-mobile-content--brand">
          <a class="tm-printer-back" href="/tlaciarne">← Zmeniť značku</a>

          <div class="tm-printer-mobile-field tm-printer-mobile-field--brand">
            <span>Značka tlačiarne</span>
            <a href="/tlaciarne">{selectedBrand}</a>
          </div>

          <div class="tm-printer-mobile-field tm-printer-mobile-field--model">
            <label for="tm-printer-model-input">Model tlačiarne</label>
            <div class="tm-printer-model-control">
              <input id="tm-printer-model-input" type="search" data-printer-input placeholder="Začnite písať model" autocomplete="off" />
              <button type="button" data-clear-printer hidden aria-label="Vymazať model">×</button>
            </div>
            <div class="printer-suggestions tm-printer-model-suggestions" data-printer-suggestions hidden></div>
          </div>

          <section class="tm-printer-popular-mobile">
            <h1>Najčastejšie hľadané tlačiarne {selectedBrand}</h1>
            <div class="printer-popular-grid" data-printer-popular-grid></div>
          </section>

          <section class="tm-printer-mobile-help" aria-label="Pomoc s výberom">
            <h2>Radi vám pomôžeme</h2>
            <a href="tel:+421917859206" class="tm-printer-help-row"><span aria-hidden="true">☎</span><strong>+421 917 859 206</strong></a>
            <a href="mailto:info@tonerymaxim.sk" class="tm-printer-help-row"><span aria-hidden="true">✉</span><strong>info@tonerymaxim.sk</strong></a>
          </section>
          <div class="tm-printer-mobile-footer">© 2026 ToneryMaxim.sk</div>
        </main>

        <div class="tm-printer-bottom-search tm-smart-search-wrap">
          <form action="/produkty" method="get" data-smart-search>
            <span aria-hidden="true">⌕</span>
            <input type="search" name="s" data-smart-search-input placeholder="Hľadať toner alebo tlačiareň" aria-label="Hľadať toner alebo tlačiareň" />
            <button type="submit">Hľadať</button>
          </form>
        </div>
      </section>

      <main class="printer-finder-page printer-desktop-fallback" data-printer-finder data-brand={selectedBrand}>
        <section class="printer-finder-hero">
          <div class="wrap printer-finder-hero-inner">
            <div class="printer-finder-copy">
              <a class="printer-back-link" href="/">← späť na úvod</a>
              <p class="eyebrow">Vyhľadanie podľa tlačiarne</p>
              <h1>Farby a náplne do tlačiarne {selectedBrand}</h1>
              <p class="lead">Značku už máte vybranú. Vyberte model zo zoznamu alebo začnite písať názov tlačiarne.</p>
            </div>
            <div class="printer-brand-card" aria-label={`Vybraná značka ${selectedBrand}`}>
              <span>Značka</span>
              <strong>{selectedBrand}</strong>
            </div>
          </div>
        </section>

        <section class="printer-finder-panel-section">
          <div class="wrap">
            <div class="printer-finder-panel">
              <div class="printer-field printer-field-brand">
                <label>Značka tlačiarne</label>
                <button type="button" data-open-brand-list>{selectedBrand}</button>
              </div>

              <div class="printer-field printer-field-model">
                <label>Model tlačiarne</label>
                <div class="printer-model-control">
                  <input type="search" data-printer-input placeholder="Vyberte alebo začnite písať model" autocomplete="off" />
                  <button type="button" data-clear-printer hidden aria-label="Vymazať model">×</button>
                </div>
                <div class="printer-suggestions" data-printer-suggestions hidden></div>
              </div>

              <button class="printer-submit" type="button" data-printer-submit disabled>Vyhľadať náplň</button>
            </div>

            <div class="printer-helper-row">
              <div class="printer-helper" data-printer-status>Načítavam modely tlačiarní...</div>
              <div class="printer-helper-note">V rozbaľovacom zozname sú všetky modely pre vybranú značku.</div>
            </div>
          </div>
        </section>

        <section class="wrap printer-popular-section">
          <div class="printer-section-head">
            <div>
              <p class="eyebrow">Najvyhľadávanejšie modely</p>
              <h2>Najčastejšie hľadané tlačiarne {selectedBrand}</h2>
              <p class="section-lead">Rýchly výber pre zákazníkov, ktorí nechcú prechádzať celý zoznam modelov.</p>
            </div>
            <p data-printer-count></p>
          </div>

          <div class="printer-popular-grid" data-printer-popular-grid></div>
        </section>
      </main>

      {brandPrinters.length > 0 && (
        <section class="printer-geo-answer-section" aria-labelledby="printer-geo-answer-title">
          <div class="wrap">
            <article class="printer-geo-answer-card">
              <p class="eyebrow">Aktuálne údaje z katalógu</p>
              <h2 id="printer-geo-answer-title">Ako vybrať toner alebo náplň pre tlačiareň {selectedBrand}</h2>
              <p>
                Pre značku {selectedBrand} evidujeme <strong>{brandPrinters.length} modelov tlačiarní</strong> s priradenými produktmi.
                V týchto modeloch je spolu <strong>{brandProducts.length} jedinečných tonerov a náplní</strong>, z ktorých je aktuálne <strong>{inStockProducts} skladom</strong>.
                Najspoľahlivejší výber získate podľa celého názvu modelu a OEM označenia pôvodnej kazety.
              </p>
              {generatedDate && <small>Produktové údaje aktualizované: {generatedDate}</small>}
            </article>

            <div class="printer-geo-faq">
              <h2>Časté otázky k tlačiarňam {selectedBrand}</h2>
              {faqItems.map((item) => (
                <details>
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      )}

      {brandPrinters.length > 0 && (
        <section class="printer-model-directory-section">
          <div class="wrap">
            <details class="printer-model-directory">
              <summary>Všetky modely tlačiarní {selectedBrand} ({brandPrinters.length})</summary>
              <nav aria-label={`Modely tlačiarní ${selectedBrand}`}>
                {brandPrinters.map((printer) => (
                  <a href={`/tlaciarne/${printer.brand.slug}/${printer.slug}`}>
                    <span>{printer.name}</span><small>{printer.products.length} produktov</small>
                  </a>
                ))}
              </nav>
            </details>
          </div>
        </section>
      )}

      <dialog class="printer-brand-modal" data-brand-modal>
        <div class="printer-brand-modal-card">
          <button class="printer-brand-modal-close" type="button" data-close-brand-modal aria-label="Zavrieť">×</button>
          <h2>Vyberte značku tlačiarne</h2>
          <p>Po kliknutí sa otvorí stránka pre vybranú značku.</p>
          <div class="printer-brand-grid" data-brand-grid></div>
        </div>
      </dialog>

      <Footer showTrust={false} />
      <FloatingAdvisor />
    </div>

    <script>
      import "../../scripts/printer-finder.js";
      import "../../scripts/smart-search.js";

      const menuToggle = document.querySelector('[data-tm-printer-menu-toggle]');
      const menu = document.querySelector('[data-tm-printer-menu]');
      const menuClose = document.querySelector('[data-tm-printer-menu-close]');
      function setMenu(open: boolean) {
        if (!menu || !menuToggle) return;
        menu.classList.toggle('is-open', open);
        menu.setAttribute('aria-hidden', String(!open));
        menuToggle.setAttribute('aria-expanded', String(open));
        document.documentElement.classList.toggle('tm-menu-open', open);
      }
      menuToggle?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
      menuClose?.addEventListener('click', () => setMenu(false));
      menu?.addEventListener('click', (event) => { if (event.target === menu) setMenu(false); });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });
    </script>
  </body>
</html>
