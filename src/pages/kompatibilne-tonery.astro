---
import SeoCatalogPage from "../components/SeoCatalogPage.astro";
import { getProductsCache } from "../lib/tm-products-cache";
import { catalogStats, landingProducts, topBrandLinks, topOemLinks, topPrinterLinks } from "../lib/seo-catalog";

const cache = await getProductsCache().catch(() => ({ products: [] as any[], generated_at: "" }));
const products = landingProducts(cache.products, "compatible");
const stats = catalogStats(products);
---

<SeoCatalogPage
  title="Kompatibilné tonery do tlačiarní | ToneryMaxim.sk"
  description="Kompatibilné tonery pre HP, Brother, Canon, Epson, Xerox a ďalšie tlačiarne. Aktuálne ceny, skladová dostupnosť a overené modely tlačiarní."
  canonicalPath="/kompatibilne-tonery"
  eyebrow="Cenovo výhodná alternatíva"
  heading="Kompatibilné tonery"
  intro="Kompatibilné tonery sú určené pre rovnaké modely tlačiarní ako zodpovedajúce originálne kazety. Pri každom produkte nájdete označenie, farbu, výťažnosť a zoznam podporovaných tlačiarní."
  products={products}
  answer={`V ponuke je ${stats.total} kompatibilných produktov s platnou cenou, z toho ${stats.inStock} je aktuálne skladom. Kompatibilný toner vyberte podľa OEM označenia a následne potvrďte presný model tlačiarne v detaile produktu.`}
  generatedAt={cache.generated_at}
  breadcrumbs={[{ name: "Kompatibilné tonery", path: "/kompatibilne-tonery" }]}
  entityFacts={["Iba kompatibilné produkty", "Cena s DPH", "Záruka 24 mesiacov"]}
  relatedLinks={[
    { href: "/tonery", label: "Všetky tonery" },
    { href: "/originalne-tonery", label: "Originálne tonery" },
    { href: "/renovovane-tonery", label: "Renovované tonery" },
    { href: "/tlaciarne", label: "Vybrať podľa tlačiarne" },
  ]}
  faq={[
    { question: "Bude kompatibilný toner fungovať v mojej tlačiarni?", answer: "Áno, ak je presný model vašej tlačiarne uvedený v kompatibilite konkrétneho produktu. Model odporúčame skontrolovať priamo na štítku tlačiarne." },
    { question: "Majú kompatibilné tonery záruku?", answer: "Na kompatibilné tonery ToneryMaxim poskytujeme 24-mesačnú záruku. Presné podmienky sú uvedené v reklamačných podmienkach." },
  ]}
  contentSections={[
    {
      heading: "Kedy je kompatibilný toner správna voľba",
      paragraphs: ["Kompatibilný toner je určený najmä pre zákazníkov, ktorí chcú znížiť cenu tlače a súčasne zachovať presnú kompatibilitu s tlačiarňou. Rozhodujúce nie je iba podobné číslo, ale celé označenie kazety a konkrétny model zariadenia."],
      bullets: ["Vyberajte podľa presného OEM kódu.", "Pri XL variante skontrolujte aj podporu tlačiarne.", "Pri farebnej tlači overte označenie Black, Cyan, Magenta alebo Yellow."],
    },
    {
      heading: "Čo kontrolujeme v katalógu",
      paragraphs: ["Landing page zobrazuje iba produkty, ktoré sú v produktovej databáze označené ako kompatibilné a majú platný názov, slug a cenu. Skladový stav, farba, výťažnosť a modely tlačiarní sa preberajú z aktuálnej produktovej cache."],
    },
  ]}
  linkGroups={[
    { heading: "Kompatibilné produkty podľa značky", intro: "Výber podľa značky tlačiarne zúži ponuku na relevantné produktové rodiny.", links: topBrandLinks(products, 8) },
    { heading: "Modely s kompatibilnou alternatívou", intro: "Pri každom modeli zobrazujeme iba produkty, ktoré ho majú uvedený v kompatibilite.", links: topPrinterLinks(products, 8) },
    { heading: "Najčastejšie OEM kódy", intro: "Porovnajte kompatibilné kazety podľa označenia pôvodného produktu.", links: topOemLinks(products, 8) },
  ]}
  schemaEntities={[{ name: "Kompatibilný toner" }, { name: "Alternatívna náplň do tlačiarne" }]}
/>
