---
import "../styles/global.css";
import "../styles/products-catalog.css";
import Header from "../components/Header.astro";
import "../styles/footer.css";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import SeoHead from "../components/SeoHead.astro";
import CatalogInitialRows from "../components/CatalogInitialRows.astro";
import { breadcrumbJsonLd } from "../lib/seo";
import { filterProducts, getProductsCache } from "../lib/tm-products-cache";

const query = String(Astro.url.searchParams.get("s") || Astro.url.searchParams.get("search") || "").trim();
const SEO_ORIGIN = 'https://www.tonerymaxim.sk';
const title = query ? `${query} – tonery a náplne | ToneryMaxim.sk` : "Tonery a náplne do tlačiarní | ToneryMaxim.sk";
const description = query ? `Výsledky pre ${query}. Porovnajte kompatibilné, originálne a renovované tonery a náplne.` : "Vyhľadajte toner alebo náplň podľa označenia, značky či modelu tlačiarne. Kompatibilné, originálne a renovované produkty na jednom mieste.";
const noindex = ["tonerymaxim.info", "www.tonerymaxim.info"].includes(Astro.url.hostname) || Astro.url.searchParams.size > 0;

const clean = (name: string) => String(Astro.url.searchParams.get(name) || "").trim();
const initialPage = Math.max(1, Number(clean("page") || 1));
const initialFilters = {
  search: query,
  printer: clean("printer"),
  brand: clean("brand"),
  category: clean("category"),
  type: clean("type"),
  color: clean("color"),
  stock: clean("stock"),
};

let initialCatalog: any = null;
try {
  const cache = await getProductsCache();
  const filtered = filterProducts(cache.products, initialFilters);
  const start = (initialPage - 1) * 12;
  const products = filtered.slice(start, start + 12).map((product: any) => ({
    id: product.id,
    sku: product.sku || "",
    name: product.name || "",
    slug: product.slug || "",
    price: product.price,
    regular_price: product.regular_price,
    sale_price: product.sale_price,
    stock_quantity: product.stock_quantity ?? null,
    stock_status: product.stock_status || "",
    image: product.image || "",
    images: Array.isArray(product.images) ? product.images.slice(0, 1) : [],
    detail_url: product.detail_url || (product.slug ? `/produkt/${product.slug}` : `/produkt/${product.id}`),
    product_type_key: product.product_type_key || "product",
    product_type_label: product.product_type_label || "PRODUKT",
    product_type_detail_label: product.product_type_detail_label || product.product_type_label || "Spotrebný materiál",
    product_type_note: product.product_type_note || "Spotrebný materiál",
    product_type_icon: product.product_type_icon || "dot",
    color: product.color || product.farba || "",
    farba: product.farba || product.color || "",
    capacity: product.capacity || product.kapacita || product.yield || product.page_yield || "",
    kapacita: product.kapacita || product.capacity || product.yield || product.page_yield || "",
    yield: product.yield || product.capacity || product.kapacita || product.page_yield || "",
    page_yield: product.page_yield || product.yield || product.capacity || product.kapacita || "",
    warranty: product.warranty || product.zaruka || "24 mesiacov",
    zaruka: product.zaruka || product.warranty || "24 mesiacov",
    compatible_printers: Array.isArray(product.compatible_printers) ? product.compatible_printers.slice(0, 80) : [],
    printers: Array.isArray(product.printers) ? product.printers.slice(0, 80) : Array.isArray(product.compatible_printers) ? product.compatible_printers.slice(0, 80) : [],
    categories: Array.isArray(product.categories) ? product.categories : [],
    attributes: Array.isArray(product.attributes) ? product.attributes : [],
    attributes_all: Array.isArray(product.attributes_all) ? product.attributes_all : Array.isArray(product.attributes) ? product.attributes : [],
  }));
  initialCatalog = {
    ok: true,
    source: "server-products-cache",
    page: initialPage,
    per_page: 12,
    count: products.length,
    total: filtered.length,
    total_pages: Math.max(1, Math.ceil(filtered.length / 12)),
    filters: initialFilters,
    products,
  };
} catch {
  initialCatalog = null;
}

const initialCatalogJson = JSON.stringify(initialCatalog)
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title={title} description={description} noindex={noindex} canonical={`${SEO_ORIGIN}/produkty`} jsonLd={breadcrumbJsonLd(SEO_ORIGIN, [{ name: "Domov", path: "/" }, { name: "Produkty", path: "/produkty" }])} />
  </head>

  <body>
    <div class="page">
      <Header />

      <main class="catalog-page">
        <section class="catalog-hero">
          <div class="wrap catalog-hero-inner">
            <div>
              <p class="eyebrow">Tonery a náplne</p>
              <h1>{query ? <>Výsledky pre „{query}“</> : "Vyberte správnu náplň"}</h1>
              <p class="lead">{initialCatalog ? `${initialCatalog.total.toLocaleString("sk-SK")} nájdených produktov` : "Vyhľadajte podľa modelu tlačiarne alebo označenia náplne."}</p>
            </div>

            <form data-catalog-form class="catalog-search" data-smart-search>
              <input
                type="search"
                data-catalog-search
                data-smart-search-input
                placeholder="Napr. HP M110w, W1420A, CE285A, TN-2421"
              />
              <button type="submit">Hľadať</button>
            </form>
          </div>
        </section>

        <section class="catalog-content">
          <div class="wrap catalog-layout">
            <aside class="catalog-filter" data-catalog-filter>
              <h2>Značky</h2>
              <button type="button" data-filter="brand" data-filter-value="" class="is-active">Všetky značky</button>
              <button type="button" data-filter="brand" data-filter-value="HP">HP</button>
              <button type="button" data-filter="brand" data-filter-value="Canon">Canon</button>
              <button type="button" data-filter="brand" data-filter-value="Brother">Brother</button>
              <button type="button" data-toggle-more-brands>+ ostatné značky</button>
              <div class="catalog-more-brands" data-more-brands hidden>
                <button type="button" data-filter="brand" data-filter-value="Epson">Epson</button>
                <button type="button" data-filter="brand" data-filter-value="Xerox">Xerox</button>
                <button type="button" data-filter="brand" data-filter-value="Samsung">Samsung</button>
                <button type="button" data-filter="brand" data-filter-value="Lexmark">Lexmark</button>
                <button type="button" data-filter="brand" data-filter-value="Kyocera">Kyocera</button>
                <button type="button" data-filter="brand" data-filter-value="OKI">OKI</button>
                <button type="button" data-filter="brand" data-filter-value="Ricoh">Ricoh</button>
                <button type="button" data-filter="brand" data-filter-value="Utax">Utax</button>
                <button type="button" data-filter="brand" data-filter-value="Toshiba">Toshiba</button>
              </div>

              <div class="filter-divider"></div>

              <h2>Kategórie</h2>
              <button type="button" data-filter="category" data-filter-value="" class="is-active">Všetky kategórie</button>
              <button type="button" data-filter="category" data-filter-value="tonery">Tonery</button>
              <button type="button" data-filter="category" data-filter-value="atramentove-naplne">Atramentové náplne</button>
              <button type="button" data-filter="category" data-filter-value="opticke-valce">Optické valce</button>
              <button type="button" data-filter="category" data-filter-value="ostatne-komponenty">Ostatné komponenty</button>

              <div class="filter-divider"></div>

              <h2>Farba</h2>
              <button type="button" data-filter="color" data-filter-value="" class="is-active">Všetky farby</button>
              <button type="button" data-filter="color" data-filter-value="cierna"><span class="filter-dot filter-dot-black"></span> Čierna</button>
              <button type="button" data-filter="color" data-filter-value="cyan"><span class="filter-dot filter-dot-cyan"></span> Cyan</button>
              <button type="button" data-filter="color" data-filter-value="purpurova"><span class="filter-dot filter-dot-magenta"></span> Purpurová</button>
              <button type="button" data-filter="color" data-filter-value="yellow"><span class="filter-dot filter-dot-yellow"></span> Yellow</button>
              <button type="button" data-filter="color" data-filter-value="multipack"><span class="filter-dot filter-dot-multi"></span> Multipack</button>

              <div class="filter-divider"></div>

              <h2>Skladom</h2>
              <button type="button" data-filter="stock" data-filter-value="" class="is-active">Všetka dostupnosť</button>
              <button type="button" data-filter="stock" data-filter-value="instock">Skladom</button>
              <button type="button" data-filter="stock" data-filter-value="10plus">Viac ako 10 ks</button>
            </aside>

            <div class="catalog-main">
              <div class="catalog-quick-filters" aria-label="Rýchle filtre produktov">
                <button type="button" data-filter="type" data-filter-value="" class="quick-filter quick-filter-all is-active">Všetky</button>
                <button type="button" data-filter="type" data-filter-value="compatible" class="quick-filter quick-filter-compatible"><span></span> Kompatibilné</button>
                <button type="button" data-filter="type" data-filter-value="original" class="quick-filter quick-filter-original"><span></span> Originálne</button>
                <button type="button" data-filter="type" data-filter-value="renovated" class="quick-filter quick-filter-renovated"><span></span> Renovované</button>
                <button type="button" data-filter="stock" data-filter-value="instock" class="quick-filter quick-filter-stock">✓ Skladom</button>
              </div>

              <div class="catalog-mobile-query" data-catalog-mobile-query hidden></div>

              <div class="catalog-toolbar">
                <div>
                  <div data-catalog-status>{initialCatalog ? `Načítané produkty: ${initialCatalog.count}` : "Načítavam produkty..."}</div>
                  <div class="catalog-active-filters" data-active-filters></div>
                </div>
                <div class="type-legend">
                  <span class="legend-item compatible">Kompatibilný</span>
                  <span class="legend-item original">Originál</span>
                  <span class="legend-item renovated">Renovovaný</span>
                </div>
              </div>

              <div data-catalog-grid class="catalog-list">
                {initialCatalog && <CatalogInitialRows products={initialCatalog.products} />}
              </div>

              <div class="catalog-pagination">
                <button type="button" data-prev-page>Predchádzajúce</button>
                <span data-page-info>Strana 1</span>
                <button type="button" data-next-page>Ďalšie</button>
              </div>
            </div>
          </div>
        </section>
      </main>

      <section class="catalog-mobile-help-area" aria-label="Pomoc s výberom správnej náplne">
        <div class="catalog-mobile-help-card" aria-label="Radi vám pomôžeme">
          <h2>Radi vám pomôžeme</h2>
          <a class="catalog-mobile-help-row" href="tel:+421917859206" aria-label="Zavolať +421 917 859 206">
            <span aria-hidden="true" class="catalog-mobile-help-icon catalog-mobile-help-icon-phone">
              <svg viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.3 1.3.4 2.6.6 4 .6.7 0 1.2.5 1.2 1.2v3.5c0 .7-.5 1.2-1.2 1.2C10.7 21.4 2.6 13.3 2.6 3.4c0-.7.5-1.2 1.2-1.2h3.5c.7 0 1.2.5 1.2 1.2 0 1.4.2 2.7.6 4 .1.4 0 .9-.3 1.2l-2.2 2.2Z" fill="currentColor"/></svg>
            </span>
            <strong>+421 917 859 206</strong>
          </a>
          <a class="catalog-mobile-help-row" href="mailto:info@tonerymaxim.sk" aria-label="Napísať e-mail info@tonerymaxim.sk">
            <span aria-hidden="true" class="catalog-mobile-help-icon catalog-mobile-help-icon-mail">
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2Zm0 3.1v8.7l5.6-4.4L4 8.1Zm16 0-5.6 4.3 5.6 4.4V8.1Zm-14.2-1 6.2 4.8 6.2-4.8H5.8Zm6.2 7.3-1.1-.9-5.5 4.3h13.2l-5.5-4.3-1.1.9Z" fill="currentColor"/></svg>
            </span>
            <strong>info@tonerymaxim.sk</strong>
          </a>
        </div>
      </section>

      <Footer showTrust={false} />

      <div class="catalog-mobile-bottom-search tm-smart-search-wrap" data-catalog-bottom-search>
        <form action="/produkty" method="get" data-smart-search>
          <span aria-hidden="true">⌕</span>
          <input type="search" name="s" data-smart-search-input data-catalog-bottom-search-input placeholder="Hľadať toner alebo tlačiareň" aria-label="Hľadať toner alebo tlačiareň" />
          <button type="submit">Hľadať</button>
        </form>
      </div>

      <FloatingAdvisor />
    </div>

    <script is:inline id="tm-catalog-initial-data" type="application/json" set:html={initialCatalogJson}></script>
    <script>
      import "../scripts/catalog.js";
      import "../scripts/smart-search.js";
    </script>
    <script>
      const bottomSearchInput = document.querySelector<HTMLInputElement>('[data-catalog-bottom-search-input]');
      if (bottomSearchInput) {
        const params = new URLSearchParams(window.location.search);
        bottomSearchInput.value = params.get('s') || params.get('search') || params.get('q') || '';
      }
      window.tmInitSmartSearch?.();
      document.addEventListener('DOMContentLoaded', () => window.tmInitSmartSearch?.());
    </script>
  </body>
</html>
