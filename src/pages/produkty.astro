---
import "../styles/global.css";
import "../styles/products-catalog.css";
import Header from "../components/Header.astro";
import "../styles/footer.css";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";

const title = "Produkty | ToneryMaxim.sk";
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <div class="page">
      <Header />

      <main class="catalog-page">
        <section class="catalog-hero">
          <div class="wrap catalog-hero-inner">
            <div>
              <p class="eyebrow">Tonery a náplne</p>
              <h1>Nájdite správny produkt pre vašu tlačiareň</h1>
              <p class="lead">Prehľadný riadkový výpis s jasným rozlíšením originálneho, kompatibilného a renovovaného spotrebného materiálu.</p>
            </div>

            <form data-catalog-form class="catalog-search" data-smart-search>
              <input
                type="search"
                data-catalog-search
                data-smart-search-input
                placeholder="Napr. HP M110w, W1420A, CE285A, TN-2421"
              />
              <button type="submit">Hľadať</button>
            </form>
          </div>
        </section>

        <section class="catalog-content">
          <div class="wrap catalog-layout">
            <aside class="catalog-filter" data-catalog-filter>
              <h2>Značky</h2>
              <button type="button" data-filter="brand" data-filter-value="" class="is-active">Všetky značky</button>
              <button type="button" data-filter="brand" data-filter-value="HP">HP</button>
              <button type="button" data-filter="brand" data-filter-value="Canon">Canon</button>
              <button type="button" data-filter="brand" data-filter-value="Brother">Brother</button>
              <button type="button" data-toggle-more-brands>+ ostatné značky</button>
              <div class="catalog-more-brands" data-more-brands hidden>
                <button type="button" data-filter="brand" data-filter-value="Epson">Epson</button>
                <button type="button" data-filter="brand" data-filter-value="Xerox">Xerox</button>
                <button type="button" data-filter="brand" data-filter-value="Samsung">Samsung</button>
                <button type="button" data-filter="brand" data-filter-value="Lexmark">Lexmark</button>
                <button type="button" data-filter="brand" data-filter-value="Kyocera">Kyocera</button>
                <button type="button" data-filter="brand" data-filter-value="OKI">OKI</button>
                <button type="button" data-filter="brand" data-filter-value="Ricoh">Ricoh</button>
                <button type="button" data-filter="brand" data-filter-value="Utax">Utax</button>
                <button type="button" data-filter="brand" data-filter-value="Toshiba">Toshiba</button>
              </div>

              <div class="filter-divider"></div>

              <h2>Kategórie</h2>
              <button type="button" data-filter="category" data-filter-value="" class="is-active">Všetky kategórie</button>
              <button type="button" data-filter="category" data-filter-value="tonery">Tonery</button>
              <button type="button" data-filter="category" data-filter-value="atramentove-naplne">Atramentové náplne</button>
              <button type="button" data-filter="category" data-filter-value="opticke-valce">Optické valce</button>
              <button type="button" data-filter="category" data-filter-value="ostatne-komponenty">Ostatné komponenty</button>

              <div class="filter-divider"></div>

              <h2>Farba</h2>
              <button type="button" data-filter="color" data-filter-value="" class="is-active">Všetky farby</button>
              <button type="button" data-filter="color" data-filter-value="cierna"><span class="filter-dot filter-dot-black"></span> Čierna</button>
              <button type="button" data-filter="color" data-filter-value="cyan"><span class="filter-dot filter-dot-cyan"></span> Cyan</button>
              <button type="button" data-filter="color" data-filter-value="purpurova"><span class="filter-dot filter-dot-magenta"></span> Purpurová</button>
              <button type="button" data-filter="color" data-filter-value="yellow"><span class="filter-dot filter-dot-yellow"></span> Yellow</button>
              <button type="button" data-filter="color" data-filter-value="multipack"><span class="filter-dot filter-dot-multi"></span> Multipack</button>

              <div class="filter-divider"></div>

              <h2>Skladom</h2>
              <button type="button" data-filter="stock" data-filter-value="" class="is-active">Všetka dostupnosť</button>
              <button type="button" data-filter="stock" data-filter-value="instock">Skladom</button>
              <button type="button" data-filter="stock" data-filter-value="10plus">Viac ako 10 ks</button>
            </aside>

            <div class="catalog-main">
              <div class="catalog-quick-filters" aria-label="Rýchle filtre produktov">
                <button type="button" data-filter="type" data-filter-value="" class="quick-filter quick-filter-all is-active">Všetky</button>
                <button type="button" data-filter="type" data-filter-value="compatible" class="quick-filter quick-filter-compatible"><span></span> Kompatibilné</button>
                <button type="button" data-filter="type" data-filter-value="original" class="quick-filter quick-filter-original"><span></span> Originálne</button>
                <button type="button" data-filter="type" data-filter-value="renovated" class="quick-filter quick-filter-renovated"><span></span> Renovované</button>
                <button type="button" data-filter="stock" data-filter-value="instock" class="quick-filter quick-filter-stock">✓ Skladom</button>
              </div>

              <div class="catalog-mobile-query" data-catalog-mobile-query hidden></div>

              <div class="catalog-toolbar">
                <div>
                  <div data-catalog-status>Načítavam produkty...</div>
                  <div class="catalog-active-filters" data-active-filters></div>
                </div>
                <div class="type-legend">
                  <span class="legend-item compatible">Kompatibilný</span>
                  <span class="legend-item original">Originál</span>
                  <span class="legend-item renovated">Renovovaný</span>
                </div>
              </div>

              <div data-catalog-grid class="catalog-list"></div>

              <div class="catalog-pagination">
                <button type="button" data-prev-page>Predchádzajúce</button>
                <span data-page-info>Strana 1</span>
                <button type="button" data-next-page>Ďalšie</button>
              </div>
            </div>
          </div>
        </section>
      </main>

      <section class="catalog-mobile-help-area" aria-label="Pomoc s výberom správnej náplne">
        <div class="catalog-mobile-help-card">
          <p class="catalog-mobile-help-kicker">Potrebujete poradiť?</p>
          <h2>Pomôžeme vám vybrať správnu náplň ešte pred objednávkou.</h2>
          <div class="catalog-mobile-help-contacts">
            <a href="tel:+421910123456"><span aria-hidden="true">☎</span> +421 910 123 456</a>
            <a href="mailto:info@tonerymaxim.sk"><span aria-hidden="true">✉</span> info@tonerymaxim.sk</a>
          </div>
        </div>
      </section>

      <Footer showTrust={false} />

      <div class="catalog-mobile-bottom-search tm-smart-search-wrap" data-catalog-bottom-search>
        <form action="/produkty" method="get" data-smart-search>
          <span aria-hidden="true">⌕</span>
          <input type="search" name="s" data-smart-search-input data-catalog-bottom-search-input placeholder="Hľadať toner alebo tlačiareň" aria-label="Hľadať toner alebo tlačiareň" />
          <button type="submit">Hľadať</button>
        </form>
      </div>

      <FloatingAdvisor />
    </div>

    <script>
      import "../scripts/catalog.js";
      import "../scripts/smart-search.js";
      window.TMInitSmartSearch?.();
    </script>
    <script>
      const bottomSearchInput = document.querySelector('[data-catalog-bottom-search-input]');
      if (bottomSearchInput) {
        const params = new URLSearchParams(window.location.search);
        bottomSearchInput.value = params.get('s') || params.get('search') || params.get('q') || '';
      }
    </script>
  </body>
</html>
