---
import '../styles/global.css'; import '../styles/footer.css'; import '../styles/newsletter.css'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import FloatingAdvisor from '../components/FloatingAdvisor.astro'; import SeoHead from '../components/SeoHead.astro';
---
<!doctype html><html lang="sk"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><SeoHead title="Newsletter – akcie a výhody | ToneryMaxim.sk" description="Prihláste sa na novinky ToneryMaxim.sk. Akcie, zľavy, nové produkty a užitočné informácie pre vašu tlačiareň." canonical="https://www.tonerymaxim.sk/newsletter"/></head><body><div class="page"><Header/><main class="newsletter-wrap"><section class="newsletter-hero"><span class="newsletter-kicker">ToneryMaxim newsletter</span><h1>Nezmeškajte lepšie ceny, akcie a výhody</h1><p>Občas vám pošleme to, čo môže ušetriť peniaze alebo uľahčiť nákup – bez zbytočných e-mailov.</p></section><section class="newsletter-grid"><div class="newsletter-benefits"><h2>Čo získate</h2><div><article><b>€</b><span><strong>Akcie a zľavy</strong><small>Aktuálne cenové výhody a výhodné nákupy.</small></span></article><article><b>+</b><span><strong>Nové produkty</strong><small>Nové tonery, náplne a ďalší sortiment.</small></span></article><article><b>★</b><span><strong>Výhody pre zákazníkov</strong><small>Vernostné odmeny, služby a nové možnosti úspory.</small></span></article><article><b>i</b><span><strong>Užitočné informácie</strong><small>Dôležité novinky o tlačiarňach, kompatibilite a firmvéri.</small></span></article></div></div><div class="newsletter-card"><h2>Chcem dostávať novinky</h2><p>Zadajte e-mail a odber potvrďte kliknutím v správe, ktorú vám pošleme.</p><form data-newsletter-subscribe><label>E-mailová adresa<input type="email" name="email" autocomplete="email" required placeholder="vas@email.sk"/></label><label class="newsletter-consent"><input type="checkbox" required/><span>Súhlasím so zasielaním obchodných a marketingových informácií ToneryMaxim.sk. Súhlas môžem kedykoľvek odvolať. <a href="/ochrana-osobnych-udajov">Viac o ochrane osobných údajov</a>.</span></label><button class="tm-btn" type="submit">Prihlásiť na odber</button><p class="newsletter-message" data-newsletter-message hidden></p></form><small class="newsletter-note">Žiadny spam. Z odberu sa môžete kedykoľvek jednoducho odhlásiť.</small></div></section><section class="newsletter-unsubscribe"><div><span class="newsletter-kicker">Odhlásenie</span><h2>Nechcete už newsletter dostávať?</h2><p>Zadajte e-mailovú adresu. Ak je prihlásená na odber, pošleme na ňu bezpečný odhlasovací odkaz. Prihlásenie do účtu nie je potrebné.</p></div><form data-newsletter-unsubscribe><input type="email" name="email" autocomplete="email" required placeholder="vas@email.sk"/><button type="submit">Odhlásiť z odberu</button><p class="newsletter-message" data-newsletter-message hidden></p></form></section></main><Footer/><FloatingAdvisor/></div><script>async function bind(sel:string,url:string,source?:string){document.querySelectorAll<HTMLFormElement>(sel).forEach(form=>form.addEventListener('submit',async(e)=>{e.preventDefault();const btn=form.querySelector<HTMLButtonElement>('button')!,msg=form.querySelector<HTMLElement>('[data-newsletter-message]')!;btn.disabled=true;msg.hidden=true;try{const email=String(new FormData(form).get('email')||''),r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,source})}),d=await r.json();msg.textContent=d.message||d.error||'Hotovo.';msg.className=`newsletter-message ${r.ok?'is-success':'is-error'}`;msg.hidden=false;if(r.ok&&url.includes('subscribe'))form.reset()}catch{msg.textContent='Požiadavku sa nepodarilo odoslať. Skúste to neskôr.';msg.className='newsletter-message is-error';msg.hidden=false}finally{btn.disabled=false}}))}bind('[data-newsletter-subscribe]','/api/newsletter/subscribe','newsletter-page');bind('[data-newsletter-unsubscribe]','/api/newsletter/unsubscribe');</script></body></html>
