---
export const prerender = false;

import "../../styles/global.css";
import "../../styles/footer.css";
import "../../styles/product-detail.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FloatingAdvisor from "../../components/FloatingAdvisor.astro";
import SeoHead from "../../components/SeoHead.astro";
import { getProductFromCache, stripHtml } from "../../lib/tm-products-cache";
import { breadcrumbJsonLd, organizationJsonLd, productDescription, productJsonLd, absoluteUrl, websiteJsonLd } from "../../lib/seo";
import {
  printerBrandForName,
  printerLinksFromNames,
  productOemCodes,
  validIndexableProduct,
} from "../../lib/seo-catalog";

const { slug } = Astro.params;
const lookup = await getProductFromCache({ slug, id: slug }).catch(() => null);
const cache = lookup?.cache || null;
const product = lookup?.product || null;
if (!product) {
  return new Response(`<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Produkt sa nenašiel | ToneryMaxim.sk</title>
    <style>
      body{margin:0;background:#f4f8fc;color:#071b3a;font-family:Arial,sans-serif}
      main{max-width:720px;margin:12vh auto;padding:40px;background:#fff;border-radius:24px;box-shadow:0 18px 60px rgba(7,27,58,.12)}
      h1{font-size:clamp(30px,5vw,52px);margin:0 0 16px}
      p{font-size:18px;line-height:1.6;color:#526172}
      a{display:inline-block;margin-top:12px;padding:14px 22px;border-radius:999px;background:#071b3a;color:#fff;text-decoration:none;font-weight:800}
    </style>
  </head>
  <body><main><h1>Produkt sa nenašiel</h1><p>Produkt už nie je dostupný alebo bola adresa zadaná nesprávne. Vyhľadajte náplň podľa označenia alebo modelu tlačiarne.</p><a href="/produkty">Prejsť na vyhľadávanie produktov</a></main></body>
</html>`, {
    status: 404,
    headers: {
      'Content-Type': 'text/html; charset=utf-8',
      'Cache-Control': 'no-store',
      'X-Robots-Tag': 'noindex, nofollow',
    },
  });
}
const productTitleParts = [
  String(product.name || '').trim(),
  String(product.color || '').trim(),
  String(product.sku || '').trim(),
].filter(Boolean);
const baseProductTitle = productTitleParts.join(' – ');
const duplicateTitleCount = cache?.products?.filter((item: any) => {
  const itemTitle = [
    String(item.name || '').trim(),
    String(item.color || '').trim(),
    String(item.sku || '').trim(),
  ].filter(Boolean).join(' – ');
  return itemTitle === baseProductTitle;
}).length || 0;
const uniqueProductTitle = duplicateTitleCount > 1
  ? `${baseProductTitle} – ID ${product.id}`
  : baseProductTitle;
const SEO_ORIGIN = 'https://www.tonerymaxim.sk';
const title = `${uniqueProductTitle} | ToneryMaxim.sk`;
const description = productDescription(product);
const canonical = `${SEO_ORIGIN}/produkt/${encodeURIComponent(product.slug)}`;
const image = absoluteUrl(SEO_ORIGIN, product.image || product.images?.[0] || '/favicon.svg');
const noindex = ["tonerymaxim.info", "www.tonerymaxim.info"].includes(Astro.url.hostname)
  || !validIndexableProduct(product);
const inStock = product.stock_status === 'instock' && Number(product.stock_quantity ?? 1) > 0;
const price = new Intl.NumberFormat('sk-SK', { style: 'currency', currency: 'EUR' }).format(Number(product.price || 0));
const printers = Array.isArray(product.compatible_printers) ? product.compatible_printers : [];
const plainDescription = stripHtml(product.description_html || product.short_description_html || product.description || '');
const productSafetyRows = [
  ['Výrobca produktu', product.manufacturer_name],
  ['Poštová adresa výrobcu', product.manufacturer_address],
  ['Elektronický kontakt výrobcu', product.manufacturer_contact],
  ['Zodpovedný hospodársky subjekt v EÚ', product.eu_responsible_person],
  ['Bezpečnostné informácie a upozornenia', product.safety_information],
].filter(([, value]) => String(value || '').trim());
const initialProductJson = JSON.stringify(product)
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
const printerEntityLinks = printerLinksFromNames(cache?.products || [], printers, 16);
const oemEntityLinks = productOemCodes(product).map((code) => ({
  href: `/oem/${code.toLowerCase()}`,
  label: code,
}));
const brandEntityLinks = [...new Map(
  printers
    .map((printer: string) => printerBrandForName(printer))
    .filter(Boolean)
    .map((brand: any) => [brand.slug, {
      href: `/znacky/${brand.slug}`,
      label: `Produkty pre ${brand.name}`,
    }]),
).values()];
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title={title} description={description} canonical={canonical} image={image} type="product" noindex={noindex} jsonLd={[organizationJsonLd(SEO_ORIGIN), websiteJsonLd(SEO_ORIGIN), productJsonLd(SEO_ORIGIN, product), breadcrumbJsonLd(SEO_ORIGIN, [{ name: "Domov", path: "/" }, { name: "Produkty", path: "/produkty" }, { name: product.name, path: `/produkt/${product.slug}` }])]} />
  </head>

  <body class="product-detail-body">
    <div class="page">
      <Header />

      <a class="product-mobile-search-shortcut" href="/produkty" aria-label="Hľadať toner alebo tlačiareň">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
      </a>

      <main class="product-detail-page" data-product-slug={slug}>
        <script id="tm-product-initial-data" type="application/json" is:inline set:html={initialProductJson}></script>
        <div class="detail-wrap">
          <a class="back-link" href="/produkty">← Späť na produkty</a>
          <section data-product-root class="tm-detail product-seo-initial tm-product-hydrating" aria-busy="true">
            <div class="tm-product-loading" aria-label="Načítava sa detail produktu">
              <div class="tm-product-loading-image"></div>
              <div class="tm-product-loading-copy">
                <span></span><span></span><span></span><span></span>
              </div>
              <div class="tm-product-loading-price"><span></span><span></span></div>
            </div>
            <div class="tm-product-seo-fallback">
            <section class="detail-hero-card">
              <div class="product-gallery"><div class="main-image"><img src={product.image} alt={product.name} width="640" height="640" loading="eager" decoding="async" /></div></div>
              <div class="product-info">
                <div class="badge-row"><span class="type-badge">{product.product_type_label}</span></div>
                <h1>{product.name}</h1>
                <p class="summary-subtitle">{description}</p>
                {printers.length > 0 && <p><strong>Kompatibilné tlačiarne:</strong> {printers.slice(0, 8).join(', ')}</p>}
                <div class:list={["stock-line", inStock ? "is-available" : "is-unavailable"]}><strong>{inStock ? 'Skladom' : 'Momentálne nie je skladom'}</strong></div>
              </div>
              <aside class="purchase-panel"><span class="vat-label">Cena s DPH</span><div class="price-row"><strong>{price}</strong><span>s DPH</span></div></aside>
            </section>
            {plainDescription && <section class="info-grid"><article class="params-card"><h2>Popis produktu</h2><p>{plainDescription}</p></article></section>}
            {productSafetyRows.length > 0 && (
              <section class="product-safety-card" aria-labelledby="product-safety-fallback-title">
                <div><span class="section-eyebrow">Bezpečnosť výrobku</span><h2 id="product-safety-fallback-title">Výrobca a bezpečnostné informácie</h2></div>
                <dl>{productSafetyRows.map(([label, value]) => <div><dt>{label}</dt><dd>{String(value)}</dd></div>)}</dl>
              </section>
            )}
            </div>
          </section>
        </div>
      </main>

      {(oemEntityLinks.length > 0 || printerEntityLinks.length > 0 || brandEntityLinks.length > 0) && (
        <section class="product-seo-relations" aria-labelledby="product-related-navigation">
          <div class="product-seo-relations-inner">
            <div class="product-seo-relations-heading">
              <p>Súvisiace overené údaje</p>
              <h2 id="product-related-navigation">Nájdite ďalšie vhodné produkty</h2>
              <span>Odkazy vznikajú z OEM označenia a kompatibilných tlačiarní uvedených pri tomto produkte.</span>
            </div>

            <div class="product-seo-relation-groups">
              {oemEntityLinks.length > 0 && (
                <article>
                  <h3>Podľa OEM označenia</h3>
                  <nav aria-label="OEM označenia produktu">
                    {oemEntityLinks.map((link) => <a href={link.href}>{link.label}</a>)}
                  </nav>
                </article>
              )}
              {printerEntityLinks.length > 0 && (
                <article>
                  <h3>Podľa modelu tlačiarne</h3>
                  <nav aria-label="Kompatibilné modely tlačiarní">
                    {printerEntityLinks.map((link) => <a href={link.href}>{link.label}</a>)}
                  </nav>
                </article>
              )}
              {brandEntityLinks.length > 0 && (
                <article>
                  <h3>Podľa značky</h3>
                  <nav aria-label="Značky kompatibilných tlačiarní">
                    {brandEntityLinks.map((link: any) => <a href={link.href}>{link.label}</a>)}
                  </nav>
                </article>
              )}
            </div>
          </div>
        </section>
      )}

      <section class="product-mobile-help-area" aria-label="Pomoc s výberom správnej náplne">
        <div class="product-mobile-help-card" aria-label="Radi vám pomôžeme">
          <h2>Radi vám pomôžeme</h2>
          <a class="product-mobile-help-row" href="tel:+421917859206" aria-label="Zavolať +421 917 859 206">
            <span aria-hidden="true" class="product-mobile-help-icon">
              <svg viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.3 1.3.4 2.6.6 4 .6.7 0 1.2.5 1.2 1.2v3.5c0 .7-.5 1.2-1.2 1.2C10.7 21.4 2.6 13.3 2.6 3.4c0-.7.5-1.2 1.2-1.2h3.5c.7 0 1.2.5 1.2 1.2 0 1.4.2 2.7.6 4 .1.4 0 .9-.3 1.2l-2.2 2.2Z" fill="currentColor"/></svg>
            </span>
            <strong>+421 917 859 206</strong>
          </a>
          <a class="product-mobile-help-row" href="mailto:info@tonerymaxim.sk" aria-label="Napísať e-mail info@tonerymaxim.sk">
            <span aria-hidden="true" class="product-mobile-help-icon">
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2Zm0 3.1v8.7l5.6-4.4L4 8.1Zm16 0-5.6 4.3 5.6 4.4V8.1Zm-14.2-1 6.2 4.8 6.2-4.8H5.8Zm6.2 7.3-1.1-.9-5.5 4.3h13.2l-5.5-4.3-1.1.9Z" fill="currentColor"/></svg>
            </span>
            <strong>info@tonerymaxim.sk</strong>
          </a>
        </div>
        <div class="product-mobile-footer-lock">© 2026 ToneryMaxim.sk</div>
      </section>

      <Footer />
      <FloatingAdvisor />
    </div>

    <script>
      import "../../scripts/product-detail.js";
    </script>
  </body>
</html>
