---
import "../styles/global.css";
import "../styles/printer-finder.css";
import "../styles/home-mobile.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import mobileLogo from "../assets/tonerymaxim-mobile-approved-logo.png";

const title = "Vybrať podľa tlačiarne | ToneryMaxim.sk";
const brands = [
  { slug: "hp", name: "HP", logo: "hp" },
  { slug: "brother", name: "Brother", logo: "brother" },
  { slug: "canon", name: "Canon", logo: "Canon" },
  { slug: "epson", name: "Epson", logo: "EPSON" },
  { slug: "samsung", name: "Samsung", logo: "SAMSUNG" },
  { slug: "xerox", name: "Xerox", logo: "Xerox" },
  { slug: "lexmark", name: "Lexmark", logo: "Lexmark" },
  { slug: "kyocera", name: "Kyocera", logo: "Kyocera" },
  { slug: "oki", name: "OKI", logo: "OKI" },
  { slug: "ricoh", name: "Ricoh", logo: "Ricoh" },
  { slug: "toshiba", name: "Toshiba", logo: "Toshiba" },
  { slug: "dell", name: "Dell", logo: "Dell" },
];
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="printer-index-page">
    <div class="page">
      <Header />

      <section class="tm-printer-mobile" aria-label="Vybrať podľa tlačiarne">
        <div class="tm-printer-mobile-topbar">
          <button class="tm-printer-mobile-menu-button" type="button" aria-label="Otvoriť menu" aria-expanded="false" data-tm-printer-menu-toggle>
            <span></span><span></span><span></span>
          </button>
          <a class="tm-printer-mobile-logo-link" href="/" aria-label="ToneryMaxim domov">
            <img src={mobileLogo.src} alt="ToneryMaxim" loading="eager" decoding="async" />
          </a>
          <a class="tm-printer-mobile-cart-link" href="/kosik" aria-label="Košík">
            <span aria-hidden="true">🛒</span>
            <strong data-cart-count>0</strong>
          </a>
        </div>

        <div class="tm-printer-mobile-drawer" data-tm-printer-menu aria-hidden="true">
          <div class="tm-printer-mobile-drawer-panel">
            <div class="tm-printer-mobile-drawer-head">
              <strong>Menu</strong>
              <button type="button" aria-label="Zavrieť menu" data-tm-printer-menu-close>×</button>
            </div>
            <section>
              <strong>Môj účet</strong>
              <a href="/prihlasenie">Prihlásenie</a>
              <a href="/ucet">Môj účet</a>
              <a href="/ucet/objednavky">Moje objednávky</a>
            </section>
            <section>
              <strong>Informácie</strong>
              <a href="/kontakt">Kontakt</a>
              <a href="/doprava-a-platba">Doprava a platba</a>
              <a href="/reklamacie">Reklamácie</a>
              <a href="/obchodne-podmienky">Obchodné podmienky</a>
              <a href="/ochrana-osobnych-udajov">Ochrana osobných údajov</a>
            </section>
            <section>
              <strong>Ponuka</strong>
              <a href="/produkty?category=tonery&search=toner">Tonery</a>
              <a href="/produkty?category=atramentove-naplne&search=atramentov%C3%A9%20n%C3%A1plne">Atramentové náplne</a>
              <a href="/produkty?category=opticke-valce&search=optick%C3%A9%20valce">Valce</a>
              <a href="/produkty?category=ostatne-komponenty&search=ostatn%C3%A9%20komponenty">Komponenty</a>
            </section>
          </div>
        </div>

        <main class="tm-printer-mobile-content">
          <h1>Značka tlačiarne</h1>
          <div class="tm-printer-brand-logo-grid" aria-label="Značky tlačiarní">
            {brands.map((brand) => (
              <a href={`/tlaciarne/${brand.slug}`} class={`tm-printer-brand-logo tm-printer-brand-logo--${brand.slug}`} aria-label={`Vybrať značku ${brand.name}`}>
                <span>{brand.logo}</span>
              </a>
            ))}
          </div>

          <section class="tm-printer-mobile-help" aria-label="Pomoc s výberom">
            <h2>Radi vám pomôžeme</h2>
            <a href="tel:+421917859206" class="tm-printer-help-row"><span aria-hidden="true">☎</span><strong>0917 859 206</strong></a>
            <a href="mailto:info@tonerymaxim.sk" class="tm-printer-help-row"><span aria-hidden="true">✉</span><strong>info@tonerymaxim.sk</strong></a>
          </section>
          <div class="tm-printer-mobile-footer">© 2026 ToneryMaxim.sk</div>
        </main>

        <div class="tm-printer-bottom-search tm-smart-search-wrap">
          <form action="/produkty" method="get" data-smart-search>
            <span aria-hidden="true">⌕</span>
            <input type="search" name="s" data-smart-search-input placeholder="Hľadať toner alebo tlačiareň" aria-label="Hľadať toner alebo tlačiareň" />
            <button type="submit">Hľadať</button>
          </form>
        </div>
      </section>

      <main class="printer-desktop-fallback">
        <section class="wrap printer-index-desktop">
          <h1>Vybrať podľa tlačiarne</h1>
          <p>Vyberte značku tlačiarne.</p>
          <div class="printer-brand-grid printer-brand-grid--desktop">
            {brands.map((brand) => <a href={`/tlaciarne/${brand.slug}`}>{brand.name}</a>)}
          </div>
        </section>
      </main>

      <Footer showTrust={false} />
      <FloatingAdvisor />
    </div>

    <script>
      import "../scripts/smart-search.js";
      const menuToggle = document.querySelector('[data-tm-printer-menu-toggle]');
      const menu = document.querySelector('[data-tm-printer-menu]');
      const menuClose = document.querySelector('[data-tm-printer-menu-close]');
      function setMenu(open) {
        if (!menu || !menuToggle) return;
        menu.classList.toggle('is-open', open);
        menu.setAttribute('aria-hidden', String(!open));
        menuToggle.setAttribute('aria-expanded', String(open));
        document.documentElement.classList.toggle('tm-menu-open', open);
      }
      menuToggle?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
      menuClose?.addEventListener('click', () => setMenu(false));
      menu?.addEventListener('click', (event) => { if (event.target === menu) setMenu(false); });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });
    </script>
  </body>
</html>
