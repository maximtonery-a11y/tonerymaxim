---
import "../styles/global.css";
import "../styles/footer.css";
import "../styles/legal.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import InfoPageShell from "../components/InfoPageShell.astro";
const toc = [
  ["#clanok-1", "Článok I. Vymedzenie pojmov"], ["#clanok-2", "Článok II. Cena"], ["#clanok-3", "Článok III. Objednávka"], ["#clanok-4", "Článok IV. Platobné podmienky"], ["#clanok-5", "Článok V. Dodacie podmienky"], ["#clanok-6", "Článok VI. Doprava a platba"], ["#clanok-7", "Článok VII. Prevod vlastníctva"], ["#clanok-8", "Článok VIII. Storno"], ["#clanok-9", "Článok IX. Odstúpenie"], ["#clanok-10", "Článok X. Práva a povinnosti"], ["#clanok-11", "Článok XI. Osobné údaje"], ["#clanok-12", "Článok XII. Neprevzatie tovaru"], ["#clanok-13", "Článok XIII. Záverečné ustanovenia"]
];
---
<!doctype html><html lang="sk"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Obchodné podmienky | ToneryMaxim.sk</title><link rel="canonical" href="https://www.tonerymaxim.sk/obchodne-podmienky" /></head><body><div class="page"><Header /><main>
<InfoPageShell active="/obchodne-podmienky" eyebrow="Právne informácie" title="Obchodné podmienky" intro="Všeobecné obchodné podmienky internetového obchodu ToneryMaxim.sk.">
    <section class="care-support-panel" aria-label="Formuláre a dokumenty">
      <h2>Formuláre a dokumenty pre zákazníkov</h2>
      <p>Okrem obchodných podmienok sú zákazníkom dostupné aj online formuláre a PDF dokumenty na stiahnutie.</p>
      <div class="care-support-grid">
        <a class="care-support-card" href="/reklamacia-online">
          <span>↺</span>
          <strong>Reklamácia online</strong>
          <small>Odoslanie reklamácie priamo cez web bez nutnosti tlačiť formulár.</small>
        </a>
        <a class="care-support-card" href="/odstupenie-od-zmluvy">
          <span>↩</span>
          <strong>Odstúpenie od zmluvy</strong>
          <small>Online formulár a PDF na stiahnutie pre vrátenie tovaru.</small>
        </a>
      </div>
    </section>
  <div class="op-grid">
    <aside class="op-toc"><h2>Obsah</h2>{toc.map(([href,label]) => <a href={href}>{label}</a>)}</aside>
    <article class="legal-panel">
      <header class="legal-panel-head"><h2>Všeobecné obchodné podmienky</h2><p>Platné pre nákup tovaru prostredníctvom internetového obchodu ToneryMaxim.sk.</p></header>
      <div class="legal-content">
        <section id="clanok-1"><h2>Článok I. Vymedzenie pojmov</h2><p>Prevádzkovateľom internetovej stránky a predávajúcim je Roman Babčan INkarus, so sídlom Tajov 265, 976 34 Tajov, IČO: 37 328 344, DIČ: 1020059920, IČ DPH: SK1020059920.</p><p>E-shopom je internetový obchod dostupný na stránke ToneryMaxim.sk, ktorý umožňuje objednávanie tovaru na diaľku prostredníctvom elektronického zariadenia.</p><p>Kupujúcim je návštevník e-shopu, ktorý vytvorí objednávku. Spotrebiteľom je fyzická osoba, ktorá pri uzatváraní a plnení zmluvy nekoná v rámci svojej podnikateľskej činnosti, zamestnania alebo povolania.</p></section>
        <section id="clanok-2"><h2>Článok II. Cena</h2><ul><li>Všetky uvádzané ceny pri tovare sú konečné a vrátane DPH.</li><li>Predávajúci je viazaný cenou uvedenou na stránke e-shopu v momente vytvorenia objednávky.</li><li>Ak sa pri tovare vyskytne zjavná technická chyba v cene, predávajúci kupujúceho bezodkladne kontaktuje.</li></ul></section>
        <section id="clanok-3"><h2>Článok III. Objednávka</h2><p>Objednávka vzniká dokončením objednávkového procesu v e-shope, výberom tovaru, vyplnením požadovaných údajov a odoslaním objednávky predávajúcemu.</p><p>Odoslaním objednávky kupujúci potvrdzuje, že sa oboznámil s cenou tovaru, cenou dopravy a platby a s týmito obchodnými podmienkami.</p><p>Po odoslaní objednávky je kupujúcemu automaticky odoslaný informačný e-mail o prijatí objednávky na spracovanie. Kúpna zmluva vzniká potvrdením objednávky predávajúcim.</p><p>Ak predávajúci nemôže objednávku alebo jej časť splniť, kontaktuje kupujúceho a navrhne ďalší postup. Ak už bola prijatá platba a objednávka nebude vybavená, platba bude vrátená.</p></section>
        <section id="clanok-4"><h2>Článok IV. Platobné podmienky</h2><p>Za tovar je možné platiť týmito spôsobmi:</p><ul><li>online platba GoPay – 0 €,</li><li>dobierka – 1,20 € s DPH,</li><li>platba prevodným príkazom vopred – 0 €,</li><li>prevodný príkaz pre štátne organizácie, školy, obce, mestá a firmy – 0 €.</li></ul><p>Pri platbe prevodom je objednávka expedovaná po prijatí úhrady, ak nebolo dohodnuté inak.</p></section>
        <section id="clanok-5"><h2>Článok V. Dodacie podmienky</h2><p>Ak je tovar skladom, je expedovaný podľa kapacitných možností v čo najkratšom čase. Pri tovare s dlhšou dostupnosťou je kupujúci informovaný o predpokladanom termíne dodania.</p><p>Ak objednávka obsahuje viacero položiek a časť z nich nie je skladom, predávajúci môže kupujúceho kontaktovať s možnosťou čiastočného dodania alebo úpravy objednávky.</p><p>Daňový doklad je kupujúcemu zaslaný elektronicky alebo spolu s tovarom.</p></section>
        <section id="clanok-6"><h2>Článok VI. Poplatky za dopravu a platbu</h2><p>Doprava a platba sa účtujú podľa spôsobu zvoleného v pokladni e-shopu.</p><h3>Doprava</h3><ul><li>Kuriér GLS a DPD – 3,90 € s DPH.</li><li>GLS Balíkomat / ParcelShop – 2,90 € s DPH.</li><li>DPD Pickup a DPD Pickup Box – 2,90 € s DPH.</li><li>Doprava pri objednávke od 29 € s DPH – 0 €.</li></ul><h3>Platba</h3><ul><li>Platba online GoPay – 0 €.</li><li>Dobierka – 1,20 € s DPH.</li><li>Platba prevodným príkazom vopred – 0 €.</li><li>Prevodný príkaz pre štátne organizácie, školy, obce, mestá a firmy – 0 €.</li></ul><p>Predávajúci sa môže s kupujúcim dohodnúť aj na inom spôsobe dopravy alebo platby.</p></section>
        <section id="clanok-7"><h2>Článok VII. Prevod vlastníckeho práva</h2><p>Vlastnícke právo k tovaru prechádza na kupujúceho momentom prevzatia tovaru, ak bol tovar riadne zaplatený.</p></section>
        <section id="clanok-8"><h2>Článok VIII. Storno objednávky</h2><p>Kupujúci môže požiadať o storno objednávky pred jej expedíciou. Ak už bola objednávka odovzdaná dopravcovi, postupuje sa podľa pravidiel pre odstúpenie od zmluvy alebo vrátenie tovaru.</p></section>
        <section id="clanok-9"><h2>Článok IX. Právo spotrebiteľa odstúpiť od zmluvy</h2><p>Spotrebiteľ má právo odstúpiť od zmluvy uzavretej na diaľku v zákonnej lehote 14 dní odo dňa prevzatia tovaru, ak právne predpisy neustanovujú inak.</p><p>Odstúpenie od zmluvy je možné oznámiť predávajúcemu e-mailom alebo písomne. Tovar je potrebné zaslať späť kompletný, nepoškodený a vhodne zabalený.</p><p>Tovar neposielajte na dobierku. Dobierkové zásielky nebudú prevzaté.</p><p>Náklady na vrátenie tovaru znáša spotrebiteľ, ak sa s predávajúcim nedohodne inak.</p></section>
        <section id="clanok-10"><h2>Článok X. Práva a povinnosti zmluvných strán</h2><p>Kupujúci je povinný prevziať objednaný tovar, zaplatiť dohodnutú cenu a pri prevzatí skontrolovať neporušenosť obalu.</p><p>Predávajúci je povinný dodať tovar v objednanom množstve, kvalite a za cenu potvrdenú v objednávke, prípadne informovať kupujúceho o zmenách dostupnosti.</p></section>
        <section id="clanok-11"><h2>Článok XI. Ochrana osobných údajov</h2><p>Osobné údaje sú spracúvané v súlade s pravidlami ochrany osobných údajov a GDPR. Podrobné informácie sú uvedené na stránke <a href="/ochrana-osobnych-udajov">Ochrana osobných údajov</a>.</p><p>Predávajúci spracúva osobné údaje najmä na účely vybavenia objednávky, doručenia tovaru, účtovníctva, zákazníckej podpory a plnenia zákonných povinností.</p></section>
        <section id="clanok-12"><h2>Článok XII. Náhrada škody pri neprevzatí tovaru</h2><p>Ak kupujúci neprevezme objednaný tovar bez predchádzajúceho storna alebo odstúpenia od zmluvy, predávajúcemu môžu vzniknúť náklady spojené s dopravou, balením a administráciou objednávky.</p><p>Predávajúci má právo posúdiť uplatnenie náhrady škody individuálne podľa konkrétneho prípadu.</p></section>
        <section id="clanok-13"><h2>Článok XIII. Záverečné ustanovenia</h2><p>Predávajúci si vyhradzuje právo meniť a dopĺňať tieto obchodné podmienky. Pre objednávku sú rozhodujúce obchodné podmienky platné v momente jej odoslania kupujúcim.</p><p>Prípadné spory je možné riešiť mimosúdne prostredníctvom príslušného subjektu alternatívneho riešenia spotrebiteľských sporov. Príslušným subjektom môže byť Slovenská obchodná inšpekcia alebo iný subjekt zapísaný v zozname Ministerstva hospodárstva SR.</p><p class="legal-note">Európska platforma ODR pre online riešenie spotrebiteľských sporov bola ukončená. Spotrebiteľ sa môže obrátiť na príslušné orgány alternatívneho riešenia sporov podľa aktuálne platných pravidiel.</p><div class="legal-contact-box"><strong>Kontakt predávajúceho</strong><span>Roman Babčan INkarus</span><span>Tajov 265, 976 34 Tajov</span><span>IČO: 37 328 344 · DIČ: 1020059920 · IČ DPH: SK1020059920</span><a href="mailto:info@tonerymaxim.sk">info@tonerymaxim.sk</a><a href="tel:+421917859206">+421917859206</a><span>Po–Pi 9:00–15:00</span></div></section>
      </div>
    </article>
  </div>
</InfoPageShell>
</main><Footer showTrust={false} /><FloatingAdvisor /></div></body></html>
