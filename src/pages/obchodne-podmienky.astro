---
import "../styles/global.css";
import "../styles/footer.css";
import "../styles/legal.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import InfoPageShell from "../components/InfoPageShell.astro";
import SeoHead from "../components/SeoHead.astro";
const toc = [
  ["#clanok-1", "Článok I. Vymedzenie pojmov"], ["#clanok-2", "Článok II. Cena"], ["#clanok-3", "Článok III. Objednávka"], ["#clanok-4", "Článok IV. Platobné podmienky"], ["#clanok-5", "Článok V. Dodacie podmienky"], ["#clanok-6", "Článok VI. Doprava a platba"], ["#clanok-7", "Článok VII. Prevod vlastníctva"], ["#clanok-8", "Článok VIII. Storno"], ["#clanok-9", "Článok IX. Odstúpenie"], ["#clanok-10", "Článok X. Práva a povinnosti"], ["#clanok-11", "Článok XI. Osobné údaje"], ["#clanok-12", "Článok XII. Neprevzatie tovaru"], ["#clanok-13", "Článok XIII. Záverečné ustanovenia"]
];
---
<!doctype html><html lang="sk"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><SeoHead title="Obchodné podmienky | ToneryMaxim.sk" description="Všeobecné obchodné podmienky internetového obchodu ToneryMaxim.sk vrátane objednávky, platby, dopravy a odstúpenia od zmluvy." canonical="https://www.tonerymaxim.sk/obchodne-podmienky" /></head><body><div class="page"><Header /><main>
<InfoPageShell active="/obchodne-podmienky" eyebrow="Právne informácie" title="Obchodné podmienky" intro="Všeobecné obchodné podmienky internetového obchodu ToneryMaxim.sk.">
    <section class="care-support-panel" aria-label="Formuláre a dokumenty">
      <h2>Formuláre a dokumenty pre zákazníkov</h2>
      <p>Okrem obchodných podmienok sú zákazníkom dostupné aj online formuláre a PDF dokumenty na stiahnutie.</p>
      <div class="care-support-grid">
        <a class="care-support-card" href="/reklamacia-online">
          <span>↺</span>
          <strong>Reklamácia online</strong>
          <small>Odoslanie reklamácie priamo cez web bez nutnosti tlačiť formulár.</small>
        </a>
        <a class="care-support-card" href="/odstupenie-od-zmluvy">
          <span>↩</span>
          <strong>Odstúpenie od zmluvy</strong>
          <small>Online formulár a PDF na stiahnutie pre vrátenie tovaru.</small>
        </a>
      </div>
    </section>
  <div class="op-grid">
    <aside class="op-toc"><h2>Obsah</h2>{toc.map(([href,label]) => <a href={href}>{label}</a>)}</aside>
    <article class="legal-panel">
      <header class="legal-panel-head"><h2>Všeobecné obchodné podmienky</h2><p>Platné pre nákup tovaru prostredníctvom internetového obchodu ToneryMaxim.sk.</p></header>
      <div class="legal-content">
        <section id="clanok-1"><h2>Článok I. Predávajúci a pojmy</h2><p>Predávajúcim a prevádzkovateľom e-shopu je Roman Babčan INkarus, Tajov 265, 976 34 Tajov, IČO: 37 328 344, DIČ: 1020059920, IČ DPH: SK1020059920, e-mail: <a href="mailto:info@tonerymaxim.sk">info@tonerymaxim.sk</a>, telefón: <a href="tel:+421917859206">+421 917 859 206</a>.</p><p>E-shop je dostupný na www.tonerymaxim.sk. Spotrebiteľ je fyzická osoba, ktorá pri zmluve nekoná v rámci podnikania, povolania alebo zamestnania. Na podnikateľský nákup sa ustanovenia výslovne určené spotrebiteľom nepoužijú.</p><p>Zmluva sa uzatvára v slovenskom jazyku. Objednávku a súvisiacu dokumentáciu uchovávame v elektronickej podobe; registrovaný zákazník vidí objednávky vo svojom účte a potvrdenie dostane e-mailom.</p></section>
        <section id="clanok-2"><h2>Článok II. Cena</h2><ul><li>Všetky uvádzané ceny pri tovare sú konečné a vrátane DPH.</li><li>Predávajúci je viazaný cenou uvedenou na stránke e-shopu v momente vytvorenia objednávky.</li><li>Ak sa pri tovare vyskytne zjavná technická chyba v cene, predávajúci kupujúceho bezodkladne kontaktuje.</li></ul></section>
        <section id="clanok-3"><h2>Článok III. Objednávka a uzatvorenie zmluvy</h2><p>Pred odoslaním objednávky môžete skontrolovať a opraviť tovar, množstvo, kontakt, adresu, dopravu, platbu, zľavy a konečnú cenu. Objednávku odošlete tlačidlom „Objednať s povinnosťou platby“, čím výslovne potvrdzujete povinnosť zaplatiť.</p><p>Automatický e-mail potvrdzuje doručenie objednávky do systému. Kúpna zmluva vzniká naším následným potvrdením prijatia objednávky na vybavenie, prípadne expedíciou alebo iným výslovným prijatím. Ak objednávku nemožno splniť, kontaktujeme vás; prijatú platbu za nevybavenú časť vrátime bez zbytočného odkladu.</p><p>Podmienkou nákupu nie je registrácia. Údaje musia byť úplné a pravdivé. V prípade objektívnej chyby ceny alebo dostupnosti vás pred prijatím objednávky požiadame o potvrdenie opravených podmienok; bez vášho súhlasu objednávku za zmenených podmienok nevybavíme.</p></section>
        <section id="clanok-4"><h2>Článok IV. Platobné podmienky</h2><p>Za tovar je možné platiť týmito spôsobmi:</p><ul><li>online platba GoPay – 0 €,</li><li>dobierka – 1,20 € s DPH,</li><li>platba prevodným príkazom vopred – 0 €,</li><li>prevodný príkaz pre štátne organizácie, školy, obce, mestá a firmy – 0 €.</li></ul><p>Pri platbe prevodom je objednávka expedovaná po prijatí úhrady, ak nebolo dohodnuté inak.</p></section>
        <section id="clanok-5"><h2>Článok V. Dodacie podmienky</h2><p>Tovar skladom objednaný v pracovný deň do 15:00 expedujeme spravidla v ten deň, inak najbližší pracovný deň. Pri platbe prevodom sa príprava začína po pripísaní úhrady. Údaj o expedícii nie je garantovaným časom doručenia; bežné doručenie DPD alebo GLS je 1–2 pracovné dni od prevzatia zásielky.</p><p>Ak tovar nie je skladom alebo objednávku nemožno odoslať v oznámenom termíne, bezodkladne vás informujeme. Čiastočné plnenie vykonáme len po dohode, ak by vám spôsobilo ďalší náklad alebo podstatnú nevýhodu.</p><p>Daňový doklad zašleme elektronicky alebo s tovarom. Nebezpečenstvo škody pri spotrebiteľskom nákupe prechádza prevzatím tovaru od dopravcu; tým nie sú dotknuté zákonné výnimky pri dopravcovi zvolenom spotrebiteľom mimo našej ponuky.</p></section>
        <section id="clanok-6"><h2>Článok VI. Poplatky za dopravu a platbu</h2><p>Doprava a platba sa účtujú podľa voľby a konečného súhrnu v pokladni.</p><h3>Doprava</h3><ul><li>Kuriér GLS alebo DPD – 3,90 € s DPH.</li><li>GLS ParcelShop/Balíkomat – 2,90 € s DPH.</li><li>DPD Pickup alebo DPD Pickup Box – 2,90 € s DPH.</li><li>Doprava pri hodnote tovaru po zľavách najmenej 29 € s DPH – 0 €.</li></ul><h3>Platba</h3><ul><li>Online GoPay – 0 €.</li><li>Dobierka – 1,20 € s DPH.</li><li>Prevod vopred – 0 €.</li><li>Prevod pre schválené organizácie a firmy – 0 €, po individuálnej dohode podmienok.</li></ul><p>Pri prevode použite IBAN SK62 0200 0000 0032 9932 3851, majiteľ účtu Roman Babčan INkarus, a číslo objednávky ako variabilný symbol. Podrobnosti sú na stránke <a href="/doprava-a-platba">Doprava a platba</a>.</p></section>
        <section id="clanok-7"><h2>Článok VII. Prevod vlastníckeho práva</h2><p>Vlastnícke právo k tovaru prechádza na kupujúceho momentom prevzatia tovaru, ak bol tovar riadne zaplatený.</p></section>
        <section id="clanok-8"><h2>Článok VIII. Storno objednávky</h2><p>Kupujúci môže požiadať o storno objednávky pred jej expedíciou. Ak už bola objednávka odovzdaná dopravcovi, postupuje sa podľa pravidiel pre odstúpenie od zmluvy alebo vrátenie tovaru.</p></section>
        <section id="clanok-9"><h2>Článok IX. Právo spotrebiteľa odstúpiť od zmluvy</h2><p>Spotrebiteľ môže bez uvedenia dôvodu odstúpiť do 14 dní od prevzatia tovaru. Oznámenie stačí odoslať v posledný deň lehoty. Tovar potom odošle najneskôr do 14 dní; priamy náklad na vrátenie znáša spotrebiteľ.</p><p>Vrátime prijaté platby vrátane ceny najlacnejšieho bežného dodania do 14 dní od oznámenia, rovnakým spôsobom platby, ak sa nedohodneme inak. Vrátenie môžeme zadržať do prijatia tovaru alebo preukázania jeho odoslania. Spotrebiteľ zodpovedá iba za zníženie hodnoty spôsobené zaobchádzaním nad rámec potrebný na zistenie vlastností a funkčnosti.</p><p>Odstúpenie, postup, zákonné výnimky a formulár sú na stránke <a href="/odstupenie-od-zmluvy">Odstúpenie od zmluvy</a>. Zásielku neposielajte na dobierku.</p></section>
        <section id="clanok-10"><h2>Článok X. Práva a povinnosti zmluvných strán</h2><p>Kupujúci je povinný prevziať objednaný tovar, zaplatiť dohodnutú cenu a pri prevzatí skontrolovať neporušenosť obalu.</p><p>Predávajúci je povinný dodať tovar v objednanom množstve, kvalite a za cenu potvrdenú v objednávke, prípadne informovať kupujúceho o zmenách dostupnosti.</p></section>
        <section id="clanok-11"><h2>Článok XI. Ochrana osobných údajov</h2><p>Osobné údaje sú spracúvané v súlade s pravidlami ochrany osobných údajov a GDPR. Podrobné informácie sú uvedené na stránke <a href="/ochrana-osobnych-udajov">Ochrana osobných údajov</a>.</p><p>Predávajúci spracúva osobné údaje najmä na účely vybavenia objednávky, doručenia tovaru, účtovníctva, zákazníckej podpory a plnenia zákonných povinností.</p></section>
        <section id="clanok-12"><h2>Článok XII. Náhrada škody pri neprevzatí tovaru</h2><p>Ak kupujúci neprevezme objednaný tovar bez predchádzajúceho storna alebo odstúpenia od zmluvy, predávajúcemu môžu vzniknúť náklady spojené s dopravou, balením a administráciou objednávky.</p><p>Predávajúci má právo posúdiť uplatnenie náhrady škody individuálne podľa konkrétneho prípadu.</p></section>
        <section id="clanok-13"><h2>Článok XIII. Záverečné ustanovenia a mimosúdne riešenie</h2><p>Pre objednávku platí znenie podmienok účinné pri jej odoslaní. Zmena podmienok nemá spätný účinok. Uplatnenie slovenského práva nezbavuje spotrebiteľa ochrany kogentných predpisov štátu jeho obvyklého pobytu, ak sa uplatnia.</p><p>Ak nie ste spokojný so spôsobom vybavenia žiadosti o nápravu alebo sme ju zamietli, môžete podať návrh na alternatívne riešenie sporu príslušnému subjektu; najmä Slovenskej obchodnej inšpekcii, Bajkalská 21/A, P. O. BOX 29, 827 99 Bratislava, <a href="https://www.soi.sk/alternativne-riesenie-spotrebitelskych-sporov" rel="external">soi.sk</a>, alebo inému subjektu zapísanému v zozname Ministerstva hospodárstva SR. Tým nie je dotknuté právo obrátiť sa na súd.</p><p class="legal-note">Európska platforma ODR bola ukončená 20. júla 2025; preto na ňu neuvádzame nefunkčný odkaz. Účinnosť podmienok: 5. augusta 2026.</p><div class="legal-contact-box"><strong>Kontakt predávajúceho</strong><span>Roman Babčan INkarus</span><span>Tajov 265, 976 34 Tajov</span><span>IČO: 37 328 344 · DIČ: 1020059920 · IČ DPH: SK1020059920</span><a href="mailto:info@tonerymaxim.sk">info@tonerymaxim.sk</a><a href="tel:+421917859206">+421917859206</a><span>Po–Pi 9:00–15:00</span></div></section>
      </div>
    </article>
  </div>
</InfoPageShell>
</main><Footer showTrust={false} /><FloatingAdvisor /></div></body></html>
