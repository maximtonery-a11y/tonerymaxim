---
import '../styles/global.css';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import { permissionsPolicy } from '../lib/permissions-policy';
Astro.response.headers.set('Permissions-Policy', permissionsPolicy(Astro.url.pathname));
---
<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead title="Nájsť náplň fotoaparátom | ToneryMaxim.sk" description="Namierte fotoaparát na označenie kazety alebo model tlačiarne a zobrazte vhodné náplne." noindex />
  </head>
  <body><div class="page"><Header />
    <main class="label-search" data-label-search>
      <a class="back" href="/">← Späť na vyhľadávanie</a>
      <section aria-labelledby="label-heading">
        <h1 id="label-heading">Nájdite náplň fotoaparátom</h1>
        <p>Namierte na model tlačiarne alebo kód tonera, atramentovej náplne či valca. Po rozpoznaní vám zobrazíme našu ponuku.</p>
        <div class="capture" data-photo-controls hidden>
          <button type="button" class="primary" data-live-start aria-controls="live-camera"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 7h4l2-3h6l2 3h4v13H3z" stroke-linejoin="round"/><circle cx="12" cy="13" r="3.5"/></svg>
            Spustiť fotoaparát
          </button>
          <label>Vybrať fotku z galérie<input type="file" accept="image/*" data-gallery /></label>
        </div>
        <dialog class="live-camera" id="live-camera" aria-labelledby="camera-heading">
          <div class="live-header"><h2 id="camera-heading">Skenovanie štítku</h2><div data-live-actions></div></div>
          <div class="viewfinder">
            <video muted playsinline autoplay aria-label="Živý obraz zo zadného fotoaparátu"></video>
            <button type="button" class="pick-row" aria-label="Zamerať riadok s označením. Šípkami hore a dole môžete presunúť rámček."></button>
            <div class="live-guide" data-live-guide aria-hidden="true"></div>
            <button type="button" class="live-zoom" data-live-zoom aria-label="Priblížiť obraz 2×" aria-pressed="false">2×</button>
          </div>
          <div class="live-feedback" data-live-feedback></div>
        </dialog>
        <p class="privacy">Obraz zostáva vo vašom zariadení. V katalógu hľadáme iba prečítané označenie.</p>
        <div data-page-feedback>
          <p id="label-status" tabindex="-1" role="status" aria-live="polite"></p>
          <button class="secondary" type="button" data-stop hidden>Zrušiť čítanie</button>
        </div>
        <div class="matches" data-matches></div>
        <button type="button" class="secondary crop-toggle" data-crop-toggle aria-expanded="false" aria-controls="crop-photo" hidden>Vybrať riadok z fotky</button>
        <div id="crop-photo" hidden>
          <p id="crop-hint" aria-live="polite">Ťuknite na začiatok a potom na koniec názvu modelu alebo kódu kazety.</p>
          <span id="crop-keys" class="sr-only">Šípkami posuňte bod na fotke a klávesom Enter ho vyberte.</span>
          <div class="crop-viewport" data-crop-viewport>
            <button type="button" class="crop-image" aria-label="Označiť bod na fotke" aria-describedby="crop-hint crop-keys">
              <img alt="Vaša fotka štítku" data-crop-image />
              <span class="crop-mark" data-crop-mark hidden></span>
              <span class="crop-mark cursor" data-crop-cursor hidden></span>
            </button>
          </div>
          <div class="crop-actions">
            <button type="button" class="secondary" data-crop-zoom aria-pressed="false">Zväčšiť fotku</button>
            <button type="button" class="secondary" data-read-around hidden>Prečítať okolie bodu</button>
            <button type="button" class="secondary" data-crop-restart hidden>Označiť znova</button>
          </div>
        </div>

        <form class="manual" method="get" action="/produkty">
          <label for="label-code">Zadať alebo opraviť označenie</label>
          <div><input id="label-code" type="search" name="s" placeholder="Napr. CE285A alebo HP P1102w" maxlength="64" required />
          <button class="secondary" type="submit">Vyhľadať</button></div>
        </form>
      </section>
    </main>
  </div></body>
</html>
<style>
  .label-search { width: min(100% - 28px, 40rem); margin: clamp(1.25rem,4vw,3rem) auto 4rem; color:#102845; }
  .back { display:inline-block; padding:.5rem 0; color:#245587; }
  section { margin-top:.65rem; padding:clamp(1.15rem,4vw,2.5rem); background:white; border:1px solid #d9e4ee; border-radius:18px; }
  h1 { font-size:clamp(1.6rem,4vw,2.15rem); line-height:1.15; margin:0 0 .65rem; }
  p { line-height:1.5; margin:0 0 1rem; }
  .capture { display:flex; flex-wrap:wrap; gap:.6rem; }
  .capture label,.capture button,.secondary,.matches :global(button),.matches :global(a) { font:inherit; font-weight:600; min-height:46px; border:1px solid #bdd0e3; border-radius:10px; background:white; color:#163b5b; padding:.65rem .9rem; cursor:pointer; touch-action:manipulation; }
  .capture label,.capture button { position:relative; display:inline-flex; gap:.5rem; align-items:center; justify-content:center; overflow:hidden; }
  .capture .primary { background:#0b3154; color:white; border-color:#0b3154; }
  .capture svg { width:21px; height:21px; }
  .capture input { position:absolute; inset:0; height:100%; width:100%; opacity:0; cursor:pointer; }
  .capture label:focus-within,button:focus-visible,input:focus-visible,.matches :global(a:focus-visible) { outline:3px solid #1970af; outline-offset:2px; }
  .live-camera { box-sizing:border-box; position:fixed; inset:0; margin:auto; padding:0; border:0; border-radius:16px; width:min(56rem,94vw); height:min(48rem,92dvh); max-width:none; max-height:none; overflow:hidden; color:#fff; background:#102337; }
  .live-camera[open] { display:grid; grid-template-rows:auto minmax(0,1fr) auto; }
  .live-camera::backdrop { background:#081626c9; }
  html:has(.live-camera[open]),body:has(.live-camera[open]) { overflow:hidden; }
  .live-header { display:flex; align-items:center; justify-content:space-between; gap:.6rem; padding:.55rem 1rem; }
  .live-header h2 { margin:0; font-size:1.125rem; color:#fff; }
  .live-header .secondary { background:#213b52; color:white; border-color:#6b8192; padding:.45rem .75rem; min-height:44px; font-size:.875rem; }
  .viewfinder { position:relative; min-height:0; overflow:hidden; background:#08131b; isolation:isolate; }
  .viewfinder video { display:block; width:100%; height:100%; object-fit:cover; transform:scale(var(--label-zoom,1)); }
  .pick-row { position:absolute; inset:0; width:100%; height:100%; padding:0; border:0; background:transparent; cursor:crosshair; touch-action:manipulation; }
  .pick-row:focus-visible { outline-offset:-4px; }
  .live-guide { position:absolute; inset:27% 4%; border:2px solid #fff; border-radius:12px; box-shadow:0 0 0 100vmax #06101c26, inset 0 0 0 1px #10263c66; pointer-events:none; }
  .live-guide[data-picked] { bottom:auto; height:22%; box-sizing:border-box; transform:translateY(-50%); }
  .live-zoom { position:absolute; bottom:12px; right:max(12px,env(safe-area-inset-right)); border:1px solid #ffffff94; border-radius:24px; background:#122435dd; color:white; min-width:48px; height:44px; font:inherit; font-weight:600; cursor:pointer; }
  .live-zoom[aria-pressed="true"] { background:white; color:#102337; }
  .live-feedback { padding:.8rem 1rem; min-height:3.5rem; align-content:center; }
  .live-feedback #label-status { margin:0; font-size:1rem; color:#fff; }
  @media(max-width:767px), (max-height:540px) and (pointer:coarse) {
    .live-camera { margin:0; border-radius:0; width:100vw; height:100%; height:100dvh; }
    .live-header { padding:calc(.4rem + env(safe-area-inset-top)) max(.75rem,env(safe-area-inset-right)) .4rem max(.75rem,env(safe-area-inset-left)); }
    .live-feedback { padding:.65rem max(.85rem,env(safe-area-inset-right)) calc(.65rem + env(safe-area-inset-bottom)) max(.85rem,env(safe-area-inset-left)); }
  }
  .privacy { margin:.75rem 0; color:#476078; font-size:.875rem; }
  #label-status:empty { margin:0; }
  #label-status { font-weight:600; scroll-margin-top:clamp(5rem,18vh,10rem); }
  .matches { display:grid; gap:.55rem; }
  .matches :global(a) { text-decoration:none; display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:.4rem; }
  .matches :global(small) { white-space:nowrap; }
  .crop-toggle { margin-top:.7rem; }
  #crop-photo p { margin:.7rem 0; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  .crop-viewport { max-height:45vh; overflow:auto; border-radius:8px; }
  .crop-actions { display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.6rem; }
  .crop-actions button { font-size:.875rem; }
  .crop-mark { position:absolute; pointer-events:none; width:16px; height:16px; border-radius:50%; border:2px solid white; box-shadow:0 0 0 2px #155eac; transform:translate(-50%,-50%); }
  .crop-mark.cursor { border-style:dashed; box-shadow:0 0 0 2px #182c43; }
  .crop-viewport.zoom .crop-image,.crop-viewport.zoom img { max-width:none; max-height:none; }
  .crop-image { position:relative; display:block; width:fit-content; max-width:100%; margin:auto; border:0; padding:0; background:none; cursor:crosshair; }
  .crop-image img { display:block; max-width:100%; max-height:40vh; width:auto; height:auto; }
  .manual { margin-top:1.25rem; padding-top:1rem; border-top:1px solid #d9e4ee; }
  .manual label { display:block; margin-bottom:.5rem; }
  .manual div { display:flex; flex-wrap:wrap; gap:.5rem; }
  .manual input { font:inherit; padding:.65rem; min-width:0; width:100%; flex:1 1 12rem; border:1px solid #9fb2c6; border-radius:9px; }
  [hidden] { display:none !important; }
  @media(max-width:420px) { .capture > * { flex:1 1 100%; } }
</style>
<script>
  import '../scripts/label-search-ui';
</script>
