---
import "../styles/global.css";
import "../styles/footer.css";
import "../styles/account.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import SeoHead from "../components/SeoHead.astro";
import { readCustomerSession } from "../lib/auth-session";

const session = readCustomerSession(Astro.cookies);
if (session) return Astro.redirect("/ucet");
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title="Registrácia | ToneryMaxim.sk" description="Vytvorte si bezplatný zákaznícky účet ToneryMaxim a nakupujte rýchlejšie pri každej ďalšej objednávke." canonical="https://www.tonerymaxim.sk/registracia" noindex={true} />
  </head>
  <body>
    <div class="page account-page">
      <Header />
      <main class="auth-wrap">
        <section class="auth-card">
          <img class="auth-logo" src="/images/logo.png" alt="ToneryMaxim" />
          <h1>Registrácia</h1>
          <p>Vytvorte si účet zdarma a nakupujte tonery rýchlejšie pri každej ďalšej objednávke.</p>

          <div class="auth-alert" data-auth-message hidden></div>

          <form class="auth-form" data-register-form>
            <div class="auth-grid-2">
              <div class="tm-field"><label for="first-name">Meno</label><input id="first-name" name="firstName" placeholder="Ján" autocomplete="given-name" required /></div>
              <div class="tm-field"><label for="last-name">Priezvisko</label><input id="last-name" name="lastName" placeholder="Novák" autocomplete="family-name" required /></div>
            </div>
            <div class="tm-field"><label for="reg-email">E-mailová adresa</label><input id="reg-email" name="email" type="email" placeholder="vas@email.sk" autocomplete="email" required /></div>
            <div class="tm-field"><label for="reg-password">Heslo</label><input id="reg-password" name="password" type="password" placeholder="12 až 128 znakov" autocomplete="new-password" required minlength="12" maxlength="128" /></div>
            <div class="tm-field"><label for="reg-password2">Potvrďte heslo</label><input id="reg-password2" name="password2" type="password" placeholder="zopakujte heslo" autocomplete="new-password" required minlength="12" maxlength="128" /></div>
            <label class="tm-check"><input name="consent" type="checkbox" required /> Potvrdzujem, že som sa oboznámil/a so <a href="/ochrana-osobnych-udajov">zásadami ochrany osobných údajov</a>. Údaje účtu spracúvame na jeho vytvorenie a správu, nie na základe marketingového súhlasu.</label>
            <button class="tm-btn" type="submit" data-auth-submit>Zaregistrovať sa</button>
          </form>

          <p class="auth-switch">Už máte účet? <a href="/prihlasenie">Prihlásiť sa</a></p>
        </section>

        <section class="auth-benefits is-grid" aria-label="Výhody registrácie">
          <div class="auth-benefit-card"><strong>🖨️ Uložené tlačiarne</strong><p>Nemusíte si pamätať model. Náplne nájdete na 1 klik.</p></div>
          <div class="auth-benefit-card"><strong>🎁 Vernostný program</strong><p>Za každú objednávku získavate body na ďalší nákup.</p></div>
          <div class="auth-benefit-card"><strong>⚡ Rýchle objednanie</strong><p>Uložené adresy, tlačiarne a história nákupov.</p></div>
          <div class="auth-benefit-card"><strong>📦 História objednávok</strong><p>Všetky faktúry a objednávky budete mať na jednom mieste.</p></div>
          <div class="auth-benefit-card"><strong>🔄 Rýchla reklamácia</strong><p>Reklamáciu vytvoríte priamo z konkrétnej objednávky.</p></div>
          <div class="auth-benefit-card"><strong>⭐ Opakované objednávky</strong><p>Rovnaký toner alebo náplň objednáte za pár sekúnd.</p></div>
        </section>
      </main>
      <Footer />
      <FloatingAdvisor />
    </div>

    <script>
      const form = document.querySelector<HTMLFormElement>("[data-register-form]")!;
      const message = document.querySelector<HTMLElement>("[data-auth-message]")!;
      const submit = document.querySelector<HTMLButtonElement>("[data-auth-submit]")!;

      function showMessage(text: string, type = "error") {
        message.hidden = false;
        message.textContent = text;
        message.className = `auth-alert is-${type}`;
      }

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const data: Record<string, unknown> = Object.fromEntries(new FormData(form));
        data.consent = Boolean(form.querySelector<HTMLInputElement>('input[name="consent"]')?.checked);

        submit.disabled = true;
        submit.textContent = "Registrujem...";
        message.hidden = true;

        try {
          const response = await fetch("/api/auth/register", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.error || "Registrácia zlyhala.");

          showMessage("Registrácia prebehla úspešne. Presmerovávam do účtu...", "success");
          window.location.href = result.redirect || "/ucet";
        } catch (error) {
          showMessage(error instanceof Error ? error.message : "Registrácia zlyhala.");
        } finally {
          submit.disabled = false;
          submit.textContent = "Zaregistrovať sa";
        }
      });
    </script>
  </body>
</html>
