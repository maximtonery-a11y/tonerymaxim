---
import "../styles/global.css";
import "../styles/hero.css";
import "../styles/benefits.css";
import "../styles/footer.css";
import "../styles/home-mobile.css";

import Header from "../components/Header.astro";
import HeroSearch from "../components/HeroSearch.astro";
import ProductFinder from "../components/ProductFinder.astro";
import Benefits from "../components/Benefits.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";

const title = "ToneryMaxim.sk";

const mobileBrands = [
  { name: "HP", slug: "hp", logo: "hp", className: "hp" },
  { name: "Brother", slug: "brother", logo: "brother", className: "brother" },
  { name: "Canon", slug: "canon", logo: "Canon", className: "canon" },
  { name: "Epson", slug: "epson", logo: "EPSON", className: "epson" },
  { name: "Samsung", slug: "samsung", logo: "SAMSUNG", className: "samsung" },
  { name: "Xerox", slug: "xerox", logo: "Xerox", className: "xerox" },
  { name: "Lexmark", slug: "lexmark", logo: "Lexmark", className: "lexmark" },
];

const allPrinterBrands = [
  "HP",
  "Canon",
  "Brother",
  "Epson",
  "Samsung",
  "Xerox",
  "Lexmark",
  "Kyocera",
  "OKI",
  "Ricoh",
  "Konica Minolta",
  "Utax",
  "Panasonic",
  "Toshiba",
  "Dell",
  "Sharp",
  "Minolta",
  "Olivetti",
  "Philips",
  "Tally",
  "Triumph Adler",
];

const toSlug = (brand: string) =>
  brand
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body class="home-page">
    <div class="page">
      <Header />

      <main>
        <section id="hladat" class="tm-mobile-home" aria-label="Mobilná úvodná stránka ToneryMaxim">
          <div class="tm-mobile-home-search">
            <form class="tm-mobile-search" action="/produkty" method="get" data-smart-search>
              <span class="tm-mobile-search-icon" aria-hidden="true">⌕</span>
              <input
                type="search"
                name="s"
                data-smart-search-input
                placeholder="Napíšte model tlačiarne alebo tonera"
                aria-label="Napíšte model tlačiarne alebo tonera"
              />
              <button type="submit" aria-label="Vyhľadať">Hľadať</button>
            </form>
          </div>

          <div class="tm-mobile-brand-grid" aria-label="Značky výrobcov tlačiarní">
            {mobileBrands.map((brand) => (
              <a class="tm-mobile-brand-card" href={`/tlaciarne/${brand.slug}`}>
                <span class={`tm-mobile-brand-logo ${brand.className}`}>{brand.logo}</span>
                <strong>{brand.name}</strong>
              </a>
            ))}

            <button class="tm-mobile-brand-card tm-mobile-brand-card-more" type="button" data-open-mobile-brand-modal>
              <span class="tm-mobile-brand-logo more">•••</span>
              <strong>Ostatné značky</strong>
            </button>
          </div>

          <div class="tm-mobile-benefits" aria-label="Výhody nákupu v ToneryMaxim">
            <article><span aria-hidden="true">✓</span><strong>Overená kompatibilita</strong></article>
            <article><span aria-hidden="true">🚚</span><strong>Rýchle doručenie</strong></article>
            <article><span aria-hidden="true">★</span><strong>Kvalitné produkty</strong></article>
            <article><span aria-hidden="true">€</span><strong>Výhodné ceny</strong></article>
            <article><span aria-hidden="true">☎</span><strong>Zákaznícka podpora</strong></article>
            <article><span aria-hidden="true">🔒</span><strong>Bezpečný nákup</strong></article>
          </div>
        </section>

        <HeroSearch />
        <ProductFinder />
        <Benefits />
      </main>

      <Footer showTrust={false} />
      <FloatingAdvisor />
    </div>

    <dialog class="tm-mobile-brand-modal" data-mobile-brand-modal>
      <div class="tm-mobile-brand-modal-card">
        <button class="tm-mobile-brand-modal-close" type="button" data-close-mobile-brand-modal aria-label="Zavrieť">×</button>
        <strong class="tm-mobile-brand-modal-title">Všetky značky</strong>
        <div class="tm-mobile-brand-modal-grid">
          {allPrinterBrands.map((brand) => (
            <a href={`/tlaciarne/${toSlug(brand)}`}>{brand}</a>
          ))}
        </div>
      </div>
    </dialog>

    <script>
      const mobileBrandModal = document.querySelector("[data-mobile-brand-modal]");
      document.querySelector("[data-open-mobile-brand-modal]")?.addEventListener("click", () => {
        if (mobileBrandModal instanceof HTMLDialogElement) mobileBrandModal.showModal();
      });
      document.querySelector("[data-close-mobile-brand-modal]")?.addEventListener("click", () => {
        if (mobileBrandModal instanceof HTMLDialogElement) mobileBrandModal.close();
      });
      mobileBrandModal?.addEventListener("click", (event) => {
        if (event.target === mobileBrandModal && mobileBrandModal instanceof HTMLDialogElement) mobileBrandModal.close();
      });
    </script>
  </body>
</html>
