---
import "../styles/global.css";
import "../styles/hero.css";
import "../styles/benefits.css";
import "../styles/footer.css";
import "../styles/home-mobile.css";

import Header from "../components/Header.astro";
import HeroSearch from "../components/HeroSearch.astro";
import ProductFinder from "../components/ProductFinder.astro";
import Benefits from "../components/Benefits.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import mobileLogo from "../assets/tonerymaxim-mobile-approved-logo.png";
import tmHelpVisual from "../assets/tm-help-kontaktujte-final.jpg";
import SeoHead from "../components/SeoHead.astro";
import { organizationJsonLd } from "../lib/seo";

const title = "Tonery a náplne do tlačiarní | ToneryMaxim.sk";
const description = "Tonery, atramentové náplne, optické valce a komponenty pre tlačiarne HP, Canon, Brother, Epson a ďalšie. Rýchle doručenie a odborná pomoc.";
const noindex = ["tonerymaxim.info", "www.tonerymaxim.info"].includes(Astro.url.hostname);
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title={title} description={description} noindex={noindex} jsonLd={[organizationJsonLd(Astro.url.origin), { "@context": "https://schema.org", "@type": "WebSite", "@id": `${Astro.url.origin}/#website`, url: Astro.url.origin, name: "ToneryMaxim.sk", potentialAction: { "@type": "SearchAction", target: `${Astro.url.origin}/produkty?s={search_term_string}`, "query-input": "required name=search_term_string" } }]} />
  </head>

  <body class="home-page">
    <div class="page">
      <Header />

      <main>
        <section class="tm-mobile-home-final" aria-label="Mobilná úvodná stránka ToneryMaxim">
          <div class="tm-mobile-topbar">
            <button class="tm-mobile-menu-button" type="button" aria-label="Otvoriť menu" aria-expanded="false" data-tm-mobile-menu-toggle>
              <span></span>
              <span></span>
              <span></span>
            </button>

            <a class="tm-mobile-logo-link" href="/novy/" aria-label="ToneryMaxim domov">
              <img src={mobileLogo.src} alt="ToneryMaxim" loading="eager" decoding="async" />
            </a>

            <a class="tm-mobile-cart-link" href="/novy/kosik" aria-label="Košík">
              <span aria-hidden="true">🛒</span>
              <strong data-cart-count>0</strong>
            </a>
          </div>

          <div class="tm-mobile-drawer" data-tm-mobile-menu aria-hidden="true">
            <div class="tm-mobile-drawer-panel">
              <div class="tm-mobile-drawer-head">
                <strong>Menu</strong>
                <button type="button" aria-label="Zavrieť menu" data-tm-mobile-menu-close>×</button>
              </div>

              <section>
                <strong>Môj účet</strong>
                <a href="/novy/prihlasenie">Prihlásenie</a>
                <a href="/novy/ucet">Môj účet</a>
                <a href="/novy/ucet/objednavky">Moje objednávky</a>
              </section>

              <section>
                <strong>Informácie</strong>
                <a href="/novy/kontakt">Kontakt</a>
                <a href="/novy/doprava-a-platba">Doprava a platba</a>
                <a href="/novy/reklamacie">Reklamácie</a>
                <a href="/novy/obchodne-podmienky">Obchodné podmienky</a>
                <a href="/novy/ochrana-osobnych-udajov">Ochrana osobných údajov</a>
              </section>

              <section>
                <strong>Ponuka</strong>
                <a href="/novy/produkty?category=tonery&search=toner">Tonery</a>
                <a href="/novy/produkty?category=atramentove-naplne&search=atramentov%C3%A9%20n%C3%A1plne">Atramentové náplne</a>
                <a href="/novy/produkty?category=opticke-valce&search=optick%C3%A9%20valce">Valce</a>
                <a href="/novy/produkty?category=ostatne-komponenty&search=ostatn%C3%A9%20komponenty">Komponenty</a>
              </section>
            </div>
          </div>

          <div class="tm-mobile-content">
            <form class="tm-mobile-hero-search" action="/novy/produkty" method="get" data-smart-search>
              <span class="tm-mobile-search-icon" aria-hidden="true">⌕</span>
              <input
                type="search"
                name="s"
                data-smart-search-input
                placeholder="Hľadať tlačiareň alebo toner"
                aria-label="Hľadať tlačiareň alebo toner"
              />
              <button type="submit" aria-label="Vyhľadať">›</button>
            </form>

            <div class="tm-mobile-search-examples" aria-label="Príklady hľadania">
              <a href="/novy/produkty?printer=HP+LaserJet+M110w">HP M110w</a>
              <a href="/novy/produkty?s=Brother%20DCP-L2532DW">Brother DCP-L2532DW</a>
              <a href="/novy/produkty?s=No.305">HP 305</a>
              <a href="/novy/produkty?s=TN-2421">TN-2421</a>
              <a href="/novy/produkty?s=HP%20LaserJet%20M1132MFP">HP LaserJet M1132MFP</a>
              <a href="/novy/produkty?s=W1420A">W1420A</a>
            </div>

            <a class="tm-mobile-printer-picker" href="/novy/tlaciarne">
              <span class="tm-mobile-printer-icon" aria-hidden="true">
                <svg viewBox="0 0 64 64" fill="none">
                  <path d="M18 24V12h28v12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16 44H10a6 6 0 0 1-6-6v-8a6 6 0 0 1 6-6h44a6 6 0 0 1 6 6v8a6 6 0 0 1-6 6h-6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M18 38h28v14H18V38Z" stroke="currentColor" stroke-linejoin="round"/>
                  <path d="M48 31h4" stroke="currentColor" stroke-linecap="round"/>
                </svg>
              </span>
              <strong>Vybrať podľa tlačiarne</strong>
              <span class="tm-mobile-printer-arrow" aria-hidden="true">›</span>
            </a>

            <div class="tm-mobile-trust-row" aria-label="Výhody nákupu">
              <article>
                <span class="tm-trust-icon tm-pink" aria-hidden="true">
                  <svg viewBox="0 0 48 48" fill="none"><path d="M24 5 39 11v11c0 10-6.4 17.3-15 21-8.6-3.7-15-11-15-21V11l15-6Z" stroke="currentColor"/><path d="m17 24 5 5 10-11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <strong>17 rokov</strong>
                <small>skúseností</small>
              </article>
              <article>
                <span class="tm-trust-icon tm-cyan" aria-hidden="true">
                  <svg viewBox="0 0 48 48" fill="none"><path d="M8 16 24 8l16 8-16 8-16-8Z" stroke="currentColor" stroke-linejoin="round"/><path d="M8 16v16l16 8 16-8V16" stroke="currentColor" stroke-linejoin="round"/><path d="M24 24v16" stroke="currentColor"/></svg>
                </span>
                <strong>30 000+</strong>
                <small>objednávok</small>
              </article>
              <article>
                <span class="tm-trust-icon tm-yellow" aria-hidden="true">
                  <svg viewBox="0 0 48 48" fill="none"><path d="M6 15h24v18H6V15Z" stroke="currentColor" stroke-linejoin="round"/><path d="M30 22h7l5 6v5H30V22Z" stroke="currentColor" stroke-linejoin="round"/><path d="M14 38a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM36 38a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" stroke="currentColor"/></svg>
                </span>
                <strong>Doručenie</strong>
                <small>do 24h</small>
              </article>
              <article>
                <span class="tm-trust-icon tm-green" aria-hidden="true">
                  <svg viewBox="0 0 48 48" fill="none"><path d="m24 5 5.5 11.2 12.4 1.8-9 8.8 2.1 12.4L24 33.4l-11 5.8 2.1-12.4-9-8.8 12.4-1.8L24 5Z" stroke="currentColor" stroke-linejoin="round"/></svg>
                </span>
                <strong>Heureka</strong>
                <small>4,9/5</small>
              </article>
            </div>

            <section class="tm-mobile-help-card" aria-label="Pomoc s výberom">
              <a class="tm-mobile-help-card-link" href="/novy/kontakt" aria-label="Kontaktujte nás">
                <img class="tm-mobile-help-card-image" src={tmHelpVisual.src} alt="Potrebujete poradiť? Sme tu pre vás. Kontaktujte nás." loading="lazy" decoding="async" />
              </a>
            </section>

            <div class="tm-mobile-footer-lock" aria-label="Copyright">
              © 2026 ToneryMaxim.sk
            </div>
          </div>
        </section>

        <HeroSearch />
        <ProductFinder />
        <Benefits />
      </main>

      <Footer showTrust={false} />
      <FloatingAdvisor />
    </div>

    <script>
      const menuToggle = document.querySelector('[data-tm-mobile-menu-toggle]');
      const menu = document.querySelector('[data-tm-mobile-menu]');
      const menuClose = document.querySelector('[data-tm-mobile-menu-close]');

      function setMenu(open) {
        if (!menu || !menuToggle) return;
        menu.classList.toggle('is-open', open);
        menu.setAttribute('aria-hidden', String(!open));
        menuToggle.setAttribute('aria-expanded', String(open));
        document.documentElement.classList.toggle('tm-menu-open', open);
      }

      menuToggle?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
      menuClose?.addEventListener('click', () => setMenu(false));
      menu?.addEventListener('click', (event) => {
        if (event.target === menu) setMenu(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenu(false);
      });
    </script>
  </body>
</html>
