---
import "../styles/global.css";
import "../styles/hero.css";
import "../styles/benefits.css";
import "../styles/footer.css";
import "../styles/home-mobile.css";

import Header from "../components/Header.astro";
import HeroSearch from "../components/HeroSearch.astro";
import ProductFinder from "../components/ProductFinder.astro";
import Benefits from "../components/Benefits.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import mobileLogo from "../assets/tonerymaxim-mobile-approved-logo.png";

const title = "ToneryMaxim.sk";
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body class="home-page">
    <div class="page">
      <Header />

      <main>
        <section class="tm-mobile-home-final" aria-label="Mobilná úvodná stránka ToneryMaxim">
          <div class="tm-mobile-topbar">
            <button class="tm-mobile-menu-button" type="button" aria-label="Otvoriť menu" aria-expanded="false" data-tm-mobile-menu-toggle>
              <span></span>
              <span></span>
              <span></span>
            </button>

            <a class="tm-mobile-logo-link" href="/" aria-label="ToneryMaxim domov">
              <img src={mobileLogo.src} alt="ToneryMaxim" loading="eager" decoding="async" />
            </a>

            <a class="tm-mobile-cart-link" href="/kosik" aria-label="Košík">
              <span aria-hidden="true">🛒</span>
              <strong data-cart-count>0</strong>
            </a>
          </div>

          <div class="tm-mobile-drawer" data-tm-mobile-menu aria-hidden="true">
            <div class="tm-mobile-drawer-panel">
              <div class="tm-mobile-drawer-head">
                <strong>Menu</strong>
                <button type="button" aria-label="Zavrieť menu" data-tm-mobile-menu-close>×</button>
              </div>

              <section>
                <strong>Môj účet</strong>
                <a href="/prihlasenie">Prihlásenie</a>
                <a href="/ucet">Môj účet</a>
                <a href="/ucet/objednavky">Moje objednávky</a>
              </section>

              <section>
                <strong>Informácie</strong>
                <a href="/kontakt">Kontakt</a>
                <a href="/doprava-a-platba">Doprava a platba</a>
                <a href="/reklamacie">Reklamácie</a>
                <a href="/obchodne-podmienky">Obchodné podmienky</a>
                <a href="/ochrana-osobnych-udajov">Ochrana osobných údajov</a>
              </section>

              <section>
                <strong>Ponuka</strong>
                <a href="/produkty?category=tonery&search=toner">Tonery</a>
                <a href="/produkty?category=atramentove-naplne&search=atramentov%C3%A9%20n%C3%A1plne">Atramentové náplne</a>
                <a href="/produkty?category=opticke-valce&search=optick%C3%A9%20valce">Valce</a>
                <a href="/produkty?category=ostatne-komponenty&search=ostatn%C3%A9%20komponenty">Komponenty</a>
              </section>
            </div>
          </div>

          <div class="tm-mobile-content">
            <form class="tm-mobile-hero-search" action="/produkty" method="get" data-smart-search>
              <span class="tm-mobile-search-icon" aria-hidden="true">⌕</span>
              <input
                type="search"
                name="s"
                data-smart-search-input
                placeholder="Hľadať tlačiareň alebo toner"
                aria-label="Hľadať tlačiareň alebo toner"
              />
              <button type="submit" aria-label="Vyhľadať">›</button>
            </form>

            <div class="tm-mobile-search-examples" aria-label="Príklady hľadania">
              <a href="/produkty?s=HP%20M110w">HP M110w</a>
              <a href="/produkty?s=Brother%20DCP-L2532DW">Brother DCP-L2532DW</a>
              <a href="/produkty?s=HP%20305">HP 305</a>
              <a href="/produkty?s=TN-2421">TN-2421</a>
              <a href="/produkty?s=HP%20LaserJet%20M1132MFP">HP LaserJet M1132MFP</a>
              <a href="/produkty?s=W1420A">W1420A</a>
            </div>

            <a class="tm-mobile-printer-picker" href="/tlaciarne">
              <span class="tm-mobile-printer-icon" aria-hidden="true">▣</span>
              <strong>Vybrať podľa tlačiarne</strong>
              <span class="tm-mobile-printer-arrow" aria-hidden="true">›</span>
            </a>

            <div class="tm-mobile-trust-row" aria-label="Výhody nákupu">
              <article>
                <span class="tm-trust-icon tm-pink" aria-hidden="true">♡</span>
                <strong>17 rokov</strong>
                <small>skúseností</small>
              </article>
              <article>
                <span class="tm-trust-icon tm-cyan" aria-hidden="true">□</span>
                <strong>30 000+</strong>
                <small>objednávok</small>
              </article>
              <article>
                <span class="tm-trust-icon tm-yellow" aria-hidden="true">▱</span>
                <strong>Doručenie</strong>
                <small>do 24h</small>
              </article>
              <article>
                <span class="tm-trust-icon tm-green" aria-hidden="true">☆</span>
                <strong>Heureka</strong>
                <small>4,9/5</small>
              </article>
            </div>

            <section class="tm-mobile-help-card">
              <div class="tm-mobile-help-icon" aria-hidden="true">?</div>
              <div class="tm-mobile-help-copy">
                <h2>Potrebujete poradiť?</h2>
                <p>Sme tu pre vás.</p>
              </div>
              <a href="/kontakt">Kontaktujte nás</a>
            </section>

            <div class="tm-mobile-footer-lock" aria-label="Doména">
              <span aria-hidden="true">🔒</span> tonerymaxim.sk
            </div>
          </div>
        </section>

        <HeroSearch />
        <ProductFinder />
        <Benefits />
      </main>

      <Footer showTrust={false} />
      <FloatingAdvisor />
    </div>

    <script>
      const menuToggle = document.querySelector('[data-tm-mobile-menu-toggle]');
      const menu = document.querySelector('[data-tm-mobile-menu]');
      const menuClose = document.querySelector('[data-tm-mobile-menu-close]');

      function setMenu(open) {
        if (!menu || !menuToggle) return;
        menu.classList.toggle('is-open', open);
        menu.setAttribute('aria-hidden', String(!open));
        menuToggle.setAttribute('aria-expanded', String(open));
        document.documentElement.classList.toggle('tm-menu-open', open);
      }

      menuToggle?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
      menuClose?.addEventListener('click', () => setMenu(false));
      menu?.addEventListener('click', (event) => {
        if (event.target === menu) setMenu(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenu(false);
      });
    </script>
  </body>
</html>
