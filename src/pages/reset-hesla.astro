---
import "../styles/global.css";
import "../styles/footer.css";
import "../styles/account.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import { readCustomerSession } from "../lib/auth-session";
import { verifyPasswordResetToken } from "../lib/password-reset";

const session = readCustomerSession(Astro.cookies);
if (session) return Astro.redirect("/ucet");

const token = Astro.url.searchParams.get("token") || "";
const validToken = Boolean(await verifyPasswordResetToken(token));
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset hesla | ToneryMaxim.sk</title>
  </head>
  <body>
    <div class="page account-page">
      <Header />
      <main class="auth-wrap">
        <section class="auth-card">
          <img class="auth-logo" src="/images/tonerymaxim-logo-sharp.png" alt="ToneryMaxim" width="1270" height="222" decoding="async" />
          <h1>Nastavenie nového hesla</h1>
          <p>Zadajte nové heslo k svojmu zákazníckemu účtu.</p>

          <div class:list={["auth-alert", !validToken && "is-error"]} data-auth-message hidden={validToken}>
            Odkaz na obnovu hesla je neplatný alebo expiroval. Požiadajte o nový odkaz.
          </div>

          {validToken ? (
            <form class="auth-form" data-reset-form>
              <input type="hidden" name="token" value={token} />
              <div class="tm-field">
                <label for="new-password">Nové heslo</label>
                <input id="new-password" name="password" type="password" placeholder="12 až 128 znakov" autocomplete="new-password" required minlength="12" maxlength="128" />
              </div>
              <div class="tm-field">
                <label for="new-password2">Potvrďte heslo</label>
                <input id="new-password2" name="password2" type="password" placeholder="zopakujte heslo" autocomplete="new-password" required minlength="12" maxlength="128" />
              </div>
              <button class="tm-btn" type="submit" data-auth-submit>Zmeniť heslo</button>
            </form>
          ) : (
            <p class="auth-switch"><a href="/zabudnute-heslo">Požiadať o nový odkaz</a></p>
          )}

          <p class="auth-switch"><a href="/prihlasenie">Späť na prihlásenie</a></p>
        </section>

        <section class="auth-benefits is-grid" aria-label="Bezpečnosť obnovy hesla">
          <div class="auth-benefit-card"><strong>🔐 Bezpečná obnova</strong><p>Odkaz je podpísaný a má obmedzenú platnosť.</p></div>
          <div class="auth-benefit-card"><strong>📩 E-mail ToneryMAXIM</strong><p>Obnova hesla sa odosiela priamo z adresy ToneryMAXIM.sk.</p></div>
          <div class="auth-benefit-card"><strong>🔁 Nové heslo</strong><p>Po zmene hesla sa prihlásite už novým heslom.</p></div>
          <div class="auth-benefit-card"><strong>💬 Pomoc s účtom</strong><p>Ak obnova nefunguje, účet vieme preveriť podľa e-mailu.</p></div>
        </section>
      </main>
      <Footer />
      <FloatingAdvisor />
    </div>

    <script>
      const form = document.querySelector<HTMLFormElement>("[data-reset-form]")!;
      const message = document.querySelector<HTMLElement>("[data-auth-message]")!;
      const submit = document.querySelector<HTMLButtonElement>("[data-auth-submit]")!;

      function showMessage(text: string, type = "error") {
        message.hidden = false;
        message.textContent = text;
        message.className = `auth-alert is-${type}`;
      }

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const data = Object.fromEntries(new FormData(form));

        submit.disabled = true;
        submit.textContent = "Mením heslo...";
        message.hidden = true;

        try {
          const response = await fetch("/api/auth/reset-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.error || "Heslo sa nepodarilo zmeniť.");

          showMessage(result.message || "Heslo bolo úspešne zmenené.", "success");
          setTimeout(() => {
            window.location.href = result.redirect || "/prihlasenie?password-reset=1";
          }, 1200);
        } catch (error) {
          showMessage(error instanceof Error ? error.message : "Heslo sa nepodarilo zmeniť.");
        } finally {
          submit.disabled = false;
          submit.textContent = "Zmeniť heslo";
        }
      });
    </script>
  </body>
</html>
