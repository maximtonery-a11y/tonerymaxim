---
import { readCheckoutProfiles, summarizeCheckoutProfiles } from '../../lib/checkout-profiler';

export const prerender = false;

import { getAdminAccessKey, isAdminLocked } from '../../lib/admin-access';
const adminKey = getAdminAccessKey(Astro.locals);
const suppliedKey = Astro.url.searchParams.get('key') || '';
const locked = isAdminLocked({ adminKey, suppliedKey, hostname: Astro.url.hostname });
const records = locked ? [] : await readCheckoutProfiles(150);
const summary = summarizeCheckoutProfiles(records);

const fmt = new Intl.NumberFormat('sk-SK');
const timeFmt = new Intl.DateTimeFormat('sk-SK', { dateStyle: 'short', timeStyle: 'medium' });

function ms(value: number) {
  if (!Number.isFinite(value)) return '—';
  return `${fmt.format(Math.round(value))} ms`;
}

function seconds(value: number) {
  if (!Number.isFinite(value)) return '—';
  return `${(value / 1000).toFixed(2).replace('.', ',')} s`;
}

function asText(value: unknown) {
  if (value === null || value === undefined || value === '') return '—';
  if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') return String(value);
  try { return JSON.stringify(value); } catch { return '—'; }
}
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>TM Performance</title>
    <style>
      :root { color-scheme: light; font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #081a3a; background: #f4f8ff; }
      * { box-sizing: border-box; }
      body { margin: 0; padding: 28px; }
      main { max-width: 1380px; margin: 0 auto; }
      h1 { margin: 0 0 8px; font-size: clamp(34px, 4vw, 58px); letter-spacing: -0.055em; }
      h2 { margin: 0 0 14px; font-size: 22px; letter-spacing: -0.03em; }
      p { color: #54627a; line-height: 1.55; }
      .top { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 22px; }
      .badge { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px; background: #fff; border: 1px solid #dbe6f6; font-weight: 900; }
      .grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; margin-bottom: 16px; }
      .card { background: #fff; border: 1px solid #dbe6f6; border-radius: 22px; padding: 18px; box-shadow: 0 18px 50px rgba(8, 26, 58, 0.08); }
      .metric span { display: block; color: #6b7890; font-size: 12px; font-weight: 900; text-transform: uppercase; letter-spacing: .05em; }
      .metric strong { display: block; margin-top: 8px; font-size: clamp(26px, 3vw, 36px); letter-spacing: -0.05em; }
      .two { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 16px; margin-top: 16px; align-items: start; }
      table { width: 100%; border-collapse: collapse; font-size: 14px; }
      th, td { padding: 10px 8px; border-bottom: 1px solid #edf2fa; text-align: left; vertical-align: top; }
      th { color: #6b7890; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; }
      td.num, th.num { text-align: right; white-space: nowrap; }
      .status { display: inline-flex; padding: 5px 9px; border-radius: 999px; font-weight: 900; font-size: 12px; }
      .ok { color: #087b43; background: #e9f9f0; }
      .fail { color: #b42318; background: #fff0ed; }
      details { border: 1px solid #e4ecf8; border-radius: 16px; padding: 12px 14px; background: #fbfdff; margin-bottom: 10px; }
      summary { cursor: pointer; font-weight: 900; }
      .muted { color: #6b7890; }
      .steps { margin-top: 12px; }
      .steps td:first-child { width: 58%; }
      .locked { max-width: 680px; margin: 90px auto; text-align: center; }
      .warn { color: #9a3412; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 16px; padding: 12px 14px; font-weight: 800; }
      @media (max-width: 980px) { body { padding: 18px; } .top, .two { display: block; } .grid { grid-template-columns: 1fr 1fr; } .card { margin-bottom: 14px; } }
      @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } table { font-size: 13px; } }
    </style>
  </head>
  <body>
    <main>
      {locked ? (
        <section class="card locked">
          <h1>TM Performance</h1>
          <p>Prehľad je chránený. Otvor ho s platným parametrom <strong>?key=...</strong>.</p>
        </section>
      ) : (
        <>
          <div class="top">
            <div>
              <h1>TM Performance</h1>
              <p>Meranie rýchlosti odoslania objednávky. Pošli testovaciu objednávku a obnov túto stránku.</p>
            </div>
            <div class="badge">Záznamy: {fmt.format(summary.total)}</div>
          </div>

          {summary.total === 0 && (
            <p class="warn">Zatiaľ nie je uložený žiadny profil objednávky. Odošli testovaciu objednávku a obnov stránku.</p>
          )}

          <section class="grid">
            <div class="card metric"><span>Úspešné</span><strong>{fmt.format(summary.completed)}</strong></div>
            <div class="card metric"><span>Chybné</span><strong>{fmt.format(summary.failed)}</strong></div>
            <div class="card metric"><span>Priemer</span><strong>{seconds(summary.avgMs)}</strong></div>
            <div class="card metric"><span>P95</span><strong>{seconds(summary.p95Ms)}</strong></div>
            <div class="card metric"><span>Posledná</span><strong>{summary.recent[0] ? seconds(summary.recent[0].totalMs) : '—'}</strong></div>
          </section>

          <section class="two">
            <div class="card">
              <h2>Najpomalšie kroky</h2>
              <table>
                <thead><tr><th>Krok</th><th class="num">Priemer</th><th class="num">Max</th><th class="num">Počet</th></tr></thead>
                <tbody>
                  {summary.slowSteps.map((item) => (
                    <tr>
                      <td>{item.step}</td>
                      <td class="num">{ms(item.avgMs)}</td>
                      <td class="num">{ms(item.maxMs)}</td>
                      <td class="num">{fmt.format(item.count)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="card">
              <h2>Posledné objednávkové merania</h2>
              {summary.recent.map((record) => (
                <details open={summary.recent.indexOf(record) === 0}>
                  <summary>
                    <span class:list={['status', record.ok ? 'ok' : 'fail']}>{record.ok ? 'OK' : 'CHYBA'}</span>
                    {' '}{timeFmt.format(new Date(record.ts))} · {record.name} · {seconds(record.totalMs)}
                  </summary>

                  <div class="steps">
                    <table>
                      <thead><tr><th>Krok</th><th class="num">Čas</th></tr></thead>
                      <tbody>
                        {record.steps.map((step) => (
                          <tr><td>{step.step}</td><td class="num">{ms(step.ms)}</td></tr>
                        ))}
                      </tbody>
                    </table>
                  </div>

                  <p class="muted">
                    Objednávka: {asText(record.extra.orderNumber)} · ID: {asText(record.extra.orderId || record.extra.paymentId)} · Platba: {asText(record.extra.paymentCode)} · Položky: {asText(record.extra.cartItems)}
                  </p>
                  {record.error && <p class="warn">{record.error}</p>}
                </details>
              ))}
            </div>
          </section>
        </>
      )}
    </main>
  </body>
</html>