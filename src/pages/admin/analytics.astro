---
export const prerender = false;

function env(name: string): string {
  return String(
    process.env[name] ??
      (import.meta.env as Record<string, string | undefined>)[name] ??
      '',
  ).trim();
}

const configuredKey = env('TM_ANALYTICS_ADMIN_KEY') || env('ADMIN_API_SECRET');
const suppliedKey = Astro.url.searchParams.get('key') || '';
const authorized = Boolean(configuredKey && suppliedKey && configuredKey === suppliedKey);
if (!authorized) Astro.response.status = 401;
const keyJson = JSON.stringify(suppliedKey).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>TM Live Analytics</title>
    <style>
      :root { font-family: Geist, Inter, system-ui, sans-serif; color: #071d45; background: #edf4ff; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; }
      button, input { font: inherit; }
      .shell { width: min(1480px, calc(100% - 32px)); margin: 0 auto; padding: 32px 0 64px; }
      .top { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:24px; }
      h1 { margin:0; font-size:clamp(32px,5vw,58px); line-height:1; letter-spacing:-.04em; }
      .sub { margin:10px 0 0; color:#62708a; }
      .actions { display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; }
      .btn { border:0; border-radius:12px; padding:12px 16px; font-weight:800; cursor:pointer; background:#082653; color:#fff; }
      .btn.blue { background:#1769ff; }
      .btn.light { color:#082653; background:#fff; border:1px solid #d8e3f4; }
      .stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-bottom:18px; }
      .stat,.panel { background:#fff; border:1px solid #dbe6f4; border-radius:20px; box-shadow:0 12px 34px rgba(24,57,101,.07); }
      .stat { padding:20px; }
      .stat small { display:block; color:#6c7890; font-weight:700; text-transform:uppercase; letter-spacing:.05em; }
      .stat strong { display:block; font-size:38px; margin-top:6px; }
      .grid { display:grid; grid-template-columns:380px minmax(0,1fr); gap:18px; align-items:start; }
      .panel { padding:20px; }
      .panel h2 { margin:0 0 16px; font-size:22px; }
      .calendar-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
      .calendar-head button { border:1px solid #d8e3f4; background:#f7faff; width:38px; height:38px; border-radius:10px; cursor:pointer; }
      .week,.days { display:grid; grid-template-columns:repeat(7,1fr); gap:6px; }
      .week span { text-align:center; color:#8390a6; font-size:12px; font-weight:800; }
      .day { min-height:56px; border:1px solid #e1e9f5; background:#fff; border-radius:11px; padding:7px; text-align:left; cursor:pointer; position:relative; color:#0b234b; }
      .day:hover { border-color:#1769ff; }
      .day.selected { background:#082653; color:#fff; border-color:#082653; }
      .day.empty { visibility:hidden; }
      .count { display:block; margin-top:5px; font-size:11px; font-weight:800; color:#1769ff; }
      .day.selected .count { color:#9fc2ff; }
      .filters { display:flex; gap:12px; align-items:center; justify-content:space-between; flex-wrap:wrap; margin-bottom:14px; }
      .filters input { border:1px solid #d7e2f1; padding:11px 12px; border-radius:10px; }
      .switch { display:flex; gap:8px; align-items:center; color:#5f6e87; font-size:14px; }
      .visits { display:flex; flex-direction:column; gap:10px; }
      .visit { width:100%; border:1px solid #dfe8f4; background:#fff; border-radius:14px; padding:14px; text-align:left; cursor:pointer; display:grid; grid-template-columns:110px 100px minmax(0,1fr) 110px; gap:12px; align-items:center; }
      .visit:hover { border-color:#1769ff; box-shadow:0 8px 24px rgba(24,57,101,.08); }
      .time { font-weight:900; font-size:17px; }
      .pill { display:inline-flex; width:max-content; border-radius:999px; padding:5px 9px; background:#eef4ff; color:#24508d; font-size:12px; font-weight:800; }
      .pill.owner { background:#fff3c6; color:#7a5300; }
      .meta { color:#68758a; font-size:13px; line-height:1.5; }
      .duration { font-weight:800; text-align:right; }
      .empty-state { padding:42px 20px; text-align:center; color:#7c889b; }
      dialog { width:min(920px,calc(100% - 28px)); border:0; border-radius:22px; padding:0; box-shadow:0 30px 100px rgba(0,20,60,.3); }
      dialog::backdrop { background:rgba(4,18,45,.58); }
      .modal-head { padding:20px 22px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #e1e8f2; }
      .modal-head h3 { margin:0; font-size:25px; }
      .close { border:0; background:#eef3fa; width:40px; height:40px; border-radius:50%; font-size:22px; cursor:pointer; }
      .modal-body { padding:22px; max-height:72vh; overflow:auto; }
      .detail-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; margin-bottom:20px; }
      .detail-box { background:#f5f8fd; border-radius:12px; padding:12px; }
      .detail-box small { color:#6d7990; display:block; }
      .detail-box strong { display:block; margin-top:4px; }
      .timeline { border-left:2px solid #dbe6f6; margin-left:8px; padding-left:20px; }
      .step { position:relative; padding:0 0 18px; }
      .step::before { content:''; position:absolute; left:-27px; top:4px; width:12px; height:12px; border-radius:50%; background:#1769ff; border:3px solid #fff; box-shadow:0 0 0 1px #b7c9e3; }
      .step b { display:block; }
      .step span { color:#6a768b; font-size:13px; }
      .error { padding:18px; color:#9b1c1c; background:#fff1f1; border:1px solid #ffd1d1; border-radius:14px; }
      .unauth { max-width:720px; margin:100px auto; background:#fff; border-radius:22px; padding:34px; border:1px solid #dbe6f4; }
      @media (max-width:900px) { .grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr}.visit{grid-template-columns:1fr 1fr}.duration{text-align:left}.detail-grid{grid-template-columns:1fr 1fr}.top{flex-direction:column}.actions{justify-content:flex-start} }
      @media (max-width:520px) { .shell{width:min(100% - 20px,1480px);padding-top:20px}.panel{padding:14px}.visit{grid-template-columns:1fr}.detail-grid{grid-template-columns:1fr}.day{min-height:48px;padding:5px}.count{font-size:10px} }
    </style>
  </head>
  <body>
    {authorized ? (
      <main class="shell">
        <header class="top">
          <div><h1>TM Live Analytics</h1><p class="sub">Skutočné návštevy zaznamenané priamo e-shopom.</p></div>
          <div class="actions">
            <button id="ownerBtn" class="btn blue">Označiť tento prehliadač ako môj</button>
            <button id="refreshBtn" class="btn light">Obnoviť</button>
          </div>
        </header>
        <section class="stats">
          <article class="stat"><small>Online teraz</small><strong id="onlineCount">–</strong></article>
          <article class="stat"><small>Návštevy dnes</small><strong id="todayCount">–</strong></article>
          <article class="stat"><small>Vybraný deň</small><strong id="selectedCount">–</strong></article>
        </section>
        <section class="grid">
          <aside class="panel">
            <div class="calendar-head"><button id="prevMonth" aria-label="Predchádzajúci mesiac">‹</button><h2 id="monthTitle"></h2><button id="nextMonth" aria-label="Ďalší mesiac">›</button></div>
            <div class="week"><span>Po</span><span>Ut</span><span>St</span><span>Št</span><span>Pi</span><span>So</span><span>Ne</span></div>
            <div id="calendar" class="days"></div>
          </aside>
          <section class="panel">
            <div class="filters">
              <div><h2 id="visitsTitle">Návštevy</h2><div id="generated" class="meta"></div></div>
              <label class="switch"><input type="checkbox" id="includeOwner" checked /> Zobraziť moje návštevy</label>
            </div>
            <div id="error"></div>
            <div id="visits" class="visits"><div class="empty-state">Načítavam…</div></div>
          </section>
        </section>
      </main>
    ) : (
      <main class="unauth"><h1>Prístup zamietnutý</h1><p>Otvorte stránku s platným kľúčom vo formáte <code>/admin/analytics?key=VAS_KLUC</code>.</p></main>
    )}
    <dialog id="visitDialog">
      <div class="modal-head"><h3 id="dialogTitle">Detail návštevy</h3><button class="close" id="closeDialog">×</button></div>
      <div class="modal-body" id="dialogBody"></div>
    </dialog>
    {authorized && <script is:inline define:vars={{ keyJson }}>
      const ADMIN_KEY = JSON.parse(keyJson);
      const $ = (id) => document.getElementById(id);
      const fmtDate = new Intl.DateTimeFormat('sk-SK', { timeZone:'Europe/Bratislava', day:'2-digit', month:'2-digit', year:'numeric' });
      const fmtTime = new Intl.DateTimeFormat('sk-SK', { timeZone:'Europe/Bratislava', hour:'2-digit', minute:'2-digit', second:'2-digit' });
      const monthFmt = new Intl.DateTimeFormat('sk-SK', { month:'long', year:'numeric' });
      let selectedDate = new Intl.DateTimeFormat('en-CA', { timeZone:'Europe/Bratislava', year:'numeric', month:'2-digit', day:'2-digit' }).format(new Date());
      let visibleMonth = new Date(selectedDate + 'T12:00:00');
      let data = null;

      function duration(ms) {
        const sec = Math.max(0, Math.round((Number(ms)||0)/1000));
        const h = Math.floor(sec/3600), m = Math.floor((sec%3600)/60), s = sec%60;
        return h ? `${h} h ${m} min` : m ? `${m} min ${s} s` : `${s} s`;
      }
      function esc(value) { return String(value ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c])); }
      function dayKey(date) { const y=date.getFullYear(), m=String(date.getMonth()+1).padStart(2,'0'), d=String(date.getDate()).padStart(2,'0'); return `${y}-${m}-${d}`; }
      async function load() {
        $('error').innerHTML = '';
        const includeOwner = $('includeOwner').checked ? '1' : '0';
        try {
          const response = await fetch(`/api/admin/analytics?key=${encodeURIComponent(ADMIN_KEY)}&date=${selectedDate}&includeOwner=${includeOwner}`, { cache:'no-store' });
          const payload = await response.json();
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Načítanie zlyhalo.');
          data = payload; render();
        } catch (error) {
          $('error').innerHTML = `<div class="error">${esc(error.message)}</div>`;
          $('visits').innerHTML = '';
        }
      }
      function render() {
        $('onlineCount').textContent = data.onlineCount;
        $('todayCount').textContent = data.todayCount;
        $('selectedCount').textContent = data.selectedCount;
        $('visitsTitle').textContent = `${fmtDate.format(new Date(selectedDate+'T12:00:00'))} — ${data.selectedCount} návštev`;
        $('generated').textContent = `Aktualizované ${fmtTime.format(new Date(data.generatedAt))}`;
        renderCalendar(); renderVisits();
      }
      function renderCalendar() {
        $('monthTitle').textContent = monthFmt.format(visibleMonth);
        const counts = new Map((data?.dailyCounts || []).map(x => [x.day, x]));
        const first = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth(), 1);
        const last = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth()+1, 0);
        const offset = (first.getDay()+6)%7;
        const cells = [];
        for (let i=0;i<offset;i++) cells.push('<button class="day empty" disabled></button>');
        for (let d=1;d<=last.getDate();d++) {
          const date = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth(), d);
          const key = dayKey(date), count = counts.get(key)?.total || 0;
          cells.push(`<button class="day ${key===selectedDate?'selected':''}" data-date="${key}"><b>${d}</b>${count?`<span class="count">${count} návštev</span>`:''}</button>`);
        }
        $('calendar').innerHTML = cells.join('');
        document.querySelectorAll('[data-date]').forEach(btn => btn.addEventListener('click', () => { selectedDate=btn.dataset.date; load(); }));
      }
      function renderVisits() {
        if (!data.visits.length) { $('visits').innerHTML='<div class="empty-state">V tento deň nebola zaznamenaná žiadna návšteva.</div>'; return; }
        $('visits').innerHTML = data.visits.map((v,i) => `<button class="visit" data-index="${i}">
          <div><div class="time">${fmtTime.format(new Date(v.startedAt))}</div><div class="meta">${fmtDate.format(new Date(v.startedAt))}</div></div>
          <div><span class="pill">${esc(v.device)}</span>${v.owner?'<span class="pill owner">MOJA</span>':''}</div>
          <div><b>${v.pageviews} stránok</b><div class="meta">${esc(v.source)}${v.products.length?` · ${esc(v.products[0])}`:''}</div></div>
          <div class="duration">${duration(v.durationMs)}</div>
        </button>`).join('');
        document.querySelectorAll('.visit').forEach(btn => btn.addEventListener('click', () => openVisit(data.visits[Number(btn.dataset.index)])));
      }
      function openVisit(v) {
        $('dialogTitle').textContent = `Návšteva ${fmtTime.format(new Date(v.startedAt))}`;
        const timeline = v.pages.map(p => `<div class="step"><b>${esc(p.path)}</b><span>${fmtTime.format(new Date(p.enteredAt))} · ${duration(p.durationMs)}${p.title?` · ${esc(p.title)}`:''}</span></div>`).join('');
        $('dialogBody').innerHTML = `<div class="detail-grid">
          <div class="detail-box"><small>Trvanie</small><strong>${duration(v.durationMs)}</strong></div>
          <div class="detail-box"><small>Aktívny čas</small><strong>${duration(v.activeMs)}</strong></div>
          <div class="detail-box"><small>Stránky</small><strong>${v.pageviews}</strong></div>
          <div class="detail-box"><small>Zariadenie</small><strong>${esc(v.device)}</strong></div>
        </div>
        <p class="meta"><b>Zdroj:</b> ${esc(v.source)} &nbsp; <b>Referer:</b> ${esc(v.referrer || 'priamy vstup')}</p>
        ${v.searches.length?`<p><b>Vyhľadávania:</b> ${v.searches.map(esc).join(', ')}</p>`:''}
        ${v.products.length?`<p><b>Produkty:</b> ${v.products.map(esc).join(', ')}</p>`:''}
        <h3>Prezerané stránky</h3><div class="timeline">${timeline || '<p>Bez stránok.</p>'}</div>`;
        $('visitDialog').showModal();
      }
      $('closeDialog').addEventListener('click', () => $('visitDialog').close());
      $('refreshBtn').addEventListener('click', load);
      $('includeOwner').addEventListener('change', load);
      $('prevMonth').addEventListener('click', () => { visibleMonth = new Date(visibleMonth.getFullYear(),visibleMonth.getMonth()-1,1); renderCalendar(); });
      $('nextMonth').addEventListener('click', () => { visibleMonth = new Date(visibleMonth.getFullYear(),visibleMonth.getMonth()+1,1); renderCalendar(); });
      $('ownerBtn').addEventListener('click', async () => {
        const response = await fetch(`/api/admin/analytics-owner?key=${encodeURIComponent(ADMIN_KEY)}`, { method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify({enabled:true}) });
        const payload = await response.json();
        if (!response.ok || !payload.ok) return alert(payload.error || 'Označenie zlyhalo.');
        $('ownerBtn').textContent='Tento prehliadač je označený ako môj';
        alert('Hotovo. Nové návštevy z tohto prehliadača budú označené ako MOJA.');
      });
      load();
      setInterval(load, 30000);
    </script>}
  </body>
</html>
