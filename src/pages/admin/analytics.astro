---
import { getAdminAccessKey, constantTimeEqual } from '../../lib/admin-access';
export const prerender = false;
const expected = getAdminAccessKey(Astro.locals);
const key = Astro.url.searchParams.get('key') || '';
const locked = !expected || !constantTimeEqual(expected, key);
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Bratislava', year:'numeric', month:'2-digit', day:'2-digit' }).format(new Date());
---
<!doctype html><html lang="sk"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>TM návštevy</title>
<style>
:root{font-family:Inter,system-ui,sans-serif;color:#071a3b;background:#f3f7fd}*{box-sizing:border-box}body{margin:0;padding:28px}.wrap{max-width:1320px;margin:auto}.head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}h1{font-size:clamp(34px,5vw,60px);margin:0;letter-spacing:-.05em}p{color:#63708a}.toolbar,.metrics,.visit-grid{display:grid;gap:14px}.toolbar{grid-template-columns:1fr auto auto;align-items:end}.metrics{grid-template-columns:repeat(3,1fr);margin:18px 0}.card{background:#fff;border:1px solid #dce7f5;border-radius:20px;padding:18px;box-shadow:0 14px 40px #0a285014}.metric small{font-weight:800;color:#68758c;text-transform:uppercase}.metric strong{display:block;font-size:38px;margin-top:7px}.btn,input{border:1px solid #ccd9ec;border-radius:12px;padding:12px 14px;font:inherit}.btn{background:#08224a;color:#fff;font-weight:800;cursor:pointer}.btn.secondary{background:#fff;color:#08224a}.switch{display:flex;align-items:center;gap:8px;font-weight:700}.visits{display:grid;grid-template-columns:430px 1fr;gap:16px}.list{max-height:680px;overflow:auto}.visit{width:100%;text-align:left;background:#fff;border:0;border-bottom:1px solid #e8eef7;padding:14px;cursor:pointer}.visit:hover,.visit.active{background:#edf5ff}.row{display:flex;justify-content:space-between;gap:12px}.owner{display:inline-block;background:#fff3c8;color:#8a5a00;border-radius:999px;padding:3px 8px;font-size:11px;font-weight:900}.detail h2{margin-top:0}.timeline{margin-top:14px}.page{display:grid;grid-template-columns:90px 1fr auto;gap:12px;padding:12px 0;border-bottom:1px solid #edf2f8}.muted{color:#6b7890}.empty{text-align:center;padding:60px 20px;color:#6b7890}.locked{max-width:600px;margin:80px auto}.spin{opacity:.55;pointer-events:none}@media(max-width:900px){body{padding:14px}.toolbar,.metrics,.visits{grid-template-columns:1fr}.list{max-height:360px}.page{grid-template-columns:70px 1fr}.page span:last-child{grid-column:2}}
</style></head><body><main class="wrap">
{locked ? <section class="card locked"><h1>TM návštevy</h1><p>Neplatný alebo chýbajúci administrátorský kľúč.</p></section> : <>
<div class="head"><div><h1>TM návštevy</h1><p>Každá návšteva je samostatná reálna relácia zaznamenaná priamo e-shopom.</p></div><button id="ownerBtn" class="btn secondary">Označiť tento prehliadač ako môj</button></div>
<section class="card toolbar"><label><strong>Dátum</strong><br><input id="date" type="date" value={today}></label><label class="switch"><input id="includeOwner" type="checkbox" checked> Zobraziť moje návštevy</label><button id="refresh" class="btn">Načítať</button></section>
<section class="metrics"><div class="card metric"><small>Online teraz</small><strong id="online">—</strong></div><div class="card metric"><small>Návštevy vo vybraný deň</small><strong id="total">—</strong></div><div class="card metric"><small>Vybraný dátum</small><strong id="selectedDate" style="font-size:25px">—</strong></div></section>
<section class="visits"><div class="card list" id="visitList"><div class="empty">Načítavam…</div></div><div class="card detail" id="detail"><div class="empty">Vyberte návštevu.</div></div></section>
<script define:vars={{key}}>
const qs=s=>document.querySelector(s), api='/api/admin-analytics?key='+encodeURIComponent(key);let data=null;
const fmtDur=ms=>{const s=Math.max(0,Math.round(ms/1000)),m=Math.floor(s/60),h=Math.floor(m/60);return h?`${h} h ${m%60} min`:m?`${m} min ${s%60} s`:`${s} s`};
const fmtTime=iso=>new Intl.DateTimeFormat('sk-SK',{timeZone:'Europe/Bratislava',hour:'2-digit',minute:'2-digit',second:'2-digit'}).format(new Date(iso));
async function load(){document.body.classList.add('spin');try{const d=qs('#date').value,own=qs('#includeOwner').checked?'1':'0';const r=await fetch(`${api}&date=${d}&includeOwner=${own}`,{cache:'no-store'});data=await r.json();if(!data.ok)throw new Error(data.error);render();}catch(e){qs('#visitList').innerHTML='<div class="empty">Načítanie zlyhalo.</div>'}finally{document.body.classList.remove('spin')}}
function render(){qs('#online').textContent=data.onlineVisits;qs('#total').textContent=data.totalVisits;qs('#selectedDate').textContent=new Intl.DateTimeFormat('sk-SK',{dateStyle:'long'}).format(new Date(data.date+'T12:00:00'));
qs('#visitList').innerHTML=data.visits.length?data.visits.map((v,i)=>`<button class="visit" data-i="${i}"><div class="row"><strong>${fmtTime(v.startedAt)}</strong><span>${fmtDur(v.durationMs)}</span></div><div class="row muted"><span>${v.device} · ${v.source}</span><span>${v.pageviews} strán</span></div>${v.owner?'<span class="owner">MOJA NÁVŠTEVA</span>':''}</button>`).join(''):'<div class="empty">V tento deň nebola zaznamenaná žiadna návšteva.</div>';qs('#detail').innerHTML='<div class="empty">Vyberte návštevu.</div>';document.querySelectorAll('.visit').forEach(b=>b.onclick=()=>show(Number(b.dataset.i),b));}
function show(i,b){document.querySelectorAll('.visit').forEach(x=>x.classList.remove('active'));b.classList.add('active');const v=data.visits[i];qs('#detail').innerHTML=`<h2>Návšteva ${v.owner?'<span class="owner">MOJA</span>':''}</h2><div class="visit-grid"><div><strong>Začiatok:</strong> ${fmtTime(v.startedAt)}</div><div><strong>Posledná aktivita:</strong> ${fmtTime(v.lastSeenAt)}</div><div><strong>Trvanie:</strong> ${fmtDur(v.durationMs)}</div><div><strong>Aktívny čas:</strong> ${fmtDur(v.activeMs)}</div><div><strong>Zariadenie:</strong> ${v.device}</div><div><strong>Zdroj:</strong> ${v.source}</div></div><div class="timeline"><h3>Prezerané stránky</h3>${v.pages.map(p=>`<div class="page"><strong>${fmtTime(p.enteredAt)}</strong><span><b>${esc(p.path)}</b>${p.title?'<br><span class="muted">'+esc(p.title)+'</span>':''}</span><span>${fmtDur(p.durationMs)}</span></div>`).join('')}</div>${v.searches.length?'<h3>Vyhľadávania</h3><p>'+v.searches.map(esc).join(', ')+'</p>':''}`}
function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
qs('#refresh').onclick=load;qs('#date').onchange=load;qs('#includeOwner').onchange=load;qs('#ownerBtn').onclick=async()=>{await fetch(api,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'mark-owner'})});qs('#ownerBtn').textContent='Tento prehliadač je označený ako môj';load()};load();setInterval(load,30000);
</script></>}
</main></body></html>
