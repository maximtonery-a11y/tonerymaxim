<html lang="sk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>Reklama a analytika | ToneryMAXIM</title>
<style>
:root{font-family:Inter,system-ui,sans-serif;color:#10213b;background:#f4f7fb}*{box-sizing:border-box}body{margin:0}.shell{width:min(1480px,calc(100% - 32px));margin:auto;padding:26px 0 60px}.top{display:flex;justify-content:space-between;gap:18px;align-items:center}.top h1{margin:0;font-size:30px}.sub,.muted{color:#64748b}.status{padding:9px 13px;border-radius:999px;background:#fff4ce;color:#755300;font-weight:800}.stats{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin:22px 0}.card,.panel{background:#fff;border:1px solid #dfe7f1;border-radius:16px;padding:18px}.card small{color:#66758d}.card strong{display:block;font-size:27px;margin-top:6px}.nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}.nav button{border:1px solid #d7e1ed;background:#fff;padding:10px 14px;border-radius:10px;font-weight:750;cursor:pointer}.nav button.active{background:#1266e5;color:#fff;border-color:#1266e5}.tab[hidden]{display:none}.grid{display:grid;grid-template-columns:1.1fr .9fr;gap:14px}.panel h2{margin-top:0}.form{display:grid;grid-template-columns:1fr 1fr;gap:14px}.form label{font-size:13px;color:#52637b;font-weight:700}.form input,.form select,.form textarea{width:100%;margin-top:6px;padding:11px;border:1px solid #ccd8e7;border-radius:10px;font:inherit}.wide{grid-column:1/-1}.btn{border:0;border-radius:10px;padding:11px 16px;font-weight:800;cursor:pointer}.primary{background:#1266e5;color:#fff}.secondary{background:#eef4fc;color:#174b91}.note{background:#eef6ff;border-left:4px solid #1266e5;padding:13px;border-radius:9px}.list{display:grid;gap:10px}.row{border:1px solid #e1e8f2;border-radius:12px;padding:13px;display:flex;justify-content:space-between;gap:12px}.pill{font-size:12px;font-weight:800;padding:5px 9px;border-radius:999px;background:#eef4ff;color:#24508d;height:max-content}.empty{text-align:center;padding:30px;color:#74839a}.error{background:#fff0f0;color:#9a2020;padding:12px;border-radius:10px}@media(max-width:1000px){.stats{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}}@media(max-width:600px){.shell{width:min(100% - 20px,1480px)}.form{grid-template-columns:1fr}.wide{grid-column:auto}.stats{grid-template-columns:1fr 1fr}.card strong{font-size:21px}.top{align-items:flex-start;flex-direction:column}}
</style></head><body><main class="shell">
{locked?<section class="panel"><h1>Prístup zamietnutý</h1><p>Otvorte administráciu s platným administrátorským kľúčom.</p></section>:<div id="app" data-key={key}>
<header class="top"><div><h1>Reklama a analytika</h1><p class="sub">Google Ads, Merchant Center, zisk a správanie návštevníkov na jednom mieste.</p></div><span class="status" id="googleStatus">Kontrolujem Google Ads…</span></header>
<section class="stats"><article class="card"><small>Náklady / 30 dní</small><strong id="cost">–</strong></article><article class="card"><small>Tržby z reklamy</small><strong id="revenue">–</strong></article><article class="card"><small>Zisk po reklame</small><strong id="profit">–</strong></article><article class="card"><small>Objednávky</small><strong id="orders">–</strong></article><article class="card"><small>ROAS</small><strong id="roas">–</strong></article><article class="card"><small>POAS</small><strong id="poas">–</strong></article></section>
<nav class="nav"><button class="active" data-tab="overview">Prehľad</button><button data-tab="datav3">Dáta a zisk V3</button><button data-tab="optimizationv2">Optimalizácia V2</button><button data-tab="controlcenter">Čo treba urobiť</button><button data-tab="create">Vytvoriť reklamu</button><button data-tab="drafts">Koncepty</button><button data-tab="approval">Schvaľovanie</button><button data-tab="deployment">Publikačný rad</button><button data-tab="searchterms">Hľadané výrazy</button><button data-tab="creativeperformance">Výkon kreatív</button><button data-tab="creatives">Obrázky</button><button data-tab="merchant">Merchant</button><button data-tab="visitors">Návštevníci</button><button data-tab="settings">Nastavenia</button></nav>
<section class="tab" id="overview"><div class="grid"><article class="panel"><h2>Výsledky kampaní</h2><div id="campaigns" class="list"><div class="empty">Načítavam…</div></div></article><aside class="panel"><h2>Čo systém robí</h2><div class="note"><b>Bezpečný režim</b><p>Reklamy sa zatiaľ ukladajú ako koncepty. Bez vášho schválenia a bez povoleného zápisu do Google Ads sa nič nespustí.</p></div><p><a href="/admin/ads-intelligence" id="adsLink">Otvoriť podrobné rozhodnutia produktov</a></p><p><a href="/admin/analytics" id="analyticsLink">Otvoriť detail návštevníkov</a></p></aside></div></section>
<section class="tab" id="datav3" hidden><div class="grid"><article class="panel"><h2>Jedna pravda: reklama → objednávka → zisk</h2><div class="stats" style="grid-template-columns:repeat(3,1fr)"><article class="card"><small>Presne priradené</small><strong id="v3Exact">–</strong></article><article class="card"><small>Pravdepodobné</small><strong id="v3Probable">–</strong></article><article class="card"><small>Nepriradené</small><strong id="v3Unattributed">–</strong></article></div><div id="v3Summary" class="note">Načítavam…</div><h2 style="margin-top:22px">Cesty zákazníkov</h2><div id="v3Journeys" class="list"><div class="empty">Načítavam…</div></div></article><article class="panel"><h2>Merchant API</h2><div id="v3Merchant" class="note">Načítavam…</div><button class="btn secondary" id="v3MerchantSync" style="margin-top:12px">Načítať reálne stavy Google</button><p id="v3MerchantMsg" class="muted"></p><div id="v3MerchantIssues" class="list"></div><h2 style="margin-top:22px">Nákupné ceny</h2><div id="v3Economics" class="list"></div></article></div></section>
<section class="tab" id="optimizationv2" hidden><div class="grid"><article class="panel"><h2>Bezpečné optimalizačné návrhy</h2><p class="muted">Nič sa nemení automaticky. Schválenie znamená iba pripravené – nevykonané.</p><button class="btn primary" id="optimizationRefresh">Prepočítať návrhy</button><p id="optimizationMsg" class="muted"></p><div id="optimizationList" class="list"><div class="empty">Načítavam…</div></div></article><article class="panel"><h2>Nový A/B experiment</h2><form id="experimentForm" class="form"><label class="wide">Názov<input name="name" required placeholder="CRG-054 obrázok A vs. B"></label><label>Variant A<input name="variantA" required placeholder="ID obrázka alebo textu"></label><label>Variant B<input name="variantB" required placeholder="ID obrázka alebo textu"></label><label>Metrika<select name="metric"><option value="CONTRIBUTION_PROFIT">Zisk po reklame</option><option value="ORDERS">Objednávky</option><option value="CART_RATE">Košíky</option></select></label><label>Minimum návštev<input name="minimumVisits" type="number" min="60" value="100"></label><button class="btn primary wide" type="submit">Uložiť koncept experimentu</button></form><h2 style="margin-top:22px">Experimenty</h2><div id="experimentList" class="list"></div></article></div></section>
<section class="tab" id="controlcenter" hidden><div class="grid"><article class="panel"><h2>Čo treba dnes urobiť</h2><p class="muted">Zoradené podľa rizika a finančného dopadu. Systém iba odporúča.</p><div id="todayActions" class="list"><div class="empty">Načítavam…</div></div><h2 style="margin-top:24px">Upozornenia</h2><div id="marketingAlerts" class="list"></div></article><article class="panel"><h2>Rozpočet</h2><div id="budgetGuard" class="note">Načítavam…</div><h2 style="margin-top:24px">Reklamný lievik</h2><div id="paidFunnel" class="list"></div><h2 style="margin-top:24px">Vstupné stránky</h2><div id="landingDiagnostics" class="list"></div></article></div></section>
<section class="tab" id="create" hidden><div class="grid"><form class="panel form" id="draftForm"><h2 class="wide">Nový koncept reklamy</h2><label>Názov reklamy<input name="name" required placeholder="Napr. HP W1420A – kompatibilné"></label><label>Cieľ<select name="goal"><option value="profit">Najvyšší zisk</option><option value="orders">Viac objednávok</option><option value="new_customers">Noví zákazníci</option><option value="remarketing">Vrátiť návštevníkov</option></select></label><label>Typ reklamy<select name="channel"><option value="shopping">Shopping</option><option value="search">Search</option><option value="performance_max">Performance Max</option></select></label><label>Denný rozpočet €<input name="dailyBudgetEur" type="number" min="1" step="1" value="10"></label><label class="wide">Čo propagovať<input name="selection" required placeholder="Produkt, OEM kód, značka alebo skupina produktov"></label><label class="wide">Vlastný hlavný nadpis – nepovinné<input name="headline" maxlength="30" placeholder="Najviac 30 znakov"></label><label class="wide">Vlastný opis – nepovinné<textarea name="description" maxlength="90" rows="3" placeholder="Najviac 90 znakov"></textarea></label><div class="wide"><b>Reklamné obrázky pre PMax</b><div id="builderCreatives" class="list" style="margin-top:8px"><span class="muted">Načítajú sa z knižnice.</span></div></div><div class="wide"><button class="btn secondary" id="generatePlan" type="button">Skontrolovať a pripraviť reklamu</button> <button class="btn primary" type="submit">Uložiť koncept</button> <span class="muted" id="formMsg"></span></div></form><aside class="panel"><h2>Kontrola kampane</h2><div id="planPreview" class="empty">Zadajte, čo chcete propagovať, a kliknite na „Skontrolovať a pripraviť reklamu“.</div><p class="muted">Systém nič neposiela do Google Ads.</p></aside></div></section>
<section class="tab" id="drafts" hidden><article class="panel"><h2>Koncepty reklám</h2><div id="draftList" class="list"></div></article></section>
<section class="tab" id="approval" hidden><div class="grid"><article class="panel"><h2>Kontrola a schválenie</h2><p class="muted">Každý koncept sa znovu prepočíta na serveri podľa aktuálneho katalógu, skladu a marže. Schválenie stále nič neposiela do Google Ads.</p><div class="note"><b>Google validate-only</b><p>Po schválení API prístupu bude možné Search kampaň overiť priamo v Google. Požiadavka má napevno validateOnly=true a nevytvorí reklamu.</p></div><div id="approvalList" class="list" style="margin-top:12px"><div class="empty">Načítavam…</div></div></article><article class="panel"><h2>Audit zmien</h2><div id="auditList" class="list"><div class="empty">Zatiaľ bez záznamov.</div></div></article></div></section>
<section class="tab" id="deployment" hidden><div class="grid"><article class="panel"><h2>Pripraviť do publikačného radu</h2><p class="muted">Iba platné schválené kampane. Zaradenie ani potvrdenie reklamu nevytvorí.</p><div id="queueCandidates" class="list"><div class="empty">Načítavam…</div></div></article><article class="panel"><h2>Publikačný rad</h2><div class="note"><b>Dvojité potvrdenie</b><p>Pred validate-only kontrolou treba presne potvrdiť názov PAUSED kampane. Živý publish nie je dostupný.</p></div><div id="deploymentList" class="list" style="margin-top:12px"><div class="empty">Načítavam…</div></div></article></div></section>
<section class="tab" id="searchterms" hidden><div class="grid"><article class="panel"><h2>Čo ľudia hľadali v Google</h2><p class="muted">Read-only údaje za posledných 30 dní. Systém iba odporúča; nič automaticky nepridáva medzi negatívne slová.</p><div class="form"><label>Cieľové CPA €<input id="searchTermsCpa" type="number" min="1" max="1000" step="1" value="10"></label><div style="align-self:end"><button class="btn primary" id="searchTermsSync">Načítať z Google Ads</button> <button class="btn secondary" id="negativeExport">Stiahnuť schválené negatívne slová</button></div></div><p id="searchTermsMsg" class="muted"></p><div id="searchTermsSummary" class="note">Zatiaľ bez synchronizácie.</div></article><article class="panel"><h2>Odporúčania</h2><div id="searchTermsList" class="list"><div class="empty">Načítavam uložený report…</div></div></article></div></section>
<section class="tab" id="creativeperformance" hidden><div class="grid"><article class="panel"><h2>Výkon reklamných variantov</h2><p class="muted">Vlastná analytika podľa utm_content za posledných 30 dní. Malá vzorka zostáva v stave UČÍ SA a nespúšťa žiadne automatické zmeny.</p><div class="note"><b>Čo porovnávame</b><p>Návštevy, aktívny čas, počet stránok, košíky, pokladne, objednávky, obrat a konverzný pomer každého obrázka alebo textového variantu.</p></div></article><article class="panel"><h2>Varianty</h2><div id="creativePerformanceList" class="list"><div class="empty">Načítavam…</div></div></article></div></section>
<section class="tab" id="creatives" hidden><div class="grid"><form class="panel form" id="creativeForm"><h2 class="wide">Knižnica reklamných obrázkov</h2><label class="wide">Názov<input name="name" placeholder="Napr. ToneryMAXIM – doprava zdarma"></label><label class="wide">Obrázok JPG, PNG alebo WebP<input name="file" type="file" accept="image/jpeg,image/png,image/webp" required></label><div class="wide"><button class="btn primary" type="submit">Nahrať a skontrolovať</button> <span id="creativeMsg" class="muted"></span></div><p class="wide muted">Minimum 300 × 300 px, najviac 10 MB. Systém automaticky rozpozná vhodnosť pre štvorec, horizontálny alebo vertikálny formát.</p></form><article class="panel"><h2>Uložené obrázky</h2><div id="creativeList" class="list"><div class="empty">Načítavam…</div></div></article></div></section>
<section class="tab" id="merchant" hidden><div class="grid"><article class="panel"><h2>Merchant Center diagnostika</h2><div class="stats" style="grid-template-columns:repeat(3,1fr)"><article class="card"><small>Vhodné pre reklamu</small><strong id="mEligible">–</strong></article><article class="card"><small>Chyby</small><strong id="mErrors">–</strong></article><article class="card"><small>Upozornenia</small><strong id="mWarnings">–</strong></article></div><button class="btn secondary" id="merchantRefresh">Obnoviť diagnostiku</button></article><article class="panel"><h2>Najčastejšie problémy</h2><div id="merchantIssues" class="list"><div class="empty">Diagnostiku spustíme pri otvorení.</div></div></article></div></section>
<section class="tab" id="visitors" hidden><article class="panel"><h2>Návštevníci z reklamy</h2><p>Detailná cesta reklama → stránky → košík → objednávka je v TM Live Analytics.</p><a class="btn secondary" id="analyticsButton" href="/admin/analytics">Otvoriť TM Live Analytics</a></article></section>
<section class="tab" id="settings" hidden><article class="panel"><h2>Nastavenia a pravidlá</h2><p>Ekonomické limity, maximálne CPC a pravidlá UČÍ SA / PONECHAŤ / POSILNIŤ zostávajú v Ads Intelligence, kým ich prenesieme do zjednodušeného rozhrania.</p><a class="btn secondary" id="settingsButton" href="/admin/ads-intelligence">Otvoriť pravidlá</a></article></section>
