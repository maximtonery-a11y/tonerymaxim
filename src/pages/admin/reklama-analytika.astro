</div>}
{!locked&&<script is:inline>
const app=document.querySelector('#app'),key=app?.dataset.key||'',headers={'x-admin-key':key},api='/api/admin/marketing-overview';if(key&&location.search)history.replaceState(null,'',location.pathname);const money=v=>`${Number(v||0).toFixed(2)} €`;const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let state=null,merchantLoaded=false,controlLoaded=false,dataV3Loaded=false,currentPlan=null;
document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('.tab').forEach(x=>x.hidden=true);document.querySelector('#'+b.dataset.tab).hidden=false;if(b.dataset.tab==='creatives'||b.dataset.tab==='create')loadCreatives();if(b.dataset.tab==='merchant'&&!merchantLoaded)loadMerchant();if(b.dataset.tab==='datav3'&&!dataV3Loaded)loadDataV3();if(b.dataset.tab==='optimizationv2')loadOptimizationV2();if(b.dataset.tab==='approval')loadApprovals();if(b.dataset.tab==='deployment')loadDeploymentQueue();if(b.dataset.tab==='searchterms')loadSearchTerms(false);if(b.dataset.tab==='controlcenter'&&!controlLoaded)loadControlCenter()}));
function links(){['adsLink','settingsButton'].forEach(id=>{const e=document.getElementById(id);if(e)e.href='/admin/ads-intelligence?key='+encodeURIComponent(key)});['analyticsLink','analyticsButton'].forEach(id=>{const e=document.getElementById(id);if(e)e.href='/admin/analytics?key='+encodeURIComponent(key)})}
function render(){const o=state.overview;document.querySelector('#cost').textContent=money(o.cost);document.querySelector('#revenue').textContent=money(o.revenue);document.querySelector('#profit').textContent=money(o.profitAfterAds);document.querySelector('#orders').textContent=o.orders;document.querySelector('#roas').textContent=o.roas==null?'—':o.roas.toFixed(2);document.querySelector('#poas').textContent=o.poas==null?'—':o.poas.toFixed(2);const g=state.googleAds;document.querySelector('#googleStatus').textContent=g.configured?(g.error?'Google Ads – chyba':g.lastSyncAt?'Google Ads pripojený':'Google Ads pripravený'):'Čaká na pripojenie Google Ads';document.querySelector('#campaigns').innerHTML=o.campaigns.length?o.campaigns.map(c=>`<div class="row"><div><b>${esc(c.name)}</b><div class="muted">${c.visits} návštev · ${c.orders} objednávok · ${money(c.revenue)}</div><div class="muted">Aktívne ${c.averageActiveSeconds} s · ${c.averagePages} strán/návštevu · ${c.cartAdds}× košík · ${c.checkouts}× pokladňa</div></div><span class="pill">${c.orders?'PONECHAŤ':'UČÍ SA'}</span></div>`).join(''):'<div class="empty">Zatiaľ nie sú dostupné návštevy priradené k platenej kampani.</div>';document.querySelector('#draftList').innerHTML=state.drafts.length?state.drafts.map(d=>`<div class="row"><div><b>${esc(d.name)}</b><div class="muted">${esc(d.channel)} · ${esc(d.selection)} · ${money(d.dailyBudgetEur)}/deň</div></div><span class="pill">KONCEPT</span></div>`).join(''):'<div class="empty">Zatiaľ nemáte uložený žiadny koncept.</div>';const cp=document.querySelector('#creativePerformanceList');if(cp)cp.innerHTML=o.creatives?.length?o.creatives.map(c=>`<div class="row"><div><b>${esc(c.content)}</b><div class="muted">${esc(c.campaign)} · ${c.visits} návštev · ${c.averageActiveSeconds} s aktívne · ${c.averagePages} strán</div><div class="muted">${c.cartAdds}× košík · ${c.checkouts}× pokladňa · ${c.orders} objednávok · ${money(c.revenue)} · konverzia ${(c.conversionRate*100).toFixed(1)} %</div><div class="muted">${esc(c.reason)}</div></div><span class="pill">${esc(c.state)}</span></div>`).join(''):'<div class="empty">Zatiaľ nie sú návštevy s rozpoznaným reklamným variantom.</div>'}
async function loadApprovals(){try{const r=await fetch('/api/admin/marketing-approval',{headers,cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Načítanie zlyhalo');const byId=new Map(j.approvals.map(a=>[a.draftId,a]));document.querySelector('#approvalList').innerHTML=state.drafts.length?state.drafts.filter(d=>d.state!=='archived').map(d=>{const a=byId.get(d.id),status=a?.effectiveWorkflowState||'review_required',label=status==='approved'?'SCHVÁLENÉ':status==='rejected'?'ZAMIETNUTÉ':'ČAKÁ NA KONTROLU';return`<div class="row"><div><b>${esc(d.name)}</b><div class="muted">${esc(d.selection)} · ${money(d.dailyBudgetEur)}/deň · ${esc(a?.decisionState||'UČÍ SA')}</div><div style="margin-top:9px"><button class="btn secondary" data-review="${esc(d.id)}">Skontrolovať</button> ${status==='review_required'&&a?.valid?`<button class="btn primary" data-approve="${esc(d.id)}">Schváliť</button> <button class="btn secondary" data-reject="${esc(d.id)}">Zamietnuť</button>`:''}${status==='approved'&&a?.valid?` <button class="btn primary" data-export="${esc(d.id)}">Stiahnuť Google balík</button>${d.channel==='search'?` <button class="btn secondary" data-validate="${esc(d.id)}">Overiť v Google</button>`:''}`:''}</div></div><span class="pill">${label}</span></div>`}).join(''):'<div class="empty">Najskôr vytvorte koncept reklamy.</div>';document.querySelector('#auditList').innerHTML=j.audit.length?j.audit.map(a=>`<div class="row"><div><b>${esc({reviewed:'Kontrola',approved:'Schválenie',rejected:'Zamietnutie',approval_invalidated:'Zmena po schválení',exported:'Google export'}[a.action]||a.action)}</b><div class="muted">${new Date(a.at).toLocaleString('sk-SK')}${a.note?' · '+esc(a.note):''}</div></div></div>`).join(''):'<div class="empty">Zatiaľ bez záznamov.</div>';document.querySelectorAll('[data-review]').forEach(b=>b.onclick=()=>approvalAction('review',b.dataset.review));document.querySelectorAll('[data-approve]').forEach(b=>b.onclick=()=>approvalAction('approve',b.dataset.approve));document.querySelectorAll('[data-reject]').forEach(b=>b.onclick=()=>approvalAction('reject',b.dataset.reject));document.querySelectorAll('[data-export]').forEach(b=>b.onclick=()=>exportGoogleBundle(b.dataset.export));document.querySelectorAll('[data-validate]').forEach(b=>b.onclick=()=>validateInGoogle(b.dataset.validate))}catch(e){document.querySelector('#approvalList').innerHTML=`<p class="error">${esc(e.message)}</p>`}}
async function approvalAction(action,draftId){const note=action==='reject'?(prompt('Dôvod zamietnutia (nepovinné):')||''):'';try{const r=await fetch('/api/admin/marketing-approval',{method:'POST',headers:{...headers,'content-type':'application/json'},body:JSON.stringify({action,draftId,note})}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Akcia zlyhala');await load();await loadApprovals()}catch(e){alert(e.message)}}
function downloadFile(name,type,data){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([data],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
async function exportGoogleBundle(draftId){try{const r=await fetch('/api/admin/google-ads-publication',{method:'POST',headers:{...headers,'content-type':'application/json'},body:JSON.stringify({draftId})}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Export zlyhal');const stamp=new Date().toISOString().slice(0,10);downloadFile(`tonerymaxim-google-ads-${stamp}.json`,'application/json',JSON.stringify(j.publication.bundle,null,2));downloadFile(`tonerymaxim-google-ads-products-${stamp}.csv`,'text/csv;charset=utf-8','\ufeff'+j.publication.csv);await loadApprovals()}catch(e){alert(e.message)}}
async function validateInGoogle(draftId){if(!confirm('Overiť Search kampaň cez Google Ads API v režime validateOnly? Reklama sa nevytvorí.'))return;try{const r=await fetch('/api/admin/google-ads-validate-only',{method:'POST',headers:{...headers,'content-type':'application/json'},body:JSON.stringify({draftId})}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Overenie zlyhalo');alert(`Google kontrola prešla. Overených operácií: ${j.validation.operations}. Nič nebolo vytvorené.`)}catch(e){alert(e.message)}}
function renderSearchTerms(report,actions=[]){const list=document.querySelector('#searchTermsList'),summary=document.querySelector('#searchTermsSummary');if(!report){summary.textContent='Zatiaľ bez synchronizácie.';list.innerHTML='<div class="empty">Po pripojení Google Ads načítajte report.</div>';return}const actionByKey=new Map(actions.map(a=>[a.key,a])),d=report.decisions||[],negative=d.filter(x=>x.suggestNegative);summary.innerHTML=`Aktualizované: <b>${new Date(report.generatedAt).toLocaleString('sk-SK')}</b><br>${d.length} výrazov · ${negative.length} návrhov na presné negatívne slovo`;list.innerHTML=d.length?d.slice(0,300).map(x=>{const a=actionByKey.get(x.key),protectedText=x.protection?.protected?`<div class="muted">Chránené: ${esc(x.protection.reason)}</div>`:'';return`<div class="row"><div><b>${esc(x.term)}</b><div class="muted">${esc(x.campaign)} · ${x.clicks} klikov · ${money(x.costEur)} · ${x.conversions} objednávok${x.cpa==null?'':` · CPA ${money(x.cpa)}`}</div><div class="muted">${esc(x.reason)}</div>${protectedText}${x.suggestNegative&&!x.protection?.protected?`<div style="margin-top:8px"><button class="btn primary" data-term-action="approve_negative" data-term-key="${esc(x.key)}">Schváliť ako negatívne</button> <button class="btn secondary" data-term-action="keep" data-term-key="${esc(x.key)}">Ponechať</button></div>`:''}</div><span class="pill">${a?.action==='approved_negative'?'SCHVÁLENÉ NEGATÍVNE':a?.action==='keep'?'PONECHAŤ':esc(x.state)+(x.suggestNegative?' · NEGATÍVNE EXACT':'')}</span></div>`}).join(''):'<div class="empty">Google Ads nevrátil žiadne hľadané výrazy za 30 dní.</div>';document.querySelectorAll('[data-term-action]').forEach(b=>b.onclick=()=>searchTermAction(b.dataset.termAction,b.dataset.termKey))}
async function loadSearchTerms(sync){const msg=document.querySelector('#searchTermsMsg');msg.textContent=sync?'Načítavam read-only údaje z Google Ads…':'';try{if(sync){const r=await fetch('/api/admin/search-terms',{method:'POST',headers:{...headers,'content-type':'application/json'},body:JSON.stringify({targetCpaEur:Number(document.querySelector('#searchTermsCpa').value)})}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Načítanie zlyhalo');msg.textContent='Report bol bezpečne aktualizovaný.'}const r=await fetch('/api/admin/search-terms',{headers,cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Načítanie zlyhalo');renderSearchTerms(j.report,j.actions||[])}catch(e){msg.textContent='Chyba: '+e.message}}
async function searchTermAction(action,keyValue){try{const r=await fetch('/api/admin/search-terms',{method:'POST',headers:{...headers,'content-type':'application/json'},body:JSON.stringify({action,key:keyValue})}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Rozhodnutie zlyhalo');await loadSearchTerms(false)}catch(e){alert(e.message)}}
