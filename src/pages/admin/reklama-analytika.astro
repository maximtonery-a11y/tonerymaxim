async function loadCreatives(){const r=await fetch('/api/admin/marketing-creatives',{headers,cache:'no-store'}),j=await r.json();const list=document.querySelector('#creativeList');if(!r.ok||!j.ok){list.innerHTML=`<p class="error">${esc(j.error||'Načítanie zlyhalo')}</p>`;return}list.innerHTML=j.items.length?j.items.map(i=>`<div class="row"><div><img src="/api/admin/marketing-creatives?id=${encodeURIComponent(i.id)}&key=${encodeURIComponent(key)}" alt="" style="width:90px;height:70px;object-fit:contain;float:left;margin-right:12px"><b>${esc(i.name)}</b><div class="muted">${i.width} × ${i.height} px · ${i.usage.length?i.usage.join(', '):'vyžaduje prispôsobenie'} · kvalita ${i.qualityScore??'—'}/100 ${esc(i.qualityState||'')}</div></div><span class="pill">${esc(i.mime.replace('image/','').toUpperCase())}</span></div>`).join(''):'<div class="empty">Zatiaľ nemáte uložený obrázok.</div>';const choices=document.querySelector('#builderCreatives');if(choices)choices.innerHTML=j.items.length?j.items.map(i=>`<label class="row"><span><b>${esc(i.name)}</b><small class="muted"> ${i.width} × ${i.height} · ${i.usage.join(', ')||'iný pomer'} · kvalita ${i.qualityScore??'—'}/100</small></span><input name="creativeIds" type="checkbox" value="${esc(i.id)}"></label>`).join(''):'<span class="muted">Najskôr nahrajte obrázky v karte Obrázky.</span>'}
document.querySelector('#creativeForm')?.addEventListener('submit',async e=>{e.preventDefault();const msg=document.querySelector('#creativeMsg');msg.textContent='Kontrolujem a nahrávam…';try{const r=await fetch('/api/admin/marketing-creatives',{method:'POST',headers,body:new FormData(e.currentTarget)}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Nahratie zlyhalo');msg.textContent=`Uložené: ${j.item.width} × ${j.item.height} px.`;e.currentTarget.reset();await loadCreatives()}catch(err){msg.textContent='Chyba: '+err.message}});
async function queueAction(action,payload={}){try{const r=await fetch('/api/admin/marketing-deployment-queue',{method:'POST',headers:{...headers,'content-type':'application/json'},body:JSON.stringify({action,...payload})}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Akcia zlyhala');await loadDeploymentQueue()}catch(e){alert(e.message)}}
async function loadDeploymentQueue(){try{const [qr,ar]=await Promise.all([fetch('/api/admin/marketing-deployment-queue',{headers,cache:'no-store'}),fetch('/api/admin/marketing-approval',{headers,cache:'no-store'})]),q=await qr.json(),a=await ar.json();if(!qr.ok||!q.ok)throw new Error(q.error||'Rad sa nenačítal');const byId=new Map(a.approvals?.map(x=>[x.draftId,x])||[]),candidates=(state.drafts||[]).filter(d=>byId.get(d.id)?.effectiveWorkflowState==='approved'&&byId.get(d.id)?.valid);document.querySelector('#queueCandidates').innerHTML=candidates.length?candidates.map(d=>`<div class="row"><div><b>${esc(d.name)}</b><div class="muted">${esc(d.channel)} · ${esc(d.selection)}</div></div><button class="btn primary" data-queue-draft="${esc(d.id)}">Zaradiť</button></div>`).join(''):'<div class="empty">Nie je pripravená žiadna platne schválená kampaň.</div>';document.querySelector('#deploymentList').innerHTML=q.items.length?q.items.map(i=>`<div class="row"><div><b>${esc(i.campaignName)}</b><div class="muted">${esc(i.channel)} · ${esc(i.status)}</div><div style="margin-top:8px">${i.status==='WAITING_CONFIRMATION'?`<button class="btn primary" data-confirm-id="${esc(i.id)}" data-confirm-name="${esc(i.campaignName)}">Dvojito potvrdiť</button> <button class="btn secondary" data-cancel-id="${esc(i.id)}">Zrušiť</button>`:''}${i.status==='APPROVED_FOR_VALIDATE_ONLY'?`<button class="btn primary" data-validate-queue="${esc(i.id)}">Spustiť bezpečný preflight</button> <button class="btn secondary" data-cancel-id="${esc(i.id)}">Zrušiť</button>`:''}</div></div><span class="pill">${esc(i.status)}</span></div>`).join(''):'<div class="empty">Publikačný rad je prázdny.</div>';document.querySelectorAll('[data-queue-draft]').forEach(b=>b.onclick=()=>queueAction('queue',{draftId:b.dataset.queueDraft}));document.querySelectorAll('[data-cancel-id]').forEach(b=>b.onclick=()=>queueAction('cancel',{id:b.dataset.cancelId}));document.querySelectorAll('[data-validate-queue]').forEach(b=>b.onclick=()=>queueAction('validate',{id:b.dataset.validateQueue}));document.querySelectorAll('[data-confirm-id]').forEach(b=>b.onclick=()=>{const expected=`PAUSED: ${b.dataset.confirmName}`,value=prompt(`Pre potvrdenie presne napíšte:\n${expected}`)||'';queueAction('confirm',{id:b.dataset.confirmId,confirmation:value})})}catch(e){document.querySelector('#deploymentList').innerHTML=`<p class="error">${esc(e.message)}</p>`}}
async function loadControlCenter(){controlLoaded=true;try{const r=await fetch('/api/admin/marketing-control-center',{headers,cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Načítanie zlyhalo');const c=j.center,b=c.budget;document.querySelector('#budgetGuard').innerHTML=`<b>${esc(b.state)}</b><p>${esc(b.reason)}</p><p>Aktuálny denný rozpočet: <b>${money(b.currentDailyBudgetEur)}</b><br>Odporúčaný bezpečný rozpočet: <b>${money(b.recommendedDailyBudgetEur)}</b><br>Zisk po reklame: <b>${money(b.profitAfterAdsEur)}</b></p><small>Žiadna zmena sa nevykonáva automaticky.</small>`;document.querySelector('#paidFunnel').innerHTML=c.funnel.stages.map((s,i)=>`<div class="row"><b>${esc(s.label)}</b><span class="pill">${s.value}${i?` · ${(s.value/(c.funnel.stages[i-1].value||1)*100).toFixed(1)} %`:''}</span></div>`).join('');document.querySelector('#marketingAlerts').innerHTML=c.alerts.length?c.alerts.map(a=>`<div class="row"><div><b>${esc(a.title)}</b><div class="muted">${esc(a.message)}</div><div>${esc(a.action)}</div></div><span class="pill">${a.severity==='critical'?'KRITICKÉ':'UPOZORNENIE'}</span></div>`).join(''):'<div class="empty">Nenašli sa kritické upozornenia.</div>';document.querySelector('#todayActions').innerHTML=c.todayActions.length?c.todayActions.map((a,i)=>`<div class="row"><div><b>${i+1}. ${esc(a.title)}</b><div class="muted">${esc(a.detail)}</div></div></div>`).join(''):'<div class="empty">Dnes nie je potrebný žiadny zásah.</div>';document.querySelector('#landingDiagnostics').innerHTML=c.landingPages.length?c.landingPages.slice(0,20).map(p=>`<div class="row"><div><b>${esc(p.path)}</b><div class="muted">${p.visits} návštev · ${p.carts} košíkov · ${p.orders} objednávok · ${money(p.revenue)}</div><div class="muted">${esc(p.reason)}</div></div><span class="pill">${esc(p.state)}</span></div>`).join(''):'<div class="empty">Zatiaľ bez platených vstupných stránok.</div>'}catch(e){controlLoaded=false;document.querySelector('#todayActions').innerHTML=`<p class="error">${esc(e.message)}</p>`}}
function renderDataV3(j){const s=j.summary,m=j.merchant,e=j.economics;document.querySelector('#v3Exact').textContent=s.exactOrders;document.querySelector('#v3Probable').textContent=s.probableOrders;document.querySelector('#v3Unattributed').textContent=s.unattributedOrders;document.querySelector('#v3Summary').innerHTML=`Pokrytie attribution: <b>${(s.attributionCoverage*100).toFixed(1)} %</b><br>Objednávky: <b>${s.orders}</b> · Tržby: <b>${money(s.revenue)}</b> · Príspevok po reklame: <b>${money(s.contributionProfit)}</b>`;document.querySelector('#v3Merchant').innerHTML=m.configured?`Merchant účet <b>${esc(m.accountId)}</b><br>Schválené: <b>${m.approved}</b> · Čakajúce: <b>${m.pending}</b> · Zamietnuté: <b>${m.disapproved}</b> · Obmedzené: <b>${m.limited}</b>${m.syncedAt?`<br><small>Aktualizované ${new Date(m.syncedAt).toLocaleString('sk-SK')}</small>`:''}${m.error?`<p class="error">${esc(m.error)}</p>`:''}`:'Merchant API ešte nemá serverové OAuth nastavenie.';document.querySelector('#v3MerchantIssues').innerHTML=m.issues?.length?m.issues.slice(0,50).map(x=>`<div class="row"><div><b>${esc(x.productName||x.offerId)}</b><div class="muted">Google: ${esc(x.severity)} · ${esc(x.code)}</div><div>${esc(x.title)}</div>${x.googlePriceEur!=null||x.webPriceEur!=null?`<div class="muted">Cena Google: ${x.googlePriceEur==null?'—':money(x.googlePriceEur)} · web: ${x.webPriceEur==null?'—':money(x.webPriceEur)}${x.priceMismatch?' · ROZDIEL CIEN':''}</div>`:''}</div><span class="pill">${esc(x.severity)}</span></div>`).join(''):'<div class="empty">Google zatiaľ nevrátil produktové problémy.</div>';document.querySelector('#v3Economics').innerHTML=`<div class="row"><b>Reálne nákupné ceny ABIX</b><span class="pill">${e.realPurchasePrices}</span></div><div class="row"><b>Bez reálnej ceny – konzervatívny odhad</b><span class="pill">${e.estimatedPurchasePrices}</span></div><div class="row"><b>Chýbajúca cena</b><span class="pill">${e.missingPrices}</span></div>`;const orders=j.journeys.filter(x=>x.order.completed),rows=orders.length?orders:j.journeys.filter(x=>x.campaign.gclid||x.campaign.campaignId);document.querySelector('#v3Journeys').innerHTML=rows.length?rows.slice(0,200).map(x=>`<details class="row" style="display:block"><summary><b>${esc(x.campaign.name||x.campaign.campaignId||x.source)} / ${esc(x.device)}</b> · ${new Date(x.startedAt).toLocaleString('sk-SK')} <span class="pill">${esc(x.confidence)}</span></summary><div class="muted" style="margin:8px 0">GCLID: ${x.campaign.gclid?'áno':'nie'} · Campaign ID: ${esc(x.campaign.campaignId||'nezistené')} · Ad group ID: ${esc(x.campaign.adGroupId||'nezistené')} · Produkt ID: ${esc(x.campaign.productId||x.order.items.map(i=>i.productId).join(', ')||'nezistené')}</div>${x.steps.map(z=>`<div style="padding:5px 0;border-top:1px solid #edf2f7">${new Date(z.at).toLocaleTimeString('sk-SK')} · ${esc(z.label)}${z.path?' · '+esc(z.path):''}</div>`).join('')}${x.order.completed?`<p><b>Objednávka ${esc(x.order.number)}</b>: ${money(x.order.value)}<br>Hrubý zisk: ${money(x.profit.grossProfitEur)} · reklama: ${money(x.profit.adCostEur)} · <b>po reklame: ${money(x.profit.contributionProfitEur)}</b><br>Break-even CPA: ${money(x.profit.breakEvenCpaEur)} · cieľové CPA: ${money(x.profit.targetCpaEur)} · ceny: ${esc(x.profit.costCoverage)}</p>`:''}<small>${esc(x.confidenceReason)}</small></details>`).join(''):'<div class="empty">Zatiaľ nie sú dostupné platené cesty ani objednávky.</div>'}
