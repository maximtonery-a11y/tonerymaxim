function formPayload(){const form=document.querySelector('#draftForm'),body=Object.fromEntries(new FormData(form));body.dailyBudgetEur=Number(body.dailyBudgetEur);body.creativeIds=[...form.querySelectorAll('[name="creativeIds"]:checked')].map(x=>x.value);return body}
function renderPlan(plan){const p=document.querySelector('#planPreview'),tone=plan.ready?'#17633a':'#9a2020';p.className='';p.innerHTML=`<p style="color:${tone}"><b>${plan.ready?'PRIPRAVENÉ NA ULOŽENIE':'TREBA OPRAVIŤ'}</b></p>${plan.blockers.map(x=>`<p class="error">${esc(x)}</p>`).join('')}<p><b>${plan.summary.eligible}</b> vhodných z ${plan.summary.matched} nájdených produktov</p><p>Priemerná hrubá marža: <b>${money(plan.summary.averageGrossMarginEur)}</b><br>Odporúčané max. CPC: <b>${money(plan.summary.recommendedMaxCpcEur)}</b><br>Vstupná stránka: <b>${esc(plan.structure.landingPage)}</b></p><h3>Nadpisy</h3><p>${plan.structure.headlines.map(esc).join(' · ')}</p><h3>Opisy</h3>${plan.structure.descriptions.map(x=>`<p>${esc(x)}</p>`).join('')}<h3>Kľúčové výrazy</h3><p>${plan.structure.keywords.map(esc).join(', ')}</p>${plan.warnings.map(x=>`<p class="note">${esc(x)}</p>`).join('')}`}
document.querySelector('#generatePlan')?.addEventListener('click',async()=>{const msg=document.querySelector('#formMsg');msg.textContent='Kontrolujem produkty a pripravujem reklamu…';try{const r=await fetch('/api/admin/campaign-builder',{method:'POST',headers:{...headers,'content-type':'application/json'},body:JSON.stringify(formPayload())}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Príprava zlyhala');currentPlan=j.plan;renderPlan(currentPlan);msg.textContent=currentPlan.ready?'Reklama prešla kontrolou.':'Reklama má blokujúce problémy.'}catch(err){msg.textContent='Chyba: '+err.message}});
