t',{id:b.dataset.expCancel});loadOptimizationV2()});document.querySelectorAll('[data-exp-approve]').forEach(b=>b.onclick=async()=>{const expected=`EXPERIMENT: ${b.dataset.expName}`,confirmation=prompt(`Pre potvrdenie presne napíšte:\n${expected}`)||'';try{await optimizationAction('approve_experiment',{id:b.dataset.expApprove,confirmation});loadOptimizationV2()}catch(e){alert(e.message)}})}catch(e){document.querySelector('#optimizationList').innerHTML=`<p class="error">${esc(e.message)}</p>`}}
document.querySelector('#optimizationRefresh')?.addEventListener('click',async()=>{const m=document.querySelector('#optimizationMsg');m.textContent='Prepočítavam návrhy…';try{await optimizationAction('refresh_recommendations',{dailyBudgetEur:30});m.textContent='Návrhy sú aktualizované. Nič sa nevykonalo.';await loadOptimizationV2()}catch(e){m.textContent='Chyba: '+e.message}});
document.querySelector('#experimentForm')?.addEventListener('submit',async e=>{e.preventDefault();const body=Object.fromEntries(new FormData(e.currentTarget));body.minimumVisits=Number(body.minimumVisits);try{await optimizationAction('create_experiment',body);e.currentTarget.reset();await loadOptimizationV2()}catch(err){alert(err.message)}});
async function loadMerchant(){merchantLoaded=true;const r=await fetch('/api/admin/merchant-diagnostics',{headers,cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok){document.querySelector('#merchantIssues').innerHTML=`<p class="error">${esc(j.error||'Diagnostika zlyhala')}</p>`;return}document.querySelector('#mEligible').textContent=j.eligiblePaid;document.querySelector('#mErrors').textContent=j.errors;document.querySelector('#mWarnings').textContent=j.warnings;const labels={missing_image:'Chýbajúci obrázok',invalid_url:'Neplatná URL',invalid_price:'Neplatná cena',short_description:'Krátky popis',out_of_stock:'Nie je skladom',missing_identifiers:'Chýbajúce identifikátory',missing_oem:'Chýbajúci OEM kód'};document.querySelector('#merchantIssues').innerHTML=Object.entries(j.byCode).sort((a,b)=>b[1]-a[1]).map(([code,count])=>`<div class="row"><b>${esc(labels[code]||code)}</b><span class="pill">${count}</span></div>`).join('')||'<div class="empty">Nenašli sa žiadne problémy.</div>'}
document.querySelector('#merchantRefresh')?.addEventListener('click',()=>{merchantLoaded=false;loadMerchant()});links();load();
</script>}
</main></body></html>
