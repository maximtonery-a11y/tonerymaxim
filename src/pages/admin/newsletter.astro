---
import { getAdminAccessKey, isAdminLocked } from '../../lib/admin-access';
import { listNewsletterRecords } from '../../lib/newsletter';
export const prerender=false;
const adminKey=getAdminAccessKey(Astro.locals);
const suppliedKey=Astro.url.searchParams.get('key')||'';
const locked=isAdminLocked({adminKey,suppliedKey,hostname:Astro.url.hostname,allowLocal:true});
const rows=locked?[]:(await listNewsletterRecords()).filter((r)=>r.status==='subscribed').sort((a,b)=>String(b.confirmedAt||b.legacyImportedAt||'').localeCompare(String(a.confirmedAt||a.legacyImportedAt||'')));
const dt=new Intl.DateTimeFormat('sk-SK',{dateStyle:'short',timeStyle:'short'});
const dashboardUrl=`/admin/dashboard${suppliedKey?`?key=${encodeURIComponent(suppliedKey)}`:''}`;
---
<!doctype html><html lang="sk"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive"/><title>Newsletter | ToneryMaxim</title><style>
:root{font-family:Inter,system-ui,sans-serif;color:#081a3a;background:#f4f8ff}*{box-sizing:border-box}body{margin:0;padding:24px}main{max-width:1100px;margin:auto}.top{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:20px}h1{margin:0 0 7px;font-size:clamp(30px,5vw,48px)}p{color:#5d6b82}.btn{display:inline-flex;padding:10px 14px;border-radius:11px;background:#071d41;color:#fff;text-decoration:none;font-weight:850}.card{background:#fff;border:1px solid #dbe6f6;border-radius:18px;padding:18px;box-shadow:0 14px 38px #0a21470d}.count{font-size:14px}.count strong{font-size:26px;color:#087b43;margin-right:5px}.search{width:100%;max-width:420px;margin:0 0 16px;padding:11px 13px;border:1px solid #cfdded;border-radius:11px;font:inherit}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:11px 9px;border-bottom:1px solid #e7edf6}th{font-size:11px;text-transform:uppercase;color:#66748b}.email{font-weight:800}.badge{display:inline-flex;padding:4px 7px;border-radius:999px;background:#e9f8f0;color:#087b43;font-size:11px;font-weight:850}.locked{text-align:center;max-width:650px;margin:80px auto}@media(max-width:700px){body{padding:12px}.top{display:block}.btn{margin-top:10px}table,thead,tbody,tr,th,td{display:block}thead{display:none}tr{padding:9px 0;border-bottom:1px solid #e7edf6}td{border:0;padding:3px 0;font-size:13px}.card{padding:14px}}
</style></head><body><main>{locked?(<section class="card locked"><h1>Newsletter</h1><p>Prehľad je chránený. Otvorte ho cez admin s platným kľúčom.</p></section>):(<><div class="top"><div><h1>Newsletter</h1><p class="count"><strong>{rows.length}</strong> aktívnych odberateľov</p></div><a class="btn" href={dashboardUrl}>← Dashboard</a></div><section class="card"><input class="search" type="search" placeholder="Hľadať e-mail…" data-search/>{rows.length?<table><thead><tr><th>E-mail</th><th>Prihlásenie</th><th>Zdroj</th><th>Stav</th></tr></thead><tbody>{rows.map((r)=><tr data-email={r.email.toLowerCase()}><td class="email">{r.email}</td><td>{r.confirmedAt?dt.format(new Date(r.confirmedAt)):r.legacyImportedAt?`Import ${dt.format(new Date(r.legacyImportedAt))}`:'—'}</td><td>{r.source}</td><td><span class="badge">aktívny</span></td></tr>)}</tbody></table>:<p>Zatiaľ nie je prihlásený žiadny odberateľ.</p>}</section></>)}</main><script>const q=document.querySelector<HTMLInputElement>('[data-search]');q?.addEventListener('input',()=>{const v=q.value.trim().toLowerCase();document.querySelectorAll<HTMLElement>('[data-email]').forEach(r=>r.hidden=!r.dataset.email?.includes(v))});</script></body></html>