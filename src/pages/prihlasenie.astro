---
import "../styles/global.css";
import "../styles/footer.css";
import "../styles/account.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import { readCustomerSession } from "../lib/auth-session";

const session = readCustomerSession(Astro.cookies);
if (session) return Astro.redirect("/ucet");
const next = Astro.url.searchParams.get("next") || "/ucet";
const logout = Astro.url.searchParams.get("logout") === "1";
const resetSent = Astro.url.searchParams.get("reset") === "sent";
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prihlásenie | ToneryMaxim.sk</title>
  </head>
  <body>
    <div class="page account-page">
      <Header />
      <main class="auth-wrap">
        <section class="auth-card">
          <img class="auth-logo" src="/images/tonerymaxim-logo-sharp.png" alt="ToneryMaxim" width="1270" height="222" decoding="async" />
          <h1>Prihlásenie</h1>
          <p>Prihláste sa do svojho účtu a vybavte opakovaný nákup, reklamáciu alebo kontrolu objednávok rýchlejšie.</p>

          <div class:list={["auth-alert", (logout || resetSent) && "is-success"]} data-auth-message hidden={!(logout || resetSent)}>{logout ? "Boli ste odhlásený." : resetSent ? "Ak účet existuje, poslali sme vám odkaz na obnovu hesla." : ""}</div>

          <form class="auth-form" data-login-form data-next={next}>
            <div class="tm-field">
              <label for="login-email">E-mailová adresa</label>
              <input id="login-email" name="email" type="email" placeholder="vas@email.sk" autocomplete="email" required />
            </div>

            <div class="tm-field">
              <label for="login-password">Heslo</label>
              <div class="tm-password-control">
                <input id="login-password" name="password" type="password" placeholder="••••••••" autocomplete="current-password" required />
                <button type="button" class="tm-password-toggle" data-password-toggle aria-controls="login-password" aria-label="Zobraziť heslo" aria-pressed="false"><span aria-hidden="true">◉</span><b>Zobraziť</b></button>
              </div>
            </div>

            <div class="auth-row">
              <label class="tm-check"><input type="checkbox" /> Zapamätať si ma</label>
              <a href="/zabudnute-heslo">Zabudli ste heslo?</a>
            </div>

            <button class="tm-btn" type="submit" data-auth-submit>Prihlásiť sa</button>
          </form>

          <p class="auth-switch">Nemáte účet? <a href="/registracia">Registrovať sa</a></p>
        </section>

        <section class="auth-benefits is-grid" aria-label="Výhody prihlásenia">
          <div class="auth-benefit-card"><strong>🖨️ Moje tlačiarne</strong><p>Uložené modely a odporúčané náplne bez hľadania.</p></div>
          <div class="auth-benefit-card"><strong>📦 História objednávok</strong><p>Objednávky, faktúry a stav nákupu na jednom mieste.</p></div>
          <div class="auth-benefit-card"><strong>🎁 Vernostné body</strong><p>Prehľad bodov, kupónov a odmien na ďalší nákup.</p></div>
          <div class="auth-benefit-card"><strong>⚡ Objednať znova</strong><p>Poslednú objednávku vložíte do košíka na 1 klik.</p></div>
          <div class="auth-benefit-card"><strong>🔄 Rýchla reklamácia</strong><p>Reklamáciu vytvoríte priamo z konkrétnej objednávky.</p></div>
        </section>
      </main>
      <Footer />
      <FloatingAdvisor />
    </div>

    <script is:inline src="/password-visibility.js"></script>

    <div class="account-migration-modal" data-account-migration-modal hidden>
      <button class="account-migration-modal__backdrop" type="button" data-account-migration-close aria-label="Zavrieť informačné okno"></button>
      <section class="account-migration-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="account-migration-title" tabindex="-1">
        <button class="account-migration-modal__close" type="button" data-account-migration-close aria-label="Zavrieť">×</button>
        <span class="account-migration-modal__eyebrow">Vitajte na novom ToneryMAXIM.sk</span>
        <h2 id="account-migration-title">Informácia k prihláseniu</h2>
        <p>Náš e-shop sme presunuli na nový, rýchlejší web plný užitočných výhod. Pôvodné zákaznícke účty sa z technických a bezpečnostných dôvodov neprenášali.</p>
        <p>Ospravedlňujeme sa za komplikácie pri prihlásení. Nová registrácia zaberie iba chvíľu a <strong>5 % zľava na celý prvý nákup sa vám po registrácii aktivuje automaticky na 30 dní.</strong></p>
        <ul>
          <li>prehľad a história objednávok,</li>
          <li>rýchlejšie nakupovanie a zopakovanie nákupu,</li>
          <li>správa dodacích a fakturačných údajov,</li>
          <li>vernostné body a ďalšie zákaznícke výhody.</li>
        </ul>
        <div class="account-migration-modal__actions">
          <a class="tm-btn" href="/registracia" data-account-migration-register>Vytvoriť nový účet</a>
          <button class="account-migration-modal__retry" type="button" data-account-migration-close>Skúsiť prihlásenie znova</button>
        </div>
        <a class="account-migration-modal__reset" href="/zabudnute-heslo">Nie ste si istí? Skúste obnoviť heslo</a>
      </section>
    </div>

    <script>
      const form = document.querySelector<HTMLFormElement>("[data-login-form]")!;
      const message = document.querySelector<HTMLElement>("[data-auth-message]")!;
      const submit = document.querySelector<HTMLButtonElement>("[data-auth-submit]")!;
      const migrationModal = document.querySelector<HTMLElement>("[data-account-migration-modal]")!;
      const migrationDialog = migrationModal?.querySelector<HTMLElement>("[role='dialog']");
      const migrationRegister = migrationModal?.querySelector<HTMLAnchorElement>("[data-account-migration-register]");
      let lastFocusedElement: HTMLElement | null = null;

      function showMessage(text: string, type = "error") {
        message.hidden = false;
        message.textContent = text;
        message.className = `auth-alert is-${type}`;
      }

      function openMigrationModal(email: string) {
        lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        if (migrationRegister) migrationRegister.href = `/registracia?email=${encodeURIComponent(email)}`;
        migrationModal.hidden = false;
        document.body.classList.add("has-account-migration-modal");
        requestAnimationFrame(() => migrationDialog?.focus());
      }

      function closeMigrationModal() {
        migrationModal.hidden = true;
        document.body.classList.remove("has-account-migration-modal");
        lastFocusedElement?.focus();
      }

      migrationModal?.querySelectorAll<HTMLElement>("[data-account-migration-close]").forEach((button) => {
        button.addEventListener("click", closeMigrationModal);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && migrationModal && !migrationModal.hidden) closeMigrationModal();
      });

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const data: Record<string, unknown> = Object.fromEntries(new FormData(form));
        data.next = form.dataset.next || "/ucet";

        submit.disabled = true;
        submit.textContent = "Prihlasujem...";
        message.hidden = true;

        try {
          const response = await fetch("/api/auth/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const result = await response.json();
          if (!response.ok || !result.ok) {
            if (result?.code === "ACCOUNT_NOT_REGISTERED" || result?.accountNotRegistered === true) {
              showMessage("Na novom webe zatiaľ nemáte vytvorený účet. Ponúkame vám novú registráciu s 5 % zľavou.", "info");
              openMigrationModal(String(data.email || ""));
              return;
            }
            throw new Error(result.error || "Prihlásenie zlyhalo.");
          }

          showMessage("Prihlásenie prebehlo úspešne. Presmerovávam...", "success");
          try { sessionStorage.removeItem("tm_header_account_v1"); } catch {}
          window.location.href = result.redirect || "/ucet";
        } catch (error) {
          showMessage(error instanceof Error ? error.message : "Prihlásenie zlyhalo.");
        } finally {
          submit.disabled = false;
          submit.textContent = "Prihlásiť sa";
        }
      });
    </script>
  </body>
</html>
