---
import "../styles/global.css";
import "../styles/cart.css";
import Header from "../components/Header.astro";
import "../styles/footer.css";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";

const title = "Košík | ToneryMaxim.sk";
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <div class="page cart-page">
      <Header />

      <main class="wrap cart-layout">
        <section class="cart-content">
          <div class="cart-heading">
            <span>Košík</span>
            <h1>Vaše produkty</h1>
            <p>Skontrolujte produkty v košíku a pokračujte bezpečne do pokladne.</p>
          </div>

          <div class="cart-empty" data-cart-empty hidden>
            <h2>Košík je prázdny</h2>
            <p>Pridajte si toner, atrament alebo komponent do košíka.</p>
            <a href="/produkty" class="cart-back">Pokračovať v nákupe</a>
          </div>

          <div class="cart-list" data-cart-list></div>

          <form class="cart-mobile-coupon summary-note coupon-note" data-cart-coupon-box hidden>
            <strong>Zľavový kupón</strong>
            <div class="coupon-inline">
              <input type="text" data-coupon-input placeholder="Zadajte kód kupónu" autocomplete="off" />
              <button type="submit" data-coupon-apply>Použiť</button>
            </div>
            <small data-coupon-message></small>
          </form>

          <div class="cart-mobile-loyalty summary-note loyalty-note" data-cart-loyalty-box hidden></div>

          <section class="cart-trust-panel" aria-label="Výhody nákupu">
            <article>
              <span>✓</span>
              <div>
                <strong>Rýchle vybavenie objednávky</strong>
                <p>Produkty skladom pripravujeme na expedíciu čo najskôr.</p>
              </div>
            </article>
            <article>
              <span>★</span>
              <div>
                <strong>Overené zákazníkmi</strong>
                <p>5,0 / 5 na Heureke a viac ako 1 323 recenzií.</p>
              </div>
            </article>
            <article>
              <span>?</span>
              <div>
                <strong>Pomoc s výberom</strong>
                <p>Pred odoslaním vieme overiť vhodnosť náplne k tlačiarni.</p>
              </div>
            </article>
          </section>
        </section>

        <aside class="cart-summary" data-cart-summary hidden>
          <h2>Súhrn objednávky</h2>

          <div class="summary-line">
            <span>Medzisúčet s DPH</span>
            <strong data-cart-subtotal>0,00 €</strong>
          </div>
          <div class="summary-line">
            <span>Základ bez DPH</span>
            <strong data-cart-net>0,00 €</strong>
          </div>
          <div class="summary-line">
            <span>DPH 23 %</span>
            <strong data-cart-vat>0,00 €</strong>
          </div>

          <div class="summary-note summary-checkout-note">
            <strong>Doprava a platba</strong>
            <span>Vyberiete v ďalšom kroku pokladne.</span>
          </div>

          <div class="summary-total">
            <span>Spolu s DPH</span>
            <strong data-cart-total>0,00 €</strong>
          </div>

          <a href="/pokladna" class="checkout-button">Pokračovať do pokladne</a>
          <button class="clear-cart" type="button" data-cart-action="clear">Vyprázdniť košík</button>
        </aside>
      </main>

      <section class="cart-mobile-help" aria-label="Pomoc s výberom">
        <h2>Radi vám pomôžeme</h2>
        <a href="tel:+421917859206" class="cart-mobile-help-line" aria-label="Zavolať na zákaznícku podporu">
          <span aria-hidden="true">☎</span>
          <strong>+421 917 859 206</strong>
        </a>
        <a href="mailto:info@tonerymaxim.sk" class="cart-mobile-help-line" aria-label="Napísať e-mail zákazníckej podpore">
          <span aria-hidden="true">✉</span>
          <strong>info@tonerymaxim.sk</strong>
        </a>
      </section>

      <div class="cart-mobile-footer" aria-label="Päta stránky">© 2026 ToneryMaxim.sk</div>

      <div class="cart-mobile-sticky" data-cart-mobile-sticky hidden>
        <a class="cart-mobile-sticky-search" href="/produkty" aria-label="Hľadať ďalší toner alebo tlačiareň">⌕</a>
        <a class="cart-mobile-sticky-checkout" href="/pokladna" aria-label="Pokračovať do pokladne">
          <span data-cart-mobile-total>0,00 €</span>
          <strong>Pokračovať</strong>
        </a>
      </div>

      <Footer />
      <FloatingAdvisor />
    </div>
  </body>
</html>
