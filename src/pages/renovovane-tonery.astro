---
import SeoCatalogPage from "../components/SeoCatalogPage.astro";
import { getProductsCache } from "../lib/tm-products-cache";
import { catalogStats, landingProducts, topBrandLinks, topOemLinks, topPrinterLinks } from "../lib/seo-catalog";

const cache = await getProductsCache().catch(() => ({ products: [] as any[], generated_at: "" }));
const products = landingProducts(cache.products, "renovated");
const stats = catalogStats(products);
---

<SeoCatalogPage
  title="Renovované tonery do laserových tlačiarní | ToneryMaxim.sk"
  description="Renovované tonery do laserových tlačiarní. Porovnajte presné označenie, farbu, výťažnosť, cenu, dostupnosť a kompatibilné modely tlačiarní."
  canonicalPath="/renovovane-tonery"
  eyebrow="Obnovený spotrebný materiál"
  heading="Renovované tonery"
  intro="Renovované produkty využívajú odborne obnovené kazety. Pri výbere vždy skontrolujte OEM označenie a presný model tlačiarne uvedený v detaile produktu."
  products={products}
  answer={`Aktuálne evidujeme ${stats.total} renovovaných produktov, z ktorých je ${stats.inStock} skladom. Renovovaný toner musí zodpovedať celému OEM označeniu aj presnému modelu tlačiarne; podobné číslo produktu nestačí.`}
  generatedAt={cache.generated_at}
  breadcrumbs={[{ name: "Renovované tonery", path: "/renovovane-tonery" }]}
  entityFacts={["Renovovaný produkt", "Cena s DPH", "Overená kompatibilita"]}
  relatedLinks={[
    { href: "/tonery", label: "Všetky tonery" },
    { href: "/kompatibilne-tonery", label: "Kompatibilné tonery" },
    { href: "/originalne-tonery", label: "Originálne tonery" },
    { href: "/atramentove-naplne", label: "Atramentové náplne" },
  ]}
  faq={[
    { question: "Čo je renovovaný toner?", answer: "Renovovaný toner je pôvodná kazeta, ktorá bola odborne vyčistená, skontrolovaná a opätovne naplnená." },
    { question: "Ako vyberiem správny renovovaný produkt?", answer: "Porovnajte OEM označenie a skontrolujte, či je váš presný model tlačiarne uvedený medzi kompatibilnými zariadeniami." },
  ]}
  contentSections={[
    {
      heading: "Čo znamená renovovaný produkt",
      paragraphs: ["Pri renovácii sa používa pôvodné telo kazety, ktoré sa odborne vyčistí, skontroluje a znovu naplní. Výsledný produkt je preto potrebné posudzovať podľa označenia, kapacity, farby a kompatibility rovnako dôsledne ako nový toner."],
    },
    {
      heading: "Kontrola pred objednaním",
      paragraphs: ["Na štítku používanej kazety nájdite OEM kód a porovnajte ho s názvom produktu. Následne overte model tlačiarne v detaile."],
      bullets: ["OEM označenie vrátane XL alebo XXL.", "Presný model tlačiarne.", "Farba a očakávaná výťažnosť."],
    },
  ]}
  linkGroups={[
    { heading: "Renovované produkty podľa značky", intro: "Dostupné značky sú vytvorené z aktuálneho katalógu.", links: topBrandLinks(products, 8) },
    { heading: "Podporované modely", intro: "Modelová stránka zobrazuje všetky aktuálne produktové alternatívy.", links: topPrinterLinks(products, 8) },
    { heading: "OEM kódy renovovaných produktov", intro: "Prejdite priamo na presné označenie kazety.", links: topOemLinks(products, 8) },
  ]}
  schemaEntities={[{ name: "Renovovaný toner" }, { name: "Obnovená tonerová kazeta" }]}
/>
