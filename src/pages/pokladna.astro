---
import "../styles/global.css";
import "../styles/cart.css";
import "../styles/checkout.css";
import Header from "../components/Header.astro";
import "../styles/footer.css";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import { readCustomerSession } from "../lib/auth-session";
import { getWooCustomerById } from "../lib/woo-client";

export const prerender = false;

const session = readCustomerSession(Astro.cookies);
const checkoutCustomer = session ? await getWooCustomerById(session.id).catch(() => null) : null;
const checkoutCustomerJson = JSON.stringify(checkoutCustomer ?? null)
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");

const title = "Pokladňa | ToneryMaxim.sk";
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <div class="page checkout-page">
      <Header />

      <main class="wrap checkout-wrap">
        <nav class="checkout-progress" aria-label="Priebeh objednávky">
          <a href="/kosik">1. Košík</a>
          <span class="is-active">2. Doprava a platba</span>
          <span>3. Dokončenie</span>
        </nav>

        <div class="checkout-mobile-guide" data-checkout-mobile-guide aria-live="polite">
          <div>
            <span data-checkout-mobile-step-label>Krok 1 z 3</span>
            <strong data-checkout-mobile-step-title>Kontakt</strong>
          </div>
          <div class="checkout-mobile-guide-track" data-checkout-mobile-progress-track role="progressbar" aria-label="Dokončenie údajov objednávky" aria-valuemin="0" aria-valuemax="3" aria-valuenow="0"><i data-checkout-mobile-progress></i></div>
          <small>Vyplňte aktuálny krok a pokračujte tlačidlom nižšie.</small>
        </div>

        <div class="checkout-empty" data-checkout-empty hidden>
          <h1>Košík je prázdny</h1>
          <p>Pred pokračovaním do pokladne pridajte produkt do košíka.</p>
          <a href="/produkty">Pokračovať v nákupe</a>
        </div>

        <div class="checkout-layout" data-checkout-form>
          <form class="checkout-form" onsubmit="return false;">
            <section class="checkout-card checkout-step is-active" data-checkout-step="contact">
              <div class="section-head" data-checkout-step-head>
                <span>1</span>
                <div>
                  <h2>Kontakt</h2>
                  <p data-contact-subtitle>Nákup bez registrácie. Účet si môžete vytvoriť až po objednávke.</p>
                </div>
              </div>

              <div class="checkout-step-body">
              <div class="form-grid two">
                <label>Email *<input id="email" name="email" type="email" autocomplete="email" required placeholder="vas@email.sk" /></label>
                <label>Telefón *<input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="+421 917 859 206" /></label>
              </div>
              <button class="checkout-step-next" type="button" data-checkout-next="delivery">Pokračovať na dopravu a platbu <span aria-hidden="true">→</span></button>
              </div>
            </section>

            <section class="checkout-card checkout-step" data-checkout-step="delivery">
              <div class="section-head" data-checkout-step-head>
                <span>2</span>
                <div>
                  <h2>Doprava a platba</h2>
                  <p>Najprv vyberte spôsob doručenia a platby. Fakturačné údaje doplníte až potom.</p>
                </div>
              </div>

              <div class="checkout-step-body">
              <div class="delivery-payment-grid">
                <div>
                  <h3 class="subsection-title">Doprava</h3>
                  <div class="option-stack">
                    <label class="option-tile compact"><input type="radio" name="shipping" value="dpd_courier" checked /><span class="option-icon">🚚</span><span><strong>DPD kuriér na adresu</strong><small>Doručenie 1–2 pracovné dni</small></span><b data-shipping-option-price>3,90 €</b></label>
                    <label class="option-tile compact"><input type="radio" name="shipping" value="dpd_pickup" /><span class="option-icon">📍</span><span><strong>DPD Pickup</strong><small>Výdajné miesto podľa výberu</small></span><b data-shipping-option-price>2,90 €</b></label>
                    <label class="option-tile compact"><input type="radio" name="shipping" value="dpd_box" /><span class="option-icon">📦</span><span><strong>DPD Pickup Box</strong><small>Vyzdvihnutie v boxe alebo Pickup mieste</small></span><b data-shipping-option-price>2,90 €</b></label>
                    <label class="option-tile compact"><input type="radio" name="shipping" value="gls_courier" /><span class="option-icon">🚛</span><span><strong>GLS kuriér na adresu</strong><small>Doručenie 1–2 pracovné dni</small></span><b data-shipping-option-price>3,90 €</b></label>
                    <label class="option-tile compact"><input type="radio" name="shipping" value="gls_pickup" /><span class="option-icon">🏪</span><span><strong>GLS ParcelShop / Balíkomat</strong><small>Výdajné miesto alebo balíkomat podľa výberu</small></span><b data-shipping-option-price>2,90 €</b></label>
                  </div>

                  <div class="pickup-box" data-pickup-box hidden>
                    <div data-pickup-summary>
                      <strong>Výdajné miesto zatiaľ nie je vybrané</strong>
                      <p>Vyberte výdajné miesto alebo box cez mapu dopravcu.</p>
                    </div>
                    <button type="button" data-open-pickup-widget>Vybrať na mape</button>
                  </div>
                  <input id="DPDPickupPointResult" type="hidden" name="dpd_pickup_result" />
                  <input id="GLSPickupPointResult" type="hidden" name="gls_pickup_result" />
                </div>

                <div>
                  <h3 class="subsection-title">Platba</h3>
                  <div class="option-stack">
                    <label class="option-tile compact"><input type="radio" name="payment" value="gopay" checked /><span class="option-icon">💳</span><span><strong>Platba online GoPay</strong><small>Platba kartou alebo podporovanou online metódou</small></span><b>0 €</b></label>
                    <label class="option-tile compact"><input type="radio" name="payment" value="cod" /><span class="option-icon">💶</span><span><strong>Dobierka</strong><small>Platba pri prevzatí zásielky</small></span><b>+ 1,20 €</b></label>
                    <label class="option-tile compact"><input type="radio" name="payment" value="bank_prepaid" /><span class="option-icon">🏦</span><span><strong>Platba prevodným príkazom vopred</strong><small>Expedícia po prijatí úhrady</small></span><b>0 €</b></label>
                    <label class="option-tile compact"><input type="radio" name="payment" value="invoice_org" /><span class="option-icon">🏛️</span><span><strong>Prevodný príkaz pre organizácie a firmy</strong><small>Školy, obce, mestá, štátne organizácie a firmy</small></span><b>0 €</b></label>
                  </div>
                </div>
              </div>
              <button class="checkout-step-next" type="button" data-checkout-next="billing">Pokračovať na fakturačné údaje <span aria-hidden="true">→</span></button>
              </div>
            </section>

            <section class="checkout-card checkout-step" data-checkout-step="billing">
              <div class="section-head" data-checkout-step-head>
                <span>3</span>
                <div>
                  <h2>Fakturačné údaje</h2>
                  <p>Firemné údaje podľa IČO doplníme automaticky.</p>
                </div>
              </div>

              <div class="checkout-step-body">
              <label class="checkline"><input id="company_enabled" type="checkbox" /> Nakupujem na firmu</label>

              <div class="company-box" data-company-box hidden>
                <div class="ico-row">
                  <label>IČO<input name="ico" inputmode="numeric" autocomplete="off" placeholder="12345678" /></label>
                  <button type="button" data-load-company>Načítať firmu</button>
                </div>

                <div class="company-status" data-company-status></div>

                <div class="form-grid three">
                  <label>DIČ<input name="dic" autocomplete="off" /></label>
                  <label>IČ DPH<input name="icdph" autocomplete="off" /></label>
                  <label>Názov firmy<input name="company" autocomplete="organization" /></label>
                </div>
              </div>

              <div class="form-grid two">
                <label>PSČ *<input name="zip" inputmode="numeric" autocomplete="postal-code" required placeholder="97405" /></label>
                <label>Mesto / obec *<input name="city" autocomplete="address-level2" required placeholder="Zadajte mesto alebo obec" /></label>
              </div>

              <label>Ulica a číslo *<input name="address" autocomplete="street-address" required placeholder="Ulica a číslo domu" /></label>

              <div class="form-grid two">
                <label>Meno *<input name="first_name" autocomplete="given-name" required /></label>
                <label>Priezvisko *<input name="last_name" autocomplete="family-name" required /></label>
              </div>

              <section class="checkout-saved-addresses" data-checkout-saved-addresses hidden>
                <div class="checkout-saved-addresses__head">
                  <div><strong>Kam máme objednávku doručiť?</strong><span>Vyberte uloženú adresu alebo zadajte inú.</span></div>
                  <a href="/ucet/adresy">Spravovať adresy</a>
                </div>
                <div class="checkout-saved-addresses__list" data-checkout-saved-address-list></div>
              </section>

              <label class="checkline"><input id="different_address" type="checkbox" /> Doručiť na inú adresu</label>

              <div class="delivery-address" data-delivery-address hidden>
                <div class="form-grid two">
                  <label>PSČ<input name="delivery_zip" inputmode="numeric" autocomplete="shipping postal-code" placeholder="97405" /></label>
                  <label>Mesto / obec<input name="delivery_city" autocomplete="shipping address-level2" placeholder="Zadajte mesto alebo obec" /></label>
                </div>

                <label>Ulica a číslo<input name="delivery_street" autocomplete="shipping street-address" placeholder="Ulica a číslo domu" /></label>

                <div class="form-grid two">
                  <label>Meno<input name="delivery_first_name" autocomplete="shipping given-name" /></label>
                  <label>Priezvisko<input name="delivery_last_name" autocomplete="shipping family-name" /></label>
                </div>

                <div class="form-grid two">
                  <label>Email<input name="delivery_email" type="email" autocomplete="shipping email" placeholder="email pre doručenie" /></label>
                  <label>Telefón<input name="delivery_phone" type="tel" inputmode="tel" autocomplete="shipping tel" placeholder="+421 917 859 206" /></label>
                </div>
              </div>
              <button class="checkout-step-next" type="button" data-checkout-next="summary">Skontrolovať objednávku <span aria-hidden="true">→</span></button>
              </div>
            </section>
          </form>

          <aside class="checkout-summary">
            <div class="summary-sticky">
              <h2>Súhrn objednávky</h2>
              <button class="checkout-mobile-summary-toggle" type="button" data-mobile-summary-toggle aria-expanded="false">
                <span>Objednávka</span>
                <strong data-mobile-summary-total>0,00 €</strong>
              </button>
              <div class="checkout-items" data-checkout-items></div>
              <div class="free-shipping-box" data-free-shipping></div>
              <div class="summary-line"><span>Tovar</span><strong data-summary-subtotal>0,00 €</strong></div>
              <div class="summary-line summary-discount" data-summary-discount-line hidden><span>Množstevná / sadová zľava</span><strong data-summary-discount>-0,00 €</strong></div>
              <div class="summary-line"><span data-summary-shipping-label>Doprava</span><strong data-summary-shipping>0,00 €</strong></div>
              <div class="summary-line"><span data-summary-payment-label>Platba</span><strong data-summary-payment>0,00 €</strong></div>
              <div class="summary-line"><span>Základ bez DPH</span><strong data-summary-net>0,00 €</strong></div>
              <div class="summary-line"><span>DPH 23 %</span><strong data-summary-vat>0,00 €</strong></div>
              <div class="summary-total"><span>Spolu s DPH</span><strong data-summary-total>0,00 €</strong></div>
              <label class="checkline heureka-consent-line">
                <input id="heureka-consent" type="checkbox" />
                <span>Chcem dostať e-mailový dotazník spokojnosti zo služby <strong>Overené zákazníkmi</strong> od Heureky. Súhlas je dobrovoľný.</span>
              </label>
              <label class="checkline terms-line">
                <input id="terms" type="checkbox" />
                <span class="terms-copy">Potvrdzujem, že som sa oboznámil/a s <a href="/obchodne-podmienky" target="_blank" rel="noopener">obchodnými podmienkami</a> a <a href="/ochrana-osobnych-udajov" target="_blank" rel="noopener">zásadami ochrany osobných údajov</a>.</span>
              </label>
              <button class="order-button" type="button" data-submit-order>🔒 Objednať s povinnosťou platby</button>
              <div class="secure-note">
                <span>🔒 Bezpečná platba cez GoPay</span>
                <a href="tel:+421917859206">☎ Pomoc: +421 917 859 206</a>
              </div>
              <div class="trust-mini"><span>✓ 17 rokov skúseností</span><span>✓ 30 000+ objednávok</span><span>✓ Overené zákazníkmi</span></div>
              <div class="order-status" data-order-status></div>
            </div>
          </aside>
        </div>
      </main>


      <section class="checkout-mobile-support" aria-label="Pomoc s objednávkou">
        <h2>Radi vám pomôžeme</h2>
        <a href="tel:+421917859206" class="checkout-mobile-support-link">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.7 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.3 1.3.4 2.6.6 4 .6.7 0 1.2.5 1.2 1.2v3.5c0 .7-.5 1.2-1.2 1.2C10.7 21.4 2.6 13.3 2.6 3.4c0-.7.5-1.2 1.2-1.2h3.5c.7 0 1.2.5 1.2 1.2 0 1.4.2 2.7.6 4 .1.4 0 .9-.3 1.2l-2.2 2.2Z" fill="currentColor"/></svg>
          <span>+421 917 859 206</span>
        </a>
        <a href="mailto:info@tonerymaxim.sk" class="checkout-mobile-support-link">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4V6Zm1.7 1.8L12 12.5l6.3-4.7H5.7Zm-.2 8.7h13V9.4L12 14.2 5.5 9.4v7.1Z" fill="currentColor"/></svg>
          <span>info@tonerymaxim.sk</span>
        </a>
      </section>

      <div class="checkout-mobile-footer">© 2026 ToneryMaxim.sk</div>

      <div class="checkout-mobile-sticky" data-checkout-mobile-sticky hidden>
        <button class="checkout-mobile-submit" type="button" data-mobile-submit-order>
          <strong data-mobile-total>0,00 €</strong>
          <span>Objednať s povinnosťou platby</span>
        </button>
      </div>

      <div class="checkout-submit-overlay" data-checkout-submit-overlay hidden role="status" aria-live="assertive" aria-atomic="true">
        <div class="checkout-submit-dialog">
          <span class="checkout-submit-spinner" aria-hidden="true"></span>
          <strong data-checkout-submit-title>Objednávku odosielame</strong>
          <p data-checkout-submit-message>Prosím, chvíľu počkajte a nezatvárajte túto stránku.</p>
        </div>
      </div>

      <div class="dpd-widget-modal" data-dpd-modal hidden>
        <div class="dpd-widget-dialog" role="dialog" aria-modal="true" aria-label="Výber DPD výdajného miesta">
          <div class="dpd-widget-head">
            <div>
              <strong>Vyberte DPD výdajné miesto</strong>
              <span data-dpd-modal-subtitle>Pickup miesto alebo box na Slovensku</span>
            </div>
            <button type="button" data-close-dpd-widget aria-label="Zavrieť DPD mapu">×</button>
          </div>
          <iframe data-dpd-iframe title="DPD Pickup widget" loading="lazy"></iframe>
        </div>
      </div>

      <div class="gls-widget-modal" data-gls-modal hidden>
        <div class="gls-widget-dialog" role="dialog" aria-modal="true" aria-label="Výber GLS výdajného miesta">
          <div class="gls-widget-head">
            <div>
              <strong>Vyberte GLS výdajné miesto</strong>
              <span data-gls-modal-subtitle>ParcelShop alebo Balíkomat na Slovensku</span>
            </div>
            <button type="button" data-close-gls-widget aria-label="Zavrieť GLS mapu">×</button>
          </div>
          <div id="gls-widget-root" class="gls-widget-root"></div>
        </div>
      </div>

      <Footer />
      <FloatingAdvisor />
    </div>

    <script is:inline set:html={`window.__TM_CHECKOUT_CUSTOMER__ = ${checkoutCustomerJson};`}></script>

    <script>
      import "../scripts/checkout.js";
    </script>
  </body>
</html>
