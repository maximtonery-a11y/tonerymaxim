---
import '../../styles/global.css'; import '../../styles/footer.css'; import '../../styles/newsletter.css'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import FloatingAdvisor from '../../components/FloatingAdvisor.astro'; import SeoHead from '../../components/SeoHead.astro'; import { confirmNewsletter } from '../../lib/newsletter'; const email=Astro.url.searchParams.get('email')||'',token=Astro.url.searchParams.get('token')||'',ok=email&&token?await confirmNewsletter(email,token):false;
---
<!doctype html><html lang="sk"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><SeoHead title="Potvrdenie newslettera | ToneryMaxim.sk" description="Potvrdenie odberu noviniek ToneryMaxim.sk." canonical="https://www.tonerymaxim.sk/newsletter/potvrdit" noindex={true}/></head><body><div class="page"><Header/><main class="newsletter-wrap"><section class="newsletter-card newsletter-result"><span class="newsletter-kicker">Newsletter</span><h1>{ok?'Odber je potvrdený':'Odkaz sa nepodarilo potvrdiť'}</h1><p>{ok?'Ďakujeme. Odteraz vám môžeme posielať novinky, akcie a výhody ToneryMaxim.sk.':'Odkaz je neplatný alebo už vypršal. Na stránke newslettera si môžete nechať poslať nový.'}</p><a class="tm-btn" href={ok?'/':'/newsletter'}>{ok?'Pokračovať na nákup':'Späť na newsletter'}</a></section></main><Footer/><FloatingAdvisor/></div></body></html>
