---
import '../../styles/global.css'; import '../../styles/footer.css'; import '../../styles/newsletter.css'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import FloatingAdvisor from '../../components/FloatingAdvisor.astro'; import SeoHead from '../../components/SeoHead.astro'; import { confirmNewsletterUnsubscribe } from '../../lib/newsletter'; const email=Astro.url.searchParams.get('email')||'',token=Astro.url.searchParams.get('token')||'',ok=email&&token?await confirmNewsletterUnsubscribe(email,token):false;
---
