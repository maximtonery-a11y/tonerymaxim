---
import "../../styles/global.css";
import "../../styles/footer.css";
import "../../styles/account.css";
import { readCustomerSession } from "../../lib/auth-session";
import AccountShell from "../../components/AccountShell.astro";
import {
  getHiddenRecentProductKeys,
  getSavedPrintersFromCustomer,
  getWooCustomerById,
  getWooCustomerOrders,
  type WooOrderLineItem,
} from "../../lib/woo-client";
import { formatMoney } from "../../lib/account-data";

const customer = readCustomerSession(Astro.cookies);
if (!customer) return Astro.redirect(`/novy/prihlasenie?next=${encodeURIComponent(Astro.url.pathname)}`);

const wooCustomer = await getWooCustomerById(customer.id);
const savedPrinters = getSavedPrintersFromCustomer(wooCustomer);
const hiddenRecent = new Set(getHiddenRecentProductKeys(wooCustomer));
const orders = await getWooCustomerOrders(customer.id, 10).catch(() => []);

type RecentProduct = WooOrderLineItem & { key: string; currency?: string };
const recentMap = new Map<string, RecentProduct>();
for (const order of orders) {
  for (const item of order.line_items || []) {
    const key = String(item.sku || item.product_id || item.name || "").trim();
    if (!key || hiddenRecent.has(key) || recentMap.has(key)) continue;
    recentMap.set(key, { ...item, key, currency: order.currency || "EUR" });
  }
}
const recentProducts = [...recentMap.values()].slice(0, 6);

function productSearchUrl(item: RecentProduct) {
  const q = item.sku || item.name || "";
  return `/novy/produkty?s=${encodeURIComponent(String(q))}`;
}

function productPrice(item: RecentProduct) {
  const qty = Number(item.quantity || 1) || 1;
  const total = Number(String(item.total || item.subtotal || "0").replace(",", "."));
  const unit = total > 0 ? total / qty : 0;
  return unit > 0 ? formatMoney(unit, item.currency || "EUR") : "—";
}
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Moje tlačiarne | ToneryMaxim.sk</title>
  </head>
  <body>
    <AccountShell user={customer} active="tlaciarne" title="Moje tlačiarne" subtitle="Uložte si svoje tlačiarne a náplne nájdete jedným kliknutím.">
      <div class="saved-printers-layout">
        <div class="saved-printers-grid">
          <section class="account-quick-panel" data-recent-products-panel>
            <div class="account-panel-head">
              <div>
                <h2>Nakupované naposledy</h2>
                <p class="account-muted">Produkty z vašich posledných objednávok.</p>
              </div>
              {recentProducts.length > 0 && <button class="tm-btn is-green is-small" type="button" data-account-add-recent-all>Vložiť všetko do košíka</button>}
            </div>

            {recentProducts.length > 0 ? (
              <div class="quick-products-grid">
                {recentProducts.map((item) => (
                  <article class="quick-product-card" data-recent-product-card data-recent-key={item.key} data-product-name={item.name || "Produkt"} data-product-sku={item.sku || item.product_id || ""} data-product-price={Number(item.total || item.subtotal || 0) / (Number(item.quantity || 1) || 1)}>
                    <button class="account-remove-small" type="button" data-remove-recent-product aria-label="Odstrániť produkt">×</button>
                    <span class="quick-product-icon">▤</span>
                    <div>
                      <strong>{item.name}</strong>
                      {item.sku && <p>{item.sku}</p>}
                      <div class="quick-product-price">{productPrice(item)}</div>
                      <div class="account-product-actions">
                        <a class="account-link-pill is-small" href={productSearchUrl(item)}>Zobraziť</a>
                        <button class="tm-btn is-green is-small" type="button" data-account-add-recent>Objednať</button>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="account-empty-box">
                <strong>Zatiaľ tu nemáte žiadne produkty.</strong>
                <p>Po prvej objednávke sa tu zobrazia produkty pre rýchle opakovanie nákupu.</p>
              </div>
            )}
          </section>

          <section class="account-panel">
            <h2>Pridať tlačiareň</h2>
            <p class="account-muted">Začnite písať model tlačiarne a vyberte ho zo zoznamu.</p>
            <form class="account-add-printer-form" data-add-printer-form autocomplete="off">
              <label class="tm-field printer-autocomplete-field">
                <span>Model tlačiarne</span>
                <input class="account-input" name="model" placeholder="napr. HP LaserJet M110w" required data-printer-search-input />
                <div class="printer-suggestions" data-printer-suggestions hidden></div>
              </label>
              <input type="hidden" name="printerTitle" data-selected-printer-title />
              <button class="tm-btn" type="submit">Uložiť tlačiareň</button>
              <div class="account-form-message" data-printer-form-message hidden></div>
            </form>
          </section>
        </div>

        <aside class="account-add-printer-panel">
          <h2>Uložené tlačiarne</h2>
          <p class="account-muted">Pre každý model si môžete rýchlo zobraziť kompatibilné náplne.</p>

          <div class="saved-printers-list" data-saved-printers-list>
            {savedPrinters.length > 0 ? (
              savedPrinters.map((printer) => (
                <article class="saved-printer-mini" data-saved-printer-card data-printer-title={printer.title}>
                  <div class="saved-printer-mini-icon" aria-hidden="true">▤</div>
                  <div class="saved-printer-mini-body">
                    <strong>{printer.title}</strong>
                    <span>{[printer.brand, printer.product_count ? `${printer.product_count} kompatibilných produktov` : "Kompatibilné náplne"].filter(Boolean).join(" · ")}</span>
                  </div>
                  <div class="saved-printer-mini-actions">
                    <a class="account-link-pill is-small" href={printer.url || `/novy/produkty?printer=${encodeURIComponent(printer.title)}`}>Zobraziť náplne</a>
                    <button class="tm-btn is-danger-soft is-small" type="button" data-remove-saved-printer>Odstrániť</button>
                  </div>
                </article>
              ))
            ) : (
              <div class="account-empty-box" data-no-printers-box>
                <strong>Nemáte uloženú žiadnu tlačiareň.</strong>
                <p>Pridajte si model tlačiarne a nabudúce nájdete správne náplne rýchlejšie.</p>
              </div>
            )}
          </div>
        </aside>
      </div>
    </AccountShell>
  </body>
</html>
