---
import "../../styles/global.css";
import "../../styles/footer.css";
import "../../styles/account.css";
import { readCustomerSession } from "../../lib/auth-session";
import AccountShell from "../../components/AccountShell.astro";
import { getCustomerLoyalty } from "../../lib/loyalty";

const customer = readCustomerSession(Astro.cookies);
if (!customer) return Astro.redirect(`/prihlasenie?next=${encodeURIComponent(Astro.url.pathname)}`);
const loyalty = await getCustomerLoyalty(customer.id);
const points = loyalty.points;
const history = loyalty.history;
const discountValue = loyalty.discountValue;
const discountValueLabel = discountValue.toFixed(2).replace(".", ",");
const paperReward = loyalty.paperReward;
const cyclePoints = paperReward.cyclePoints;
const nextRewardText = cyclePoints < 500
  ? `Do odmeny „1× kancelársky papier“ vám chýba ešte ${500 - cyclePoints} bodov.`
  : cyclePoints < 800
    ? `Do odmeny „2× kancelársky papier“ vám chýba ešte ${800 - cyclePoints} bodov.`
    : `Do odmeny „3× kancelársky papier“ vám chýba ešte ${1000 - cyclePoints} bodov.`;
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vernostný program | ToneryMaxim.sk</title>
  </head>
  <body>
    <AccountShell user={customer} active="vernost" title="Vernostný program" subtitle="Body za objednávky, zľavy a odmeny pri ďalšom nákupe.">
      <section class="loyalty-hero account-panel">
        <div>
          <p class="account-kicker">Aktuálny stav</p>
          <h2>{points} bodov</h2>
          <p>{points > 0 ? <>Vaše body majú aktuálnu hodnotu <strong>{discountValueLabel} €</strong> pri ďalšom nákupe.</> : <>Body získate po vybavení objednávky.</>}</p>
          <div class="loyalty-progress" aria-label="Postup k ďalšej odmene">
            <span style={`width: ${Math.min(100, Math.round((cyclePoints / 1000) * 100))}%`}></span>
          </div>
          <small>{paperReward.availablePacks > 0 ? `${paperReward.availablePacks}× papier sa automaticky pridá k najbližšej objednávke za 0,01 € za balík.` : nextRewardText}</small>
        </div>
        <div class="loyalty-value-card">
          <span>Hodnota zľavy</span>
          <strong>{discountValueLabel} €</strong>
          <a class="tm-btn is-green" href="/produkty">Použiť pri nákupe</a>
        </div>
      </section>

      <section class="account-section-grid loyalty-rules-grid">
        <article class="account-list-card loyalty-rule-card">
          <span class="account-stat-icon">€</span>
          <h3>1 € = 1 bod</h3>
          <p>Za každý nákup získate body podľa hodnoty objednávky.</p>
        </article>
        <article class="account-list-card loyalty-rule-card">
          <span class="account-stat-icon">★</span>
          <h3>100 bodov = 1 €</h3>
          <p>Body môžete neskôr premeniť na zľavu pri objednávke.</p>
        </article>
        <article class="account-list-card loyalty-rule-card">
          <span class="account-stat-icon">🎁</span>
          <h3>Odmeny navyše</h3>
          <p>Odmeny sa počítajú zo všetkých získaných bodov, aj keď body použijete ako zľavu.</p>
        </article>
      </section>

      <div class="account-grid-2 account-gap-top">
        <section class="account-panel">
          <div class="account-panel-head">
            <div>
              <h2>Najbližšie odmeny</h2>
              <p class="account-muted">Cyklus {paperReward.cycle}: získaných {cyclePoints} z 1 000 bodov.</p>
            </div>
          </div>
          <div class="reward-milestones">
            <div class="reward-milestone">
              <div><strong>500 bodov</strong><span>1× kancelársky papier (500 listov)</span></div>
              <small>{cyclePoints >= 500 ? "získané" : `chýba ${500 - cyclePoints} bodov`}</small>
            </div>
            <div class="reward-milestone">
              <div><strong>800 bodov</strong><span>2× kancelársky papier (1000 listov)</span></div>
              <small>{cyclePoints >= 800 ? "získané" : `chýba ${800 - cyclePoints} bodov`}</small>
            </div>
            <div class="reward-milestone">
              <div><strong>1000 bodov</strong><span>3× kancelársky papier (1500 listov)</span></div>
              <small>{`chýba ${1000 - cyclePoints} bodov`}</small>
            </div>
          </div>
        </section>

        <section class="account-panel">
          <h2>História bodov</h2>
          {history.length > 0 ? (
            <div class="points-history">
              {history.map((item) => (
                <div class={`points-row ${Number(item.points || 0) >= 0 ? "is-plus" : "is-minus"}`}>
                  <span>{Number(item.points || 0) >= 0 ? `+${item.points}` : item.points}</span>
                  <div><strong>{item.title}</strong><small>{item.date}</small></div>
                </div>
              ))}
            </div>
          ) : (
            <div class="account-empty-box">
              <strong>Zatiaľ bez bodov.</strong>
              <p>História bodov sa zobrazí po prvej vybavenej objednávke.</p>
            </div>
          )}
        </section>
      </div>
    </AccountShell>
  </body>
</html>
