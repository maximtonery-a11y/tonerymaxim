---
import "../../styles/global.css";
import "../../styles/footer.css";
import "../../styles/account.css";
import { readCustomerSession } from "../../lib/auth-session";
import AccountShell from "../../components/AccountShell.astro";
import { getCustomerMeta, getWooCustomerById, parseJsonMeta } from "../../lib/woo-client";

const customer = readCustomerSession(Astro.cookies);
if (!customer) return Astro.redirect(`/prihlasenie?next=${encodeURIComponent(Astro.url.pathname)}`);
const wooCustomer = await getWooCustomerById(customer.id);
const points = Number(getCustomerMeta(wooCustomer, "tm_loyalty_points") || 0);
const history = parseJsonMeta<any[]>(getCustomerMeta(wooCustomer, "tm_loyalty_history"), []);
const discountValue = Math.floor(points / 100);
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vernostný program | ToneryMaxim.sk</title>
  </head>
  <body>
    <AccountShell user={customer} active="vernost" title="Vernostný program" subtitle="Body za objednávky, zľavy a odmeny pri ďalšom nákupe.">
      <section class="loyalty-hero account-panel">
        <div>
          <p class="account-kicker">Aktuálny stav</p>
          <h2>{points} bodov</h2>
          <p>{points > 0 ? <>Vaše body majú aktuálnu hodnotu <strong>{discountValue},00 €</strong> pri ďalšom nákupe.</> : <>Body získate po vybavení objednávky.</>}</p>
          <div class="loyalty-progress" aria-label="Postup k ďalšej odmene">
            <span style={`width: ${Math.min(100, Math.round((points / 750) * 100))}%`}></span>
          </div>
          <small>{points >= 750 ? "Dosiahli ste hranicu pre odmenu." : `Do odmeny „Doprava zdarma“ vám chýba ešte ${750 - points} bodov.`}</small>
        </div>
        <div class="loyalty-value-card">
          <span>Hodnota zľavy</span>
          <strong>{discountValue},00 €</strong>
          <a class="tm-btn is-green" href="/produkty">Použiť pri nákupe</a>
        </div>
      </section>

      <section class="account-section-grid loyalty-rules-grid">
        <article class="account-list-card loyalty-rule-card">
          <span class="account-stat-icon">€</span>
          <h3>1 € = 1 bod</h3>
          <p>Za každý nákup získate body podľa hodnoty objednávky.</p>
        </article>
        <article class="account-list-card loyalty-rule-card">
          <span class="account-stat-icon">★</span>
          <h3>100 bodov = 1 €</h3>
          <p>Body môžete neskôr premeniť na zľavu pri objednávke.</p>
        </article>
        <article class="account-list-card loyalty-rule-card">
          <span class="account-stat-icon">🎁</span>
          <h3>Odmeny navyše</h3>
          <p>Pri vybraných nákupoch získate kupóny alebo dopravu zdarma.</p>
        </article>
      </section>

      <div class="account-grid-2 account-gap-top">
        <section class="account-panel">
          <div class="account-panel-head">
            <div>
              <h2>Najbližšie odmeny</h2>
              <p class="account-muted">Míľniky vernostného programu.</p>
            </div>
          </div>
          <div class="reward-milestones">
            <div class="reward-milestone">
              <div><strong>750 bodov</strong><span>Doprava zdarma</span></div>
              <small>{points >= 750 ? "dostupné" : `chýba ${750 - points} bodov`}</small>
            </div>
            <div class="reward-milestone">
              <div><strong>1000 bodov</strong><span>Kupón 10 €</span></div>
              <small>{points >= 1000 ? "dostupné" : `chýba ${1000 - points} bodov`}</small>
            </div>
          </div>
        </section>

        <section class="account-panel">
          <h2>História bodov</h2>
          {history.length > 0 ? (
            <div class="points-history">
              {history.map((item) => (
                <div class={`points-row ${Number(item.points || 0) >= 0 ? "is-plus" : "is-minus"}`}>
                  <span>{Number(item.points || 0) >= 0 ? `+${item.points}` : item.points}</span>
                  <div><strong>{item.title}</strong><small>{item.date}</small></div>
                </div>
              ))}
            </div>
          ) : (
            <div class="account-empty-box">
              <strong>Zatiaľ bez bodov.</strong>
              <p>História bodov sa zobrazí po prvej vybavenej objednávke.</p>
            </div>
          )}
        </section>
      </div>
    </AccountShell>
  </body>
</html>
