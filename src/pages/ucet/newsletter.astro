---
import '../../styles/global.css'; import '../../styles/footer.css'; import '../../styles/account.css'; import '../../styles/newsletter.css'; import AccountShell from '../../components/AccountShell.astro'; import SeoHead from '../../components/SeoHead.astro'; import { readCustomerSession } from '../../lib/auth-session'; import { getNewsletterRecord } from '../../lib/newsletter'; const customer=readCustomerSession(Astro.cookies); if(!customer)return Astro.redirect('/prihlasenie?next=/ucet/newsletter'); const record=await getNewsletterRecord(customer.email); const status=record?.status||'unsubscribed';
---
<!doctype html><html lang="sk"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><SeoHead title="Newsletter | Môj účet | ToneryMaxim.sk" description="Nastavenie odberu newslettera." canonical="https://www.tonerymaxim.sk/ucet/newsletter" noindex={true}/></head><body><AccountShell user={customer} active="newsletter" title="Newsletter" subtitle="Novinky, akcie a výhody máte plne pod kontrolou."><section class="account-card account-newsletter-card"><div class="account-newsletter-status"><span><strong data-newsletter-state>{status==='subscribed'?'Newsletter odoberáte':status==='pending'?'Čaká sa na potvrdenie':'Newsletter momentálne neodoberáte'}</strong><small>{customer.email}</small></span><div class="account-newsletter-actions">{status!=='subscribed'&&<button class="tm-btn" type="button" data-account-subscribe>Prihlásiť na odber</button>}{status==='subscribed'&&<button class="tm-btn tm-btn--secondary" type="button" data-account-unsubscribe>Odhlásiť z odberu</button>}</div></div><p class="newsletter-message" data-newsletter-message hidden></p><p class="newsletter-note">Prihlásenie na newsletter je dobrovoľné a oddelené od vášho zákazníckeho účtu. Súhlas môžete kedykoľvek odvolať.</p></section></AccountShell><script define:vars={{email:customer.email}}>const msg=document.querySelector('[data-newsletter-message]');async function act(url,source){try{const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,source})}),d=await r.json();msg.textContent=d.message||d.error;msg.className=`newsletter-message ${r.ok?'is-success':'is-error'}`;msg.hidden=false;if(r.ok)setTimeout(()=>location.reload(),1200)}catch{msg.textContent='Požiadavku sa nepodarilo odoslať.';msg.className='newsletter-message is-error';msg.hidden=false}}document.querySelector('[data-account-subscribe]')?.addEventListener('click',()=>act('/api/newsletter/subscribe','account'));document.querySelector('[data-account-unsubscribe]')?.addEventListener('click',()=>act('/api/newsletter/account-unsubscribe'));</script></body></html>
