---
import "../../styles/global.css";
import "../../styles/footer.css";
import "../../styles/account.css";
import { readCustomerSession, setCustomerCookie } from "../../lib/auth-session";
import { getWooCustomerById } from "../../lib/woo-client";
import { customerToSession, formatDate } from "../../lib/account-data";
import { getCustomerInvoices, InvoiceError, invoiceOrderFilter, invoiceOrderReference, invoicePageNumber, readInvoiceOrderReference, type CustomerInvoice } from "../../lib/account-invoices";
import AccountShell from "../../components/AccountShell.astro";

const session = readCustomerSession(Astro.cookies);
if (!session) return Astro.redirect("/prihlasenie?next=" + encodeURIComponent(Astro.url.pathname + Astro.url.search));
const wooCustomer = await getWooCustomerById(session.id);
if (!wooCustomer) return Astro.redirect("/prihlasenie?next=" + encodeURIComponent(Astro.url.pathname));
setCustomerCookie(Astro.cookies, wooCustomer);
const customer = customerToSession(wooCustomer);
let documents: CustomerInvoice[] = [];
let page = 1, hasMore = false;
let reference = "";
let error = "";
try {
  const filter = Astro.request.method === "POST" ? await Astro.request.formData() : Astro.url.searchParams;
  page = invoicePageNumber(filter.get("page"));
  const orderId = filter.has("ref")
    ? readInvoiceOrderReference(customer.id, filter.get("ref"))
    : invoiceOrderFilter(filter.get("order"));
  if (orderId !== undefined) reference = invoiceOrderReference(customer.id, orderId);
  const result = await getCustomerInvoices(customer.id, page, orderId);
  documents = result.documents; hasMore = result.hasMore;
} catch (caught) {
  error = caught instanceof InvoiceError ? caught.message : "Faktúry momentálne nie sú dostupné. Skúste to o chvíľu.";
  Astro.response.status = caught instanceof InvoiceError ? caught.status : 503;
}
function invoicePageUrl(targetPage: number) {
  const params = new URLSearchParams({ page: String(targetPage) });
  if (reference) params.set("ref", reference);
  return "/ucet/faktury?" + params.toString();
}
---
<!doctype html>
<html lang="sk">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="robots" content="noindex,nofollow" /><title>Faktúry | ToneryMaxim.sk</title></head>
  <body>
    <AccountShell user={customer} active="faktury" title="Faktúry" subtitle="Vaše faktúry a dobropisy na stiahnutie.">
      {reference && <p><a href="/ucet/faktury">Zobraziť faktúry zo všetkých objednávok</a></p>}
      {error ? (
        <section class="account-panel" role="alert"><h2>Faktúry sa nepodarilo načítať</h2><p>{error}</p>
          {(Astro.response.status ?? 503) >= 500
            ? <a class="tm-btn" href={invoicePageUrl(page)}>Skúsiť znova</a>
            : <a class="tm-btn" href="/ucet/objednavky">Moje objednávky</a>}
        </section>
      ) : documents.length ? (
        <div class="account-section-grid">
          {documents.map((document) => (
            <section class="account-list-card">
              <div class="order-head"><h2>{document.type === "credit_note" ? "Dobropis" : "Faktúra"} {document.number}</h2></div>
              <div class="account-list-row"><span>Dátum vystavenia</span><strong>{formatDate(document.date + "T12:00:00")}</strong></div>
              {document.order_number && <div class="account-list-row"><span>Objednávka</span><strong>{document.order_number}</strong></div>}
              <div class="invoice-downloads">
                <a class="tm-btn is-dark" href={"/api/account/invoices/" + document.id + "/pdf"} download>Stiahnuť PDF</a>
                {document.xml && <a class="tm-btn" href={"/api/account/invoices/" + document.id + "/xml"} download>Stiahnuť XML e-faktúru</a>}
              </div>
            </section>
          ))}
        </div>
      ) : (
        <section class="account-panel"><h2>Zatiaľ tu nie sú žiadne faktúry</h2><p class="account-muted">Faktúra sa tu zobrazí po jej vystavení a pridaní k objednávke.</p><a class="tm-btn" href="/ucet/objednavky">Moje objednávky</a></section>
      )}
      {!error && (page > 1 || hasMore) && <nav class="invoice-pagination" aria-label="Stránky faktúr">
        {page > 1 && <a class="tm-btn" href={invoicePageUrl(page - 1)} rel="prev">Predchádzajúca strana</a>}
        <span>Strana {page}</span>
        {hasMore && <a class="tm-btn" href={invoicePageUrl(page + 1)} rel="next">Ďalšia strana</a>}
      </nav>}
    </AccountShell>
  </body>
</html>
<style>
  .invoice-downloads,.invoice-pagination{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:20px}
  .invoice-downloads .tm-btn{min-height:44px}
  .invoice-pagination{justify-content:center}
  @media(max-width:600px){.invoice-downloads .tm-btn{width:100%;text-align:center}}
</style>
