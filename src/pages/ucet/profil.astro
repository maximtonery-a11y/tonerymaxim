---
import "../../styles/global.css";
import "../../styles/footer.css";
import "../../styles/account.css";
import { readCustomerSession, setCustomerCookie } from "../../lib/auth-session";
import { getWooCustomerById } from "../../lib/woo-client";
import { customerToSession, getBilling } from "../../lib/account-data";
import AccountShell from "../../components/AccountShell.astro";

const session = readCustomerSession(Astro.cookies);
if (!session) return Astro.redirect(`/prihlasenie?next=${encodeURIComponent(Astro.url.pathname)}`);
const wooCustomer = await getWooCustomerById(session.id);
if (!wooCustomer) return Astro.redirect(`/prihlasenie?next=${encodeURIComponent(Astro.url.pathname)}`);
setCustomerCookie(Astro.cookies, wooCustomer);
const customer = customerToSession(wooCustomer);
const billing = getBilling(wooCustomer);
---

<!doctype html>
<html lang="sk">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Profil | ToneryMaxim.sk</title></head>
  <body>
    <AccountShell user={customer} active="profil" title="Profil" subtitle="Osobné údaje, telefón a zmena hesla.">
      <div class="account-grid-2">
        <section class="account-panel">
          <h2>Osobné údaje</h2>
          <div class="auth-alert" data-profile-message hidden></div>
          <form class="account-add-printer-form" data-profile-form>
            <label class="tm-field"><span>Meno</span><input class="account-input" name="first_name" value={customer.first_name || billing.first_name || ""} required /></label>
            <label class="tm-field"><span>Priezvisko</span><input class="account-input" name="last_name" value={customer.last_name || billing.last_name || ""} required /></label>
            <label class="tm-field"><span>E-mail</span><input class="account-input" value={customer.email} disabled /></label>
            <label class="tm-field"><span>Telefón</span><input class="account-input" name="phone" value={billing.phone || ""} /></label>
            <button class="tm-btn" type="submit" data-profile-submit>Uložiť profil</button>
          </form>
        </section>

        <section class="account-panel">
          <h2>Zmena hesla</h2>
          <div class="auth-alert" data-password-message hidden></div>
          <form class="account-add-printer-form" data-password-form>
            <label class="tm-field"><span>Aktuálne heslo</span><input class="account-input" name="current_password" type="password" autocomplete="current-password" required /></label>
            <label class="tm-field"><span>Nové heslo</span><input class="account-input" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></label>
            <label class="tm-field"><span>Potvrdenie nového hesla</span><input class="account-input" name="password2" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></label>
            <button class="tm-btn" type="submit" data-password-submit>Zmeniť heslo</button>
          </form>
        </section>
      </div>
    </AccountShell>

    <script>
      function showMessage(el: HTMLElement, text: string, type = "error") {
        el.hidden = false;
        el.textContent = text;
        el.className = `auth-alert is-${type}`;
      }

      async function postJson(url: string, data: Record<string, FormDataEntryValue>) {
        const response = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || "Požiadavka sa nepodarila.");
        return result;
      }

      const profileForm = document.querySelector<HTMLFormElement>("[data-profile-form]")!;
      const profileMsg = document.querySelector<HTMLElement>("[data-profile-message]")!;
      const profileSubmit = document.querySelector<HTMLButtonElement>("[data-profile-submit]")!;
      profileForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        profileSubmit.disabled = true;
        profileSubmit.textContent = "Ukladám...";
        profileMsg.hidden = true;
        try {
          const result = await postJson("/api/account/update-profile", Object.fromEntries(new FormData(profileForm)));
          showMessage(profileMsg, result.message || "Profil bol uložený.", "success");
        } catch (error) {
          showMessage(profileMsg, error instanceof Error ? error.message : "Profil sa nepodarilo uložiť.");
        } finally {
          profileSubmit.disabled = false;
          profileSubmit.textContent = "Uložiť profil";
        }
      });

      const passwordForm = document.querySelector<HTMLFormElement>("[data-password-form]")!;
      const passwordMsg = document.querySelector<HTMLElement>("[data-password-message]")!;
      const passwordSubmit = document.querySelector<HTMLButtonElement>("[data-password-submit]")!;
      passwordForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        passwordSubmit.disabled = true;
        passwordSubmit.textContent = "Mením...";
        passwordMsg.hidden = true;
        try {
          const result = await postJson("/api/account/change-password", Object.fromEntries(new FormData(passwordForm)));
          passwordForm.reset();
          showMessage(passwordMsg, result.message || "Heslo bolo zmenené.", "success");
        } catch (error) {
          showMessage(passwordMsg, error instanceof Error ? error.message : "Heslo sa nepodarilo zmeniť.");
        } finally {
          passwordSubmit.disabled = false;
          passwordSubmit.textContent = "Zmeniť heslo";
        }
      });
    </script>
  </body>
</html>
