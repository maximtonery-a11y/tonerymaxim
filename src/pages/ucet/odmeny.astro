---
import "../../styles/global.css";
import "../../styles/footer.css";
import "../../styles/account.css";
import { readCustomerSession } from "../../lib/auth-session";
import AccountShell from "../../components/AccountShell.astro";
import { getWelcomeReward, getWooCustomerById, welcomeCouponCode } from "../../lib/woo-client";
import { formatDate } from "../../lib/account-data";
import { getCustomerLoyalty } from "../../lib/loyalty";
import { couponUsageText, getCustomerActiveCoupons } from "../../lib/coupons";

const customer = readCustomerSession(Astro.cookies);
if (!customer) return Astro.redirect(`/prihlasenie?next=${encodeURIComponent(Astro.url.pathname)}`);

const wooCustomer = await getWooCustomerById(customer.id);
const reward = getWelcomeReward(wooCustomer);
const welcomeCode = welcomeCouponCode(customer.id);
const loyalty = await getCustomerLoyalty(customer.id);
const paperReward = loyalty.paperReward;
const cyclePoints = paperReward.cyclePoints;
const activeCoupons = await getCustomerActiveCoupons(customer.id);
const visibleCoupons = [
  ...(reward.active ? [{ code: welcomeCode, label: "Uvítacia zľava 5 %", detail: `Na celý sortiment · platí do ${formatDate(reward.expires)}`, href: "/produkty" }] : []),
  ...activeCoupons.map((coupon) => ({
    code: coupon.code,
    label: coupon.label,
    detail: `${coupon.scope === "compatible" ? "Na kompatibilné tonery" : "Na celý sortiment"} · ${couponUsageText(coupon)}`,
    href: coupon.scope === "compatible" ? "/produkty?type=compatible" : "/produkty",
  })),
];
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Moje odmeny | ToneryMaxim.sk</title>
  </head>
  <body>
    <AccountShell user={customer} active="odmeny" title="Moje odmeny" subtitle="Kupóny a zľavy pre váš účet.">
      <section class="account-grid-2">
        <article class="account-panel scratch-panel">
          <div class="scratch-copy">
            <span class="scratch-gift">🎁</span>
            <div>
              <p class="account-kicker">Uvítacia odmena</p>
              <h2>Zľava 5 % po registrácii</h2>
              <p>Zľava 5 % platí na celý sortiment pri jednej objednávke, 1 mesiac od registrácie.</p>
            </div>
          </div>

          {reward.active ? (
            <div class="reward-scratch-card reward-scratch-card-large" data-scratch-card>
              <div class="reward-strip" data-scratch-cover>Zotrite tu a odhaľte zľavu</div>
              <div class="reward-result" data-scratch-result hidden>
                <strong>5 % zľava</strong>
                <span>{welcomeCode}</span>
                <small>Platí do {formatDate(reward.expires)} na celý sortiment.</small>
              </div>
              <button class="tm-btn" type="button" data-reveal-reward>Zotrieť odmenu</button>
            </div>
          ) : (
            <div class="account-empty-box">
              <strong>Uvítacia zľava je použitá alebo expirovaná.</strong>
              <p>Aktívne kupóny sa automaticky použijú v košíku.</p>
            </div>
          )}
        </article>

        <article class="account-panel">
          <div class="account-panel-head">
            <div>
              <h2>Aktívne kupóny</h2>
              <p class="account-muted">Jednorazové kupóny pripravené pre ďalší nákup.</p>
            </div>
          </div>

          {visibleCoupons.length > 0 ? (
            <div class="coupon-card-list">
              {visibleCoupons.map((coupon) => (
                <a class="coupon-card is-percent" href={coupon.href}>
                  <div>
                    <strong>{coupon.label}</strong>
                    <small>{coupon.detail}</small>
                  </div>
                  <span>Automaticky v košíku</span>
                </a>
              ))}
            </div>
          ) : (
            <div class="account-empty-box">
              <strong>Nemáte aktívny kupón.</strong>
              <p>Nový 7 % kupón na ďalší nákup kompatibilných tonerov získate po dokončení ďalšej objednávky.</p>
            </div>
          )}
        </article>
      </section>

      <section class="account-panel account-gap-top">
        <div class="account-panel-head">
          <div>
            <h2>Odmeny za vernostné body</h2>
            <p class="account-muted">Cyklus {paperReward.cycle}: získaných {cyclePoints} z 1 000 bodov. Použitie bodov na zľavu postup neznižuje.</p>
          </div>
        </div>
        <div class="reward-milestones">
          <div class="reward-milestone"><div><strong>500 bodov</strong><span>1× kancelársky papier (500 listov)</span></div><small>{cyclePoints >= 500 ? "získané" : `chýba ${500 - cyclePoints} bodov`}</small></div>
          <div class="reward-milestone"><div><strong>800 bodov</strong><span>2× kancelársky papier (1000 listov)</span></div><small>{cyclePoints >= 800 ? "získané" : `chýba ${800 - cyclePoints} bodov`}</small></div>
          <div class="reward-milestone"><div><strong>1000 bodov</strong><span>3× kancelársky papier (1500 listov)</span></div><small>{`chýba ${1000 - cyclePoints} bodov`}</small></div>
        </div>
      </section>
    </AccountShell>
    <script>
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest<HTMLButtonElement>("[data-reveal-reward]");
        if (!button) return;
        const card = button.closest("[data-scratch-card]");
        card?.querySelector("[data-scratch-cover]")?.setAttribute("hidden", "");
        card?.querySelector("[data-scratch-result]")?.removeAttribute("hidden");
        button.textContent = "Zľava je odhalená";
        button.disabled = true;
      });
    </script>
  </body>
</html>
