---
import "../../styles/global.css";
import "../../styles/footer.css";
import "../../styles/account.css";
import { readCustomerSession } from "../../lib/auth-session";
import AccountShell from "../../components/AccountShell.astro";

const customer = readCustomerSession(Astro.cookies);
if (!customer) return Astro.redirect(`/prihlasenie?next=${encodeURIComponent(Astro.url.pathname)}`);
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reklamácie | ToneryMaxim.sk</title>
  </head>
  <body>
    <AccountShell user={customer} active="reklamacie" title="Reklamácie" subtitle="Rýchle reklamácie naviazané priamo na objednávky a konkrétne produkty.">
      <section class="claims-layout" data-claims-app>
        <div class="claims-list" data-claims-list>
          <article class="account-panel claim-loading">Načítavam reklamácie…</article>
        </div>

        <aside class="account-panel claim-form-panel">
          <p class="account-kicker">Nová reklamácia</p>
          <h2>Vytvoriť reklamáciu</h2>
          <p class="account-muted">Vyberte objednávku, produkt a popíšte problém.</p>

          <form class="claim-form" data-claim-form>
            <label>
              <span>Objednávka</span>
              <select class="account-select" name="order_id" data-claim-order required>
                <option value="">Načítavam objednávky…</option>
              </select>
            </label>

            <label>
              <span>Produkt</span>
              <select class="account-select" name="product_id" data-claim-product required>
                <option value="">Najprv vyberte objednávku</option>
              </select>
            </label>

            <label>
              <span>Dôvod reklamácie</span>
              <select class="account-select" name="reason" required>
                <option value="Produkt netlačí správne">Produkt netlačí správne</option>
                <option value="Produkt nepasuje do tlačiarne">Produkt nepasuje do tlačiarne</option>
                <option value="Produkt prišiel poškodený">Produkt prišiel poškodený</option>
                <option value="Objednaný alebo doručený iný produkt">Objednaný alebo doručený iný produkt</option>
                <option value="Iný dôvod">Iný dôvod</option>
              </select>
            </label>

            <label>
              <span>Popis problému</span>
              <textarea class="account-textarea" name="message" rows="5" placeholder="Popíšte problém s produktom..." required></textarea>
            </label>

            <p class="claim-form-info">Fotografie a doplňujúce podklady nám môžete poslať odpoveďou na potvrdenie reklamácie.</p>
            <p class="claim-form-message" data-claim-message hidden></p>

            <button class="tm-btn is-dark" type="submit" data-claim-submit>Odoslať reklamáciu</button>
          </form>
        </aside>
      </section>
    </AccountShell>

    <script>
      type AccountOrderItem = {
        product_id?: number;
        variation_id?: number;
        name: string;
        sku?: string;
        quantity: number;
      };
      type AccountOrder = {
        id: number;
        number: string;
        date_created?: string;
        total?: string;
        items: AccountOrderItem[];
      };
      type AccountClaim = {
        id: string;
        product_name: string;
        order_number: string;
        created_at?: string;
        status?: string;
        decision?: string;
        status_label?: string;
        reason?: string;
        product_sku?: string;
        message?: string;
        admin_comment?: string;
      };

      const listEl = document.querySelector<HTMLElement>("[data-claims-list]")!;
      const form = document.querySelector<HTMLFormElement>("[data-claim-form]")!;
      const orderSelect = document.querySelector<HTMLSelectElement>("[data-claim-order]")!;
      const productSelect = document.querySelector<HTMLSelectElement>("[data-claim-product]")!;
      const messageEl = document.querySelector<HTMLElement>("[data-claim-message]")!;
      const submitBtn = document.querySelector<HTMLButtonElement>("[data-claim-submit]")!;
      const reasonSelect = form.querySelector<HTMLSelectElement>('[name="reason"]')!;
      const claimMessage = form.querySelector<HTMLTextAreaElement>('[name="message"]')!;

      let orders: AccountOrder[] = [];
      let claims: AccountClaim[] = [];

      function escapeHtml(value: unknown) {
        const entities: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#039;", '"': "&quot;" };
        return String(value ?? "").replace(/[&<>'"]/g, (char) => entities[char] || char);
      }

      function formatDate(value: unknown) {
        if (!value) return "";
        const date = new Date(String(value));
        if (Number.isNaN(date.getTime())) return "";
        return new Intl.DateTimeFormat("sk-SK", { day: "2-digit", month: "2-digit", year: "numeric" }).format(date);
      }

      function claimStepState(claim: AccountClaim, key: string) {
        const status = claim?.status || "received";
        const decision = claim?.decision || (status === "approved" || status === "rejected" ? status : "");

        if (key === "received") return "is-done";
        if (key === "checking") {
          if (["checking", "approved", "rejected", "resolved"].includes(status)) return status === "checking" ? "is-active" : "is-done";
          return "";
        }
        if (key === "approved" || key === "rejected") {
          if (decision !== key) return "";
          return status === key ? "is-active" : "is-done";
        }
        if (key === "resolved") return status === "resolved" ? "is-active" : "";
        return "";
      }

      function claimStepsFor(claim: AccountClaim): Array<[string, string]> {
        const status = claim?.status || "received";
        const decision = claim?.decision || (status === "approved" || status === "rejected" ? status : "");
        const decisionStep: [string, string] = decision === "rejected"
          ? ["rejected", "Neschválená"]
          : ["approved", "Schválená"];

        if (status === "received" || status === "checking") {
          return [
            ["received", "Prijatá"],
            ["checking", "Kontrolujeme"],
            ["approved", "Schválená"],
            ["rejected", "Neschválená"],
            ["resolved", "Vybavená"],
          ];
        }

        return [
          ["received", "Prijatá"],
          ["checking", "Kontrolujeme"],
          decisionStep,
          ["resolved", "Vybavená"],
        ];
      }

      function renderClaims() {
        if (!claims.length) {
          listEl.innerHTML = `
            <article class="account-panel claim-empty">
              <strong>Zatiaľ nemáte žiadnu reklamáciu.</strong>
              <p>Vyberte objednávku vpravo, produkt a odošlite reklamáciu. Stav potom uvidíte priamo tu.</p>
            </article>`;
          return;
        }

        listEl.innerHTML = claims.map((claim) => {
          const steps = claimStepsFor(claim).map(([key, label]) => {
            const cls = claimStepState(claim, key);
            return `<div class="claim-step ${cls}"><span></span><strong>${label}</strong></div>`;
          }).join("");

          return `
            <article class="claim-card account-panel">
              <div class="claim-head">
                <div>
                  <span class="claim-id">#${escapeHtml(claim.id)}</span>
                  <h2>${escapeHtml(claim.product_name)}</h2>
                  <p>Objednávka <strong>${escapeHtml(claim.order_number)}</strong> · odoslané ${formatDate(claim.created_at)}</p>
                </div>
                <span class="status-pill ${claim.status === "checking" ? "is-warning" : claim.status === "resolved" ? "is-done" : claim.status === "rejected" ? "is-error" : ""}">${escapeHtml(claim.status_label)}</span>
              </div>
              <div class="claim-steps">${steps}</div>
              <div class="claim-detail-grid">
                <div><span>Dôvod</span><strong>${escapeHtml(claim.reason)}</strong></div>
                ${claim.product_sku ? `<div><span>SKU</span><strong>${escapeHtml(claim.product_sku)}</strong></div>` : ""}
              </div>
              <p class="claim-note">${escapeHtml(claim.message || "Reklamáciu sme prijali. Po kontrole vás budeme kontaktovať e-mailom.")}</p>
              ${claim.admin_comment ? `<div class="claim-admin-comment"><strong>Vyjadrenie ToneryMAXIM.sk</strong><p>${escapeHtml(claim.admin_comment)}</p></div>` : ""}
            </article>`;
        }).join("");
      }

      function renderOrders() {
        if (!orders.length) {
          orderSelect.innerHTML = `<option value="">Nemáte objednávku vhodnú na reklamáciu</option>`;
          productSelect.innerHTML = `<option value="">Najprv musí existovať objednávka</option>`;
          submitBtn.disabled = true;
          return;
        }

        orderSelect.innerHTML = `<option value="">Vyberte objednávku</option>` + orders.map((order) => {
          const label = `#${order.number} · ${formatDate(order.date_created)} · ${order.total || ""} €`;
          return `<option value="${order.id}">${escapeHtml(label)}</option>`;
        }).join("");
        submitBtn.disabled = false;
        renderProducts();
      }

      function renderProducts() {
        const order = orders.find((item) => Number(item.id) === Number(orderSelect.value));
        if (!order) {
          productSelect.innerHTML = `<option value="">Najprv vyberte objednávku</option>`;
          return;
        }
        productSelect.innerHTML = `<option value="">Vyberte produkt</option>` + order.items.map((item) => {
          const id = item.product_id || item.variation_id;
          const sku = item.sku ? ` · SKU: ${item.sku}` : "";
          return `<option value="${id}">${escapeHtml(item.name)} × ${item.quantity}${escapeHtml(sku)}</option>`;
        }).join("");
      }

      function setMessage(text: string, type = "") {
        messageEl.hidden = !text;
        messageEl.textContent = text || "";
        messageEl.className = `claim-form-message ${type}`;
      }

      async function loadClaims() {
        try {
          const res = await fetch("/api/account/claims", { headers: { Accept: "application/json" } });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || "Reklamácie sa nepodarilo načítať.");
          orders = Array.isArray(data.orders) ? data.orders : [];
          claims = Array.isArray(data.claims) ? data.claims : [];
          renderClaims();
          renderOrders();
        } catch (error) {
          const errorMessage = error instanceof Error ? error.message : "Skúste stránku obnoviť.";
          listEl.innerHTML = `<article class="account-panel claim-empty is-error"><strong>Reklamácie sa nepodarilo načítať.</strong><p>${escapeHtml(errorMessage)}</p></article>`;
          setMessage(errorMessage, "is-error");
        }
      }

      orderSelect?.addEventListener("change", renderProducts);

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        setMessage("");
        if (!submitBtn) return;
        submitBtn.disabled = true;
        submitBtn.textContent = "Odosielam…";

        const payload = {
          order_id: Number(orderSelect.value || 0),
          product_id: Number(productSelect.value || 0),
          reason: reasonSelect.value || "",
          message: claimMessage.value || "",
        };

        try {
          const res = await fetch("/api/account/claims", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || "Reklamáciu sa nepodarilo odoslať.");
          claims = [data.claim, ...claims];
          form.reset();
          renderProducts();
          renderClaims();
          setMessage("Reklamáciu sme prijali. Potvrdenie sme poslali na e-mail.", "is-success");
        } catch (error) {
          setMessage(error instanceof Error ? error.message : "Reklamáciu sa nepodarilo odoslať.", "is-error");
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = "Odoslať reklamáciu";
        }
      });

      loadClaims();
    </script>
  </body>
</html>
