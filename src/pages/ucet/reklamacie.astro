---
import "../../styles/global.css";
import "../../styles/footer.css";
import "../../styles/account.css";
import { readCustomerSession, customerDisplayName } from "../../lib/auth-session";
import AccountShell from "../../components/AccountShell.astro";

const customer = readCustomerSession(Astro.cookies);
if (!customer) return Astro.redirect(`/prihlasenie?next=${encodeURIComponent(Astro.url.pathname)}`);
const customerName = customerDisplayName(customer);
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reklamácie | ToneryMaxim.sk</title>
  </head>
  <body>
    <AccountShell user={customer} active="reklamacie" title="Reklamácie" subtitle="Rýchle reklamácie naviazané priamo na objednávky a konkrétne produkty.">
      <section class="claims-layout">
        <div class="claims-list">
          <article class="claim-card account-panel">
            <div class="claim-head">
              <div>
                <span class="claim-id">#R20260012</span>
                <h2>Brother TN-2421 kompatibilný toner</h2>
                <p>Objednávka <strong>TM-202600145</strong> · odoslané 14. 5. 2026</p>
              </div>
              <span class="status-pill">Prijatá</span>
            </div>

            <div class="claim-steps">
              <div class="claim-step is-active"><span></span><strong>Prijatá</strong></div>
              <div class="claim-step"><span></span><strong>Kontrolujeme</strong></div>
              <div class="claim-step"><span></span><strong>Schválená</strong></div>
              <div class="claim-step"><span></span><strong>Vybavená</strong></div>
            </div>

            <p class="claim-note">Reklamáciu sme prijali. Po kontrole vás budeme kontaktovať e-mailom.</p>
          </article>

          <article class="claim-card account-panel">
            <div class="claim-head">
              <div>
                <span class="claim-id">#R20260009</span>
                <h2>Canon CRG-057H kompatibilný toner</h2>
                <p>Objednávka <strong>TM-202600123</strong> · odoslané 2. 5. 2026</p>
              </div>
              <span class="status-pill is-warning">Kontrolujeme</span>
            </div>

            <div class="claim-steps">
              <div class="claim-step is-done"><span></span><strong>Prijatá</strong></div>
              <div class="claim-step is-active"><span></span><strong>Kontrolujeme</strong></div>
              <div class="claim-step"><span></span><strong>Schválená</strong></div>
              <div class="claim-step"><span></span><strong>Vybavená</strong></div>
            </div>

            <p class="claim-note">Produkt kontrolujeme. Stav reklamácie tu bude priebežne aktualizovaný.</p>
          </article>
        </div>

        <aside class="account-panel claim-form-panel">
          <p class="account-kicker">Nová reklamácia</p>
          <h2>Vytvoriť reklamáciu</h2>
          <p class="account-muted">Najrýchlejšie ju vytvoríte výberom objednávky a produktu. Po napojení účtu sa polia vyplnia automaticky.</p>

          <form class="claim-form">
            <label>
              <span>Objednávka</span>
              <select class="account-select">
                <option>TM-202600145</option>
                <option>TM-202600123</option>
              </select>
            </label>

            <label>
              <span>Produkt</span>
              <select class="account-select">
                <option>Brother TN-2421 kompatibilný toner</option>
                <option>Brother DR-2401 kompatibilný valec</option>
                <option>Canon CRG-057H kompatibilný toner</option>
              </select>
            </label>

            <label>
              <span>Dôvod reklamácie</span>
              <select class="account-select">
                <option>Produkt netlačí správne</option>
                <option>Produkt nepasuje do tlačiarne</option>
                <option>Produkt prišiel poškodený</option>
                <option>Iný dôvod</option>
              </select>
            </label>

            <label>
              <span>Popis problému</span>
              <textarea class="account-textarea" rows="5" placeholder="Popíšte problém s produktom..."></textarea>
            </label>

            <label>
              <span>Priložiť fotografiu</span>
              <input class="account-input" type="file" />
            </label>

            <button class="tm-btn is-dark" type="button">Odoslať reklamáciu</button>
            <div class="account-form-note">Toto je zatiaľ vizuálna verzia. Po napojení zákazníckeho účtu sa reklamácia uloží k objednávke.</div>
          </form>
        </aside>
      </section>
    </AccountShell>
  </body>
</html>
