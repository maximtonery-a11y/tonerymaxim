---

<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test ikoniek – ToneryMaxim</title>
  </head>
  <body>
    <main class="tm-design-page tm-icons-test-page">
      <a class="tm-design-back" href="/design/product-list">← Späť na výpis</a>

      <section class="tm-icons-test-head">
        <div>
          <h1>Test ikoniek</h1>
          <p>Vyber čísla ikoniek. Napríklad: štít 4, puzzle 17, recyklácia 26.</p>
        </div>
      </section>

      <section class="tm-icons-test-section tm-icons-test-section--blue">
        <div class="tm-icons-section-title">
          <h2>Štít / Originál</h2>
          <span>1–10</span>
        </div>
        <div class="tm-icons-grid">
          {shieldIcons.map((icon) => (
            <article class="tm-icon-option tm-icon-option--blue">
              <strong>{icon.id}</strong>
              <div class="tm-row-symbol tm-icon-test-symbol" aria-hidden="true">
                <svg class={`tm-test-svg tm-test-svg--${icon.style}`} viewBox="0 0 24 24">
                  {icon.paths.map((path) => <path d={path} />)}
                </svg>
              </div>
              <span>{icon.label}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="tm-icons-test-section tm-icons-test-section--green">
        <div class="tm-icons-section-title">
          <h2>Puzzle / Kompatibilný</h2>
          <span>11–20</span>
        </div>
        <div class="tm-icons-grid">
          {puzzleIcons.map((icon) => (
            <article class="tm-icon-option tm-icon-option--green">
              <strong>{icon.id}</strong>
              <div class="tm-row-symbol tm-icon-test-symbol" aria-hidden="true">
                <svg class={`tm-test-svg tm-test-svg--${icon.style}`} viewBox="0 0 24 24">
                  {icon.paths.map((path) => <path d={path} />)}
                </svg>
              </div>
              <span>{icon.label}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="tm-icons-test-section tm-icons-test-section--orange">
        <div class="tm-icons-section-title">
          <h2>Recyklácia / Renovovaný</h2>
          <span>21–30</span>
        </div>
        <div class="tm-icons-grid">
          {recycleIcons.map((icon) => (
            <article class="tm-icon-option tm-icon-option--orange">
              <strong>{icon.id}</strong>
              <div class="tm-row-symbol tm-icon-test-symbol" aria-hidden="true">
                <svg class={`tm-test-svg tm-test-svg--${icon.style}`} viewBox="0 0 24 24">
                  {icon.paths.map((path) => <path d={path} />)}
                </svg>
              </div>
              <span>{icon.label}</span>
            </article>
          ))}
        </div>
      </section>
    </main>
      <Footer />
  </body>
</html>
