---
import "../styles/global.css";
import "../styles/footer.css";
import "../styles/advice.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import SeoHead from "../components/SeoHead.astro";
import { adviceArticles } from "../data/advice";
import { breadcrumbJsonLd, organizationJsonLd, websiteJsonLd } from "../lib/seo";

const origin = "https://www.tonerymaxim.sk";
const canonical = `${origin}/poradna`;
const title = "Odborná poradňa o toneroch a tlačiarňach | ToneryMaxim.sk";
const description = "Praktické odborné návody k výberu tonerov, OEM kódom, výťažnosti, chybám tlače, renovácii, skladovaniu a recyklácii náplní.";
const jsonLd = [
  organizationJsonLd(origin),
  websiteJsonLd(origin),
  breadcrumbJsonLd(origin, [{ name: "Domov", path: "/" }, { name: "Odborná poradňa", path: "/poradna" }]),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${canonical}#collection`,
    name: "Odborná poradňa ToneryMaxim.sk",
    description,
    url: canonical,
    inLanguage: "sk-SK",
    isPartOf: { "@id": `${origin}/#website` },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: adviceArticles.length,
      itemListElement: adviceArticles.map((article, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: `${canonical}/${article.slug}`,
        name: article.title,
      })),
    },
  },
];
---
<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title={title} description={description} canonical={canonical} jsonLd={jsonLd} />
  </head>
  <body>
    <div class="page">
      <Header />
      <main class="advice-page">
        <div class="wrap advice-wrap">
          <nav class="advice-breadcrumbs" aria-label="Drobečková navigácia"><a href="/">Domov</a><span>›</span><span>Odborná poradňa</span></nav>
          <header class="advice-hub-head">
            <div>
              <p class="advice-eyebrow">Odborná poradňa ToneryMaxim.sk</p>
              <h1>Rozumejte tonerom. Vyberte správne na prvýkrát.</h1>
              <p>Overené praktické odpovede k výberu náplní, kompatibilite, prevádzke tlačiarne aj riešeniu problémov bez zbytočnej výmeny dielov.</p>
            </div>
            <aside>
              <strong>Roman Babčan</strong>
              <span>odborný garant poradne</span>
              <b>17+ rokov skúseností</b>
            </aside>
          </header>

          <section aria-labelledby="advice-list-title">
            <div class="advice-section-head">
              <div><p class="advice-eyebrow">Praktické návody</p><h2 id="advice-list-title">Vyberte si tému</h2></div>
              <span>{adviceArticles.length} odborných článkov</span>
            </div>
            <div class="advice-card-grid advice-card-grid--hub">
              {adviceArticles.map((article) => (
                <a class="advice-card" href={`/poradna/${article.slug}`}>
                  <small>{article.readingMinutes} min čítania</small>
                  <strong>{article.title}</strong>
                  <span>{article.description}</span>
                  <b>Prečítať návod →</b>
                </a>
              ))}
            </div>
          </section>

          <section class="advice-help">
            <div><p class="advice-eyebrow">Potrebujete konkrétnu odpoveď?</p><h2>Pošlite nám model tlačiarne alebo označenie kazety.</h2><p>Overíme kompatibilitu ešte pred objednávkou.</p></div>
            <div><a href="mailto:info@tonerymaxim.sk">Napísať e-mail</a><a href="tel:+421917859206">+421 917 859 206</a></div>
          </section>
        </div>
      </main>
      <Footer showTrust={false} />
      <FloatingAdvisor />
    </div>
  </body>
</html>
