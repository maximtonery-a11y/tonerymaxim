---
import "../styles/global.css";
import "../styles/footer.css";
import "../styles/account.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import { readCustomerSession } from "../lib/auth-session";

const session = readCustomerSession(Astro.cookies);
if (session) return Astro.redirect("/ucet");
const sent = Astro.url.searchParams.get("sent") === "1";
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zabudnuté heslo | ToneryMaxim.sk</title>
  </head>
  <body>
    <div class="page account-page">
      <Header />
      <main class="auth-wrap">
        <section class="auth-card">
          <img class="auth-logo" src="/images/tonerymaxim-logo-sharp.png" alt="ToneryMaxim" width="1270" height="222" decoding="async" />
          <h1>Zabudnuté heslo</h1>
          <p>Zadajte e-mail, ktorý používate pri účte. Ak účet existuje, pošleme vám odkaz na obnovu hesla.</p>

          <div class:list={["auth-alert", sent && "is-success"]} data-auth-message hidden={!sent}>
            {sent ? "Žiadosť bola odoslaná. Skontrolujte e-mail aj spam." : ""}
          </div>

          <form class="auth-form" data-forgot-form>
            <div class="tm-field">
              <label for="reset-email">E-mailová adresa</label>
              <input id="reset-email" name="email" type="email" placeholder="vas@email.sk" autocomplete="email" required />
            </div>

            <button class="tm-btn" type="submit" data-auth-submit>Odoslať odkaz na obnovu hesla</button>
          </form>

          <p class="auth-switch"><a href="/prihlasenie">Späť na prihlásenie</a></p>
        </section>

        <section class="auth-benefits is-grid" aria-label="Pomoc pri obnove hesla">
          <div class="auth-benefit-card"><strong>🔐 Bezpečná obnova</strong><p>Odkaz na nové heslo sa odosiela priamo z ToneryMAXIM.sk.</p></div>
          <div class="auth-benefit-card"><strong>📩 Skontrolujte e-mail</strong><p>Správa môže prísť do prijatej pošty, spamu alebo hromadnej pošty.</p></div>
          <div class="auth-benefit-card"><strong>⏱️ Platnosť odkazu</strong><p>Odkaz použite čo najskôr, aby ste si mohli nastaviť nové heslo.</p></div>
          <div class="auth-benefit-card"><strong>💬 Pomoc s účtom</strong><p>Ak obnova nepríde, účet vieme preveriť podľa e-mailovej adresy.</p></div>
        </section>
      </main>
      <Footer />
      <FloatingAdvisor />
    </div>

    <script>
      const form = document.querySelector<HTMLFormElement>("[data-forgot-form]")!;
      const message = document.querySelector<HTMLElement>("[data-auth-message]")!;
      const submit = document.querySelector<HTMLButtonElement>("[data-auth-submit]")!;

      function showMessage(text: string, type = "error") {
        message.hidden = false;
        message.textContent = text;
        message.className = `auth-alert is-${type}`;
      }

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const data = Object.fromEntries(new FormData(form));

        submit.disabled = true;
        submit.textContent = "Odosielam...";
        message.hidden = true;

        try {
          const response = await fetch("/api/auth/forgot-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.error || "Odoslanie obnovy hesla zlyhalo.");

          showMessage(result.message || "Ak účet existuje, poslali sme vám odkaz na obnovu hesla.", "success");
          form.reset();
        } catch (error) {
          showMessage(error instanceof Error ? error.message : "Odoslanie obnovy hesla zlyhalo.");
        } finally {
          submit.disabled = false;
          submit.textContent = "Odoslať odkaz na obnovu hesla";
        }
      });
    </script>
  </body>
</html>
