---
import "../styles/global.css";
import Header from "../components/Header.astro";
import "../styles/footer.css";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";

const title = "Zabudnuté heslo | ToneryMaxim.sk";

const WOO_RESET_URL = "https://www.coloriq.store/wp-login.php?action=lostpassword";
const REDIRECT_URL = "http://localhost:4321/prihlasenie?reset=sent";
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <div class="page">
      <Header />

      <main class="auth-page">
        <section class="auth-shell">
          <div class="auth-card">
            <a class="auth-logo" href="/">
              <img src="/images/tonerymaxim-logo.png" alt="ToneryMaxim.sk" />
            </a>

            <h1>Zabudnuté heslo</h1>

            <p>
              Zadajte e-mail, ktorý používate pri účte. Pošleme vám odkaz na obnovu hesla.
            </p>

            <form class="auth-form" method="post" action={WOO_RESET_URL}>
              <input type="hidden" name="redirect_to" value={REDIRECT_URL} />

              <label for="user_login">E-mailová adresa</label>
              <input
                id="user_login"
                name="user_login"
                type="email"
                placeholder="vas@email.sk"
                required
              />

              <button type="submit">Odoslať odkaz na obnovu hesla</button>
            </form>

            <div class="auth-bottom">
              <a href="/prihlasenie">Späť na prihlásenie</a>
            </div>
          </div>

          <div class="auth-benefits">
            <article>
              <h2>Bezpečná obnova hesla</h2>
              <p>
                Obnovu hesla spracuje priamo WordPress/WooCommerce systém, ktorý už odosielanie e-mailov zvláda.
              </p>
            </article>

            <article>
              <h2>Skontrolujte aj spam</h2>
              <p>
                Ak e-mail nepríde do pár minút, pozrite priečinok spam alebo hromadnú poštu.
              </p>
            </article>

            <article>
              <h2>Pomoc s prihlásením</h2>
              <p>
                Ak sa neviete dostať do účtu, kontaktujte nás a účet vám preveríme.
              </p>
            </article>
          </div>
        </section>
      </main>

      <Footer />
      <FloatingAdvisor />
    </div>
  </body>
</html>