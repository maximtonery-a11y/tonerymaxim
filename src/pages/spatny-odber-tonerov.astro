---
import "../styles/global.css";
import "../styles/footer.css";
import "../styles/legal.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import InfoPageShell from "../components/InfoPageShell.astro";
import SeoHead from "../components/SeoHead.astro";
import { breadcrumbJsonLd } from "../lib/seo";

const SEO_ORIGIN = "https://www.tonerymaxim.sk";
const canonical = `${SEO_ORIGIN}/spatny-odber-tonerov`;
const noindex = ["tonerymaxim.info", "www.tonerymaxim.info"].includes(Astro.url.hostname.toLowerCase());
const faq = [
  { q: "Kto môže využiť spätný odber?", a: "Služba je určená pre aktívnych zákazníkov ToneryMaxim, ktorí u nás nakupujú. Registrácia ani minimálny počet objednávok nie sú podmienkou." },
  { q: "Ako vrátim použité tonery pri ďalšej objednávke?", a: "Pred doručením novej objednávky nás kontaktujte. Po dohode zabezpečíme prevzatie bezpečne zabalených náplní kuriérom ako spätný balík. Tento spôsob odporúčame." },
  { q: "Kam môžem použité náplne poslať?", a: "Na vlastné náklady ich môžete po predchádzajúcom oznámení poslať na adresu Roman Babčan INkarus, Tajov 265, 976 34 Tajov." },
  { q: "Môžem požiadať o zvoz aj bez objednávky?", a: "Výnimočne áno, po individuálnej dohode môžeme zabezpečiť samostatné vyzdvihnutie kuriérom." },
  { q: "Musí byť toner zabalený?", a: "Áno. Každú náplň vložte do ochranného vrecka alebo pôvodného obalu a všetky kusy do pevnej uzavretej krabice." },
];
const jsonLd = [
  breadcrumbJsonLd(SEO_ORIGIN, [
    { name: "Domov", path: "/" },
    { name: "Spätný odber tonerov", path: "/spatny-odber-tonerov" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } })),
  },
];
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title="Spätný odber použitých tonerov | ToneryMaxim.sk"
      description="Spätný odber použitých tonerov pre aktívnych zákazníkov ToneryMaxim. Vrátenie pri ďalšej objednávke, zaslanie na našu adresu alebo zvoz kuriérom po dohode."
      canonical={canonical}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="page">
      <Header />
      <main>
        <InfoPageShell
          active="/spatny-odber-tonerov"
          eyebrow="Ekologické odovzdanie prázdnych kaziet"
          title="Spätný odber použitých tonerov"
          intro="Pomáhame našim zákazníkom ekologicky odovzdať použité tonery a atramentové náplne. Kazety odovzdávame odborným partnerom na renováciu alebo ekologické spracovanie."
        >
          <section class="return-intro">
            <article><i>♻</i><div><strong>Odborné spracovanie</strong><p>Použiteľné kazety môžu smerovať na renováciu, ostatné na odborné zhodnotenie.</p></div></article>
            <article><i>▣</i><div><strong>Jedna spoločná krabica</strong><p>Viac prázdnych náplní zabalíte spolu, čím sa zníži počet jázd kuriéra.</p></div></article>
            <article><i>↗</i><div><strong>Tri možnosti odovzdania</strong><p>Pri novej objednávke, poštou na našu adresu alebo výnimočne samostatným zvozom.</p></div></article>
          </section>

          <section class="return-panel">
            <div class="return-panel-head"><span>Jednoduchá podmienka</span><h2>Pre koho je spätný odber určený?</h2><p>Pre našich aktívnych zákazníkov, ktorí nakupujú v ToneryMaxim. Nemusíte byť registrovaní a nie je stanovený minimálny počet objednávok ani zakúpených náplní.</p></div>
          </section>

          <section class="return-panel">
            <div class="return-panel-head"><span>Tri spôsoby odovzdania</span><h2>Ako nám odovzdať použité tonery?</h2></div>
            <div class="return-steps">
              <article><i>1</i><h3>Pri ďalšej objednávke – odporúčame</h3><p>Kontaktujte nás vopred. Po dohode zabezpečíme, aby kuriér pri doručení vašej novej objednávky prevzal aj pripravenú krabicu s použitými náplňami ako spätný balík.</p></article>
              <article><i>2</i><h3>Zaslaním na našu adresu</h3><p>Použité náplne môžete po predchádzajúcom oznámení poslať na vlastné náklady na adresu <strong>Roman Babčan INkarus, Tajov 265, 976 34 Tajov</strong>.</p></article>
              <article><i>3</i><h3>Samostatný zvoz kuriérom</h3><p>Výnimočne môžeme zabezpečiť vyzdvihnutie použitých tonerov aj bez novej objednávky. Táto možnosť je dostupná po individuálnej dohode.</p></article>
            </div>
          </section>

          <section class="return-two-columns">
            <article class="return-panel">
              <div class="return-panel-head"><span>Balenie</span><h2>Ako toner pripraviť</h2></div>
              <ul class="return-list is-ok">
                <li>prázdny toner vložte do nepriepustného vrecka,</li>
                <li>atramentovú náplň uzavrite, aby nevytiekla,</li>
                <li>použite pevnú a nepoškodenú kartónovú krabicu,</li>
                <li>voľný priestor vyplňte papierom alebo inou výplňou,</li>
                <li>krabicu dôkladne zalepte.</li>
              </ul>
            </article>
            <article class="return-panel is-warning">
              <div class="return-panel-head"><span>Nepreberáme</span><h2>Čo do zásielky nepatrí</h2></div>
              <ul class="return-list is-no">
                <li>voľne vysypaný tonerový prášok,</li>
                <li>vytekajúce alebo nezabalené kazety,</li>
                <li>batérie, elektroniku a iný kancelársky odpad,</li>
                <li>znečistené obaly a komunálny odpad,</li>
                <li>zásielky bez predchádzajúceho schválenia.</li>
              </ul>
            </article>
          </section>

          <section class="return-contact">
            <div><span>Máte použité tonery?</span><h2>Dohodnime spôsob odovzdania</h2><p>Napíšte nám na info@tonerymaxim.sk alebo zavolajte na +421 917 859 206. Najradšej zabezpečíme spätný balík pri vašej ďalšej objednávke.</p></div>
            <div><a class="primary-pill" href="mailto:info@tonerymaxim.sk?subject=Sp%C3%A4tn%C3%BD%20odber%20pou%C5%BEit%C3%BDch%20tonerov">Dohodnúť spätný odber</a><a href="/kontakt">Kontaktné údaje</a></div>
          </section>

          <section class="return-faq">
            <div class="return-panel-head"><span>Otázky a odpovede</span><h2>Najčastejšie otázky</h2></div>
            {faq.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
          </section>
        </InfoPageShell>
      </main>
      <Footer showTrust={false} />
      <FloatingAdvisor />
    </div>
  </body>
</html>

<style>
  .return-intro { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-bottom:16px; }
  .return-intro article, .return-panel, .return-contact, .return-faq { border:1px solid #dbe8f6; border-radius:22px; background:#fff; box-shadow:0 18px 54px rgba(6,23,53,.07); }
  .return-intro article { display:flex; gap:14px; padding:20px; }
  .return-intro i { display:grid; flex:0 0 auto; width:44px; height:44px; place-items:center; border-radius:14px; background:#effaf3; color:#16a34a; font-style:normal; font-size:20px; font-weight:950; }
  .return-intro strong { color:#061735; font-size:16px; }
  .return-intro p, .return-panel-head p, .return-steps p, .return-contact p, .return-faq p { margin:5px 0 0; color:#64748b; font-size:13px; line-height:1.5; }
  .return-panel { padding:25px; margin-bottom:16px; }
  .return-panel-head > span, .return-contact span { color:#16a34a; font-size:12px; font-weight:950; letter-spacing:.08em; text-transform:uppercase; }
  .return-panel-head h2, .return-contact h2, .return-faq h2 { margin:5px 0 0; color:#061735; font-size:25px; line-height:1.15; letter-spacing:-.025em; }
  .return-table-wrap { margin-top:20px; overflow-x:auto; border:1px solid #dbe8f6; border-radius:17px; }
  .return-table { width:100%; min-width:690px; border-collapse:collapse; }
  .return-table th { padding:13px 15px; background:#f4f8fd; color:#52637d; font-size:12px; text-align:left; }
  .return-table td { padding:14px 15px; border-top:1px solid #e5edf7; color:#344968; font-size:13px; vertical-align:middle; }
  .return-table td strong, .return-table td span { display:block; }
  .return-table td strong { color:#061735; font-size:14px; }
  .return-table td span { margin-top:3px; color:#64748b; font-size:12px; }
  .return-table b { display:inline-flex; border-radius:999px; padding:6px 9px; font-size:11px; }
  .return-table b.yes { background:#eaf8ef; color:#087a38; }
  .return-table b.no { background:#f1f5f9; color:#64748b; }
  .return-small-note { margin:13px 0 0; color:#64748b; font-size:12px; line-height:1.5; }
  .return-steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:20px; }
  .return-steps article { padding:16px; border:1px solid #e1ebf6; border-radius:17px; background:#f8fbff; }
  .return-steps i { display:grid; width:30px; height:30px; place-items:center; border-radius:50%; background:#061735; color:#fff; font-style:normal; font-weight:950; }
  .return-steps h3 { margin:13px 0 6px; color:#061735; font-size:14px; }
  .return-two-columns { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .return-panel.is-warning { border-color:#f0dfbd; background:linear-gradient(145deg,#fffaf0,#fff); }
  .return-list { display:grid; gap:9px; margin:18px 0 0; padding:0; list-style:none; }
  .return-list li { position:relative; padding-left:25px; color:#344968; font-size:14px; line-height:1.5; }
  .return-list li::before { position:absolute; left:0; font-weight:950; }
  .return-list.is-ok li::before { content:"✓"; color:#16a34a; }
  .return-list.is-no li::before { content:"×"; color:#dc6a18; }
  .return-contact { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:25px; margin-bottom:16px; background:linear-gradient(135deg,#effaf3,#fff); border-color:#c9ecd6; }
  .return-contact > div:last-child { display:flex; align-items:center; gap:14px; }
  .return-contact > div:last-child > a:last-child { color:#087a38; font-weight:900; text-decoration:none; }
  .return-contact .primary-pill { background:#087a38; box-shadow:none; }
  .return-faq { padding:25px; }
  .return-faq details { border-top:1px solid #e1ebf6; }
  .return-faq details:first-of-type { margin-top:18px; }
  .return-faq summary { padding:16px 0; color:#061735; font-weight:900; cursor:pointer; }
  .return-faq details p { padding:0 0 16px; }
  @media(max-width:1000px){.return-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.return-intro,.return-two-columns{grid-template-columns:1fr}.return-contact{align-items:flex-start;flex-direction:column}.return-contact>div:last-child{align-items:flex-start;flex-direction:column}}
  @media(max-width:560px){.return-steps{grid-template-columns:1fr}.return-panel,.return-contact,.return-faq{padding:20px}}
</style>
