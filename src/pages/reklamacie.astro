---
import "../styles/global.css";
import "../styles/footer.css";
import "../styles/legal.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingAdvisor from "../components/FloatingAdvisor.astro";
import InfoPageShell from "../components/InfoPageShell.astro";
const notices = [
  ["↺", "Reklamáciu nám najskôr oznámte", "Napíšte na info@tonerymaxim.sk a uveďte číslo objednávky."],
  ["☎", "Pred odoslaním nás kontaktujte", "Pomôžeme urýchliť vybavenie reklamácie."],
  ["!", "Tovar neposielajte na dobierku", "Dobierkové zásielky nebudú prevzaté."],
];
const steps = [
  ["▤", "Vyplňte údaje", "Uveďte číslo objednávky, produkt a popis vady."],
  ["□", "Zabaľte tovar", "Tovar zabaľte tak, aby sa počas prepravy nepoškodil."],
  ["🚚", "Odošlite zásielku", "Priložte doklad o kúpe alebo číslo objednávky."],
  ["✓", "Lehota v potvrdení", "O výsledku a určenej lehote vás budeme informovať."],
];
---
<!doctype html><html lang="sk"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Reklamácie | ToneryMaxim.sk</title><link rel="canonical" href="https://www.tonerymaxim.sk/reklamacie" /></head><body><div class="page"><Header /><main>
<InfoPageShell active="/reklamacie" eyebrow="Reklamácie" title="Reklamačné podmienky" intro="Vadu tovaru zakúpeného v e-shope uplatnite jednoducho online, e-mailom alebo písomne.">
  <section class="notice-row">{notices.map(([icon,title,text]) => <article class="notice-card"><span class="info-icon">{icon}</span><div><b>{title}</b><small>{text}</small></div></article>)}</section>
  <section class="care-support-panel" aria-label="Online formuláre zákazníckej podpory">
    <h2>Online formuláre zákazníckej podpory</h2>
    <p>Reklamáciu aj odstúpenie od zmluvy môžete vybaviť priamo na webe alebo si stiahnuť PDF formulár.</p>
    <div class="care-support-grid">
      <a class="care-support-card" href="/reklamacia-online">
        <span>↺</span>
        <strong>Vyplniť reklamáciu online</strong>
        <small>Pre neregistrovaných zákazníkov aj rýchle podanie reklamácie mimo účtu.</small>
      </a>
      <a class="care-support-card" href="/odstupenie-od-zmluvy">
        <span>↩</span>
        <strong>Odstúpenie od zmluvy online</strong>
        <small>Online formulár a PDF formulár na stiahnutie pre vrátenie tovaru.</small>
      </a>
    </div>
  </section>
  <section class="care-downloads">
    <a href="/reklamacia-online" class="care-primary">Vyplniť reklamáciu online</a>
    <a href="/reklamacny-formular.pdf" class="care-secondary" download>Stiahnuť reklamačný formulár PDF</a>
  </section>
  <h2 class="section-title">Ako prebieha reklamácia?</h2>
  <section class="steps-grid">{steps.map(([icon,title,text], index) => <article class="step-card"><span class="step-no">{index + 1}</span><span class="info-icon">{icon}</span><h2>{title}</h2><p>{text}</p></article>)}</section>

  <article class="legal-panel">
    <header class="legal-panel-head"><h2>Úplné znenie reklamačných podmienok</h2></header>
    <div class="legal-content">
      <section><h2>1. Zodpovednosť za vady</h2><p>Pri spotrebiteľskom nákupe zodpovedáme za vadu, ktorú mal tovar pri dodaní a ktorá sa prejaví do dvoch rokov od dodania. Osobitná obchodná záruka uvedená pri produkte rozširuje zákonné práva, nenahrádza ich ani neobmedzuje.</p><p>Pri nákupe podnikateľa sa práva z vád riadia Obchodným zákonníkom a dohodnutými podmienkami. Neuvádzame automatickú jednoročnú záruku, pokiaľ nebola výslovne poskytnutá.</p></section>
      <section><h2>2. Uplatnenie vady</h2><p>Vadu oznámte do dvoch mesiacov od jej zistenia, najneskôr v zákonnej dobe zodpovednosti. Uveďte, ako sa vada prejavuje a ktoré právo si uplatňujete. Doklad o kúpe pomôže reklamáciu urýchliť, nákup však možno preukázať aj iným hodnoverným spôsobom.</p></section>
      <section><h2>3. Na čo sa zodpovednosť za vady nevzťahuje</h2><p>Zodpovednosť za vady sa nevzťahuje najmä na vady spôsobené:</p><ul><li>mechanickým poškodením výrobku spôsobeným kupujúcim,</li><li>nesprávnym zaobchádzaním s výrobkom alebo používaním v rozpore s návodom,</li><li>používaním tovaru v podmienkach, ktoré nezodpovedajú prirodzenému prostrediu tovaru,</li><li>zanedbaním starostlivosti a údržby,</li><li>nadmerným zaťažovaním,</li><li>používaním v rozpore s dokumentáciou, technickými normami alebo bezpečnostnými predpismi,</li><li>bežným opotrebením tovaru alebo jeho časti,</li><li>živelnou udalosťou.</li></ul></section>
      <section><h2>4. Ako reklamáciu uplatniť</h2><p>Reklamáciu odporúčame vopred oznámiť e-mailom na <a href="mailto:info@tonerymaxim.sk">info@tonerymaxim.sk</a>. Do e-mailu uveďte číslo objednávky, názov produktu, popis vady a podľa možnosti priložte fotografiu.</p><p>Reklamovaný tovar je potrebné vhodne zabaliť, aby počas prepravy nedošlo k jeho poškodeniu. K zásielke priložte kópiu dokladu o kúpe alebo číslo objednávky a stručný popis vady.</p><p>Tovar neposielajte na dobierku. Dobierkové zásielky nebudú prevzaté.</p></section>
      <section><h2>5. Potvrdenie a lehota</h2><p>Bezodkladne vám vydáme písomné potvrdenie o vytknutí vady, v ktorom uvedieme primeranú lehotu na odstránenie vady. Lehota spravidla nepresiahne 30 dní, iba ak je dlhšia doba odôvodnená objektívnym dôvodom, ktorý nemôžeme ovplyvniť. O výsledku dostanete písomný doklad.</p><p>Nevyhnutné náklady na prevzatie veci a odstránenie uznanej vady znáša predávajúci.</p></section>
      <section><h2>6. Práva spotrebiteľa</h2><ul><li>Môžete si zvoliť opravu alebo výmenu, ak zvolený spôsob nie je nemožný alebo v porovnaní s druhým neprimerane nákladný.</li><li>Oprava alebo výmena sa vykoná bezplatne, na naše náklady a bez závažných ťažkostí pre spotrebiteľa.</li><li>Na primeranú zľavu alebo odstúpenie od zmluvy máte právo najmä ak vadu neodstránime, odmietneme odstrániť, vada sa zopakuje alebo je tak závažná, že odôvodňuje okamžitú zľavu či odstúpenie.</li><li>Od zmluvy nemožno odstúpiť, ak je vada zanedbateľná; dôkazné bremeno o zanedbateľnosti nesie predávajúci.</li></ul></section>
      <section><h2>7. Ukončenie reklamácie</h2><p>Reklamácia sa považuje za vybavenú odovzdaním opraveného alebo vymeneného tovaru, vrátením kúpnej ceny, poskytnutím primeranej zľavy, písomnou výzvou na prevzatie plnenia alebo odôvodneným zamietnutím reklamácie.</p><p>O výsledku reklamačného konania je kupujúci informovaný v zákonnej lehote.</p><div class="legal-contact-box"><strong>Kontakt pre reklamácie</strong><span>Roman Babčan INkarus</span><span>Tajov 265, 976 34 Tajov</span><span>IČO: 37 328 344 · DIČ: 1020059920 · IČ DPH: SK1020059920</span><a href="mailto:info@tonerymaxim.sk">info@tonerymaxim.sk</a><a href="tel:+421917859206">+421917859206</a><span>Po–Pi 9:00–15:00</span></div></section>
    </div>
  </article>
</InfoPageShell>
</main><Footer showTrust={false} /><FloatingAdvisor /></div></body></html>
