---
import "../styles/global.css";
import "../styles/footer.css";
import "../styles/account.css";
import { readCustomerSession, setCustomerCookie, customerDisplayName } from "../lib/auth-session";
import { getWooCustomerById, getWooCustomerOrders } from "../lib/woo-client";
import { customerToSession, formatDate, formatMoney, orderNumber, orderStatusLabel, safeText } from "../lib/account-data";
import AccountShell from "../components/AccountShell.astro";

const session = readCustomerSession(Astro.cookies);
if (!session) return Astro.redirect(`/prihlasenie?next=${encodeURIComponent(Astro.url.pathname)}`);

const wooCustomer = await getWooCustomerById(session.id);
if (!wooCustomer) return Astro.redirect(`/prihlasenie?next=${encodeURIComponent(Astro.url.pathname)}`);
setCustomerCookie(Astro.cookies, wooCustomer);
const customer = customerToSession(wooCustomer);
const customerName = customerDisplayName(customer);
const orders = await getWooCustomerOrders(customer.id, 10);
const lastOrder = orders[0] || null;
const totalSpent = orders.reduce((sum, order) => sum + Number(order.total || 0), 0);
const billing = wooCustomer.billing || {};
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Môj účet | ToneryMaxim.sk</title>
  </head>
  <body>
    <AccountShell user={customer} active="prehlad" title={`Dobrý deň, ${customerName}! 👋`} subtitle="Prehľad účtu, objednávok a uložených údajov.">
      <div class="account-stats">
        <a class="account-stat" href="/ucet/objednavky"><span class="account-stat-icon">▣</span><small>Objednávky</small><strong>{orders.length}</strong><span class="account-link">Zobraziť všetky</span></a>
        <a class="account-stat" href="/ucet/adresy"><span class="account-stat-icon">⌖</span><small>Adresa</small><strong>{billing.city ? "OK" : "Chýba"}</strong><span>{billing.city || "Doplniť adresu"}</span></a>
        <a class="account-stat" href="/ucet/profil"><span class="account-stat-icon">◎</span><small>Profil</small><strong>{customer.email ? "OK" : "—"}</strong><span class="account-link">Upraviť</span></a>
        <a class="account-stat" href="/ucet/objednavky"><span class="account-stat-icon">€</span><small>Celkový nákup</small><strong>{formatMoney(totalSpent)}</strong><span>spolu za objednávky</span></a>
      </div>

      <div class="account-grid-2">
        <section class="account-panel">
          <h2>Posledná objednávka</h2>
          {lastOrder ? (
            <div class="order-preview">
              <div class="order-head"><strong>{orderNumber(lastOrder)}</strong><span class="status-pill">{orderStatusLabel(lastOrder.status)}</span></div>
              <div class="account-list-row"><span>Dátum</span><strong>{formatDate(lastOrder.date_created)}</strong></div>
              {(lastOrder.line_items || []).slice(0, 5).map((item) => (
                <div class="order-item"><span>{safeText(item.name)} × {item.quantity || 1}</span><strong>{formatMoney(item.total, lastOrder.currency || "EUR")}</strong></div>
              ))}
              <div class="order-total"><span>Spolu</span><strong>{formatMoney(lastOrder.total, lastOrder.currency || "EUR")}</strong></div>
              <div class="account-order-actions">
                <a class="tm-btn is-outline" href="/ucet/objednavky">Zobraziť objednávky</a>
              </div>
            </div>
          ) : (
            <div class="account-empty-soft">
              <strong>Zatiaľ bez objednávky</strong>
              <p>Po prvej objednávke sa tu zobrazí jej stav a možnosť opakovaného nákupu.</p>
              <a class="tm-btn" href="/produkty">Prejsť na produkty</a>
            </div>
          )}
        </section>

        <section class="account-panel">
          <h2>Údaje zákazníka</h2>
          <div class="account-list-row"><span>Meno</span><strong>{customerName}</strong></div>
          <div class="account-list-row"><span>E-mail</span><strong>{customer.email}</strong></div>
          <div class="account-list-row"><span>Telefón</span><strong>{safeText(billing.phone)}</strong></div>
          <div class="account-list-row"><span>Adresa</span><strong>{billing.address_1 ? `${billing.address_1}, ${billing.postcode || ""} ${billing.city || ""}` : "Chýba"}</strong></div>
          <div class="account-order-actions">
            <a class="tm-btn" href="/ucet/profil">Upraviť profil</a>
            <a class="tm-btn is-outline" href="/ucet/adresy">Upraviť adresy</a>
          </div>
        </section>
      </div>

      <div class="account-actions">
        <a class="account-action" href="/ucet/objednavky"><span class="account-action-icon">▣</span><span><strong>Objednávky</strong><p>Prehľad objednávok, produktov a stavu nákupu.</p></span></a>
        <a class="account-action" href="/ucet/adresy"><span class="account-action-icon">⌖</span><span><strong>Adresy</strong><p>Fakturačná a dodacia adresa pre ďalšie objednávky.</p></span></a>
        <a class="account-action" href="/ucet/profil"><span class="account-action-icon">◎</span><span><strong>Profil a heslo</strong><p>Osobné údaje, telefón a zmena hesla.</p></span></a>
      </div>
    </AccountShell>
  </body>
</html>
