---
import { getDispatchParts } from "../scripts/dispatch-message.js";
import { isAvailableNow, storefrontStockClass, storefrontStockText } from "../lib/product-availability";

type Product = Record<string, any>;

const catalogProps = Astro.props as { products?: Product[]; specialProducts?: Product[]; showSpecialAsProducts?: boolean };
const { products = [], showSpecialAsProducts = false } = catalogProps;

const money = (value: unknown) => new Intl.NumberFormat("sk-SK", {
  style: "currency",
  currency: "EUR",
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
}).format(Number(value || 0));

const hasLowestPriceReference = (product: Product) => product.lowest_price_30d_valid === true && Number(product.lowest_price_30d || 0) > 0;

const pageYield = (product: Product) => {
  for (const candidate of [product.yield_pages, product.page_yield]) {
    const raw = String(candidate ?? "").trim();
    if (!raw || /\b(ml|cl|dl|l|liter|litre|g|kg)\b/i.test(raw)) continue;
    if (!/^\d[\d\s.,]*$/.test(raw) && !/\b(stran|strán|pages?)\b/i.test(raw)) continue;
    const packText = `${product.name || ""} ${product.color || product.farba || ""} ${raw}`;
    if (/CMYK|CMY|C\/M\/Y|multipack|troj[ -]?pack|VAL(?:BP)?|RBWBP|\+/i.test(packText)) continue;
    const multiplier = raw.match(/(\d[\d\s.,]*)\s*(?:x|×|\*)\s*(\d[\d\s.,]*)\s*(?:stran|strán|pages?)/i);
    if (multiplier) {
      const count = Number(multiplier[1].replace(/\s/g, "").replace(",", "."));
      const perItem = Number(multiplier[2].replace(/\s/g, "").replace(/\.(?=\d{3}(?:\D|$))/g, "").replace(",", "."));
      const productName = String(product.name || "");
      const confirmedSameCartridgePack = count === 2 && (/(?:dual\s*pack|duopack|twin|\b2\s*ks\b|\(2\s*ks\)|2\s*x\s*(?:origináln|kompatibiln|renovovan).*toner)/i.test(productName) || /\b(?:CB|CE|CF|Q|W)\d{3,4}(?:A?D|XD)\b/i.test(productName));
      if (confirmedSameCartridgePack && Number.isFinite(perItem) && perItem > 0) return count * perItem;
      continue;
    }
    const match = raw.replace(/\s/g, "").match(/(\d[\d.,]*)/);
    const parsed = match ? Number(match[1].replace(/\.(?=\d{3}(?:\D|$))/g, "").replace(",", ".")) : 0;
    if (Number.isFinite(parsed) && parsed > 0) return parsed;
  }
  return 0;
};
const costPerPage = (product: Product) => {
  const pages = pageYield(product);
  const price = Number(product.price || 0);
  return pages > 0 && price > 0 ? `${(price / pages).toLocaleString("sk-SK", { minimumFractionDigits: 3, maximumFractionDigits: 3 })} € / strana` : "";
};

const typeData = (product: Product) => {
  const key = product.product_type_key || "product";
  if (key === "original") return { key, label: "ORIGINÁL", note: "🏅 Originálna kvalita výrobcu", iconImage: "/design-icons/icon-original.png" };
  if (key === "compatible") return { key, label: "KOMPATIBILNÝ", note: "⭐ Odporúčame, najpredávanejší model", iconImage: "/design-icons/icon-compatible.png" };
  if (key === "renovated") return { key, label: "RENOVOVANÝ", note: "🏢 Ekologická voľba pre kancelárie", iconImage: "/design-icons/icon-renovated.png" };
  return { key, label: product.product_type_label || "PRODUKT", note: product.product_type_note || "Spotrebný materiál", iconImage: "" };
};

const chipVariant = (product: Product) => {
  const key = String(product.product_type_key || "");
  if (key !== "compatible" && key !== "renovated") return null;
  const text = `${product.name || ""} ${product.slug || ""} ${product.description || ""}`.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  if (/bez[ -]?cip|no[ -]?chip/.test(text)) return { key: "no-chip", label: "BEZ ČIPU", note: "Vyžaduje pôvodný čip" };
  if (/hatona/.test(text)) return { key: "hatona", label: "HATONA", note: "Renovovaný variant Hatona" };
  if (/oem[ -]?cip/.test(text)) return { key: "oem-chip", label: "S OEM ČIPOM", note: "Originálny čip" };
  return { key: "ready-chip", label: "S ČIPOM", note: "Pripravený na použitie" };
};

const stockText = (product: Product) => {
  return storefrontStockText(product);
};

const stockClass = (product: Product) => storefrontStockClass(product);
const dispatchInfo = (product: Product) => isAvailableNow(product)
  ? getDispatchParts()
  : { title: "Na objednávku", detail: "dodanie 3–10 pracovných dní" };
const colorHex = (value: unknown) => {
  const c = String(value || "").toLowerCase();
  if (c.includes("žlt") || c.includes("zlt") || c.includes("yellow")) return "#facc15";
  if (c.includes("azú") || c.includes("azur") || c.includes("cyan")) return "#06b6d4";
  if (c.includes("purp") || c.includes("magenta")) return "#d946ef";
  if (c.includes("čier") || c.includes("cier") || c.includes("black")) return "#111827";
  if (c.includes("cmyk") || c.includes("multi")) return "linear-gradient(90deg,#06b6d4,#d946ef,#facc15,#111827)";
  return "#94a3b8";
};


const productDetailUrl = (product: Product) => {
  const direct = String(product?.detail_url || product?.url || "").trim();
  if (direct.startsWith("/")) return direct;
  if (direct.startsWith("/produkt/")) return `${direct}`;
  if (direct.startsWith("produkt/")) return `/${direct}`;
  const slug = String(product?.slug || product?.id || "").trim();
  return slug ? `/produkt/${encodeURIComponent(slug)}` : "/produkty";
};
const desktopProductImage = (value: unknown) => {
  const src = String(value || "");
  if (src.includes("/231-1.jpg")) return "/images/products/brother-lc-123xlm-clean.webp";
  if (src.includes("/232-1.jpg")) return "/images/products/brother-lc-123xly-clean.webp";
  return src;
};
const printers = (product: Product) => Array.isArray(product.compatible_printers) ? product.compatible_printers.filter(Boolean) : [];
const groupTitle = (key: string) => key === "compatible" ? "Kompatibilný" : key === "original" ? "Originál" : key === "renovated" ? "Renovovaný" : "Produkt";
let previousGroup = "";
// Špecializované produkty bez čipu, s OEM čipom a Hatona sa nesmú
// podsúvať na stránke tlačiarne ani v bežnom katalógu. Pri ich výslovnom
// vyhľadaní ich stránka pošle v `products` a zapne showSpecialAsProducts.
const specialProducts: Product[] = [];
const mainProducts = showSpecialAsProducts ? products : products.filter((product) => {
  const chip = chipVariant(product);
  return !chip || (chip.key !== "hatona" && chip.key === "ready-chip");
});
const specialGroups = [
  { key: "no-chip", label: "Bez čipu", note: "Cenovo výhodnejší variant pre zákazníkov, ktorí vedia použiť pôvodný čip." },
  { key: "oem-chip", label: "S OEM čipom", note: "Renovovaný variant s originálnym OEM čipom." },
].map((group) => ({ ...group, products: specialProducts.filter((product) => chipVariant(product)?.key === group.key) })).filter((group) => group.products.length);

---
{mainProducts.map((product) => {
  const type = typeData(product);
  const chip = chipVariant(product);
  const productPrinters = printers(product);
  const showGroup = type.key !== previousGroup;
  previousGroup = type.key;
  const color = product.color || "Neuvedené";
  const capacity = product.yield || product.page_yield || product.capacity || product.kapacita || "Neuvedené";
  const dispatch = dispatchInfo(product);
  const pagePrice = costPerPage(product);
  return (
    <>
      {showGroup && <h2 class={`tm-mobile-product-group tm-mobile-product-group--${type.key}`}>{groupTitle(type.key)}</h2>}
      <article class={`tm-product-row tm-product-row--${type.key}`}>
        <div class="tm-row-accent" aria-hidden="true"></div>
        <div class="tm-row-type">
          <div class="tm-row-symbol" aria-hidden="true">
            {type.iconImage ? <img src={type.iconImage} alt="" /> : <span>•</span>}
          </div>
          <div class="tm-row-type-copy">
            <span class="tm-type-badge">{type.label}</span>
            {chip && <span class={`tm-chip-variant tm-chip-variant--${chip.key}`} title={chip.note}>{chip.label}</span>}
            <p>{type.note}</p>
          </div>
        </div>
        <a href={productDetailUrl(product)} class="tm-row-photo" aria-label="Otvoriť produkt">
          <picture>
            <source media="(min-width: 761px)" srcset={desktopProductImage(product.image)} />
            <img src={product.image} alt={product.name} loading="lazy" class="tm-product-fit-image" />
          </picture>
        </a>
        <div class="tm-row-main">
          <h2><a href={productDetailUrl(product)}>{product.name}</a></h2>
          <p class="tm-row-printers">{productPrinters.length ? productPrinters.slice(0, 4).join(", ") : "Kompatibilita bude doplnená."}</p>
          <div class="tm-row-info-line">
            <div class="tm-row-meta">
              <span class="tm-meta-color"><i style={`--swatch:${colorHex(color)}`}></i>{color}</span>
              <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7z"></path><path d="M14 3v5h5M9 13h6M9 17h6"></path></svg>{capacity}</span>
              <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 20 6v6c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V6z"></path><path d="m8.5 12 2.2 2.2 4.8-5"></path></svg>24 mes. záruka</span>
            </div>
            <div class="tm-row-compat">
              <button type="button" data-open-printers>Vhodné pre {productPrinters.length} tlačiarní</button>
              <span class="tm-dispatch">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"></path><path d="M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path></svg>
                <span class="tm-dispatch-copy">
                  <strong>{dispatch.title}</strong>
                  <small>{dispatch.detail}</small>
                </span>
              </span>
            </div>
          </div>
        </div>
        <div class="tm-row-buy">
          <span class={`tm-stock-dot ${stockClass(product)}`}>{stockText(product)}</span>
          <strong>{money(product.price)}</strong>
          <small>s DPH</small>
          {pagePrice && <small class="tm-cost-per-page">{pagePrice}</small>}
          {hasLowestPriceReference(product) && <small class="tm-lowest-price">Najnižšia cena za posledných 30 dní: <b>{money(product.lowest_price_30d)}</b></small>}
          <button type="button" aria-label={`Pridať do košíka ${product.name}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h16l-2 8H7zM5 6 4 3H2M8 20a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM18 20a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"></path></svg>Do košíka
          </button>
        </div>
      </article>
    </>
  );
})}

{specialGroups.length > 0 && (
  <section class="tm-special-variants-box" aria-label="Ďalšie dostupné varianty">
    <div class="tm-special-variants-head"><strong>Ďalšie dostupné varianty</strong></div>
    <div class="tm-special-variants-list">
      {specialGroups.map((group) => (
        <div class={`tm-special-variants-group tm-special-variants-group--${group.key}`}>
          <div><strong>{group.label}</strong><small>{group.note}</small></div>
          <div class="tm-special-variants-links">
            {group.products.slice(0, 8).map((product) => <a href={productDetailUrl(product)}>{product.name}<b>{money(product.price)}</b></a>)}
          </div>
        </div>
      ))}
    </div>
  </section>
)}
