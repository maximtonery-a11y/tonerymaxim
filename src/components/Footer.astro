  { src: "/images/footer-logos/img (1).png", alt: "Visa", width: 67, height: 23 },
  { src: "/images/footer-logos/img (2).png", alt: "Visa Electron", width: 67, height: 43 },
  { src: "/images/footer-logos/img.png", alt: "Verified by Visa", width: 67, height: 30 },
  { src: "/images/footer-logos/mc_vrt_opt_pos_73_2x.png", alt: "Mastercard", width: 140, height: 115 },
  { src: "/images/footer-logos/ms_vrt_opt_pos_73_2x.png", alt: "Maestro", width: 140, height: 115 },
  { src: "/images/footer-logos/mc_securecode_156px_width.png", alt: "Mastercard SecureCode", width: 156, height: 72 },
];

const shippingLogos = [
  { src: "/images/footer-logos/gls-logo-optimized.webp", alt: "GLS kuriér", width: 220, height: 150 },
  { src: "/images/footer-logos/gls-ptp-optimized.webp", alt: "GLS ParcelShop", width: 300, height: 170 },
  { src: "/images/footer-logos/dpd-logo-optimized.webp", alt: "DPD kuriér", width: 300, height: 133 },
  { src: "/images/footer-logos/dpd-pickup-optimized.webp", alt: "DPD Pickup", width: 240, height: 77 },
];
---

