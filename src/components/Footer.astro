      <a href="/reklamacia-online">Reklamácia online</a>
      <a href="/odstupenie-od-zmluvy">Odstúpenie</a>
      <a href="https://www.tonerymaxim.info" target="_blank" rel="noopener noreferrer">Pôvodný e-shop ↗</a>
    </div>
  </div>
</footer>

<CookieConsent />
<LegacyShopPanel />

<script>
  function formatSkNumber(value: unknown) {
    const number = Number(value || 0);
    if (!Number.isFinite(number) || number <= 0) return "";
    return new Intl.NumberFormat("sk-SK").format(number);
  }

  function formatSkRating(value: unknown) {
    const number = Number(value || 0);
    if (!Number.isFinite(number) || number <= 0) return "";
    return number.toLocaleString("sk-SK", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  }

  function renderStars(rating: unknown) {
    const value = Number(rating || 0);
    const rounded = Math.max(0, Math.min(5, Math.round(value)));
    return "★".repeat(rounded || 5) + "☆".repeat(Math.max(0, 5 - (rounded || 5)));
  }

  function updateFooterHeureka(data: any) {
    if (data?.ok !== true) return;

    const reviews = Array.isArray(data?.reviews) ? data.reviews : [];
    const reviewCards = Array.from(document.querySelectorAll<HTMLElement>("[data-heureka-review-card]"));

    reviews.slice(0, reviewCards.length).forEach((review: any, index: number) => {
      const card = reviewCards[index];
      const textNode = card?.querySelector<HTMLElement>("[data-heureka-review-text]");
      const authorNode = card?.querySelector<HTMLElement>("[data-heureka-review-author]");
      const reviewText = String(review?.summary || review?.pros || "").trim();
      const author = String(review?.author || "").trim();
      if (textNode && reviewText) textNode.textContent = `„${reviewText}“`;
      if (authorNode && author) authorNode.textContent = author;
    });

    const rating = Number(data?.averageRating || 0);
    const reviewCount = Number(data?.reviewCount || 0);
    if (rating <= 0 || reviewCount <= 0) return;
    const ratingText = formatSkRating(rating);
    const countText = formatSkNumber(reviewCount);
    const stars = renderStars(rating);

    document.querySelectorAll("[data-heureka-count], [data-heureka-bottom-count]").forEach((node) => {
      node.textContent = countText;
    });
    document.querySelectorAll("[data-heureka-mini-count]").forEach((node) => {
      node.textContent = `${countText} recenzií`;
    });

    document.querySelectorAll("[data-heureka-rating], [data-heureka-mini-score]").forEach((node) => {
      node.textContent = node.hasAttribute("data-heureka-mini-score") ? `${ratingText}/5` : ratingText;
    });

    document.querySelectorAll("[data-heureka-stars]").forEach((node) => {
      node.textContent = stars;
    });
    if (Number(data?.recommendationPercent || 0) > 0) {
      document.querySelectorAll("[data-heureka-recommendation]").forEach((node) => {
        node.textContent = `${Math.round(Number(data.recommendationPercent))} %`;
      });
    }
  }

  async function loadFooterHeurekaStats() {
    try {
      const response = await fetch("/api/heureka-reviews", {
        headers: { Accept: "application/json" },
        cache: "default",
      });
      const data = await response.json();
      updateFooterHeureka(data);
    } catch (error) {
      // Zostanú zobrazené posledné overené hodnoty a recenzie uložené v HTML.
    }
  }

  loadFooterHeurekaStats();
</script>
