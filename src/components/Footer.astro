<script>
  const HEUREKA_REVIEW_URL = "https://obchody.heureka.sk/tonerymaxim-sk/recenze/?e=reviews&p=left";

  function formatSkNumber(value) {
    const number = Number(value || 0);
    if (!Number.isFinite(number) || number <= 0) return "1 323";
    return new Intl.NumberFormat("sk-SK").format(number);
  }

  function formatSkRating(value) {
    const number = Number(value || 0);
    if (!Number.isFinite(number) || number <= 0) return "4,9";
    return number.toLocaleString("sk-SK", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  }

  function escapeHtml(value) {
    return String(value || "").replace(/[&<>'"]/g, (char) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      "'": "&#039;",
      '"': "&quot;",
    }[char]));
  }

  function renderStars(rating) {
    const value = Number(rating || 0);
    const rounded = Math.max(0, Math.min(5, Math.round(value)));
    return "★".repeat(rounded || 5) + "☆".repeat(Math.max(0, 5 - (rounded || 5)));
  }

  function updateHeurekaDom(data) {
    const recommendation = Number(data?.recommendationPercent || 100);
    const rating = Number(data?.averageRating || 4.9);
    const reviewCount = Number(data?.reviewCount || 1323);
    const countText = formatSkNumber(reviewCount);
    const ratingText = formatSkRating(rating);
    const stars = renderStars(rating);

    document.querySelectorAll("[data-heureka-recommendation], [data-heureka-bottom-recommendation]").forEach((node) => {
      node.textContent = `${recommendation} %`;
    });

    document.querySelectorAll("[data-heureka-count], [data-heureka-bottom-count]").forEach((node) => {
      node.textContent = countText;
    });

    document.querySelectorAll("[data-heureka-rating]").forEach((node) => {
      node.textContent = ratingText;
    });

    document.querySelectorAll("[data-heureka-stars]").forEach((node) => {
      node.textContent = stars;
    });

    document.querySelectorAll("[data-heureka-mini-score]").forEach((node) => {
      node.textContent = `${ratingText}/5`;
    });

    document.querySelectorAll("[data-heureka-mini-count]").forEach((node) => {
      node.textContent = `${countText} recenzií`;
    });

    const cards = document.querySelector("[data-heureka-review-cards]");
    const reviews = Array.isArray(data?.reviews) ? data.reviews.slice(0, 3) : [];

    if (cards && reviews.length) {
      cards.innerHTML = reviews.map((review) => {
        const text = review.summary || review.pros || "Overený zákazník odporúča obchod.";
        return `
          <a class="heureka-review-card" href="${HEUREKA_REVIEW_URL}" target="_blank" rel="noopener noreferrer">
            <p>„${escapeHtml(text)}“</p>
            <div><span class="heureka-mini-badge">✓</span><small>Overený zákazník</small></div>
            <strong>${renderStars(review.rating || 5)}</strong>
          </a>
        `;
      }).join("");
    }
  }

  async function loadHeurekaStats() {
    try {
      const response = await fetch("/api/heureka-reviews", {
        headers: { Accept: "application/json" },
        cache: "default",
      });
      const data = await response.json();
      updateHeurekaDom(data);
    } catch (error) {
      // Fallback hodnoty ostanú v HTML.
    }
  }

  loadHeurekaStats();
</script>
