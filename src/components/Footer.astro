      </a>
      <p>Slovenský špecialista na tonery, atramentové náplne a komponenty pre tlačiarne.</p>
    </div>

    <nav class="footer-col" aria-label="Zákaznícka podpora">
      <h3>Zákaznícka podpora</h3>
      <a href="/kontakt">Kontakt</a>
      <a href="/faq">FAQ</a>
      <a href="/poradna">Odborná poradňa</a>
      <a href="/doprava-a-platba">Doprava</a>
      <a href="/reklamacie">Reklamácie</a>
      <a href="/reklamacia-online">Reklamácia online</a>
      <a href="/odstupenie-od-zmluvy">Odstúpenie od zmluvy</a>
      <a href="/obchodne-podmienky">Obchodné podmienky</a>
    </nav>

    <nav class="footer-col" aria-label="Sortiment">
      <h3>Sortiment</h3>
      <a href="/tonery">Tonery</a>
      <a href="/atramentove-naplne">Atramentové náplne</a>
      <a href="/produkty?category=opticke-valce&search=optick%C3%A9%20valce">Optické valce</a>
      <a href="/produkty?category=ostatne-komponenty&search=komponent">Ostatné komponenty</a>
    </nav>

    <nav class="footer-col" aria-label="Firma">
      <h3>Firma</h3>
      <a href="/o-nas">O nás</a>
      <a href="/kontakt">Kontakt</a>
      <a href="/toner-bez-starosti">Toner bez starostí</a>
      <a href="/spatny-odber-tonerov">Spätný odber tonerov</a>
      <a href="/vernostny-program">Vernostný program</a>
      <a href="/ochrana-osobnych-udajov">GDPR</a>
      <a href="/partneri-a-tretie-strany">Partneri a tretie strany</a>
      <a href="/cookies">Informácie o cookies</a>
      <a href="/cookies#nastavenia" data-open-cookie-settings>Nastavenia cookies</a>
      <a href="https://www.tonerymaxim.info" target="_blank" rel="noopener noreferrer">Pôvodný e-shop ↗</a>
    </nav>

    <div class="footer-contact-box">
      <h3>Kontakt</h3>
      <a href="tel:+421917859206">☎ +421 917 859 206</a>
      <a href="mailto:info@tonerymaxim.sk">✉ info@tonerymaxim.sk</a>
      <p>Po–Pi 9:00–15:00</p>
      <p class="footer-company-data">Roman Babčan INkarus<br />Tajov 265, 976 34 Tajov<br />IČO: 37 328 344 · DIČ: 1020059920 · IČ DPH: SK1020059920</p>
      <a class="footer-contact-rating" href={heurekaUrl} target="_blank" rel="noopener noreferrer" aria-label="Otvoriť recenzie ToneryMaxim na Heureke">
        <span class="footer-heureka-stars" data-heureka-stars aria-hidden="true">★★★★★</span>
        <span class="footer-heureka-details">
          <strong><span data-heureka-rating>4,9</span>/5</strong>
          <small><b data-heureka-count>1 326</b> recenzií</small>
          <small><b data-heureka-recommendation>100 %</b> odporúča</small>
        </span>
      </a>
    </div>
  </div>

  <div class="wrap footer-trust-row" aria-label="Platby a doprava">
    <div class="footer-methods footer-payment-methods">
      <strong>Platby</strong>
      <div class="footer-logo-list footer-logo-list--payments">
        {paymentLogos.map((logo) => (
          <span class="footer-logo-tile">
            <img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} loading="lazy" decoding="async" />
          </span>
        ))}
      </div>
    </div>

    <div class="footer-methods footer-shipping-methods">
      <strong>Doprava</strong>
      <div class="footer-logo-list footer-logo-list--shipping">
        {shippingLogos.map((logo) => (
          <span class="footer-logo-tile footer-logo-tile--shipping">
            <img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} loading="lazy" decoding="async" />
          </span>
