<script>
  // Odstráni prípadný druhý poradenský blok vložený staršou komponentou alebo starým layoutom.
  function removeDuplicateHelpBlocks() {
    const cards = Array.from(document.querySelectorAll(".footer-help-card, .help-card, .advisor-card, .support-card, .need-help-card, [data-help-card], [data-advisor-card]"));
    const visibleTextCards = cards.filter((card) => /potrebujete poradiť|pomôžeme vám vybrať|radi vám pomôžeme/i.test(card.textContent || ""));

    visibleTextCards.forEach((card, index) => {
      if (index > 0) card.remove();
    });

    document.querySelectorAll("section, div, article").forEach((node) => {
      const text = node.textContent || "";
      if (/Potrebujete poradiť/i.test(text) && /Pomôžeme vám vybrať správnu náplň/i.test(text)) {
        node.remove();
      }
    });
  }

  removeDuplicateHelpBlocks();
  document.addEventListener("DOMContentLoaded", removeDuplicateHelpBlocks);
</script>
