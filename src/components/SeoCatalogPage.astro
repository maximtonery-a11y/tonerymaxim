---
import "../styles/global.css";
import "../styles/products-catalog.css";
import "../styles/footer.css";
import "../styles/seo-catalog.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingAdvisor from "./FloatingAdvisor.astro";
import SeoHead from "./SeoHead.astro";
import CatalogInitialRows from "./CatalogInitialRows.astro";
import { breadcrumbJsonLd, organizationJsonLd, websiteJsonLd } from "../lib/seo";
import { catalogStats, collectionJsonLd, type EntityLink, type TmProduct } from "../lib/seo-catalog";
import { EXPERT_EXPERIENCE, EXPERT_NAME, EXPERT_PATH, expertPersonJsonLd } from "../lib/expert";
import { skCount } from "../lib/catalog-seo-text";

type Link = { href: string; label: string };
type Faq = { question: string; answer: string };
type ContentSection = { heading: string; paragraphs: string[]; bullets?: string[] };
type CommerceBenefit = { icon: string; title: string; detail: string; dispatch?: boolean; compatibleOnly?: boolean };
type TypeComparison = { key: "compatible" | "original" | "renovated"; title: string; description: string; benefit: string; suitable: string };
type RecommendationCard = { title: string; text: string; href?: string };
type LinkGroup = { heading: string; intro?: string; links: EntityLink[] };
type Pagination = { page: number; totalPages: number; pageSize: number; basePath: string };
type ExpertGuide = {
  title: string;
  summary: string;
  updated: string;
  author?: string;
  experience?: string;
  links?: Link[];
};

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalPath: string;
  eyebrow: string;
  heading: string;
  intro: string;
  products: TmProduct[];
  breadcrumbs?: Array<{ name: string; path: string }>;
  relatedLinks?: Link[];
  faq?: Faq[];
  entityFacts?: string[];
  answer?: string;
  contentSections?: ContentSection[];
  linkGroups?: LinkGroup[];
  generatedAt?: string;
  schemaEntities?: Array<{ name: string; url?: string }>;
  notFound?: boolean;
  expertGuide?: ExpertGuide;
  pagination?: Pagination;
  productFirst?: boolean;
  productTypeFilters?: boolean;
  commerceBenefits?: CommerceBenefit[];
  typeComparison?: TypeComparison[];
  recommendationCard?: RecommendationCard;
}

const {
  title,
  description,
  image,
  canonicalPath,
  eyebrow,
  heading,
  intro,
  products = [],
  breadcrumbs = [],
  relatedLinks = [],
  faq = [],
  entityFacts = [],
  answer = "",
  contentSections = [],
  linkGroups = [],
  generatedAt = "",
  schemaEntities = [],
  notFound = false,
  expertGuide,
  pagination,
  productFirst = false,
  productTypeFilters = false,
  commerceBenefits = [],
  typeComparison = [],
  recommendationCard,
} = Astro.props;

const SEO_ORIGIN = "https://www.tonerymaxim.sk";
const previewHost = ["tonerymaxim.info", "www.tonerymaxim.info"].includes(Astro.url.hostname.toLowerCase());
const canonical = new URL(canonicalPath, SEO_ORIGIN).toString();
const noindex = previewHost || notFound || products.length === 0;
const paginationPage = pagination ? Math.min(pagination.totalPages, Math.max(1, pagination.page)) : 1;
const shownProducts = pagination
  ? products.slice((paginationPage - 1) * pagination.pageSize, paginationPage * pagination.pageSize)
  : products.slice(0, 80);
const paginationUrl = (page: number) => page <= 1 ? pagination?.basePath || canonicalPath : `${pagination?.basePath || canonicalPath}?page=${page}`;
const previousPage = pagination && paginationPage > 1 ? paginationUrl(paginationPage - 1) : "";
const nextPage = pagination && paginationPage < pagination.totalPages ? paginationUrl(paginationPage + 1) : "";
const breadcrumbItems = [{ name: "Domov", path: "/" }, ...breadcrumbs];
const stats = catalogStats(products);
const money = (value: number) => new Intl.NumberFormat("sk-SK", {
  style: "currency",
  currency: "EUR",
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
}).format(value);
const statCards = [
  { label: "Produktov", value: String(stats.total) },
  { label: "Skladom", value: String(stats.inStock) },
  ...(stats.compatible ? [{ label: "Kompatibilných", value: String(stats.compatible) }] : []),
  ...(stats.original ? [{ label: "Originálnych", value: String(stats.original) }] : []),
  ...(stats.renovated ? [{ label: "Renovovaných", value: String(stats.renovated) }] : []),
  ...(stats.minPrice > 0 ? [{
    label: stats.minPrice === stats.maxPrice ? "Cena" : "Ceny od",
    value: money(stats.minPrice),
  }] : []),
];
const faqJsonLd = faq.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
} : null;
const expertJsonLd = expertGuide ? {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${canonical}#expert-guide`,
  headline: expertGuide.title,
  description: expertGuide.summary,
  url: canonical,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  datePublished: "2026-08-09",
  dateModified: expertGuide.updated,
  inLanguage: "sk-SK",
  author: {
    "@type": "Person",
    "@id": `${SEO_ORIGIN}${EXPERT_PATH}#person`,
    name: expertGuide.author || "Roman Babčan",
    url: `${SEO_ORIGIN}${EXPERT_PATH}`,
    jobTitle: "Odborný poradca pre tonery a tlačiarne",
    worksFor: { "@id": `${SEO_ORIGIN}/#organization` },
  },
  publisher: { "@id": `${SEO_ORIGIN}/#organization` },
} : null;
const jsonLd = [
  organizationJsonLd(SEO_ORIGIN),
  expertPersonJsonLd(SEO_ORIGIN),
  websiteJsonLd(SEO_ORIGIN),
  breadcrumbJsonLd(SEO_ORIGIN, breadcrumbItems),
  collectionJsonLd(SEO_ORIGIN, canonicalPath, heading, description, shownProducts, {
    generatedAt,
    about: schemaEntities,
  }),
  ...(faqJsonLd ? [faqJsonLd] : []),
  ...(expertJsonLd ? [expertJsonLd] : []),
];
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    {previousPage && <link rel="prev" href={new URL(previousPage, SEO_ORIGIN).toString()} />}
    {nextPage && <link rel="next" href={new URL(nextPage, SEO_ORIGIN).toString()} />}
  </head>
  <body>
    <div class="page">
      <Header />

      <main class="seo-catalog-page">
        <section class:list={{ "seo-catalog-hero": true, "seo-catalog-hero--product-first": productFirst }}>
          <div class="wrap">
            <nav class="seo-breadcrumbs" aria-label="Drobečková navigácia">
              {breadcrumbItems.map((item, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">›</span>}
                  {index === breadcrumbItems.length - 1
                    ? <strong>{item.name}</strong>
                    : <a href={item.path}>{item.name}</a>}
                </>
              ))}
            </nav>
            <p class="eyebrow">{eyebrow}</p>
            <h1>{heading}</h1>
            <p class="seo-catalog-lead">{intro}</p>

            {productFirst && commerceBenefits.length > 0 && (
              <ul class="seo-commerce-benefits" aria-label="Výhody nákupu">
                {commerceBenefits.map((benefit) => (
                  <li class:list={{ "seo-benefit-compatible": benefit.compatibleOnly }}>
                    <span class="seo-benefit-icon" aria-hidden="true">{benefit.icon}</span>
                    <span>
                      <strong data-tm-dispatch-title={benefit.dispatch ? "" : undefined}>{benefit.title}</strong>
                      <small data-tm-dispatch-detail={benefit.dispatch ? "" : undefined}>{benefit.detail}</small>
                    </span>
                  </li>
                ))}
              </ul>
            )}

            {entityFacts.length > 0 && (
              <ul class="seo-fact-list" aria-label="Dôležité informácie">
                {entityFacts.map((fact) => {
                  const match = productTypeFilters ? fact.match(/^(Kompatibilné|Originálne|Renovované):\s*(\d+)/) : null;
                  const filter = match?.[1] === "Kompatibilné" ? "compatible" : match?.[1] === "Originálne" ? "original" : match?.[1] === "Renovované" ? "renovated" : "";
                  const selected = filter && Astro.url.searchParams.get("typ") === filter;
                  const filterHref = filter ? (selected ? `${canonicalPath}#produkty` : `${canonicalPath}?typ=${filter}#produkty`) : "";
                  return <li class:list={{ [`seo-type-${filter}`]: Boolean(filter), "is-active": Boolean(selected) }}>{filter ? <a class="seo-type-filter" href={filterHref} aria-current={selected ? "true" : undefined}>{fact}</a> : fact}</li>;
                })}
              </ul>
            )}

            {relatedLinks.length > 0 && (
              <nav class="seo-related-links" aria-label="Súvisiace kategórie">
                {relatedLinks.map((link) => <a href={link.href}>{link.label}</a>)}
              </nav>
            )}
          </div>
        </section>

        {!productFirst && !notFound && answer && (
          <section class="seo-answer-section" aria-label="Aktuálne údaje z katalógu">
            <div class="wrap seo-answer-grid">
              <article class="seo-answer-card">
                <div class="seo-answer-label"><span aria-hidden="true">✓</span> Údaje z aktuálneho katalógu</div>
                <p>{answer}</p>
              </article>

              <dl class="seo-stat-grid" aria-label="Súhrn ponuky">
                {statCards.slice(0, 6).map((item) => (
                  <div>
                    <dt>{item.label}</dt>
                    <dd>{item.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </section>
        )}

        {!productFirst && !notFound && expertGuide && (
          <section class="seo-expert-guide" aria-labelledby="seo-expert-title">
            <div class="wrap seo-expert-guide-grid">
              <article>
                <p class="eyebrow">Odborné odporúčanie</p>
                <h2 id="seo-expert-title">{expertGuide.title}</h2>
                <p>{expertGuide.summary}</p>
                {expertGuide.links && expertGuide.links.length > 0 && (
                  <nav aria-label="Súvisiace odborné návody">
                    {expertGuide.links.map((link) => <a href={link.href}>{link.label}<span aria-hidden="true">→</span></a>)}
                  </nav>
                )}
              </article>
              <aside>
                <strong><a href={EXPERT_PATH}>{expertGuide.author || EXPERT_NAME}</a></strong>
                <span>odborný garant obsahu</span>
                <b>{expertGuide.experience || EXPERT_EXPERIENCE}</b>
                <small>Aktualizované {new Intl.DateTimeFormat("sk-SK", { dateStyle: "medium" }).format(new Date(`${expertGuide.updated}T12:00:00Z`))}</small>
              </aside>
            </div>
          </section>
        )}



        <section class="seo-catalog-products" id="produkty">
          <div class="wrap">
            <div class="seo-section-heading">
              <div>
                <p class="eyebrow">Aktuálna ponuka</p>
                <h2>{notFound ? "Stránka sa nenašla" : `${skCount(products.length, "produkt", "produkty", "produktov")} v ponuke`}</h2>
              </div>
              {!notFound && products.length > shownProducts.length && (
                <a href={`/produkty?s=${encodeURIComponent(heading)}`}>Zobraziť celý katalóg</a>
              )}
            </div>

            {shownProducts.length > 0 ? (
              <>
                <div class="catalog-list seo-catalog-list">
                  <CatalogInitialRows products={shownProducts} />
                </div>
                {pagination && pagination.totalPages > 1 && (
                  <nav class="catalog-pagination" aria-label="Stránkovanie produktov">
                    <a class:list={{ "is-disabled": !previousPage }} href={previousPage || paginationUrl(1)} aria-disabled={!previousPage}>Predchádzajúca</a>
                    <span>Strana {paginationPage} z {pagination.totalPages}</span>
                    <a class:list={{ "is-disabled": !nextPage }} href={nextPage || paginationUrl(pagination.totalPages)} aria-disabled={!nextPage}>Ďalšia</a>
                  </nav>
                )}
              </>
            ) : (
              <div class="seo-empty-state">
                <h2>{notFound ? "Táto stránka neexistuje" : "Produkty pripravujeme"}</h2>
                <p>Vyhľadajte toner podľa označenia alebo modelu tlačiarne.</p>
                <div>
                  <a class="seo-primary-action" href="/produkty">Prejsť na produkty</a>
                  <a href="/tlaciarne">Vybrať tlačiareň</a>
                </div>
              </div>
            )}
          </div>
        </section>

        {productFirst && !notFound && (answer || expertGuide) && (
          <div id="odborne-informacie" class="seo-printer-details">
            {answer && (
              <section class="seo-answer-section" aria-label="Aktuálne údaje z katalógu">
                <div class="wrap seo-answer-grid">
                  <article class="seo-answer-card">
                    <div class="seo-answer-label"><span aria-hidden="true">✓</span> Údaje z aktuálneho katalógu</div>
                    <p>{answer}</p>
                  </article>
                  <dl class="seo-stat-grid" aria-label="Súhrn ponuky">
                    {statCards.slice(0, 6).map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
                  </dl>
                </div>
              </section>
            )}
            {expertGuide && (
              <section class="seo-expert-guide" aria-labelledby="seo-expert-title-after">
                <div class="wrap seo-expert-guide-grid">
                  <article>
                    <p class="eyebrow">Odborné odporúčanie</p>
                    <h2 id="seo-expert-title-after">{expertGuide.title}</h2>
                    <p>{expertGuide.summary}</p>
                    {expertGuide.links && expertGuide.links.length > 0 && (
                      <nav aria-label="Súvisiace odborné návody">
                        {expertGuide.links.map((link) => <a href={link.href}>{link.label}<span aria-hidden="true">→</span></a>)}
                      </nav>
                    )}
                  </article>
                  <aside>
                    <strong><a href={EXPERT_PATH}>{expertGuide.author || EXPERT_NAME}</a></strong>
                    <span>odborný garant obsahu</span>
                    <b>{expertGuide.experience || EXPERT_EXPERIENCE}</b>
                    <small>Aktualizované {new Intl.DateTimeFormat("sk-SK", { dateStyle: "medium" }).format(new Date(`${expertGuide.updated}T12:00:00Z`))}</small>
                  </aside>
                </div>
              </section>
            )}
          </div>
        )}

        {productFirst && contentSections.length > 0 && (
          <section class="seo-content-section seo-printer-content">
            <div class="wrap seo-content-grid">
              {contentSections.map((section) => (
                <article>
                  <h2>{section.heading}</h2>
                  {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                  {section.bullets && section.bullets.length > 0 && (
                    <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
                  )}
                </article>
              ))}
            </div>
          </section>
        )}

        {productFirst && typeComparison.length > 0 && (
          <section class="seo-printer-type-section" aria-labelledby="seo-type-comparison-title">
            <div class="wrap">
              <h2 id="seo-type-comparison-title">Aký typ náplne si vybrať?</h2>
              <p class="seo-printer-section-intro">Rozdiel je najmä vo výrobcovi, cene a spôsobe výroby. Vždy vyberajte produkt určený pre presný model vašej tlačiarne.</p>
              <div class="seo-type-comparison">
                {typeComparison.map((item) => (
                  <article class={`seo-type-card seo-type-card--${item.key}`}>
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                    <dl>
                      <div><dt>Hlavná výhoda</dt><dd>{item.benefit}</dd></div>
                      <div><dt>Vhodné pre</dt><dd>{item.suitable}</dd></div>
                    </dl>
                  </article>
                ))}
              </div>
            </div>
          </section>
        )}

        {productFirst && recommendationCard && (
          <section class="seo-recommendation-section" aria-labelledby="seo-recommendation-title">
            <div class="wrap">
              <article class="seo-recommendation-card">
                <span aria-hidden="true">★</span>
                <div>
                  <p class="eyebrow">Odporúčame</p>
                  <h2 id="seo-recommendation-title">{recommendationCard.title}</h2>
                  <p>{recommendationCard.text}</p>
                </div>
                {recommendationCard.href && <a href={recommendationCard.href}>Zobraziť odporúčaný toner</a>}
              </article>
            </div>
          </section>
        )}

        {!productFirst && contentSections.length > 0 && (
          <section class="seo-content-section">
            <div class="wrap seo-content-grid">
              {contentSections.map((section) => (
                <article>
                  <h2>{section.heading}</h2>
                  {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                  {section.bullets && section.bullets.length > 0 && (
                    <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
                  )}
                </article>
              ))}
            </div>
          </section>
        )}

        {linkGroups.some((group) => group.links.length > 0) && (
          <section class="seo-entity-section">
            <div class="wrap">
              {linkGroups.filter((group) => group.links.length > 0).map((group) => (
                <div class="seo-entity-group">
                  <div class="seo-entity-heading">
                    <h2>{group.heading}</h2>
                    {group.intro && <p>{group.intro}</p>}
                  </div>
                  <div class="seo-entity-links">
                    {group.links.map((link) => (
                      <a href={link.href}>
                        <strong>{link.label}</strong>
                        {link.description && <span>{link.description}</span>}
                        {typeof link.count === "number" && <small>{link.count} produktov</small>}
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {faq.length > 0 && (
          <section class="seo-faq-section">
            <div class="wrap seo-faq-wrap">
              <div>
                <p class="eyebrow">Faktografické odpovede</p>
                <h2>Najčastejšie otázky</h2>
              </div>
              <div class="seo-faq-list">
                {faq.map((item) => (
                  <details>
                    <summary>{item.question}</summary>
                    <p>{item.answer}</p>
                  </details>
                ))}
              </div>
            </div>
          </section>
        )}
      </main>

      <Footer showTrust={false} />
      <FloatingAdvisor />
    </div>

    <script>
      import "../scripts/smart-search.js";

      document.querySelectorAll(".seo-catalog-list .tm-product-row").forEach((row) => {
        const target = row.querySelector(".tm-row-main h2 a, .tm-row-photo")?.getAttribute("href");
        if (!target) return;
        row.querySelectorAll(".tm-row-buy button, [data-open-printers]").forEach((button) => {
          button.addEventListener("click", () => { window.location.href = target; });
        });
      });

      window.tmInitSmartSearch?.();
      document.addEventListener("DOMContentLoaded", () => window.tmInitSmartSearch?.());

      import("../scripts/dispatch-message.js").then(({ getDispatchParts }) => {
        const parts = getDispatchParts();
        document.querySelectorAll("[data-tm-dispatch-title]").forEach((element) => { element.textContent = parts.title; });
        document.querySelectorAll("[data-tm-dispatch-detail]").forEach((element) => { element.textContent = parts.detail; });
      }).catch(() => {});
    </script>
  </body>
</html>
