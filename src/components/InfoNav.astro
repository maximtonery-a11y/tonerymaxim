---
const { active = "" } = Astro.props;
const items = [
  { href: "/faq", label: "FAQ", desc: "Najčastejšie otázky o toneroch", icon: "?" },
  { href: "/kontakt", label: "Kontakt", desc: "Napíšte nám alebo nájdite firemné údaje", icon: "✉" },
  { href: "/doprava-a-platba", label: "Doprava a platba", desc: "Spôsoby doručenia a platby", icon: "▣" },
  { href: "/reklamacie", label: "Reklamácie", desc: "Postup pri reklamácii", icon: "↺" },
  { href: "/obchodne-podmienky", label: "Obchodné podmienky", desc: "Pravidlá nákupu", icon: "§" },
  { href: "/ochrana-osobnych-udajov", label: "Ochrana osobných údajov", desc: "GDPR a vaše práva", icon: "◌" },
  { href: "/cookies", label: "Cookies", desc: "Používanie cookies", icon: "⌕" },
];
---
<aside class="info-sidebar" aria-label="Informačné stránky">
  <div class="info-sidebar-card">
    <span class="info-sidebar-label">Centrum pomoci</span>
    <strong>Informačné stránky</strong>
    <nav>
      {items.map((item) => (
        <a href={item.href} class={active === item.href ? "is-active" : ""}>
          <i aria-hidden="true">{item.icon}</i>
          <span>{item.label}</span>
          <small>{item.desc}</small>
        </a>
      ))}
    </nav>
  </div>
</aside>
