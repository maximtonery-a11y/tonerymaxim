---
const { active = "" } = Astro.props;
const items = [
  { href: "/novy/faq", label: "FAQ", desc: "Najčastejšie otázky o toneroch", icon: "?" },
  { href: "/novy/kontakt", label: "Kontakt", desc: "Napíšte nám alebo nájdite firemné údaje", icon: "✉" },
  { href: "/novy/doprava-a-platba", label: "Doprava a platba", desc: "Spôsoby doručenia a platby", icon: "▣" },
  { href: "/novy/reklamacie", label: "Reklamácie", desc: "Postup pri reklamácii", icon: "↺" },
  { href: "/novy/reklamacia-online", label: "Reklamácia online", desc: "Vyplniť formulár na webe", icon: "✎", group: "online" },
  { href: "/novy/odstupenie-od-zmluvy", label: "Odstúpenie online", desc: "Formulár a PDF na stiahnutie", icon: "↩", group: "online" },
  { href: "/novy/obchodne-podmienky", label: "Obchodné podmienky", desc: "Pravidlá nákupu", icon: "§" },
  { href: "/novy/ochrana-osobnych-udajov", label: "Ochrana osobných údajov", desc: "GDPR a vaše práva", icon: "◌" },
  { href: "/novy/cookies", label: "Cookies", desc: "Používanie cookies", icon: "⌕" },
];
---
<aside class="info-sidebar" aria-label="Informačné stránky">
  <div class="info-sidebar-card">
    <span class="info-sidebar-label">Centrum pomoci</span>
    <strong>Zákaznícka podpora</strong>
    <nav>
      {items.map((item) => (
        <a href={item.href} class={`${active === item.href ? "is-active" : ""} ${item.group === "online" ? "is-online-form" : ""}`.trim()}>
          <i aria-hidden="true">{item.icon}</i>
          <span>{item.label}</span>
          <small>{item.desc}</small>
        </a>
      ))}
    </nav>
  </div>
</aside>
