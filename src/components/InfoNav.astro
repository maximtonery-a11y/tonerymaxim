---
const { active = "" } = Astro.props;
const items = [
  { href: "/o-nas", label: "O nás", desc: "Spoznajte ToneryMaxim", icon: "★" },
  { href: "/faq", label: "FAQ", desc: "Najčastejšie otázky o toneroch", icon: "?" },
  { href: "/poradna", label: "Odborná poradňa", desc: "Praktické návody k tonerom a tlačiarňam", icon: "i" },
  { href: "/kontakt", label: "Kontakt", desc: "Napíšte nám alebo nájdite firemné údaje", icon: "✉" },
  { href: "/doprava-a-platba", label: "Doprava a platba", desc: "Spôsoby doručenia a platby", icon: "▣" },
  { href: "/toner-bez-starosti", label: "Toner bez starostí", desc: "Pripomienka výmeny náplne", icon: "◷" },
  { href: "/spatny-odber-tonerov", label: "Spätný odber", desc: "Pravidlá a postup zvozu", icon: "♻" },
  { href: "/vernostny-program", label: "Vernostný program", desc: "Body a odmeny za nákupy", icon: "★" },
  { href: "/reklamacie", label: "Reklamácie", desc: "Postup pri reklamácii", icon: "↺" },
  { href: "/reklamacia-online", label: "Reklamácia online", desc: "Vyplniť formulár na webe", icon: "✎", group: "online" },
  { href: "/odstupenie-od-zmluvy", label: "Odstúpenie online", desc: "Formulár a PDF na stiahnutie", icon: "↩", group: "online" },
  { href: "/obchodne-podmienky", label: "Obchodné podmienky", desc: "Pravidlá nákupu", icon: "§" },
  { href: "/ochrana-osobnych-udajov", label: "Ochrana osobných údajov", desc: "GDPR a vaše práva", icon: "◌" },
  { href: "/partneri-a-tretie-strany", label: "Partneri a tretie strany", desc: "Dopravcovia, platby a online služby", icon: "↗" },
  { href: "/cookies", label: "Cookies", desc: "Používanie cookies", icon: "⌕" },
];
---
<aside class="info-sidebar" aria-label="Informačné stránky">
  <div class="info-sidebar-card">
    <span class="info-sidebar-label">Centrum pomoci</span>
    <strong>Zákaznícka podpora</strong>
    <nav>
      {items.map((item) => (
        <a href={item.href} class={`${active === item.href ? "is-active" : ""} ${item.group === "online" ? "is-online-form" : ""}`.trim()}>
          <i aria-hidden="true">{item.icon}</i>
          <span>{item.label}</span>
          <small>{item.desc}</small>
        </a>
      ))}
    </nav>
  </div>
</aside>
