---
import mobileLogo from "../assets/tonerymaxim-mobile-approved-logo.png";
import TrustBar from "./TrustBar.astro";
---

<header class="site-header">
  <a class="site-logo-link" href="/" aria-label="ToneryMaxim domov">
    <img class="site-logo" src="/images/tonerymaxim-logo-sharp.png" alt="ToneryMaxim" width="1270" height="222" decoding="async" fetchpriority="high" />
  </a>

  <nav class="site-nav" aria-label="Hlavná navigácia">
    <a href="/tonery">Tonery</a>
    <a href="/atramentove-naplne">Atramenty</a>
    <a href="/produkty?category=opticke-valce&search=optick%C3%A9%20valce">Valce</a>
    <a href="/produkty?category=ostatne-komponenty&search=ostatn%C3%A9%20komponenty">Komponenty</a>
  </nav>

  <div class="header-search-area">
    <form class="header-search" action="/produkty" method="get" data-smart-search>
      <span class="header-search-icon" aria-hidden="true">⌕</span>
      <input
        type="search"
        name="s"
        data-smart-search-input
        placeholder="Hľadať toner alebo tlačiareň..."
        aria-label="Hľadať toner, náplň alebo tlačiareň"
      />
      <button type="submit" aria-label="Vyhľadať">Hľadať</button>
    </form>
  </div>

  <div class="header-actions">
    <a
      class="header-heureka"
      href="https://obchody.heureka.sk/tonerymaxim-sk/recenze/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Heureka recenzie ToneryMaxim"
      data-heureka-mini
    >
      <span class="header-heureka-stars" data-heureka-stars aria-hidden="true">★★★★★</span>
      <strong class="header-heureka-score" data-heureka-mini-score>4,9/5</strong>
      <small class="header-heureka-count" data-heureka-mini-count>1 326 recenzií</small>
    </a>

    <a href="/prihlasenie" class="account-link" aria-label="Prihlásenie alebo účet">Účet</a>

    <a href="/kosik" class="icon-btn cart-btn" aria-label="Košík">
      🛒
      <span class="cart-dot" data-cart-count>0</span>
    </a>
  </div>


  <div class="tm-global-mobile-bar" aria-label="Mobilná navigácia">
    <button class="tm-global-mobile-menu-button" type="button" aria-label="Otvoriť menu" aria-expanded="false" data-tm-global-menu-toggle>
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a class="tm-global-mobile-logo" href="/" aria-label="ToneryMaxim domov">
      <img src={mobileLogo.src} alt="ToneryMaxim" />
    </a>

    <a href="/kosik" class="tm-global-mobile-cart" aria-label="Košík">
      🛒
      <span class="cart-dot" data-cart-count>0</span>
    </a>
  </div>

  <div class="tm-global-mobile-drawer" data-tm-global-menu aria-hidden="true">
    <div class="tm-global-mobile-drawer-panel">
      <div class="tm-global-mobile-drawer-head">
        <strong>Menu</strong>
        <button type="button" aria-label="Zavrieť menu" data-tm-global-menu-close>×</button>
      </div>

      <section>
        <strong>Môj účet</strong>
        <a href="/prihlasenie">Prihlásenie</a>
        <a href="/ucet">Môj účet</a>
        <a href="/ucet/objednavky">Moje objednávky</a>
      </section>

      <section>
        <strong>Informácie a pomoc</strong>
        <a href="/o-nas">O nás</a>
        <a href="/kontakt">Kontakt</a>
        <a href="/faq">FAQ – časté otázky</a>
        <a href="/poradna">Odborná poradňa</a>
        <a href="/doprava-a-platba">Doprava a platba</a>
        <a href="/toner-bez-starosti">Toner bez starostí</a>
        <a href="/spatny-odber-tonerov">Spätný odber tonerov</a>
        <a href="/vernostny-program">Vernostný program</a>
        <a href="/reklamacie">Reklamácie</a>
        <a href="/reklamacia-online">Reklamácia online</a>
        <a href="/odstupenie-od-zmluvy">Odstúpenie od zmluvy</a>
        <a href="/obchodne-podmienky">Obchodné podmienky</a>
        <a href="/ochrana-osobnych-udajov">Ochrana osobných údajov</a>
        <a href="/partneri-a-tretie-strany">Partneri a tretie strany</a>
        <a href="/cookies">Informácie o cookies</a>
        <a href="/cookies#nastavenia" data-open-cookie-settings>Upraviť nastavenia cookies</a>
      </section>

      <section>
        <strong>Ponuka</strong>
        <a href="/tonery">Tonery</a>
        <a href="/atramentove-naplne">Atramentové náplne</a>
        <a href="/produkty?category=opticke-valce&search=optick%C3%A9%20valce">Valce</a>
        <a href="/produkty?category=ostatne-komponenty&search=ostatn%C3%A9%20komponenty">Komponenty</a>
      </section>

      <section>
        <strong>Ďalšie</strong>
        <a class="tm-global-mobile-legacy-link" href="https://www.tonerymaxim.info" target="_blank" rel="noopener noreferrer">Pôvodný e-shop <span aria-hidden="true">↗</span></a>
      </section>
    </div>
  </div>

  <TrustBar />
</header>
<style is:global>
.add-cart-drawer[hidden] { display: none !important; }
.add-cart-drawer { position: fixed; inset: 0; z-index: 2147483000; font-family: inherit; }
.add-cart-backdrop { position: absolute; inset: 0; background: rgba(2, 15, 40, .34); backdrop-filter: blur(3px); }
.add-cart-panel { position: absolute; top: 0; right: 0; width: min(420px, calc(100vw - 24px)); height: 100%; background: #fff; border-left: 1px solid #dbe7f5; box-shadow: -24px 0 70px rgba(5, 20, 44, .18); padding: 26px; overflow: auto; animation: tmCartDrawerIn .18s ease-out; }
@keyframes tmCartDrawerIn { from { transform: translateX(24px); opacity: .7; } to { transform: translateX(0); opacity: 1; } }
.add-cart-close { position: absolute; top: 16px; right: 18px; width: 38px; height: 38px; border: 0; border-radius: 999px; background: #f2f6fb; color: #08224a; font-size: 24px; cursor: pointer; }
.add-cart-status { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 22px; padding: 10px 14px; border-radius: 999px; background: #eaf8ef; color: #08742f; font-weight: 800; }
.add-cart-product { display: grid; grid-template-columns: 88px 1fr; gap: 16px; align-items: center; padding: 18px 0 22px; border-bottom: 1px solid #e5edf7; }
.add-cart-thumb { width: 88px; height: 88px; border-radius: 18px; background: #f6f9fd; display: grid; place-items: center; }
.add-cart-thumb img { max-width: 78px; max-height: 78px; object-fit: contain; }
.add-cart-product h2 { margin: 0 0 6px; font-size: 20px; line-height: 1.2; color: #071d41; }
.add-cart-product p { margin: 0 0 8px; color: #65748b; }
.add-cart-product strong { color: #071d41; font-size: 18px; }
.add-cart-summary { padding: 18px 0; display: grid; gap: 10px; }
.add-cart-summary div { display: flex; justify-content: space-between; gap: 16px; color: #4f6178; }
.add-cart-summary strong { color: #071d41; }
.add-cart-summary p { margin: 8px 0 0; padding: 12px 14px; border-radius: 14px; background: #fff7df; color: #8a5a00; font-weight: 800; }
.add-cart-summary p.is-free { background: #eaf8ef; color: #08742f; }
.add-cart-actions { display: grid; gap: 10px; margin-top: 8px; }
.add-cart-actions a, .add-cart-actions button { text-align: center; text-decoration: none; border-radius: 14px; padding: 14px 16px; font-weight: 900; cursor: pointer; font-family: inherit; }
.add-cart-actions .btn-primary { background: #071d41; color: #fff; border: 1px solid #071d41; }
.add-cart-actions .btn-secondary { background: #f3f7fc; color: #071d41; border: 1px solid #dce8f6; }
body.has-add-cart-drawer { overflow: hidden; }
@media (max-width: 640px) { .add-cart-panel { top: auto; bottom: 0; width: 100%; height: auto; max-height: 88vh; border-left: 0; border-radius: 26px 26px 0 0; } }
</style>

<script>
  // Odstráni prebliknutie nehotového rozloženia pri prechode medzi stránkami.
  const revealPage = () => {
    requestAnimationFrame(() => document.documentElement.classList.add("tm-page-ready"));
  };
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", revealPage, { once: true });
  } else {
    revealPage();
  }
  // Bezpečnostná poistka pri chybe iného skriptu.
  window.setTimeout(() => document.documentElement.classList.add("tm-page-ready"), 1200);

  import "../scripts/device-layout.js";
  import "../scripts/cart.js";
  import "../scripts/smart-search.js";

  const globalMenuToggle = document.querySelector("[data-tm-global-menu-toggle]");
  const globalMenu = document.querySelector("[data-tm-global-menu]");
  const globalMenuClose = document.querySelector("[data-tm-global-menu-close]");

  function setGlobalMenu(open: boolean) {
    if (!globalMenu || !globalMenuToggle) return;
    globalMenu.classList.toggle("is-open", open);
    globalMenu.setAttribute("aria-hidden", String(!open));
    globalMenuToggle.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("tm-menu-open", open);
  }

  globalMenuToggle?.addEventListener("click", () => setGlobalMenu(!globalMenu?.classList.contains("is-open")));
  globalMenuClose?.addEventListener("click", () => setGlobalMenu(false));
  globalMenu?.addEventListener("click", (event) => {
    if (event.target === globalMenu) setGlobalMenu(false);
    if (event.target instanceof Element && event.target.closest("a")) setGlobalMenu(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setGlobalMenu(false);
  });

  async function updateHeaderAccountState() {
    const links = document.querySelectorAll('.account-link');
    if (!links.length) return;
    try {
      const response = await fetch('/api/auth/me', { credentials: 'same-origin', headers: { Accept: 'application/json' }, cache: 'no-store' });
      const data = await response.json().catch(() => ({}));
      const customer = data?.customer;
      if (!response.ok || !data?.ok || !customer) throw new Error('not logged');
      const first = String(customer.first_name || customer.billing?.first_name || customer.username || customer.email || '').trim().split(/\s+/)[0] || 'Môj účet';
      links.forEach((link) => {
        link.setAttribute('href', '/ucet');
        link.textContent = `Účet: ${first}`;
        link.setAttribute('aria-label', 'Môj účet');
      });
    } catch {
      links.forEach((link) => {
        if (link.getAttribute('href') === '/ucet') return;
        link.setAttribute('href', '/prihlasenie');
        link.textContent = 'Účet';
      });
    }
  }

  updateHeaderAccountState();
  window.addEventListener('storage', (event) => {
    if (!event.key || event.key.includes('auth') || event.key.includes('customer')) updateHeaderAccountState();
  });

</script>
