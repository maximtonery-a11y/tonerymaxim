<header class="site-header">
  <button class="mobile-menu-toggle" type="button" aria-label="Menu" data-mobile-menu-toggle>
    <span></span>
    <span></span>
    <span></span>
  </button>

  <a class="site-logo-link" href="/" aria-label="ToneryMaxim domov">
    <img class="site-logo" src="/images/logo.png" alt="ToneryMaxim" />
  </a>

  <nav class="site-nav" aria-label="Hlavná navigácia">
    <a href="/produkty?category=tonery&search=toner">Tonery</a>
    <a href="/produkty?category=atramentove-naplne&search=atramentov%C3%A9%20n%C3%A1plne">Atramenty</a>
    <a href="/produkty?category=opticke-valce&search=optick%C3%A9%20valce">Valce</a>
    <a href="/produkty?category=ostatne-komponenty&search=ostatn%C3%A9%20komponenty">Komponenty</a>
  </nav>

  <div class="header-search-area">
    <form class="header-search" action="/produkty" method="get" data-smart-search>
      <span class="header-search-icon" aria-hidden="true">⌕</span>
      <input
        type="search"
        name="s"
        data-smart-search-input
        placeholder="Hľadať toner alebo tlačiareň..."
        aria-label="Hľadať toner, náplň alebo tlačiareň"
      />
      <button type="submit" aria-label="Vyhľadať">Hľadať</button>
    </form>
  </div>

  <div class="header-actions">
    <a
      class="header-heureka"
      href="https://obchody.heureka.sk/tonerymaxim-sk/recenze/?e=reviews&p=left"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Heureka recenzie ToneryMaxim"
      data-heureka-mini
    >
      <span class="header-heureka-badge" aria-hidden="true">★</span>
      <span class="header-heureka-text">
        <strong data-heureka-mini-score>5,0/5</strong>
        <small data-heureka-mini-count>1 323 recenzií</small>
      </span>
    </a>

    <a href="/prihlasenie" class="account-link" aria-label="Prihlásenie alebo účet">Účet</a>

    <a href="/kosik" class="icon-btn cart-btn" aria-label="Košík">
      🛒
      <span class="cart-dot" data-cart-count>0</span>
    </a>
  </div>
</header>

<nav class="mobile-drawer" aria-label="Mobilné menu" data-mobile-drawer>
  <a href="/produkty?category=tonery&search=toner">Tonery</a>
  <a href="/produkty?category=atramentove-naplne&search=atramentov%C3%A9%20n%C3%A1plne">Atramenty</a>
  <a href="/produkty?category=opticke-valce&search=optick%C3%A9%20valce">Valce</a>
  <a href="/produkty?category=ostatne-komponenty&search=ostatn%C3%A9%20komponenty">Komponenty</a>
</nav>

<nav class="mobile-bottom-nav" aria-label="Spodná mobilná navigácia">
  <a href="/"><span>⌂</span><strong>Domov</strong></a>
  <a href="/tlaciarne"><span>▦</span><strong>Značky</strong></a>
  <a href="/produkty"><span>⌕</span><strong>Hľadať</strong></a>
  <a href="/kontakt"><span>?</span><strong>Pomoc</strong></a>
  <a href="/prihlasenie"><span>◎</span><strong>Účet</strong></a>
</nav>

<script>
  import "../scripts/cart.js";
  import "../scripts/smart-search.js";

  const mobileMenuToggle = document.querySelector("[data-mobile-menu-toggle]");
  const mobileDrawer = document.querySelector("[data-mobile-drawer]");

  mobileMenuToggle?.addEventListener("click", () => {
    const isOpen = mobileDrawer?.classList.toggle("is-open") ?? false;
    mobileMenuToggle.setAttribute("aria-expanded", String(isOpen));
  });
</script>
