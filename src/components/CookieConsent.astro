<div class="tm-cookie-consent" id="tm-cookie-consent" data-cookie-consent>
  <button type="button" class="tm-cookie-floating" id="tm-cookie-floating" aria-label="Otvoriť nastavenia cookies">
    <span aria-hidden="true">🍪</span>
    <strong>Cookies</strong>
  </button>

  <section class="tm-cookie-panel" id="tm-cookie-panel" role="dialog" aria-live="polite" aria-label="Nastavenia cookies">
    <button type="button" class="tm-cookie-close" id="tm-cookie-close" aria-label="Zavrieť cookies lištu">×</button>

    <div class="tm-cookie-content">
      <div class="tm-cookie-text">
        <span class="tm-cookie-label">Cookies</span>
        <h2>Používame cookies</h2>
        <p>
          Nevyhnutné cookies zabezpečujú fungovanie košíka, prihlásenia a objednávky.
          Analytické a marketingové cookies použijeme iba po vašom súhlase.
        </p>
        <a href="/novy/cookies">Viac informácií o cookies</a>
      </div>

      <div class="tm-cookie-options" aria-label="Výber cookies">
        <label class="tm-cookie-option tm-cookie-option-locked">
          <input type="checkbox" checked disabled />
          <span>
            <strong>Nevyhnutné</strong>
            <small>Vždy aktívne – košík, prihlásenie, objednávka.</small>
          </span>
        </label>

        <label class="tm-cookie-option">
          <input type="checkbox" id="tm-cookie-analytics" />
          <span>
            <strong>Analytické</strong>
            <small>Meranie návštevnosti a zlepšovanie webu.</small>
          </span>
        </label>

        <label class="tm-cookie-option">
          <input type="checkbox" id="tm-cookie-marketing" />
          <span>
            <strong>Marketingové</strong>
            <small>Reklama a meranie kampaní.</small>
          </span>
        </label>
      </div>

      <div class="tm-cookie-actions">
        <button type="button" class="tm-cookie-btn tm-cookie-btn-light" id="tm-cookie-reject">Odmietnuť voliteľné</button>
        <button type="button" class="tm-cookie-btn tm-cookie-btn-light" id="tm-cookie-save">Uložiť výber</button>
        <button type="button" class="tm-cookie-btn tm-cookie-btn-dark" id="tm-cookie-accept">Prijať všetko</button>
      </div>
    </div>
  </section>
</div>

