<div class="tm-cookie-consent" data-cookie-consent hidden>
  <div class="tm-cookie-card" role="dialog" aria-live="polite" aria-label="Nastavenie cookies">
    <div class="tm-cookie-main">
      <span class="tm-cookie-badge">Cookies</span>
      <h2>Používame cookies</h2>
      <p>
        Nevyhnutné cookies zabezpečujú fungovanie košíka, prihlásenia a objednávky.
        Analytické a marketingové cookies použijeme iba po vašom súhlase.
      </p>
      <a href="/cookies">Viac informácií o cookies</a>
    </div>

    <div class="tm-cookie-options" data-cookie-options hidden>
      <label class="tm-cookie-toggle is-locked">
        <input type="checkbox" checked disabled />
        <span>
          <strong>Nevyhnutné</strong>
          <small>Vždy aktívne</small>
        </span>
      </label>

      <label class="tm-cookie-toggle">
        <input type="checkbox" data-cookie-category="analytics" />
        <span>
          <strong>Analytické</strong>
          <small>Meranie návštevnosti a zlepšovanie webu</small>
        </span>
      </label>

      <label class="tm-cookie-toggle">
        <input type="checkbox" data-cookie-category="marketing" />
        <span>
          <strong>Marketingové</strong>
          <small>Relevantná reklama a meranie kampaní</small>
        </span>
      </label>
    </div>

    <div class="tm-cookie-actions">
      <button type="button" class="tm-cookie-secondary" data-cookie-settings>Prispôsobiť</button>
      <button type="button" class="tm-cookie-secondary" data-cookie-reject>Odmietnuť voliteľné</button>
      <button type="button" class="tm-cookie-primary" data-cookie-accept>Prijať všetko</button>
      <button type="button" class="tm-cookie-primary" data-cookie-save hidden>Uložiť výber</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const STORAGE_KEY = "tm_cookie_consent_v1";
    const root = document.querySelector("[data-cookie-consent]");
    if (!root) return;

    const options = root.querySelector("[data-cookie-options]");
    const settingsButton = root.querySelector("[data-cookie-settings]");
    const rejectButton = root.querySelector("[data-cookie-reject]");
    const acceptButton = root.querySelector("[data-cookie-accept]");
    const saveButton = root.querySelector("[data-cookie-save]");
    const analyticsInput = root.querySelector('[data-cookie-category="analytics"]');
    const marketingInput = root.querySelector('[data-cookie-category="marketing"]');

    function readConsent() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");
      } catch (error) {
        return null;
      }
    }

    function writeConsent(consent) {
      const payload = {
        necessary: true,
        analytics: Boolean(consent.analytics),
        marketing: Boolean(consent.marketing),
        savedAt: new Date().toISOString(),
      };

      localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      window.dispatchEvent(new CustomEvent("tm:cookies", { detail: payload }));
      root.hidden = true;
    }

    function openSettings() {
      options.hidden = false;
      saveButton.hidden = false;
      acceptButton.hidden = true;
      settingsButton.hidden = true;
      rejectButton.textContent = "Odmietnuť";
    }

    window.ToneryMaximCookies = {
      open: function () {
        root.hidden = false;
        openSettings();
      },
      get: readConsent,
      reset: function () {
        localStorage.removeItem(STORAGE_KEY);
        root.hidden = false;
      },
    };

    settingsButton.addEventListener("click", openSettings);
    acceptButton.addEventListener("click", function () {
      writeConsent({ analytics: true, marketing: true });
    });
    rejectButton.addEventListener("click", function () {
      writeConsent({ analytics: false, marketing: false });
    });
    saveButton.addEventListener("click", function () {
      writeConsent({
        analytics: analyticsInput.checked,
        marketing: marketingInput.checked,
      });
    });

    const existingConsent = readConsent();
    if (existingConsent) {
      window.dispatchEvent(new CustomEvent("tm:cookies", { detail: existingConsent }));
      return;
    }

    root.hidden = false;

  })();
</script>

