<script is:inline>
(function () {
  var STORAGE_KEY = "tm_cookie_consent_v10";
  var OLD_KEYS = [
    "tm_cookie_consent",
    "tonerymaxim_cookie_consent",
    "tm_cookie_consent_v1",
    "tm_cookie_consent_v2",
    "tm_cookie_consent_v3",
    "tm_cookie_consent_v4",
    "tm_cookie_consent_v5",
    "tm_cookie_consent_v6",
    "tm_cookie_consent_v7",
    "tm_cookie_consent_v8",
    "tm_cookie_consent_v9"
  ];

  function el(id) { return document.getElementById(id); }
  function root() { return el("tm-cookie-consent"); }
  function analytics() { return el("tm-cookie-analytics"); }
  function marketing() { return el("tm-cookie-marketing"); }

  function parse(value) {
    try { return JSON.parse(value || "null"); } catch (error) { return null; }
  }

  function readConsent() {
    try { return parse(window.localStorage.getItem(STORAGE_KEY)); } catch (error) { return null; }
  }

  function cleanOldKeys() {
    try { OLD_KEYS.forEach(function (key) { window.localStorage.removeItem(key); }); } catch (error) {}
  }

  function setChecks(consent) {
    if (analytics()) analytics().checked = !!(consent && consent.analytics);
    if (marketing()) marketing().checked = !!(consent && consent.marketing);
  }

  function emit(consent) {
    try { window.dispatchEvent(new CustomEvent("tm:cookies", { detail: consent })); } catch (error) {}
  }

  function openPanel() {
    var r = root();
    if (!r) return;
    r.classList.remove("tm-cookie-is-hidden");
    r.classList.add("tm-cookie-is-open");
  }

  function closePanel() {
    var r = root();
    if (!r) return;
    r.classList.remove("tm-cookie-is-open");
    r.classList.add("tm-cookie-is-hidden");
  }

  function saveConsent(analyticsValue, marketingValue) {
    var consent = {
      necessary: true,
      analytics: !!analyticsValue,
      marketing: !!marketingValue,
      savedAt: new Date().toISOString()
    };

    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));
      cleanOldKeys();
    } catch (error) {}

    setChecks(consent);
    emit(consent);
    closePanel();
    return consent;
  }

  function acceptAll() { return saveConsent(true, true); }
  function rejectOptional() { return saveConsent(false, false); }
  function saveSelection() {
    return saveConsent(analytics() && analytics().checked, marketing() && marketing().checked);
  }

  function resetConsent() {
    try {
      window.localStorage.removeItem(STORAGE_KEY);
      cleanOldKeys();
    } catch (error) {}
    setChecks({ analytics: false, marketing: false });
    openPanel();
  }

  function bind() {
    var accept = el("tm-cookie-accept");
    var reject = el("tm-cookie-reject");
    var save = el("tm-cookie-save");
    var close = el("tm-cookie-close");
    var floating = el("tm-cookie-floating");

    if (accept) accept.addEventListener("click", function (event) { event.preventDefault(); acceptAll(); });
    if (reject) reject.addEventListener("click", function (event) { event.preventDefault(); rejectOptional(); });
    if (save) save.addEventListener("click", function (event) { event.preventDefault(); saveSelection(); });
    if (close) close.addEventListener("click", function (event) { event.preventDefault(); closePanel(); });
    if (floating) floating.addEventListener("click", function (event) { event.preventDefault(); openPanel(); });

    document.addEventListener("click", function (event) {
      var target = event.target;
      if (!target || !target.closest) return;
      var trigger = target.closest('[data-open-cookie-settings], a[href="/novy/cookies#nastavenia"], a[href="#cookies"]');
      if (!trigger) return;
      event.preventDefault();
      openPanel();
    });
  }

  function init() {
    var consent = readConsent();
    if (consent) {
      setChecks(consent);
      emit(consent);
      closePanel();
    } else {
      setChecks({ analytics: false, marketing: false });
      openPanel();
    }
    bind();
  }

  window.ToneryMaximCookies = {
    open: openPanel,
    close: closePanel,
    acceptAll: acceptAll,
    reject: rejectOptional,
    saveSelection: saveSelection,
    get: readConsent,
    reset: resetConsent
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
})();
</script>
