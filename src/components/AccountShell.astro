---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingAdvisor from "./FloatingAdvisor.astro";
import { customerDisplayName, customerInitials, type CustomerSession } from "../lib/auth-session";

const {
  title = "Môj účet",
  subtitle = "Prehľad vašich objednávok, tlačiarní a odmien.",
  active = "prehlad",
  user = null,
} = Astro.props as {
  title?: string;
  subtitle?: string;
  active?: string;
  user?: CustomerSession | null;
};

const displayName = customerDisplayName(user);
const initials = customerInitials(user);
const email = user?.email || "";

const navItems = [
  { id: "prehlad", href: "/ucet", icon: "⌂", label: "Prehľad" },
  { id: "objednavky", href: "/ucet/objednavky", icon: "▣", label: "Objednávky" },
  { id: "tlaciarne", href: "/ucet/tlaciarne", icon: "▤", label: "Moje tlačiarne" },
  { id: "produkty", href: "/ucet/produkty", icon: "▧", label: "Moje produkty" },
  { id: "reklamacie", href: "/ucet/reklamacie", icon: "◇", label: "Reklamácie" },
  { id: "vernost", href: "/ucet/vernost", icon: "★", label: "Vernostný program" },
  { id: "odmeny", href: "/ucet/odmeny", icon: "🎁", label: "Moje odmeny" },
  { id: "adresy", href: "/ucet/adresy", icon: "⌖", label: "Adresy" },
  { id: "newsletter", href: "/ucet/newsletter", icon: "✉", label: "Newsletter" },
  { id: "profil", href: "/ucet/profil", icon: "◎", label: "Profil" },
];
---

<div class="page account-page">
  <Header />

  <main class="account-wrap">
    <div class="account-shell">
      <aside class="account-sidebar" data-account-sidebar>
        <div class="account-user-card">
          <div class="account-avatar">{initials}</div>
          <div>
            <strong>{displayName}</strong>
            <span>{email}</span>
          </div>
        </div>

        <nav class="account-nav" aria-label="Menu účtu">
          {navItems.map((item) => (
            <a
              class:list={["account-nav-link", active === item.id && "is-active"]}
              href={item.href}
              rel={active === item.id ? undefined : "prefetch"}
            >
              <span>{item.icon}</span>
              {item.label}
            </a>
          ))}
        </nav>

        <form method="post" action="/api/auth/logout" data-account-logout-form>
          <button class="account-logout" type="submit">↪ Odhlásiť sa</button>
          <p data-account-logout-error role="alert" hidden></p>
        </form>
      </aside>

      <section class="account-content">
        <div class="account-topbar">
          <div>
            <p class="account-kicker">Zákaznícka zóna</p>
            <h1>{title}</h1>
            <p>{subtitle}</p>
          </div>
          <button class="account-menu-toggle" type="button" data-account-menu-toggle>Menu účtu</button>
        </div>

        <slot />
      </section>
    </div>
  </main>

  <Footer />
  <FloatingAdvisor />
</div>

<script>
  import "../scripts/account-ui.js";

  document.querySelector<HTMLFormElement>('[data-account-logout-form]')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const errorBox = form.querySelector<HTMLElement>('[data-account-logout-error]');
    if (button?.disabled) return;
    if (button) button.disabled = true;
    if (errorBox) errorBox.hidden = true;

    try {
      const response = await fetch('/api/auth/logout', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: '{}',
        cache: 'no-store',
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result?.ok !== true) throw new Error(result?.error || 'Odhlásenie zlyhalo.');
      try { sessionStorage.removeItem('tm_header_account_v1'); } catch {}
      window.location.assign('/prihlasenie?logout=1');
    } catch (error) {
      if (button) button.disabled = false;
      if (errorBox) {
        errorBox.textContent = error instanceof Error ? error.message : 'Odhlásenie zlyhalo. Skúste to znova.';
        errorBox.hidden = false;
      }
    }
  });

  const accountLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".account-nav-link[href]"));
  const prefetched = new Set<string>();

  function prefetchAccountPage(href: string) {
    if (!href || prefetched.has(href)) return;
    prefetched.add(href);

    const link = document.createElement("link");
    link.rel = "prefetch";
    link.href = href;
    link.as = "document";
    document.head.appendChild(link);
  }

  if ("requestIdleCallback" in window) {
    window.requestIdleCallback(() => {
      accountLinks.slice(0, 4).forEach((link) => prefetchAccountPage(link.href));
    }, { timeout: 2500 });
  } else {
    globalThis.setTimeout(() => {
      accountLinks.slice(0, 4).forEach((link) => prefetchAccountPage(link.href));
    }, 1000);
  }

  accountLinks.forEach((link) => {
    link.addEventListener("mouseenter", () => prefetchAccountPage(link.href), { once: true });
    link.addEventListener("touchstart", () => prefetchAccountPage(link.href), { once: true, passive: true });
  });
</script>
