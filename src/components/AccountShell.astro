---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingAdvisor from "./FloatingAdvisor.astro";
import AccountMobileNav from "./AccountMobileNav.astro";
import { accountNavigation as navItems } from "../lib/account-navigation";
import { customerDisplayName, customerInitials, type CustomerSession } from "../lib/auth-session";

const {
  title = "Môj účet",
  subtitle = "Prehľad vašich objednávok, tlačiarní a odmien.",
  active = "prehlad",
  user = null,
} = Astro.props as {
  title?: string;
  subtitle?: string;
  active?: string;
  user?: CustomerSession | null;
};

const displayName = customerDisplayName(user);
const initials = customerInitials(user);
const email = user?.email || "";


---

<div class="page account-page">
  <Header />

  <main class="account-wrap">
    <div class="account-shell">
      <aside class="account-sidebar" data-account-sidebar>
        <div class="account-user-card">
          <div class="account-avatar">{initials}</div>
          <div>
            <strong>{displayName}</strong>
            <span>{email}</span>
          </div>
        </div>

        <nav class="account-nav" aria-label="Menu účtu">
          {navItems.map((item) => (
            <a
              class:list={["account-nav-link", active === item.id && "is-active"]}
              href={item.href}
              aria-current={active === item.id ? "page" : undefined}
            >
              <span>{item.icon}</span>
              {item.label}
            </a>
          ))}
        </nav>

        <form method="post" action="/api/auth/logout" data-account-logout-form>
          <button class="account-logout" type="submit">↪ Odhlásiť sa</button>
          <p data-account-logout-error role="alert" hidden></p>
        </form>
      </aside>

      <section class="account-content">
        <div class="account-topbar">
          <div>
            <p class="account-kicker">Zákaznícka zóna</p>
            <h1>{title}</h1>
            <p>{subtitle}</p>
          </div>
        </div>

        <slot />
      </section>
    </div>
  </main>

  <Footer />
  <FloatingAdvisor />
  <noscript>
    <style is:inline>
      /* Keep cookie information readable in the footer without an inert overlay. */
      .account-page #tm-cookie-consent { position: static !important; inset: auto !important; margin-block: 20px !important; }
      .account-page #tm-cookie-consent button { display: none !important; }
    </style>
  </noscript>
</div>

<AccountMobileNav active={active} />

<script>
  import "../scripts/account-ui.js";

  document.querySelectorAll<HTMLFormElement>('[data-account-logout-form]').forEach((logoutForm) => logoutForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const errorBox = form.querySelector<HTMLElement>('[data-account-logout-error]');
    if (button?.disabled) return;
    if (button) button.disabled = true;
    if (errorBox) errorBox.hidden = true;

    try {
      const response = await fetch('/api/auth/logout', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: '{}',
        cache: 'no-store',
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result?.ok !== true) throw new Error(result?.error || 'Odhlásenie zlyhalo.');
      try { sessionStorage.removeItem('tm_header_account_v1'); sessionStorage.removeItem('tm_cart_benefits_v1'); localStorage.setItem('tm_cart_benefits_epoch', Date.now() + '-' + Math.random()); localStorage.removeItem('tm_coupon_v1'); } catch {}
      window.location.assign('/prihlasenie?logout=1');
    } catch (error) {
      if (button) button.disabled = false;
      if (errorBox) {
        errorBox.textContent = error instanceof Error ? error.message : 'Odhlásenie zlyhalo. Skúste to znova.';
        errorBox.hidden = false;
      }
    }
  }));

</script>
