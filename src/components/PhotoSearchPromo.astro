---
import { PHOTO_GUIDE_PATH, PHOTO_SEARCH_PATH } from '../lib/photo-search-promo';

interface Props { layout: 'mobile' | 'desktop' }
const mobile = Astro.props.layout === 'mobile';
---
<section class:list={['photo-promo', { 'photo-promo-mobile': mobile }]} aria-label="Hľadanie fotoaparátom">
  <span class="photo-badge" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 8V5a2 2 0 0 1 2-2h3m8 0h3a2 2 0 0 1 2 2v3m0 8v3a2 2 0 0 1-2 2h-3m-8 0H5a2 2 0 0 1-2-2v-3" />
      <circle cx="12" cy="12" r="4" />
    </svg>
  </span>
  <h2>{mobile ? 'Nájdite náplň fotoaparátom' : 'Máte fotku tlačiarne alebo náplne?'}</h2>
  <p>{mobile
    ? 'Namierte na model tlačiarne alebo kód na kazete. Zobrazíme vám vhodné náplne.'
    : 'Vyberte fotku z počítača alebo naskenujte štítok mobilom.'}</p>
  <div class="photo-actions">
    <a class="photo-start" href={mobile ? PHOTO_SEARCH_PATH + '#skenovat' : PHOTO_SEARCH_PATH}>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
        {mobile ? <><path d="M3 7h4l2-3h6l2 3h4v13H3z"/><circle cx="12" cy="13" r="3.5"/></>
          : <><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8" cy="9" r="1.4"/><path d="m4 18 5-5 3 3 4-5 5 6"/></>}
      </svg>
      {mobile ? 'Spustiť fotoaparát' : 'Hľadať podľa fotky'}
    </a>
    <a class="photo-guide" href={PHOTO_GUIDE_PATH}>Ako to funguje?</a>
  </div>
  {!mobile && <a class="photo-qr" href={PHOTO_SEARCH_PATH} aria-label="Otvoriť stránku skenera. QR kód môžete načítať mobilom."><span aria-hidden="true"></span>Otvoriť v mobile</a>}
</section>
<style>
  .photo-promo {
    display: grid; grid-template-columns: auto minmax(0,1fr) auto;
    grid-template-areas: 'badge title qr' 'badge copy qr' 'badge actions qr';
    align-items: center; column-gap: .8rem; row-gap: .25rem;
    margin: .8rem 0 0; padding: .85rem; border: 1px solid #b4d4cb; border-radius: 14px;
    background: #eef8f4; color: #102e4b;
  }
  .photo-badge { grid-area: badge; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 11px; background: #d5ede5; color: #096556; }
  .photo-badge svg { width: 23px; height: 23px; }
  .photo-promo h2 { grid-area: title; margin: 0; color: #102e4b; font-size: 1.18rem; line-height: 1.2; letter-spacing: -.025em; }
  .photo-promo p { grid-area: copy; margin: 0; color: #33544f; font-size: .92rem; line-height: 1.45; }
  .photo-actions { grid-area: actions; display: flex; flex-wrap: wrap; align-items: center; gap: .15rem .85rem; }
  .photo-actions a { display: inline-flex; align-items: center; gap: .45rem; min-height: 44px; font-size: .875rem; font-weight: 700; }
  .photo-start { background: #102e4b; color: #fff; border-radius: 10px; padding: .5rem .85rem; text-decoration: none; }
  .photo-start:hover { background: #214b66; }
  .photo-start svg { width: 18px; height: 18px; flex: none; }
  .photo-guide { color: #125b52; text-decoration: underline; text-underline-offset: .18em; }
  .photo-qr { grid-area: qr; display: grid; justify-items: center; gap: .15rem; padding-inline-start: .75rem; border-inline-start: 1px solid #b5d6cc; color: #33544d; font-size: .75rem; line-height: 1.2; text-align: center; }
  .photo-qr span { width: 82px; height: 82px; background: white url('/images/qr-hladat-fotkou.png') center / contain no-repeat; image-rendering: pixelated; }
  .photo-promo a:focus-visible { outline: 3px solid #08778c; outline-offset: 2px; }
  .photo-promo-mobile {
    grid-template-columns: auto minmax(0,1fr); grid-template-areas: 'badge title' 'copy copy' 'actions actions';
    margin: .7rem 0 1rem; gap: .55rem .65rem; padding: .9rem; border-radius: 17px; background: linear-gradient(120deg,#f8fdfb,#eaf7f3);
  }
  .photo-promo-mobile h2 { font-size: 1.22rem; }
  @media (min-width: 761px) and (max-width: 1100px) {
    .photo-promo:not(.photo-promo-mobile) { grid-template-columns: minmax(0,1fr) auto; grid-template-areas: 'title qr' 'copy qr' 'actions qr'; }
    .photo-promo:not(.photo-promo-mobile) .photo-badge { display: none; }
  }
</style>
