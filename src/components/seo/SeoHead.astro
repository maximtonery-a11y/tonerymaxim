---
import ProductionSeoHead from "../SeoHead.astro";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  socialUrl?: string;
  image?: string;
  type?: "website" | "product" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const props = Astro.props;
---

