---
import menuScript from "../scripts/account-menu.js?raw";
import { accountNavigation } from "../lib/account-navigation";
const { active = "prehlad" } = Astro.props as { active?: string };
const primary = new Set(["prehlad", "objednavky", "tlaciarne", "reklamacie"]);
const more = accountNavigation.filter((item) => !primary.has(item.id));
const icons = {
  prehlad: "M3 10.5 12 3l9 7.5V21h-6v-7H9v7H3z",
  objednavky: "M3 7l9-4 9 4v10l-9 4-9-4z M3 7l9 4 9-4 M12 11v10",
  tlaciarne: "M6 8V3h12v5 M6 17H3V8h18v9h-3 M6 14h12v7H6z",
  reklamacie: "M4 3h16v18H4z M8 8h8 M8 12h8 M8 16h4",
  viac: "M4 6h16 M4 12h16 M4 18h16",
};
---
<div class="account-dock">
  <nav class="account-mobile-nav" data-account-mobile-nav aria-label="Rýchle menu účtu">
    {accountNavigation.filter((item) => primary.has(item.id)).map((item) => (
      <a href={item.href} data-account-nav-link aria-current={active === item.id ? "page" : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[item.id as keyof typeof icons]} /></svg>
        <span>{item.id === "tlaciarne" ? "Tlačiarne" : item.label}</span>
      </a>
    ))}
    <details class="account-more" data-account-more>
      <summary aria-controls="account-more-panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d={icons.viac} /></svg>
        <span>Viac</span>
      </summary>
      <section class="account-more-panel" id="account-more-panel" aria-label="Ďalšie časti účtu">
        <div class="account-more-head"><h2>Celý môj účet</h2><button type="button" data-account-more-close aria-label="Zavrieť menu účtu">×</button></div>
        <div class="account-more-links">
          {more.map((item) => <a data-account-nav-link href={item.href} aria-current={active === item.id ? "page" : undefined}>{item.label}</a>)}
        </div>
        <form method="post" action="/api/auth/logout" data-account-logout-form><button class="account-more-logout" type="submit">Odhlásiť sa</button><p data-account-logout-error role="alert" hidden></p></form>
      </section>
    </details>
  </nav>
</div>
<!-- Native links/details are usable before deferred scripts or without JavaScript. -->
<script is:inline data-account-menu-script set:html={menuScript} />
