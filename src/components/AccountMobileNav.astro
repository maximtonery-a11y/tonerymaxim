---
import menuScript from "../scripts/account-menu.js?raw";
const { active = "prehlad", items = [] } = Astro.props as {
  active?: string;
  items?: Array<{ id: string; href: string; icon: string; label: string }>;
};
const benefits = new Set(["vernost", "odmeny"]);
const primary = new Set(["prehlad", "objednavky", "tlaciarne"]);
const more = items.filter((item) => !primary.has(item.id) && !benefits.has(item.id));
const icons = {
  prehlad: "M3 10.5 12 3l9 7.5V21h-6v-7H9v7H3z",
  objednavky: "M3 7l9-4 9 4v10l-9 4-9-4z M3 7l9 4 9-4 M12 11v10",
  tlaciarne: "M6 8V3h12v5 M6 17H3V8h18v9h-3 M6 14h12v7H6z",
  vyhody: "M3 8h18v5H3z M5 13v8h14v-8 M12 8v13 M12 8H8a3 3 0 1 1 3-3l1 3H16a3 3 0 1 0-3-3z",
  viac: "M4 6h16 M4 12h16 M4 18h16",
};
---
<nav class="account-mobile-nav" data-account-mobile-nav aria-label="Rýchle menu účtu">
  {items.filter((item) => primary.has(item.id)).map((item) => (
    <a href={item.href} data-account-nav-link aria-current={(active === item.id || (item.id === "objednavky" && ["faktury", "reklamacie"].includes(active))) ? "page" : undefined}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[item.id as keyof typeof icons]} /></svg>
      <span>{item.id === "tlaciarne" ? "Tlačiarne" : item.label}</span>
    </a>
  ))}
  <button type="button" class:list={[benefits.has(active) && "is-active"]} data-account-drawer-open="benefits" aria-controls="account-mobile-drawer" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.vyhody} /></svg><span>Výhody</span>
  </button>
  <button type="button" class:list={[more.some((item) => item.id === active) && !["faktury", "reklamacie"].includes(active) && "is-active"]} data-account-drawer-open="more" aria-controls="account-mobile-drawer" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d={icons.viac} /></svg><span>Viac</span>
  </button>
</nav>
<dialog class="account-mobile-drawer" id="account-mobile-drawer" data-account-drawer aria-labelledby="account-mobile-drawer-title">
  <div class="account-mobile-drawer-head"><h2 id="account-mobile-drawer-title">Menu účtu</h2><form method="dialog"><button type="submit" aria-label="Zavrieť menu účtu">×</button></form></div>
  <nav aria-label="Výhody účtu" data-account-drawer-group="benefits" hidden>
    {items.filter((item) => benefits.has(item.id)).map((item) => <a class="account-mobile-drawer-link" data-account-nav-link href={item.href} aria-current={active === item.id ? "page" : undefined}>{item.label}</a>)}
  </nav>
  <nav aria-label="Ďalšie časti účtu" data-account-drawer-group="more" hidden>
    {more.map((item) => <a class="account-mobile-drawer-link" data-account-nav-link href={item.href} aria-current={active === item.id ? "page" : undefined}>{item.label === "Profil" ? "Profil a heslo" : item.label === "Adresy" ? "Adresy a firemné údaje" : item.label === "Newsletter" ? "E-mailové novinky" : item.label}</a>)}
    <form method="post" action="/api/auth/logout" data-account-logout-form><button class="account-mobile-drawer-link" type="submit">Odhlásiť sa</button><p data-account-logout-error role="alert" hidden></p></form>
  </nav>
</dialog>
<noscript><nav class="account-mobile-fallback" aria-label="Všetky časti účtu">{items.map((item) => <a href={item.href}>{item.label}</a>)}</nav></noscript>
<!-- Critical tap handlers run while parsing the menu, before deferred account/advisor bundles. -->
<script is:inline data-account-menu-script set:html={menuScript} />
