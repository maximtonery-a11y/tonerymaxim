<section class="hero-shell">
  <div class="wrap hero">
    <div class="hero-copy">
      <h1>Nájdite správny toner za pár sekúnd</h1>
      <p>Pre tlačiarne HP, Brother, Canon, Epson, Xerox, Samsung a ďalšie.</p>

      <form class="search" action="/produkty" method="get" data-smart-search>
        <div class="search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M10.8 18.1a7.3 7.3 0 1 1 0-14.6 7.3 7.3 0 0 1 0 14.6Z" stroke="currentColor" stroke-width="2.2"/>
            <path d="m16.4 16.4 4.1 4.1" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
        </div>

        <input type="search" name="s" data-smart-search-input placeholder="Zadajte model tlačiarne alebo označenie toneru" />
        <button type="submit">Vyhľadať</button>
      </form>

      <div class="examples">
        <span class="examples-label">Príklady:</span>
        <a class="chip" href="/produkty?s=HP%20LaserJet%20M110w">HP LaserJet M110w</a>
        <a class="chip" href="/produkty?s=Brother%20DCP-L2532DW">Brother DCP-L2532DW</a>
        <a class="chip" href="/produkty?s=Canon%20MF655Cdw">Canon MF655Cdw</a>
        <a class="chip" href="/produkty?s=TN-2421">TN-2421</a>
        <a class="chip" href="/produkty?s=W1420A">W1420A</a>
      </div>
    </div>

    <div class="hero-art">
      <img class="hero-image" src="/images/tlaciaren.png" alt="Tlačiareň s tonerom" />
    </div>
  </div>
</section>
