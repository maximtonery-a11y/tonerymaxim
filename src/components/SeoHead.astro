---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  socialUrl?: string;
  image?: string;
  type?: "website" | "product" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

import { normalizeCanonical, normalizeSeoDescription, normalizeSeoTitle } from "../lib/seo-snippet.ts";

const PRODUCTION_ORIGIN = 'https://www.tonerymaxim.sk';
const PREVIEW_HOSTS = new Set(['tonerymaxim.info', 'www.tonerymaxim.info']);
const requestHostname = Astro.url.hostname.toLowerCase();
const socialOrigin = PREVIEW_HOSTS.has(requestHostname)
  ? `https://${requestHostname}`
  : PRODUCTION_ORIGIN;
const defaultCanonical = new URL(Astro.url.pathname, PRODUCTION_ORIGIN).toString();
const defaultSocialUrl = new URL(Astro.url.pathname, socialOrigin).toString();
const defaultImage = new URL('/images/tonerymaxim-social-preview.jpg', socialOrigin).toString();

const {
  title: rawTitle,
  description: rawDescription,
  canonical = defaultCanonical,
  socialUrl = defaultSocialUrl,
  image = defaultImage,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const title = normalizeSeoTitle(rawTitle);
const description = normalizeSeoDescription(rawDescription);
const normalizedCanonical = normalizeCanonical(canonical, defaultCanonical, PRODUCTION_ORIGIN);

const robots = noindex
  ? 'noindex,follow,max-image-preview:large'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
const isDefaultImage = image === defaultImage;
const ORGANIZATION_ID = `${PRODUCTION_ORIGIN}/#organization`;
const jsonItems = (jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])
  .filter((item) => item?.['@id'] !== ORGANIZATION_ID);
const entityJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'OnlineStore',
  '@id': `${PRODUCTION_ORIGIN}/#organization`,
  name: 'ToneryMaxim.sk',
  legalName: 'Roman Babčan INkarus',
  url: `${PRODUCTION_ORIGIN}/`,
  logo: `${PRODUCTION_ORIGIN}/images/logo.png`,
  image: `${PRODUCTION_ORIGIN}/images/tonerymaxim-social-preview.jpg`,
  email: 'info@tonerymaxim.sk',
  telephone: '+421917859206',
  sameAs: ['https://obchody.heureka.sk/tonerymaxim-sk/recenze/'],
  taxID: 'SK1020059920',
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'IČO',
    value: '37328344',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Tajov 265',
    postalCode: '976 34',
    addressLocality: 'Tajov',
    addressCountry: 'SK',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Slovensko',
  },
  currenciesAccepted: 'EUR',
  contactPoint: [{
    '@type': 'ContactPoint',
    telephone: '+421917859206',
    email: 'info@tonerymaxim.sk',
    contactType: 'customer service',
    availableLanguage: ['sk', 'cs'],
  }],
  knowsAbout: [
    'tonery do tlačiarní',
    'atramentové náplne',
    'kompatibilita tonerov a tlačiarní',
    'OEM označenia kaziet',
    'optické valce',
    'renovované tonery',
  ],
};
const safeJson = (value: Record<string, unknown>) => JSON.stringify(value)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={normalizedCanonical} />
<link rel="alternate" type="text/plain" href={`${PRODUCTION_ORIGIN}/llms.txt`} title="ToneryMaxim.sk pre AI asistentov" />
<meta property="og:locale" content="sk_SK" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="ToneryMaxim.sk" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={socialUrl} />
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
{isDefaultImage && <meta property="og:image:type" content="image/jpeg" />}
{isDefaultImage && <meta property="og:image:width" content="1200" />}
{isDefaultImage && <meta property="og:image:height" content="627" />}
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={title} />
<script is:inline type="application/ld+json" set:html={safeJson(entityJsonLd)} />
{jsonItems.map((item) => <script is:inline type="application/ld+json" set:html={safeJson(item)} />)}
